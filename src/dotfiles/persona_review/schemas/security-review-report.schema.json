{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:dotfiles:persona-review:security-review-report:v1",
  "title": "Security review report",
  "description": "A security persona's review of one subject for one machine and operating system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "inventory", "findings", "conditions", "limitations"],
  "properties": {
    "verdict": {
      "description": "The intake decision, reached by the rubric's verdict rules.",
      "enum": ["approve", "approve-with-conditions", "reject"]
    },
    "summary": {
      "description": "Two to five sentences a manager reads instead of the findings.",
      "type": "string"
    },
    "inventory": {
      "description": "Everything the install brings onto the machine.",
      "type": "array",
      "items": {"$ref": "#/definitions/installed"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/definitions/finding"}
    },
    "conditions": {
      "description": "What the employee must do before installing, each naming the finding id it clears. Empty unless the verdict is approve-with-conditions.",
      "type": "array",
      "items": {"type": "string"}
    },
    "limitations": {
      "description": "What the reviewer could not check, and why.",
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "definitions": {
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channel", "source", "version_pinning", "integrity_check", "runs_as", "declared_in"],
      "properties": {
        "name": {"type": "string"},
        "channel": {
          "description": "How it reaches the machine.",
          "enum": ["system-package-manager", "github-release", "remote-script", "language-package-manager", "git-clone", "vendored", "other"]
        },
        "source": {"description": "The URL, repository or package name it comes from.", "type": "string"},
        "version_pinning": {"enum": ["exact", "range", "latest", "unknown"]},
        "integrity_check": {"enum": ["signature", "checksum", "package-manager", "none", "unknown"]},
        "runs_as": {"description": "The account its installer runs as.", "enum": ["root", "user"]},
        "declared_in": {"description": "The repository path that declares it.", "type": "string"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end"],
      "properties": {
        "path": {"description": "Relative to the subject's root.", "type": "string"},
        "line_start": {"type": "integer"},
        "line_end": {"type": "integer"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "severity", "cwe", "attack_techniques", "category", "locations",
        "description", "evidence", "impact", "likelihood", "remediation", "remediation_kind", "references"
      ],
      "properties": {
        "id": {"description": "SEC- and a three-digit number, unique in this report.", "type": "string", "pattern": "^SEC-[0-9]{3}$"},
        "title": {"type": "string"},
        "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
        "cvss_v4_vector": {"description": "Optional. Its score falls in the severity's band.", "type": "string"},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "attack_techniques": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}},
        "category": {
          "enum": [
            "supply-chain", "code-execution", "privilege-escalation", "persistence", "credential-exposure",
            "defense-impairment", "network-exposure", "data-exfiltration", "configuration-weakening", "policy"
          ]
        },
        "locations": {"type": "array", "items": {"$ref": "#/definitions/location"}},
        "description": {"description": "What the code does, stated as fact.", "type": "string"},
        "evidence": {"description": "The lines quoted from the subject that show it.", "type": "string"},
        "impact": {"description": "What an attacker gains on this machine and from it.", "type": "string"},
        "likelihood": {"enum": ["high", "medium", "low"]},
        "remediation": {"description": "The fix, or why none is known.", "type": "string"},
        "remediation_kind": {"enum": ["code-change", "configuration", "compensating-control", "accept-risk", "none-available"]},
        "references": {"description": "URLs to the CWE, ATT&CK page, advisory or upstream documentation.", "type": "array", "items": {"type": "string"}}
      }
    }
  }
}
