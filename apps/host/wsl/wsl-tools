#!/usr/bin/env bash
set -euo pipefail

# Everything this machine needs to answer for WSL: what the disk weighs, why it
# is slow, and how to get the space back.
#
# One binary rather than a wsl-reclaim and a wsl-doctor beside each other. These
# get reached for a few times a year, and at that interval the cost is not typing
# the verb — it is remembering that the tool exists and what it was called. One
# name that lists its own verbs is findable; a family of them is a thing you go
# looking for.
#
# One *file*, too. The shell layer at ~/.local/shell/host/wsl is sourced by
# every interactive shell, so an implementation library there would put `clean`
# and `report` in the shell's namespace and pay for parsing them at every prompt.

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"

AGGRESSIVE=false
ASSUME_YES=false
BACKUP_DIR=""
FINDINGS=()

note() {
  FINDINGS+=("$1"$'\x1f'"$2")
}

# ================================================================
# THE WINDOWS SIDE
# ================================================================

powershell_out() {
  powershell.exe -NoProfile -NonInteractive -Command "$1" </dev/null 2>/dev/null | tr -d '\r\0'
}

windows_userprofile() {
  local profile
  profile=$(powershell_out "Write-Output \$env:USERPROFILE" | tr -d '\n')
  [[ -n "$profile" ]] || return 1
  wslpath -u "$profile" 2>/dev/null
}

windows_temp_dir() {
  local temp
  temp=$(powershell_out "Write-Output \$env:TEMP" | tr -d '\n')
  [[ -n "$temp" ]] || return 1
  wslpath -u "$temp" 2>/dev/null
}

# Whether this Windows account can elevate at all — not whether it is elevated
# now, which unelevated is always no and answers nothing.
#
# Group membership rather than IsInRole(Administrator). Under UAC an admin
# account runs on a filtered token where IsInRole answers false, so a probe built
# on it reports every machine as unable to elevate. The Administrators SID is
# still listed on the filtered token, which is the question actually being asked:
# will UAC prompt this user for consent, or for somebody else's password.
windows_can_elevate() {
  local answer
  answer=$(powershell_out "
    \$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    \$administrators = New-Object Security.Principal.SecurityIdentifier('S-1-5-32-544')
    if (\$identity.Groups -contains \$administrators) { Write-Output 'yes' } else { Write-Output 'no' }
  " | tr -d '\n ')

  [[ "$answer" == "yes" ]]
}

# The registry is the only reliable answer. Distros installed before WSL 2.4 sit
# under %LOCALAPPDATA%\Packages\<PackageFamilyName>\LocalState and newer ones
# under %LOCALAPPDATA%\wsl\{guid}, so a hardcoded path is wrong on about half the
# machines that have one.
wsl_base_path() {
  local distro="${WSL_DISTRO_NAME:-}" query base backslash device_prefix
  [[ -n "$distro" ]] || return 1

  # PowerShell string literals are single-quoted so the whole query survives one
  # round of bash double-quoting. \$_ is the pipeline variable and must reach
  # PowerShell unexpanded.
  query="(Get-ChildItem HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Lxss"
  query+=" | Where-Object { \$_.GetValue('DistributionName') -eq '$distro' }).GetValue('BasePath')"

  base=$(powershell_out "$query" | tr -d '\n')
  [[ -n "$base" ]] || return 1

  # BasePath comes back as an extended-length path. wslpath does not understand
  # the \\?\ device prefix and returns nothing at all for one. Assembled from a
  # variable because a literal backslash before a closing quote is unreadable
  # and reads to shellcheck as a botched escape.
  backslash=$'\\'
  device_prefix="${backslash}${backslash}?${backslash}"
  printf '%s\n' "${base#"$device_prefix"}"
}

vhdx_windows_path() {
  local base backslash
  base=$(wsl_base_path) || return 1
  backslash=$'\\'
  printf '%s%sext4.vhdx\n' "$base" "$backslash"
}

vhdx_linux_path() {
  local windows_path
  windows_path=$(vhdx_windows_path) || return 1
  wslpath -u "$windows_path" 2>/dev/null
}

# ================================================================
# MEASUREMENT
# ================================================================

human() {
  numfmt --to=iec --suffix=B --format='%.1f' "${1:-0}" 2>/dev/null || echo "${1:-0}"
}

dir_bytes() {
  local path="$1" total
  [[ -e "$path" ]] || {
    echo 0
    return 0
  }
  total=$(du -sb "$path" 2>/dev/null | cut -f1)
  echo "${total:-0}"
}

used_bytes() {
  df -B1 --output=used / | tail -1 | tr -d ' '
}

vhdx_bytes() {
  local vhdx
  if ! vhdx=$(vhdx_linux_path) || [[ ! -f "$vhdx" ]]; then
    echo 0
    return 0
  fi
  stat -c %s "$vhdx" 2>/dev/null || echo 0
}

# Where a cache lives is the owning tool's answer, not a path this script knows.
# go and npm both relocate theirs on a whim, and uv's moves with XDG_CACHE_HOME.
cache_path() {
  case "$1" in
    apt) echo /var/cache/apt/archives ;;
    pacman) echo /var/cache/pacman/pkg ;;
    uv) has_command uv && uv cache dir 2>/dev/null ;;
    go-build) has_command go && go env GOCACHE 2>/dev/null ;;
    go-modules) has_command go && go env GOMODCACHE 2>/dev/null ;;
    npm) has_command npm && npm config get cache 2>/dev/null ;;
    cargo) echo "${CARGO_HOME:-$HOME/.cargo}/registry" ;;
    pip) has_command pip && pip cache dir 2>/dev/null ;;
    journal) echo /var/log/journal ;;
    trash) echo "${XDG_DATA_HOME:-$HOME/.local/share}/Trash" ;;
    user-cache) echo "${XDG_CACHE_HOME:-$HOME/.cache}" ;;
  esac
  return 0
}

CACHES=(apt pacman uv go-build go-modules npm cargo pip journal trash user-cache)

# ================================================================
# REPORT
# ================================================================

report_disk() {
  print_section "Disk" "brightgreen"

  local used avail percent
  read -r used avail percent < <(df -h --output=used,avail,pcent / | tail -1)
  printf '  %-22s %s used, %s free (%s)\n' "inside the distro" "$used" "$avail" "$percent"

  local bytes wasted
  bytes=$(vhdx_bytes)
  if [[ "$bytes" -gt 0 ]]; then
    printf '  %-22s %s\n' "ext4.vhdx on Windows" "$(human "$bytes")"
    printf '  %-22s %s\n' "" "$(vhdx_windows_path)"

    # The gap is the whole subject. Everything else here is context for it.
    wasted=$((bytes - $(used_bytes)))
    [[ "$wasted" -gt 0 ]] && printf '  %-22s %s\n' "never given back" "$(human "$wasted")"
  else
    print_warning "Could not locate ext4.vhdx — is \$WSL_DISTRO_NAME set and interop enabled?"
  fi
  return 0
}

report_caches() {
  print_section "Caches" "brightblue"

  local name path bytes total=0 found=false
  for name in "${CACHES[@]}"; do
    path=$(cache_path "$name")
    [[ -n "$path" && -e "$path" ]] || continue
    bytes=$(dir_bytes "$path")
    [[ "$bytes" -gt 0 ]] || continue
    found=true
    printf '  %-14s %10s  %s\n' "$name" "$(human "$bytes")" "$path"
    # user-cache overlaps uv, npm and pip, so counting it would double-count.
    [[ "$name" == "user-cache" ]] || total=$((total + bytes))
  done

  if has_command docker && docker info >/dev/null 2>&1; then
    found=true
    printf '  %-14s %10s  %s\n' "docker" "$(docker system df --format '{{.Size}}' 2>/dev/null | head -1)" "docker system df"
  fi

  $found || print_info "No caches worth reporting."
  [[ "$total" -gt 0 ]] && printf '\n  %-14s %10s  (excludes the overlapping user cache)\n' "reclaimable" "$(human "$total")"
  return 0
}

report_route() {
  print_section "How this machine can shrink it" "brightmagenta"

  if windows_can_elevate; then
    print_success "This account can elevate — 'wsl-tools compact' is the cheap route"
    print_info "'wsl-tools rebuild' also works and needs no administrator"
  else
    print_warning "This account cannot elevate, so diskpart and Optimize-VHD are both closed"
    print_info "'wsl-tools rebuild' is the route that does not need one"
  fi
}

report() {
  print_header "wsl-tools" "brightcyan"
  report_disk
  report_caches
  report_route
  echo ""
  print_info "Free the blocks first, either way: wsl-tools clean"
}

# ================================================================
# CLEAN
# ================================================================

run_step() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    print_success "$label"
  else
    print_warning "$label — skipped or failed"
  fi
}

clean() {
  print_header "wsl-tools clean" "brightcyan"
  print_section "Purging caches" "brightblue"

  has_command apt-get && run_step "apt archives" sudo apt-get clean
  has_command apt-get && run_step "apt orphans" sudo apt-get -y autoremove --purge
  has_command pacman && run_step "pacman packages" sudo pacman -Scc --noconfirm
  has_command uv && run_step "uv cache" uv cache prune
  has_command go && run_step "go build and test cache" go clean -cache -testcache
  has_command npm && run_step "npm cache" npm cache clean --force
  has_command pip && run_step "pip cache" pip cache purge
  has_command journalctl && run_step "journal over 100M" sudo journalctl --vacuum-size=100M

  if has_command docker && docker info >/dev/null 2>&1; then
    if $AGGRESSIVE; then
      run_step "docker images, build cache and volumes" docker system prune -af --volumes
    else
      run_step "docker dangling images and build cache" docker system prune -f
    fi
  fi

  if $AGGRESSIVE; then
    # The module cache is every dependency of every Go project on the machine.
    # Clearing it costs a full re-download on the next build, which on a
    # throttled corporate network is minutes, so it is never the default.
    has_command go && run_step "go module cache" go clean -modcache
    local trash
    trash=$(cache_path trash)
    [[ -d "$trash" ]] && run_step "trash" find "$trash" -mindepth 1 -delete
  fi

  print_section "Releasing blocks" "brightmagenta"
  if sudo fstrim -av 2>&1 | grep -q trimmed; then
    print_success "fstrim released free blocks to the host"
  else
    print_info "fstrim had nothing to release — the root mount already discards"
  fi

  echo ""
  print_info "The vhdx does not shrink until it is compacted or rebuilt."
}

# ================================================================
# GENERATED POWERSHELL
# ================================================================

# Both scripts take their values as PowerShell parameters, and both heredocs are
# quoted so bash expands nothing inside them.
#
# An unquoted heredoc interpolating a Windows path is two footguns at once and
# both fired while this was being written: `$installDir` expanded to nothing
# because the local was named `install_dir`, and PowerShell's backtick escapes
# became bash command substitution. Neither shows up in the output — the
# generated script is just quietly wrong. With no expansion in the body there is
# nothing left to get wrong.

# Sparse mode is deliberately not offered. `--set-sparse true` has been gated
# behind --allow-unsafe since WSL 2.5.6 after reports of ext4 corruption, and a
# sparse vhdx cannot be compacted at all: diskpart refuses with "Virtual hard
# disk files must be uncompressed and unencrypted and must not be sparse."
# Turning it back off re-materialises every hole, so the escape hatch costs a
# full compact cycle.
#
# Optimize-VHD is not offered either. It needs the Hyper-V PowerShell module,
# which is absent on Windows Home and on any managed box that never enabled the
# feature, and diskpart does the same job everywhere it is allowed to run.
write_compact_script() {
  cat >"$1" <<'POWERSHELL'
param([Parameter(Mandatory = $true)][string]$Vhdx)

$ErrorActionPreference = 'Stop'

function Show-Size($label) {
  $size = (Get-Item -LiteralPath $Vhdx -Force).Length / 1GB
  Write-Host ("{0,-8} {1:N2} GB" -f $label, $size)
}

Show-Size 'Before:'

# The 8 second rule: WSL keeps the VM alive briefly after the last shell exits,
# and diskpart cannot attach a vhdx the utility VM still holds open.
Write-Host 'Shutting WSL down...'
wsl.exe --shutdown
Start-Sleep -Seconds 10

$commands = @"
select vdisk file="$Vhdx"
attach vdisk readonly
compact vdisk
detach vdisk
exit
"@

$scriptFile = [System.IO.Path]::GetTempFileName()
Set-Content -LiteralPath $scriptFile -Value $commands -Encoding ASCII
diskpart.exe /s $scriptFile
Remove-Item -LiteralPath $scriptFile -Force

Show-Size 'After:'
Read-Host 'Done. Press Enter to close'
POWERSHELL
}

# The only route that reclaims everything without elevation. The disk is not
# compacted; it is thrown away and written again from a tar of the filesystem,
# so the new one is the size of the data rather than of the high-water mark it
# once reached.
#
# The window between --unregister and --import is the whole risk. The archive is
# verified readable before anything is destroyed, is deliberately kept
# afterwards, and the re-import command is printed before the step that needs it.
write_rebuild_script() {
  cat >"$1" <<'POWERSHELL'
param(
  [Parameter(Mandatory = $true)][string]$Distro,
  [Parameter(Mandatory = $true)][string]$Archive,
  [Parameter(Mandatory = $true)][string]$InstallDir,
  [Parameter(Mandatory = $true)][long]$Needed
)

$ErrorActionPreference = 'Stop'

$backupDir = Split-Path -Parent $Archive
if (-not (Test-Path $backupDir)) { New-Item -ItemType Directory -Path $backupDir -Force | Out-Null }

# Checked before the shutdown rather than after the export has already spent the
# time and left a truncated archive for the verification below to reject.
$drive = (Get-Item $backupDir).PSDrive
if ($drive.Free -lt $Needed) {
  Write-Host ("Not enough room on {0}: {1:N1} GB free, {2:N1} GB needed." -f $drive.Name, ($drive.Free / 1GB), ($Needed / 1GB))
  Write-Host 'Re-run with --to <path> on a drive with more room. Nothing has been changed.'
  Read-Host 'Press Enter to close'
  exit 1
}

Write-Host 'Shutting WSL down...'
wsl.exe --shutdown
Start-Sleep -Seconds 10

Write-Host ('Exporting ' + $Distro + ' to ' + $Archive + ' - this takes a while.')
wsl.exe --export $Distro $Archive
if ($LASTEXITCODE -ne 0) {
  Write-Host 'Export failed. Nothing has been changed.'
  Read-Host 'Press Enter to close'
  exit 1
}

# An export that exits 0 and leaves an unreadable archive is the failure that
# matters, because the next step cannot be undone. Read it back before trusting.
Write-Host 'Verifying the archive...'
$listed = & tar.exe -tf $Archive 2>$null | Select-Object -First 1
if (-not $listed) {
  Write-Host 'The archive could not be read back. Nothing has been changed.'
  Read-Host 'Press Enter to close'
  exit 1
}
Write-Host ("Archive is readable: {0:N1} GB" -f ((Get-Item $Archive).Length / 1GB))

Write-Host ''
Write-Host 'Unregistering and re-importing. If anything fails from here, recover with:'
Write-Host ('  wsl --import ' + $Distro + ' "' + $InstallDir + '" "' + $Archive + '"')
Write-Host ''

wsl.exe --unregister $Distro
wsl.exe --import $Distro $InstallDir $Archive
if ($LASTEXITCODE -ne 0) {
  Write-Host 'IMPORT FAILED. The archive is intact. Run the command above to recover.'
  Read-Host 'Press Enter to close'
  exit 1
}

$rebuilt = Join-Path $InstallDir 'ext4.vhdx'
Write-Host ''
Write-Host ("New disk: {0:N2} GB" -f ((Get-Item -LiteralPath $rebuilt -Force).Length / 1GB))
Write-Host ('The archive is kept at ' + $Archive + '. Delete it once the distro is verified.')
Read-Host 'Done. Press Enter to close'
POWERSHELL
}

# ================================================================
# HANDOFF
# ================================================================

# PowerShell single-quoted literals take everything as written, so a Windows path
# needs no backslash escaping here — only an embedded quote, which doubles.
ps_quote() {
  printf "'%s'" "${1//\'/\'\'}"
}

# Detached and never a child of this shell: `wsl --shutdown` kills every process
# in the distro, and a compactor or an exporter that dies with its caller leaves
# the disk attached read-only, or the distro unregistered with no import.
launch_detached() {
  local windows_script="$1" verb="$2" arguments argument
  shift 2

  arguments="'-NoProfile','-ExecutionPolicy','Bypass','-File',$(ps_quote "$windows_script")"
  for argument in "$@"; do
    arguments+=",$(ps_quote "$argument")"
  done

  if [[ -n "$verb" ]]; then
    powershell_out "Start-Process -FilePath powershell.exe -Verb $verb -ArgumentList $arguments"
  else
    powershell_out "Start-Process -FilePath powershell.exe -ArgumentList $arguments"
  fi
}

# A destructive verb asks for the thing being destroyed, not for a keystroke. `y`
# is muscle memory; typing the distro name is not, and rebuild unregisters it.
confirm_with() {
  local expected="$1" answer

  $ASSUME_YES && return 0

  read -r -p "Type '$expected' to continue: " answer
  [[ "$answer" == "$expected" ]] && return 0

  print_info "Nothing done."
  return 1
}

# ================================================================
# COMPACT — cheap, needs an administrator
# ================================================================

compact() {
  local vhdx temp script_path windows_script

  # Probed before anything else. Firing Start-Process -Verb RunAs at an account
  # that cannot elevate produces a UAC box demanding another user's password,
  # which is a worse answer than saying so.
  if ! windows_can_elevate; then
    print_error "This Windows account cannot elevate, and diskpart will not run without it."
    print_info "Use 'wsl-tools rebuild' instead — it reclaims the same space with no administrator."
    return 1
  fi

  vhdx=$(vhdx_windows_path) || {
    print_error "Could not locate ext4.vhdx for \$WSL_DISTRO_NAME"
    return 1
  }

  temp=$(windows_temp_dir) || {
    print_error "Could not resolve the Windows temp directory"
    return 1
  }

  print_header "wsl-tools compact" "brightcyan"
  print_info "Target: $vhdx"
  echo ""
  print_warning "This shuts down every WSL distro, including this shell."
  print_warning "diskpart needs administrator rights, so Windows will prompt via UAC."

  confirm_with "yes" || return 0

  # The script has to live on the Windows filesystem. Anything under \\wsl$
  # becomes unreachable the instant `wsl --shutdown` runs, which is the second
  # instruction in the script itself.
  script_path="$temp/wsl-compact.ps1"
  write_compact_script "$script_path"
  windows_script=$(wslpath -w "$script_path")

  launch_detached "$windows_script" RunAs -Vhdx "$vhdx"

  print_success "Handed off to an elevated PowerShell window."
  print_info "This distro will stop within a few seconds. Reopen the terminal when it finishes."
}

# ================================================================
# REBUILD — no administrator, and irreversible in the middle
# ================================================================

# The default user is a property of the Store launcher's registration, and an
# imported distro has no launcher. Without this the rebuilt distro starts as
# root, which reads as a broken rebuild rather than a missing setting.
pin_default_user() {
  local conf="${WSL_CONF:-/etc/wsl.conf}"

  grep -qE '^\s*default\s*=' "$conf" 2>/dev/null && return 0

  print_info "Pinning the default user in $conf — an imported distro has no launcher to remember it."

  # sudo only where it is actually needed. /etc/wsl.conf is root-owned on a real
  # machine and the tests point this at a file they own.
  if [[ -w "$conf" ]] || { [[ ! -e "$conf" ]] && [[ -w "$(dirname "$conf")" ]]; }; then
    printf '\n[user]\ndefault=%s\n' "$(whoami)" >>"$conf"
  else
    printf '\n[user]\ndefault=%s\n' "$(whoami)" | sudo tee -a "$conf" >/dev/null
  fi
}

rebuild() {
  local distro="${WSL_DISTRO_NAME:-}" base temp script_path windows_script
  local archive install_dir needed used profile

  [[ -n "$distro" ]] || {
    print_error "\$WSL_DISTRO_NAME is unset — cannot tell Windows which distro to rebuild."
    return 1
  }

  base=$(wsl_base_path) || {
    print_error "Could not locate the install directory for $distro"
    return 1
  }

  temp=$(windows_temp_dir) || {
    print_error "Could not resolve the Windows temp directory"
    return 1
  }

  used=$(used_bytes)
  # The archive and the new disk both have to fit alongside the old one. 1.2x the
  # used bytes covers the archive plus the headroom the import needs.
  needed=$((used * 12 / 10))
  install_dir="$base"

  if [[ -n "$BACKUP_DIR" ]]; then
    archive="$BACKUP_DIR\\$distro.tar"
  else
    profile=$(windows_userprofile) || {
      print_error "Could not resolve %USERPROFILE% for the default archive location"
      return 1
    }
    archive="$(wslpath -w "$profile")\\wsl-backups\\$distro.tar"
  fi

  print_header "wsl-tools rebuild" "brightcyan"
  printf '  %-14s %s\n' "distro" "$distro"
  printf '  %-14s %s\n' "used now" "$(human "$used")"
  printf '  %-14s %s\n' "disk today" "$(human "$(vhdx_bytes)")"
  printf '  %-14s %s\n' "archive" "$archive"
  printf '  %-14s %s\n' "reinstall to" "$install_dir"
  echo ""
  print_warning "This exports the distro, unregisters it, and imports it back."
  print_warning "Between those steps the distro exists only as that archive."
  print_info "No administrator is needed. The archive is verified first and kept afterwards."

  confirm_with "$distro" || return 0

  pin_default_user

  script_path="$temp/wsl-rebuild.ps1"
  write_rebuild_script "$script_path"
  windows_script=$(wslpath -w "$script_path")

  launch_detached "$windows_script" "" \
    -Distro "$distro" -Archive "$archive" -InstallDir "$install_dir" -Needed "$needed"

  print_success "Handed off to a PowerShell window."
  print_info "This distro will stop within a few seconds. Watch that window for the result."
}

# ================================================================
# CHECKS
# ================================================================

check_version() {
  print_section "Version" "brightgreen"

  local version
  version=$(powershell_out 'wsl.exe --version' | head -1)
  printf '  %-22s %s\n' "wsl" "${version:-unknown}"
  printf '  %-22s %s\n' "distro" "${WSL_DISTRO_NAME:-unknown}"
  printf '  %-22s %s\n' "kernel" "$(uname -r)"

  # An inbox WSL has no --version at all. It also has no mirrored networking, no
  # autoMemoryReclaim and no --manage, so half of what follows silently does
  # nothing until it is updated.
  if [[ -z "$version" ]]; then
    note "WSL does not report a version" "It is the inbox build. Update it: wsl.exe --update"
  fi

  local state
  state=$(powershell_out "wsl.exe -l -v" | grep -F "${WSL_DISTRO_NAME:-}" | head -1)
  if [[ "$state" == *" 1"* ]]; then
    note "This distro runs on WSL 1" "WSL 1 has no real kernel and much slower Linux file IO. Convert: wsl.exe --set-version ${WSL_DISTRO_NAME:-<distro>} 2"
  fi
}

check_privilege() {
  print_section "Privilege" "brightyellow"

  if windows_can_elevate; then
    print_success "This Windows account can elevate"
    return 0
  fi

  print_warning "This Windows account cannot elevate"
  print_info "Defender exclusions and 'wsl-tools compact' are both closed off"
  print_info "'wsl-tools rebuild' shrinks the disk without one"
}

# A distro installed from the Store lives under Packages\<PackageFamilyName>.
# Anywhere else means it arrived through `wsl --import`, which is what a previous
# rebuild leaves behind — the machine remembers the procedure even when nobody
# does.
check_install_origin() {
  local base store_marker backslash
  base=$(wsl_base_path) || return 0

  print_section "Origin" "brightblue"
  printf '  %-22s %s\n' "installed at" "$base"

  backslash=$'\\'
  store_marker="${backslash}Packages${backslash}"
  if [[ "$base" == *"$store_marker"* ]]; then
    print_info "Registered by the Store package — never rebuilt"
  else
    print_success "Imported, not Store-installed — this distro has been rebuilt before"
  fi
}

check_memory() {
  print_section "Memory" "brightblue"

  local vm_total host_total swap_total
  vm_total=$(awk '/^MemTotal:/ {print $2 * 1024}' /proc/meminfo)
  swap_total=$(awk '/^SwapTotal:/ {print $2 * 1024}' /proc/meminfo)
  host_total=$(powershell_out '(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory' | tr -d '\n')

  printf '  %-22s %s\n' "assigned to the VM" "$(human "$vm_total")"
  printf '  %-22s %s\n' "swap" "$(human "$swap_total")"
  [[ -n "$host_total" ]] && printf '  %-22s %s\n' "installed on Windows" "$(human "$host_total")"

  local available
  available=$(awk '/^MemAvailable:/ {print $2 * 1024}' /proc/meminfo)
  printf '  %-22s %s\n' "available" "$(human "$available")"

  # Under 15% available is where a build starts swapping against a disk that is
  # itself a file on the host disk, which is the worst case WSL has.
  if [[ "$vm_total" -gt 0 ]] && [[ $((available * 100 / vm_total)) -lt 15 ]]; then
    note "Under 15% of the VM's memory is available" "Raise memory= in .wslconfig, or close what is holding it"
  fi
}

check_wslconfig() {
  print_section ".wslconfig" "brightmagenta"

  local profile config
  if ! profile=$(windows_userprofile); then
    print_warning "Could not resolve %USERPROFILE% — interop may be disabled"
    return 0
  fi

  config="$profile/.wslconfig"
  if [[ ! -f "$config" ]]; then
    print_warning "No .wslconfig — every setting is at its default"
    note "No .wslconfig exists" "Install the annotated one: task wsl:tune"
    return 0
  fi

  print_success "Present at $config"
  grep -vE '^\s*(#|;|$)' "$config" | sed 's/^/  /'

  # dropCache is the shipped default and it throws away the guest's page cache
  # wholesale, so the next build re-reads every file it just read. gradual
  # returns memory to Windows without that cliff.
  if ! grep -qE '^\s*autoMemoryReclaim' "$config"; then
    note "autoMemoryReclaim is unset, so it is dropCache" "Set autoMemoryReclaim=gradual under [experimental]"
  fi
}

check_wsl_conf() {
  print_section "/etc/wsl.conf" "brightgreen"

  if [[ ! -f /etc/wsl.conf ]]; then
    print_warning "No /etc/wsl.conf — every per-distro setting is at its default"
    return 0
  fi

  grep -vE '^\s*(#|;|$)' /etc/wsl.conf | sed 's/^/  /'
}

check_interop_path() {
  print_section "Interop" "brightblue"

  local windows_entries total_entries
  windows_entries=$(tr ':' '\n' <<<"$PATH" | grep -c '^/mnt/' || true)
  total_entries=$(tr ':' '\n' <<<"$PATH" | grep -c . || true)
  printf '  %-22s %s of %s\n' "PATH entries on /mnt" "$windows_entries" "$total_entries"

  # A command that exists is found and cached. A command that does not exist —
  # every typo, and every `command -v` guard in every shell library and prompt —
  # stats every directory on PATH, and each /mnt entry is a 9p round trip.
  local start end microseconds
  start=$(date +%s%N)
  for _ in $(seq 1 20); do
    command -v wsl-tools-probe-does-not-exist >/dev/null 2>&1 || true
  done
  end=$(date +%s%N)
  microseconds=$(((end - start) / 20 / 1000))
  printf '  %-22s %s µs\n' "cost of a PATH miss" "$microseconds"

  if [[ "$windows_entries" -gt 10 ]]; then
    note "$windows_entries Windows directories are on PATH, at ${microseconds}µs per lookup" \
      "Set appendWindowsPath=false under [interop] in /etc/wsl.conf, then symlink the .exe files you actually use into ~/.local/bin"
  fi
}

check_filesystem() {
  print_section "Filesystem" "brightmagenta"

  local home_fs
  home_fs=$(findmnt -no FSTYPE --target "$HOME" 2>/dev/null || echo unknown)
  printf '  %-22s %s (%s)\n' "\$HOME" "$HOME" "$home_fs"

  if [[ "$HOME" == /mnt/* ]]; then
    note "\$HOME is on the Windows filesystem" "Every file open crosses 9p. Move the home directory onto ext4."
  fi

  # Anything git touches is the worst case: status walks every file, and on drvfs
  # each stat is a round trip rather than a page-cache hit.
  #
  # Bounded by depth, by the profile directory and by a timeout, because the scan
  # is itself a drvfs walk. Unbounded across /mnt/c it takes long enough to read
  # as a hang, which in a tool about things being slow is its own bug report.
  local repos profile
  profile=$(windows_userprofile) || return 0
  repos=$(timeout 10 fd -HI -t d -d 3 '^\.git$' "$profile" 2>/dev/null | head -5 || true)
  if [[ -n "$repos" ]]; then
    print_warning "Git repos on the Windows filesystem:"
    while IFS= read -r repo; do
      printf '    %s\n' "$repo"
    done <<<"$repos"
    note "Git repos are living on /mnt/c" "Move them under ~ — git on drvfs is an order of magnitude slower"
  fi
}

check_systemd() {
  systemctl is-system-running >/dev/null 2>&1 || return 0

  print_section "Boot" "brightgreen"
  systemd-analyze blame 2>/dev/null | head -5 | sed 's/^/  /' || true
}

check_defender() {
  print_section "Defender" "brightblue"

  local exclusions
  exclusions=$(powershell_out 'Get-MpPreference -ErrorAction SilentlyContinue | Select-Object -ExpandProperty ExclusionPath')
  if [[ -z "$exclusions" ]]; then
    print_info "No exclusions readable — Defender is off, or policy hides them"
    return 0
  fi

  if grep -qiF 'ext4.vhdx' <<<"$exclusions" || grep -qiE 'LocalState|\\wsl' <<<"$exclusions"; then
    print_success "The WSL disk is excluded from real-time scanning"
    return 0
  fi

  # Worded by what this account can do about it. A fix nobody here can apply is
  # context, not an action, and listing it as one is noise on every run.
  if windows_can_elevate; then
    note "The ext4.vhdx is not excluded from Defender" \
      "Every read and write inside WSL is scanned on the host. Add an exclusion for the disk as an administrator."
  else
    print_warning "The ext4.vhdx is not excluded from Defender, and this account cannot add one"
    print_info "Every read and write inside WSL is scanned on the host. It needs an administrator."
  fi
}

# ================================================================
# BENCH
# ================================================================

# Timed here rather than read off dd's own summary: GNU time is not installed
# everywhere, and dd's throughput line is localised and formatted differently
# across coreutils versions.
write_speed() {
  local target="$1" start end nanoseconds
  start=$(date +%s%N)
  dd if=/dev/zero of="$target" bs=1M count=64 conv=fdatasync >/dev/null 2>&1 || {
    echo "n/a"
    return 0
  }
  end=$(date +%s%N)
  rm -f "$target"

  nanoseconds=$((end - start))
  awk -v n="$nanoseconds" 'BEGIN { if (n > 0) printf "%.0f MB/s", 64 / (n / 1000000000); else print "n/a" }'
}

bench() {
  print_header "wsl-tools bench" "brightcyan"
  print_info "Writing 64MB to each filesystem."
  echo ""

  printf '  %-22s %s\n' "ext4 (inside WSL)" "$(write_speed /tmp/wsl-tools-bench)"

  local profile
  if profile=$(windows_userprofile); then
    printf '  %-22s %s\n' "drvfs (/mnt/c)" "$(write_speed "$profile/wsl-tools-bench")"
  fi

  echo ""
  print_info "A large gap is why repos belong under ~ and not under /mnt/c."
}

report_findings() {
  echo ""
  if [[ ${#FINDINGS[@]} -eq 0 ]]; then
    print_section_success "Nothing to fix"
    return 0
  fi

  print_section "What to change" "brightyellow"
  local finding problem fix
  for finding in "${FINDINGS[@]}"; do
    IFS=$'\x1f' read -r problem fix <<<"$finding"
    print_warning "$problem"
    printf '    %s\n' "$fix"
  done
}

# ================================================================
# TIMING
# ================================================================

# Median of three rather than one run or a mean. A shell startup is dominated by
# whatever else the machine was doing during it, so a single sample is noise and
# a mean is whatever the worst sample was.
median_ms() {
  local runs=() start end
  for _ in 1 2 3; do
    start=$(date +%s%N)
    "$@" >/dev/null 2>&1 || true
    end=$(date +%s%N)
    runs+=($(((end - start) / 1000000)))
  done
  printf '%s\n' "${runs[@]}" | sort -n | sed -n '2p'
}

# The interop entries, which is what `appendWindowsPath` adds and what a PATH
# miss pays for one at a time.
path_without_windows() {
  tr ':' '\n' <<<"$PATH" | grep -v '^/mnt/' | paste -sd: -
}

# ================================================================
# PROCESSES
# ================================================================

# What a filesystem type costs, said once so the table and the summary agree.
mount_note() {
  case "$1" in
    ext4 | btrfs | xfs) echo "native, page-cache speed" ;;
    9p | drvfs | virtiofs | drvfs2) echo "crosses to Windows, a round trip per op" ;;
    cifs | nfs | smb3) echo "network share" ;;
    overlay) echo "container layer" ;;
    *) return 1 ;;
  esac
}

processes() {
  print_header "wsl-tools processes" "brightcyan"

  print_section "Holding memory inside the VM" "brightgreen"
  printf '  %10s %7s  %s\n' "RSS" "CPU" "COMMAND"

  local rss cpu comm
  while read -r rss cpu comm; do
    [[ -n "$comm" ]] || continue
    printf '  %10s %6s%%  %s\n' "$(human $((rss * 1024)))" "$cpu" "$comm"
  done < <(ps -eo rss=,pcpu=,comm= --sort=-rss 2>/dev/null | head -8)

  local resident charged gap
  resident=$(ps -eo rss= 2>/dev/null | awk '{total += $1} END {print total * 1024}')

  print_section "What Windows is charged for the VM" "brightblue"

  # vmmemWSL on current builds, vmmem on older ones. Asking for both and taking
  # the first hit is cheaper than working out which build this is.
  charged=$(powershell_out "Get-Process -Name vmmemWSL,vmmem -ErrorAction SilentlyContinue | ForEach-Object { \$_.WorkingSet64 }" | head -1 | tr -d ' ')

  if [[ -z "$charged" || ! "$charged" =~ ^[0-9]+$ ]]; then
    print_warning "Could not read the VM's working set from Windows"
    return 0
  fi

  printf '  %-24s %s\n' "vmmem working set" "$(human "$charged")"
  printf '  %-24s %s\n' "resident in processes" "$(human "${resident:-0}")"

  # The gap is the guest's page cache, and it is the whole subject of
  # autoMemoryReclaim. Windows is charged for it; nothing inside reports it as
  # used, which is why WSL looks like it leaks and does not.
  gap=$((charged - ${resident:-0}))
  if [[ "$gap" -gt 0 ]]; then
    printf '  %-24s %s\n' "page cache and slack" "$(human "$gap")"
    print_info "That gap is cache Windows pays for and Linux reports as free."
    print_info "autoMemoryReclaim decides whether it is returned gradually or dropped outright."
  fi

  print_section "WSL processes on the Windows side" "brightmagenta"
  local helpers
  helpers=$(powershell_out "Get-Process -ErrorAction SilentlyContinue | Where-Object { \$_.Name -match 'wsl|docker' } | ForEach-Object { \$_.Name + ' ' + [math]::Round(\$_.WorkingSet64 / 1MB) + ' MB' }")

  if [[ -z "$helpers" ]]; then
    print_info "None found."
    return 0
  fi

  while IFS= read -r helper; do
    [[ -n "$helper" ]] && printf '  %s\n' "$helper"
  done <<<"$helpers"
}

# ================================================================
# MOUNTS
# ================================================================

mounts() {
  print_header "wsl-tools mounts" "brightcyan"

  print_section "Where each path actually lives" "brightgreen"

  # The target goes last in every row here. A container layer path is 70-odd
  # characters of hash and a fixed-width column for it wraps every other row.
  local target fstype note layers=0
  while read -r target fstype; do
    note=$(mount_note "$fstype") || continue

    # Docker's layers are one mount each and there is a mount per image on the
    # machine. They answer no question this verb is asked, and unsummarised they
    # are the entire output on any box that runs containers.
    if [[ "$fstype" == "overlay" ]]; then
      layers=$((layers + 1))
      continue
    fi

    printf '  %-9s %-42s %s\n' "$fstype" "$note" "$target"
  done < <(findmnt -rno TARGET,FSTYPE 2>/dev/null | sort -k2)

  [[ "$layers" -gt 0 ]] && printf '  %-9s %-42s %s\n' "overlay" "container layer" "$layers mounts"

  print_section "The paths you work in" "brightblue"
  local path label
  for label in "\$HOME:$HOME" "cwd:$PWD"; do
    path="${label#*:}"
    fstype=$(findmnt -no FSTYPE --target "$path" 2>/dev/null || echo unknown)
    printf '  %-9s %-42s %s\n' "${label%%:*}" "$(mount_note "$fstype" || echo "$fstype")" "$path"
  done

  # Every Windows drive is mounted whether or not anything uses it, so the count
  # says nothing on its own. What matters is whether work is happening on one.
  if [[ "$PWD" == /mnt/* ]]; then
    print_warning "You are working on the Windows filesystem right now."
    print_info "git, node_modules and anything that walks a tree pay a round trip per file here."
  fi
}

# ================================================================
# STARTUP
# ================================================================

startup() {
  print_header "wsl-tools startup" "brightcyan"
  print_info "Median of three runs each."

  print_section "Shell startup" "brightgreen"
  printf '  %-26s %s ms\n' "bash, no rc" "$(median_ms bash --norc --noprofile -c true)"

  if ! has_command zsh; then
    print_warning "zsh is not installed, so there is no interactive startup to measure."
    return 0
  fi

  printf '  %-26s %s ms\n' "zsh, no rc" "$(median_ms zsh -f -c true)"

  local full
  full=$(median_ms zsh -i -c true)
  printf '  %-26s %s ms\n' "zsh, interactive" "$full"

  print_section "What the Windows PATH costs" "brightblue"

  local windows_entries stripped delta
  windows_entries=$(tr ':' '\n' <<<"$PATH" | grep -c '^/mnt/' || true)
  printf '  %-26s %s\n' "interop PATH entries" "$windows_entries"

  if [[ "$windows_entries" -eq 0 ]]; then
    print_success "No Windows directories on PATH — appendWindowsPath is already off."
    return 0
  fi

  # The same interactive startup with the interop entries removed. It measures
  # what turning appendWindowsPath off would buy, which is otherwise a change you
  # can only evaluate by living with it.
  stripped=$(PATH="$(path_without_windows)" median_ms zsh -i -c true)
  printf '  %-26s %s ms\n' "same, without them" "$stripped"

  delta=$((full - stripped))
  if [[ "$delta" -gt 0 ]]; then
    printf '  %-26s %s ms\n' "cost per new shell" "$delta"
    print_info "Set appendWindowsPath=false under [interop] in /etc/wsl.conf to keep it,"
    print_info "then symlink the .exe files you actually use into ~/.local/bin."
  else
    print_success "The interop entries are not measurably costing startup time."
  fi
}

# ================================================================
# ENTRY
# ================================================================

doctor() {
  print_header "wsl-tools doctor" "brightcyan"
  check_version
  check_privilege
  check_install_origin
  check_memory
  check_wslconfig
  check_wsl_conf
  check_interop_path
  check_filesystem
  check_systemd
  check_defender
  report_findings
}

show_help() {
  help_header "wsl-tools" "What the WSL disk weighs, why it is slow, and how to get the space back."
  help_usage "wsl-tools <verb> [options]"

  help_section "Verbs"
  help_row "status" "" "What the disk and each cache weigh, and which shrink route is open"
  help_row "doctor" "" "Why WSL is sluggish, measured, with the change that fixes each one"
  help_row "clean" "" "Purge caches, then release the freed blocks"
  help_row "compact" "" "Shrink the vhdx in place. Needs a Windows administrator."
  help_row "rebuild" "" "Export, unregister and re-import. Needs no administrator."
  help_row "bench" "" "Compare ext4 and drvfs write throughput"

  help_section "Looking closer"
  help_row "processes" "" "What holds memory and CPU inside, against what Windows is charged"
  help_row "mounts" "" "Which paths are native ext4 and which cross to Windows"
  help_row "startup" "" "Shell startup cost, and how much of it is the Windows PATH"

  help_section "Options"
  help_row "-a, --aggressive" "" "With clean: also drop the go module cache, docker volumes, trash"
  help_row "--to" "<win-path>" "With rebuild: where to write the archive, e.g. D:\\backups"
  help_row "-y, --yes" "" "Skip the confirmation"
  help_row "-h, --help" "" "Show this help message"

  help_section "Examples"
  help_row "wsl-tools status"
  help_row "wsl-tools clean --aggressive"
  help_row "wsl-tools rebuild --to D:\\backups"

  help_end
  print_info "Freeing space inside the distro never shrinks the file. Both steps are needed."
}

main() {
  local verb=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a | --aggressive) AGGRESSIVE=true ;;
      -y | --yes) ASSUME_YES=true ;;
      --to)
        shift
        BACKUP_DIR="${1:-}"
        [[ -n "$BACKUP_DIR" ]] || {
          print_error "--to needs a Windows path"
          return 1
        }
        ;;
      -h | --help | help)
        show_help
        return 0
        ;;
      status | doctor | clean | compact | rebuild | bench) verb="$1" ;;
      processes | mounts | startup) verb="$1" ;;
      *)
        print_error "Unknown argument: $1"
        return 1
        ;;
    esac
    shift
  done

  # A bare invocation lists the verbs rather than picking one. This is reached
  # for a few times a year, so the common case is not knowing what it can do.
  if [[ -z "$verb" ]]; then
    show_help
    return 0
  fi

  if ! grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    print_error "wsl-tools only means anything inside WSL."
    return 1
  fi

  case "$verb" in
    status) report ;;
    doctor) doctor ;;
    clean) clean ;;
    compact) compact ;;
    rebuild) rebuild ;;
    bench) bench ;;
    processes) processes ;;
    mounts) mounts ;;
    startup) startup ;;
  esac
}

# Sourced by tests/shell/test_wsl_tools.py, which drives the generated PowerShell
# directly. It cannot be exercised any other way: the machine running the tests
# is not the machine that has a vhdx.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
