#!/usr/bin/env bash
# rofi-keybinds - Display Hyprland keybindings in rofi
# Lists every bind registered with a description, as `hyprctl binds` reports them

set -euo pipefail

# modmask is the xkb modifier bitfield: SHIFT 1, CTRL 4, ALT 8, SUPER 64.
get_keybinds() {
  hyprctl binds -j | jq -r '
    def has_mod($bit): (. / $bit | floor) % 2 == 1;
    .[]
    | select(.has_description)
    | ([ (.modmask | if has_mod(64) then "Super" else empty end),
         (.modmask | if has_mod(4) then "Ctrl" else empty end),
         (.modmask | if has_mod(8) then "Alt" else empty end),
         (.modmask | if has_mod(1) then "Shift" else empty end),
         .key ] | join(" + ")) as $keys
    | (if .submap == "" then "" else "[\(.submap)] " end) + "\($keys) → \(.description)"
  ' | sort
}

main() {
  get_keybinds | rofi -dmenu -i -p "Keybinds" -no-custom || true
}

# If called with --list, just output the keybinds (for piping)
if [[ "${1:-}" == "--list" ]]; then
  get_keybinds
else
  main
fi
