#!/usr/bin/env bash
# fleet-capture-window - Open a floating Ghostty on a fleet inbox capture note
#
# SUPER+C runs this on Hyprland, whose window rule floats and centers the window by
# its class. fleet reads the same class to record the window the key was pressed over.
#
# Usage:
#   fleet-capture-window                    Keep the screen, then open the window
#   fleet-capture-window --write [SCREEN]   Inside it, write the note and report a failure

set -euo pipefail

if [[ "${1:-}" != "--write" ]]; then
  screens="${XDG_STATE_HOME:-$HOME/.local/state}/fleet/capture-screens"
  mkdir -p "$screens"
  chmod 700 "$screens"
  screen="$screens/$(date -u +%Y%m%dT%H%M%S%3NZ).jpg"
  # Taken before the window exists, so the note is not in the shot. A desk with
  # no screenshot still gets its note.
  grim -t jpeg -q 80 "$screen" || screen=""
  exec ghostty --class=fleet.inbox.capture -e "$0" --write "$screen"
fi

failure=$(mktemp)
screen="${2:-}"
filed=""

# A screenshot no row names is one nobody would find to remove, and it can show anything.
leave() {
  rm -f "$failure"
  if [[ -z "$filed" && -n "$screen" ]]; then
    rm -f "$screen"
  fi
}
trap leave EXIT
# Closing the window cancels the note, which is why this exits without a notification.
trap 'exit 1' HUP TERM

screen_flag=()
if [[ -n "$screen" ]]; then
  screen_flag=(--screen "$screen")
fi

# The window closes when this exits, so a failure has to outlive it.
if VISUAL="nvim +startinsert" fleet inbox capture note "${screen_flag[@]}" 2>"$failure"; then
  filed=yes
else
  notify-send "fleet inbox capture" "$(<"$failure")"
fi
