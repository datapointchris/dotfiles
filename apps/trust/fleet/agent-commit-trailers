#!/usr/bin/env bash
# prepare-commit-msg hook, run from git config rather than .git/hooks. A commit
# made inside a Claude Code session gets Agent-Name, Agent-Session and, under a
# scheduled run, Agent-Run. A session in a slate worklog also names it in Worklog.
# A commit with no session in its environment is left alone, and starts no slate.
#
# It never refuses a commit. A message it cannot stamp is committed without the
# trailers, with a line on stderr saying so.
set -uo pipefail

message_file=${1:?git passes the commit message file first}
session=${CLAUDE_CODE_SESSION_ID:-}
[[ -n $session ]] || exit 0

# A rebase rewrites commits rather than making them, so each keeps the trailers it has.
for rewriting in rebase-merge rebase-apply; do
  [[ ! -d $(git rev-parse --git-path "$rewriting") ]] || exit 0
done

library=${SHELL_DIR:-$HOME/.local/shell}/git-commit-hooks.sh
if ! source "$library" 2>/dev/null; then
  echo "agent-commit-trailers: $library is missing, so this commit carries no agent trailers" >&2
  exit 0
fi

trailers=(--trailer "Agent-Name: $(agent_name)" --trailer "Agent-Session: $session")
[[ -z ${FLEET_RUN_ID:-} ]] || trailers+=(--trailer "Agent-Run: $FLEET_RUN_ID")

# A test's fixture repo, whose origin has no host, asks slate nothing. An amend keeps
# the worklog its message names. The bound keeps a slate that cannot answer from
# holding the commit up.
if hosted_repo_name >/dev/null && ! git interpret-trailers --parse "$message_file" | grep -q '^Worklog: '; then
  bound_seconds=3
  failure=$(mktemp)
  worklog=$(timeout "$bound_seconds" slate worklogs current 2>"$failure")
  status=$?
  if ((status == 0)); then
    [[ -z $worklog ]] || trailers+=(--trailer "Worklog: $worklog")
  else
    reason=$(head -n 1 "$failure")
    ((status != 124)) || reason="slate did not answer within $bound_seconds seconds"
    echo "agent-commit-trailers: ${reason:-slate exited $status}, so this commit carries no Worklog trailer" >&2
  fi
  rm -f "$failure"
fi

# doNothing keeps the trailers already there, so an amend never doubles them.
if ! git interpret-trailers --in-place --if-exists doNothing "${trailers[@]}" "$message_file"; then
  echo "agent-commit-trailers: could not stamp $message_file, so this commit carries no agent trailers" >&2
fi
exit 0
