#!/usr/bin/env bash
# post-commit and post-merge hook, run from git config rather than .git/hooks. A
# session's commit is recorded on the slate worklog the session is in as the commit
# is made, under its full sha and the repo its origin names. A commit outside a
# session, or in a repo whose origin has no host, starts no slate. A session in no
# worklog links nothing.
#
# A post-merge that made no commit, a fast-forward or a squash, links nothing, as in
# record-git-commit.
#
# It never fails a commit. A link it cannot make is left out, with a line on stderr
# saying so.
set -uo pipefail

[[ -n ${CLAUDE_CODE_SESSION_ID:-} ]] || exit 0

# An origin with a host marks real work, so a test's fixture repo links nothing.
origin=$(git remote get-url origin 2>/dev/null) || exit 0
[[ $origin == *:* && $origin != file:* ]] || exit 0

if (($# > 0)); then
  [[ $1 == 0 ]] || exit 0
  [[ $(git reflog -1 --format=%gs HEAD 2>/dev/null) != *': Fast-forward'* ]] || exit 0
fi

commit=$(git rev-parse HEAD)

# Each bound keeps a slate that cannot answer from holding the commit up.
bound_seconds=3
failure=$(mktemp)
trap 'rm -f "$failure"' EXIT

report_slate_failure() {
  local status=$1 what=$2 reason
  reason=$(head -n 1 "$failure")
  ((status != 124)) || reason="slate did not answer within $bound_seconds seconds"
  echo "link-commit-to-slate-worklog: ${reason:-slate exited $status}, so $what" >&2
}

worklog=$(timeout "$bound_seconds" slate worklogs current 2>"$failure")
status=$?
if ((status != 0)); then
  report_slate_failure "$status" "no worklog links $commit"
  exit 0
fi
[[ -n $worklog ]] || exit 0

timeout "$bound_seconds" slate worklogs link "$worklog" --commit "$commit" --repo "$(basename "$origin" .git)" >/dev/null 2>"$failure"
status=$?
((status == 0)) || report_slate_failure "$status" "worklog $worklog does not link $commit"
exit 0
