#!/usr/bin/env bash
# post-commit and post-merge hook, run from git config rather than .git/hooks. Each
# commit made here appends one git.commit_made record to
# $XDG_STATE_HOME/telemetry/git-commits.jsonl, which Alloy ships. The record names
# the commit by its sha, and the session that made it with the time to the
# millisecond. The warehouse joins that session and time to the worklog the session
# held, so the record names no worklog and this hook calls no service.
# git-commit-record.schema.json beside it is the record's shape.
#
# Past ROTATE_BYTES the file is renamed to git-commits.jsonl.1 before the append,
# replacing the generation before it. Alloy follows the rename, so nothing ships
# twice, and worktree reads .1 before the current file.
#
# A repo whose origin has no host, such as a test's fixture, records nothing, and
# neither does a post-merge that made no commit. git-commit-hooks.sh decides both.
#
# It never refuses a commit. A record it cannot write is left out, with a line on
# stderr saying so.
set -uo pipefail

# worktree reads both generations whole on every run, so the bound keeps that read
# short. Alloy has shipped a line within seconds, so one old generation is enough.
ROTATE_BYTES=$((8 * 1024 * 1024))

# jq rather than date, because BSD date has no %N.
made=$(jq -nr 'now | (floor | strftime("%Y-%m-%dT%H:%M:%S")) + "." + ("00" + ((. * 1000 | floor) % 1000 | tostring))[-3:] + "Z"' 2>/dev/null)

library=${SHELL_DIR:-$HOME/.local/shell}/git-commit-hooks.sh
if ! source "$library" 2>/dev/null; then
  echo "record-git-commit: $library is missing, so this commit has no git.commit_made record" >&2
  exit 0
fi
repo=$(hosted_repo_name) || exit 0
made_a_commit "$@" || exit 0

read -r sha parents < <(git log -1 --format='%H %P' HEAD 2>/dev/null)
if [[ -z ${sha:-} || -z $made ]]; then
  echo "record-git-commit: git could not read HEAD or jq could not read the clock, so this commit has no git.commit_made record" >&2
  exit 0
fi
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=''

session=${CLAUDE_CODE_SESSION_ID:-}
agent=''
[[ -z $session ]] || agent=$(agent_name)

# W3C baggage is comma-separated key=value members, each with optional ;properties.
# A flow id is a W3C trace id, and any other value reads as no flow.
flow=''
IFS=, read -ra members <<<"${BAGGAGE:-}"
for member in "${members[@]}"; do
  member=${member%%;*}
  member=${member//[[:space:]]/}
  [[ $member != fleet.flow.id=* ]] || flow=${member#fleet.flow.id=}
done
[[ $flow =~ ^[0-9a-f]{32}$ && $flow != 00000000000000000000000000000000 ]] || flow=''

# The trace context puts the record under the span that made the commit.
trace_id=''
span_id=''
if [[ ${TRACEPARENT:-} =~ ^00-([0-9a-f]{32})-([0-9a-f]{16})-[0-9a-f]{2}$ ]]; then
  trace_id=${BASH_REMATCH[1]}
  span_id=${BASH_REMATCH[2]}
fi

# The resource is what the spawner set, such as the run and the agent, then this
# service last, so an inherited service.name cannot replace it.
resource="${OTEL_RESOURCE_ATTRIBUTES:+$OTEL_RESOURCE_ATTRIBUTES,}service.name=git"

record=$(jq -cn \
  --arg timestamp "$made" --arg resource "$resource" --arg sha "$sha" --arg parents "${parents:-}" \
  --arg repo "$repo" --arg branch "$branch" \
  --arg session "$session" --arg agent "$agent" --arg run "${FLEET_RUN_ID:-}" --arg flow "$flow" \
  --arg trace_id "$trace_id" --arg span_id "$span_id" \
  '{
    timestamp: $timestamp,
    name: "git.commit_made",
    resource: $resource,
    "fleet.schema_version": 1,
    trace_id: $trace_id,
    span_id: $span_id,
    "vcs.ref.head.revision": $sha,
    "vcs.repository.name": $repo,
    "vcs.ref.head.name": $branch,
    "session.id": $session,
    "fleet.commit.parents": ($parents | split(" ") | map(select(. != ""))),
    "fleet.agent.name": $agent,
    "fleet.run.id": $run,
    "fleet.flow.id": $flow
  } | with_entries(select(.value != ""))') || {
  echo "record-git-commit: jq could not build the record, so $sha has no git.commit_made record" >&2
  exit 0
}

records=${XDG_STATE_HOME:-$HOME/.local/state}/telemetry/git-commits.jsonl
# wc rather than stat, because BSD stat spells the size -f %z.
if size=$(wc -c 2>/dev/null <"$records") && ((size > ROTATE_BYTES)); then
  mv -f "$records" "$records.1" 2>/dev/null \
    || echo "record-git-commit: could not rotate $records to $records.1, so it keeps growing" >&2
fi
if ! { mkdir -p "${records%/*}" && printf '%s\n' "$record" >>"$records"; } 2>/dev/null; then
  echo "record-git-commit: could not append to $records, so $sha has no git.commit_made record" >&2
fi
exit 0
