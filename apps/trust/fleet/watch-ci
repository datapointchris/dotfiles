class ActionsPoller:
    """What the API last said about each repo's runs, jobs, pull requests and tags."""

    def __init__(self, github: GitHub, owner: str, repos: list[str]) -> None:
        self.github = github
        self.owner = owner
        self.repos = repos
        self.idle_turn: dict[str, float] = {}
        self.stagger(time.time())
        self.references_read: dict[tuple[str, str], float] = {}
        self.excerpt_retry: dict[int, float] = {}
        self.excerpt_attempts: collections.Counter[int] = collections.Counter()
        self.pruned = 0.0
        self.visible = True
        self.live_jobs: dict[int, dict[int, Json]] = {}
        self.running_check_runs: list[str] = []
        self.live_error = ''
        self.live_took = 0.0
        self.run_lists_changed = asyncio.Event()

    def body(self, kind: str, name: object) -> Path:
        return self.github.cache / kind / f'{name}.json'

    def runs(self) -> list[Json]:
        return [run for repo in self.repos for run in (self.github.load(self.body('runs', repo)) or {}).get('workflow_runs', [])]

    def rest_jobs(self, run_id: int) -> list[Json]:
        return (self.github.load(self.body('jobs-every-attempt', run_id)) or {}).get('jobs', [])

    def jobs(self, run_id: int) -> list[Json]:
        """The REST jobs, with the live view's status, times and steps laid over each job it has."""
        live = self.live_jobs.get(run_id, {})
        return [job | live[job['id']] if job['id'] in live else job for job in self.rest_jobs(run_id)]

    def disagrees(self, run_id: int) -> bool:
        """Whether the live view has a job the REST copy lacks, or one in another state."""
        rest = {job['id']: job['status'] for job in self.rest_jobs(run_id)}
        return any(rest.get(job_id) != live['status'] for job_id, live in self.live_jobs[run_id].items())

    async def follow_live(self, every: float, landed: Callable[[], None]) -> None:
        """Keep the live view current: each `every` seconds while a job runs, otherwise each LIVE_QUIET_EVERY or when a run list changes."""
        while True:
            started = time.time()
            self.run_lists_changed.clear()
            if self.visible and not self.github.held('graphql', started):
                await self.read_live()
                landed()
            await asyncio.sleep(max(started + every - time.time(), 0.0))
            if not self.running_check_runs:
                with contextlib.suppress(TimeoutError):
                    await asyncio.wait_for(self.run_lists_changed.wait(), max(started + LIVE_QUIET_EVERY - time.time(), 0.0))

    async def read_live(self) -> None:
        suites = {
            run['check_suite_node_id']: run['id'] for run in self.runs() if run['status'] != 'completed' and run.get('check_suite_node_id')
        }
        if not suites:
            self.live_jobs, self.running_check_runs, self.live_error = {}, [], ''
            return
        asked = list(suites)[:LIVE_NODES_MOST]
        started = time.perf_counter()
        data, problem = await self.github.graphql(LIVE_QUERY, {'suites': asked, 'running': self.running_check_runs[:LIVE_NODES_MOST]})
        self.live_took = time.perf_counter() - started
        try:
            if data is None:
                raise ValueError(problem)
            steps = {
                node['databaseId']: [rest_shaped(step, STEP_FIELDS) for step in node['steps']['nodes']] for node in data['running'] if node
            }
            live: dict[int, dict[int, Json]] = {}
            running = []
            for suite, node in zip(asked, data['suites'], strict=True):
                if not node:
                    continue
                jobs = live[suites[suite]] = {}
                for check in node['checkRuns']['nodes']:
                    jobs[check['databaseId']] = rest_shaped(check, CHECK_RUN_FIELDS)
                    if check['databaseId'] in steps:
                        jobs[check['databaseId']]['steps'] = steps[check['databaseId']]
                    if check['status'] == 'IN_PROGRESS':
                        running.append(check['id'])
        except (KeyError, TypeError, ValueError) as error:
            self.live_jobs, self.running_check_runs, self.live_error = {}, [], f'live jobs: {error}'
            return
        self.live_jobs, self.running_check_runs, self.live_error = live, running, ''

    def pull_requests(self, repo: str) -> list[Json]:
        return self.github.load(self.body('pull-requests', repo)) or []

    def tags(self, repo: str) -> list[Json]:
        return self.github.load(self.body('tags', repo)) or []

    def excerpt(self, job_id: int) -> list[str]:
        return self.github.load(self.body('failure-excerpts', job_id)) or []

    async def poll(self) -> None:
        self.github.errors.clear()
        repo_path = f'/repos/{self.owner}'
        now = time.time()
        due = [repo for repo in self.repos if self.run_list_due(repo, now)]
        for repo in due:
            if now >= self.idle_turn[repo]:
                self.idle_turn[repo] = now + IDLE_EVERY
        changed = await asyncio.gather(
            *(
                self.github.refresh(f'{repo_path}/{repo}/actions/runs?per_page={RUNS_PER_REPO}', self.body('runs', repo), repo)
                for repo in due
            )
        )
        if any(changed):
            self.run_lists_changed.set()
        reads = []
        for repo in self.repos:
            runs = (self.github.load(self.body('runs', repo)) or {}).get('workflow_runs', [])
            if self.references_due('pull-requests', repo, max((epoch(r['created_at']) for r in runs), default=0.0)):
                path = f'{repo_path}/{repo}/pulls?state=all&sort=updated&direction=desc&per_page={PULL_REQUESTS_PER_REPO}'
                reads.append(self.github.refresh(path, self.body('pull-requests', repo), f'{repo} pull requests'))
            finished = max((epoch(r['updated_at']) for r in runs if r['status'] == 'completed'), default=0.0)
            if self.references_due('tags', repo, finished):
                path = f'{repo_path}/{repo}/tags?per_page={TAGS_PER_REPO}'
                reads.append(self.github.refresh(path, self.body('tags', repo), f'{repo} tags'))
        await asyncio.gather(*reads)
        now = time.time()
        await self.read_jobs(now)
        self.prune(now)

    def stagger(self, now: float) -> None:
        """Spread the idle repos' next reads across IDLE_EVERY, so they never come due together."""
        self.idle_turn = {repo: now + IDLE_EVERY * index / len(self.repos) for index, repo in enumerate(self.repos)}

    def run_list_due(self, repo: str, now: float) -> bool:
        """Every poll while the repo is live or was never read, otherwise once its idle turn comes round."""
        body = self.body('runs', repo)
        if not body.exists() or now >= self.idle_turn[repo]:
            return True
        runs = (self.github.load(body) or {}).get('workflow_runs', [])
        return any(run['status'] != 'completed' or now - epoch(run['updated_at']) < HOT_FOR for run in runs)

    def references_due(self, kind: str, repo: str, newest: float) -> bool:
        """Whether a run has appeared since this list was last read, in GitHub's clock so local skew never matters."""
        if self.references_read.get((kind, repo), -1.0) >= newest:
            return False
        self.references_read[(kind, repo)] = newest
        return True

    async def read_jobs(self, now: float) -> None:
        reads = []
        for run in self.runs():
            if run['status'] == 'completed' and run['conclusion'] == 'success' and run['run_attempt'] == 1:
                continue
            body = self.body('jobs-every-attempt', run['id'])
            confirmed = body.stat().st_mtime if body.exists() else 0.0
            if run['status'] == 'completed':
                if confirmed >= epoch(run['updated_at']):
                    continue
            elif run['id'] in self.live_jobs and body.exists():
                if now - confirmed < JOBS_RECHECK or not self.disagrees(run['id']):
                    continue
            elif now - confirmed < JOBS_EVERY:
                continue
            repo = run['repository']['name']
            reads.append(self.github.refresh(self.jobs_path(repo, run['id']), body, f'{repo} jobs {run["id"]}'))
        await asyncio.gather(*reads)

    def jobs_path(self, repo: str, run_id: int) -> str:
        return f'/repos/{self.owner}/{repo}/actions/runs/{run_id}/jobs?filter=all&per_page=100'

    async def read_excerpts(self, jobs: list[tuple[str, Json]]) -> None:
        now = time.time()
        due = [
            (repo, job)
            for repo, job in jobs
            if not self.body('failure-excerpts', job['id']).exists() and self.excerpt_retry.get(job['id'], 0) <= now
        ][:EXCERPTS_PER_POLL]

        async def read(repo: str, job: Json) -> None:
            log = await self.github.text(f'/repos/{self.owner}/{repo}/actions/jobs/{job["id"]}/logs')
            self.excerpt_attempts[job['id']] += 1
            if log is None and self.excerpt_attempts[job['id']] < EXCERPT_ATTEMPTS:
                self.excerpt_retry[job['id']] = now + EXCERPT_RETRY
                return
            body = self.body('failure-excerpts', job['id'])
            body.parent.mkdir(parents=True, exist_ok=True)
            body.write_text(json.dumps(failure_excerpt(log) if log else []))

        await asyncio.gather(*(read(repo, job) for repo, job in due))

    def prune(self, now: float) -> None:
        """Drop jobs, excerpts and commit reads nothing has confirmed for a day. A peer may prune too, so a file can go mid-walk."""
        if now - self.pruned < PRUNE_EVERY:
            return
        self.pruned = now
        for kind in ('jobs-every-attempt', 'failure-excerpts', COMMIT_READS):
            directory = self.github.cache / kind
            for path in directory.glob('*') if directory.is_dir() else ():
                with contextlib.suppress(FileNotFoundError):
                    if now - path.stat().st_mtime > PRUNE_AFTER:
                        path.unlink(missing_ok=True)
                        self.github.forget(path)


@dataclass
class PullRequestIndex:
    by_head_sha: dict[str, Json]
    by_branch: dict[str, Json]
    by_merge_sha: dict[str, Json]
    by_number: dict[int, Json]

    @classmethod
    def of(cls, pulls: list[Json]) -> PullRequestIndex:
        index = cls({}, {}, {}, {})
        for pr in pulls:
            index.by_head_sha.setdefault(pr['head']['sha'], pr)
            index.by_branch.setdefault(pr['head']['ref'], pr)
            index.by_number[pr['number']] = pr
            if pr.get('merged_at') and pr.get('merge_commit_sha'):
                index.by_merge_sha[pr['merge_commit_sha']] = pr
        return index

    def for_run(self, run: Json) -> Json | None:
        if run['event'] in PULL_REQUEST_EVENTS:
            pr = self.by_head_sha.get(run['head_sha']) or self.by_branch.get(run['head_branch'])
            if pr is None and run.get('pull_requests'):
                number = run['pull_requests'][0]['number']
                pr = self.by_number.get(number) or {'number': number, 'html_url': f'{run["repository"]["html_url"]}/pull/{number}'}
            return pr
        if run['event'] == 'push':
            return self.by_merge_sha.get(run['head_sha'])
        return None


@dataclass
class Failure:
    """A run with a failed job in any attempt, its failed jobs newest attempt first."""

    when: float
    run: Json
    jobs: list[Json]
    resolution: str

    def latest_attempt_jobs(self) -> list[Json]:
        return [job for job in self.jobs if job['run_attempt'] == self.jobs[0]['run_attempt']]


@dataclass
class Entry:
    group: str
    run: Json
    jobs: list[Json]
    failure: Failure | None = None


class Board:
    """The runs grouped by state, each joined to its pull request, tag and typical duration."""

    def __init__(self, poller: ActionsPoller, now: float) -> None:
        self.now = now
        self.owner = poller.owner
        self.excerpt = poller.excerpt
        self.runs = poller.runs()
        self.jobs = {run['id']: poller.jobs(run['id']) for run in self.runs}
        self.pulls = {repo: PullRequestIndex.of(poller.pull_requests(repo)) for repo in poller.repos}
        self.tags: dict[str, dict[str, list[str]]] = {}
        for repo in poller.repos:
            by_sha: dict[str, list[str]] = defaultdict(list)
            for tag in poller.tags(repo):
                by_sha[tag['commit']['sha']].append(clean(tag['name']))
            self.tags[repo] = by_sha
        self.lanes: dict[tuple[str, int, str], list[Json]] = defaultdict(list)
        durations: dict[tuple[str, int], list[float]] = defaultdict(list)
        for run in sorted(self.runs, key=lambda r: r['updated_at'], reverse=True):
            repo = run['repository']['name']
            self.lanes[(repo, run['workflow_id'], run['head_branch'])].append(run)
            took = durations[(repo, run['workflow_id'])]
            if run['conclusion'] == 'success' and run.get('run_started_at') and len(took) < TYPICAL_OF:
                took.append(epoch(run['updated_at']) - epoch(run['run_started_at']))
        self.typical = {lane: statistics.median(took) for lane, took in durations.items() if took}
        self.failures = sorted(self.collect_failures(), key=lambda f: f.when, reverse=True)

    def pull_request(self, run: Json) -> Json | None:
        return self.pulls[run['repository']['name']].for_run(run)

    def collect_failures(self) -> list[Failure]:
        failures = []
        for run in self.runs:
            failed_jobs = sorted(
                (job for job in self.jobs[run['id']] if failed(job)),
                key=lambda job: (job['run_attempt'], job.get('completed_at') or ''),
                reverse=True,
            )
            if failed_jobs:
                when = max(epoch(job.get('completed_at') or run['updated_at']) for job in failed_jobs)
                failures.append(Failure(when, run, failed_jobs, self.resolution(run, failed_jobs[0])))
            elif run['status'] == 'completed' and failed(run):
                failures.append(Failure(epoch(run['updated_at']), run, [], self.resolution(run, None)))
        return failures

    def resolution(self, run: Json, job: Json | None) -> str:
        """Why a failure no longer stands, or nothing when it does."""
        if job is not None and run['conclusion'] == 'success' and job['run_attempt'] < run['run_attempt']:
            return f'attempt {run["run_attempt"]} passed'
        pr = self.pull_request(run)
        if run['event'] in PULL_REQUEST_EVENTS and pr and pr.get('state') == 'closed':
            return f'PR #{pr["number"]} {"merged" if pr.get("merged_at") else "closed"}'
        lane = self.lanes[(run['repository']['name'], run['workflow_id'], run['head_branch'])]
        later = [r['run_number'] for r in lane if r['run_number'] > run['run_number'] and r['conclusion'] == 'success']
        return f'#{min(later)} passed since' if later else ''

    def group(self, run: Json) -> str:
        """A live run is RUNNING once any job of its attempt has started. GitHub calls a run queued while any one job waits."""
        if run['status'] == 'completed':
            return group_of(run)
        current = [job for job in self.jobs[run['id']] if job['run_attempt'] == run['run_attempt']]
        if not current:
            return group_of(run)
        return 'RUNNING' if any(job['status'] in ('in_progress', 'completed') for job in current) else 'QUEUED'

    def entries(self, keep: int) -> dict[str, list[Entry]]:
        grouped: dict[str, list[Json]] = defaultdict(list)
        for run in self.runs:
            grouped[self.group(run)].append(run)

        def current_jobs(run: Json) -> list[Json]:
            return [job for job in self.jobs[run['id']] if job['run_attempt'] == run['run_attempt'] and job.get('conclusion') != 'skipped']

        return {
            'RUNNING': [Entry('RUNNING', run, current_jobs(run)) for run in sorted(grouped['RUNNING'], key=lambda r: r['run_started_at'])],
            'QUEUED': [Entry('QUEUED', run, current_jobs(run)) for run in sorted(grouped['QUEUED'], key=lambda r: r['created_at'])],
            'FAILED': [Entry('FAILED', f.run, f.jobs, f) for f in self.failures[:keep]],
            **{
                group: [Entry(group, run, []) for run in sorted(grouped[group], key=lambda r: r['updated_at'], reverse=True)[:keep]]
                for group in ('CANCELED', 'SUCCEEDED')
            },
        }

    def totals(self) -> dict[str, int]:
        """How many runs each group holds that a reader would miss when they are not shown: every live run, every standing failure."""
        counts = {group: 0 for group in GROUPS}
        for run in self.runs:
            if (group := self.group(run)) in LIVE:
                counts[group] += 1
        counts['FAILED'] = sum(1 for f in self.failures if not f.resolution)
        return counts

    def standing_failed_jobs(self, keep: int) -> list[tuple[str, Json]]:
        return [(f.run['repository']['name'], job) for f in self.failures[:keep] if not f.resolution for job in f.latest_attempt_jobs()]

    def title(self, run: Json) -> str:
        """The run's whole title. GitHub cuts `display_title` at about 70 characters, so it is the last resort."""
        pr = self.pull_request(run)
        if run['event'] in PULL_REQUEST_EVENTS and pr and pr.get('title'):
            return clean(pr['title'])
        subject = ((run.get('head_commit') or {}).get('message') or '').split('\n')[0]
        if run['event'] == 'push' and subject:
            return clean(subject)
        return clean(run['display_title'])


@dataclass(frozen=True)
class Cell:
    """Text with its color and link, padded to `pad` columns on its right, or on its left where `right` aligns it."""

    text: str
    style: str = ''
    link: str = ''
    pad: int = 0
    right: bool = False

    def padded(self) -> str:
        space = ' ' * max(0, self.pad - width_of(self.text))
        return space + self.text if self.right else self.text + space


Line = list[Cell]
GAP = Cell('  ')


def width_of(text: str) -> int:
    if text.isascii():
        return len(text)
    return sum(0 if unicodedata.combining(c) else 2 if unicodedata.east_asian_width(c) in 'WF' else 1 for c in text)


def line_width(line: Line) -> int:
    return sum(max(cell.pad, width_of(cell.text)) for cell in line)


def fit(text: str, width: int) -> str:
    """The text cut to width, ending in an ellipsis where anything was cut."""
    if width_of(text) <= width:
        return text
    if width <= 0:
        return ''
    kept = ''
    for char in text:
        if width_of(kept + char) > width - 1:
            break
        kept += char
    return kept.rstrip() + '…'


def column(cell: Cell, width: int, right: bool = False) -> Cell:
    """The cell cut and padded to a column `width` wide."""
    return Cell(fit(cell.text, width), cell.style, cell.link, width, right)


def clip(line: Line, width: int) -> Line:
    """The line cut to width, ending in an ellipsis where anything was cut. Nothing on the board wraps."""
    if line_width(line) <= width:
        return line
    out: Line = []
    used = 0
    for cell in line:
        text = cell.padded()
        if used + width_of(text) <= width - 1:
            out.append(Cell(text, cell.style, cell.link))
            used += width_of(text)
            continue
        out.append(Cell(fit(text.rstrip(), width - used), cell.style, cell.link))
        break
    return out


class AnsiRenderer:
    def __init__(self, color: bool) -> None:
        self.color = color

    def cell(self, cell: Cell) -> str:
        text = cell.text
        pad = ' ' * max(0, cell.pad - width_of(text))
        if self.color and cell.style:
            text = f'\033[{cell.style}m{text}\033[0m'
        if self.color and cell.link:
            text = f'\033]8;;{cell.link}\033\\{text}\033]8;;\033\\'
        return pad + text if cell.right else text + pad

    def line(self, line: Line) -> str:
        return ''.join(self.cell(cell) for cell in line).rstrip()


@dataclass(frozen=True)
class RunRow:
    """One run's cells in column order: age, symbol, repo, title, took, run and trigger."""

    age: Cell
    symbol: str
    color: str
    repo: Cell
    title: str
    took: Cell
    run: Cell
    trigger: Line


@dataclass(frozen=True)
class JobRow:
    """One job's cells: symbol, name, how long it took or has run, its runner or attempts, and its step or the labels it waits for."""

    job: Json
    symbol: str
    color: str
    name: str
    took: str
    where: str
    step: str


@dataclass(frozen=True)
class Columns:
    """Widths shared by every row on the screen. A job's step starts beside its symbol and spans the repo and title columns.

    The trigger column is last and unpadded, so the screen's edge cuts it first.
    """

    age: int
    repo: int
    title: int
    took: int
    run: int

    @property
    def repo_at(self) -> int:
        return len('  ') + self.age + len(' ✓ ')

    @property
    def step_at(self) -> int:
        return self.repo_at + len('└ ✓ ')

    @property
    def title_at(self) -> int:
        return self.repo_at + self.repo + len(GAP.text)


def job_symbol(job: Json) -> tuple[str, str]:
    if job['status'] == 'in_progress':
        return RUN_SYMBOL['RUNNING']
    if job['status'] != 'completed':
        return RUN_SYMBOL['QUEUED']
    if job.get('conclusion') == 'success':
        return RUN_SYMBOL['SUCCEEDED']
    if failed(job):
        return RUN_SYMBOL['FAILED']
    if job.get('conclusion') == 'cancelled':
        return RUN_SYMBOL['CANCELED']
    return '·', DIM


def step_named(steps: list[Json], step: Json) -> str:
    """A step by its position, since step numbers skip: a job's post steps are numbered from 25 in an 18-step job.

    An action pinned to a commit keeps the commit's first seven characters, as git shortens one.
    """
    name = re.sub(r'@([0-9a-f]{7})[0-9a-f]{33}\b', r'@\1', clean(step['name']))
    return f'step {steps.index(step) + 1}/{len(steps)} {name}'


class Layout:
    """One frame of the board as rows on shared columns, none wider than the terminal."""

    def __init__(self, board: Board, width: int) -> None:
        self.board = board
        self.width = width
        self.now = board.now

    def trigger(self, entry: Entry) -> Line:
        """How a failure resolved, then what started the run, its tag, a live rerun's attempt, and who started it when not the owner.

        The resolution leads so that the screen's edge, cutting this last column, takes the trigger's detail first.
        """
        run, failure = entry.run, entry.failure
        pr = self.board.pull_request(run)
        branch = clean(run['head_branch'])
        said: Line = []
        resolution = failure.resolution if failure else ''
        if resolution:
            said.append(Cell(resolution, GREEN))
        if run['event'] in PULL_REQUEST_EVENTS:
            named = f'PR #{pr["number"]}' if pr else 'PR'
            source = f'from {branch}' if resolution.startswith(f'{named} ') else f'{named} from {branch}'
            said.append(Cell(source, CYAN, (pr or {}).get('html_url') or ''))
        elif run['event'] == 'push' and pr:
            said.append(Cell(f'PR #{pr["number"]} merged into {branch}', CYAN, pr.get('html_url') or ''))
        else:
            verb = {'push': 'push to', 'workflow_dispatch': 'manual on', 'schedule': 'schedule on'}.get(run['event'], f'{run["event"]} on')
            said.append(Cell(f'{verb} {branch}'))
        if tags := self.board.tags[run['repository']['name']].get(run['head_sha']):
            said.append(Cell(f'tag {", ".join(tags)}', GREEN))
        if entry.group in LIVE and run['run_attempt'] > 1:
            said.append(Cell(f'attempt {run["run_attempt"]}'))
        actor = (run.get('triggering_actor') or run.get('actor') or {}).get('login')
        if actor and actor != self.board.owner:
            said.append(Cell(f'by {clean(actor)}', DIM))
        return [said[0], *(cell for part in said[1:] for cell in (Cell(' · ', DIM), part))]

    def run_row(self, entry: Entry) -> RunRow:
        run, group, now = entry.run, entry.group, self.now
        repo = run['repository']
        typical = self.board.typical.get((repo['name'], run['workflow_id']))
        if group == 'RUNNING':
            elapsed = now - epoch(run['run_started_at'])
            age = Cell(duration(now - epoch(run['created_at'])), YELLOW)
            so_far = duration(elapsed) + (f'/~{duration(typical)}' if typical else '')
            took = Cell(so_far, RED if typical and elapsed > 2 * typical else YELLOW)
        elif group == 'QUEUED':
            age = Cell(duration(now - epoch(run['created_at'])), CYAN)
            took = Cell('')
        else:
            finished = entry.failure.when if entry.failure else epoch(run['updated_at'])
            standing = entry.failure is not None and not entry.failure.resolution
            age = Cell(ago(now - finished), RED if standing else '')
            took = Cell(duration(epoch(run['updated_at']) - epoch(run.get('run_started_at') or run['created_at'])))
        symbol, color = RUN_SYMBOL[group]
        return RunRow(
            age,
            symbol,
            color,
            Cell(clean(repo['name']), BOLD, f'{repo["html_url"]}/actions'),
            self.board.title(run),
            took,
            Cell(f'{clean(run["name"])} #{run["run_number"]}', '', run['html_url']),
            self.trigger(entry),
        )

    def job_row(self, job: Json, note: str, runner: bool) -> JobRow:
        """A job's row. The runner column holds its runner, then `note` and whether it timed out. A failed job's runner is left out."""
        now, steps = self.now, job.get('steps') or []
        symbol, color = job_symbol(job)
        name = clean(job['name'])
        if job['status'] == 'in_progress':
            step = next((s for s in steps if s['status'] == 'in_progress'), None)
            detail = 'setting up'
            if step:
                detail = step_named(steps, step) + (f' ({duration(now - epoch(step["started_at"]))})' if step.get('started_at') else '')
            took = duration(now - epoch(job.get('started_at') or job['created_at']))
            return JobRow(job, symbol, color, name, took, clean(job.get('runner_name')), detail)
        if job['status'] == 'completed':
            took = ''
            if job.get('started_at') and job.get('completed_at'):
                took = duration(epoch(job['completed_at']) - epoch(job['started_at']))
            stopped = next((s for s in steps if s.get('conclusion') in ('failure', 'timed_out', 'cancelled')), None)
            if stopped:
                detail = step_named(steps, stopped)
            elif failed(job) and not steps:
                detail = 'no steps recorded'
            else:
                ended = {'success': 'passed'}.get(job.get('conclusion') or '', job.get('conclusion') or 'finished')
                when = f'{ended} {ago(now - epoch(job["completed_at"]))} ago' if job.get('completed_at') else ended
                detail = f'{when} · {len(steps)} step{"" if len(steps) == 1 else "s"}' if steps else when
            timed_out = 'timed out' if job.get('conclusion') == 'timed_out' else ''
            where = ' · '.join(filter(None, [clean(job.get('runner_name')) if runner else '', note, timed_out]))
            return JobRow(job, symbol, color, name, took, where, detail)
        labels = ', '.join(clean(label) for label in job.get('labels', []))
        return JobRow(job, symbol, color, name, duration(now - epoch(job['created_at'])), '', f'needs {labels}')

    def rows(self, entry: Entry) -> list[JobRow]:
        """One row per job. A failure folds a job's failed attempts into one row, its newest, and counts them."""
        if entry.failure is None:
            return [self.job_row(job, '', runner=True) for job in entry.jobs]
        attempts: dict[str, list[Json]] = {}
        for job in entry.failure.jobs:
            attempts.setdefault(job['name'], []).append(job)
        rows = []
        for tries in attempts.values():
            newest = tries[0]
            label = ''
            if len(tries) > 1:
                label = f'{len(tries)} attempts'
            elif entry.run['run_attempt'] > 1:
                label = f'attempt {newest["run_attempt"]}'
            rows.append(self.job_row(newest, label, runner=False))
        return rows

    def block(self, entry: Entry, run: RunRow, jobs: list[JobRow], columns: Columns) -> list[Line]:
        """The run's row, then a row per job on the same columns, then a standing failure's log lines under its step."""
        lines = [
            clip(
                [
                    Cell('  '),
                    column(run.age, columns.age, right=True),
                    Cell(' '),
                    Cell(run.symbol, run.color),
                    Cell(' '),
                    column(run.repo, columns.repo),
                    GAP,
                    column(Cell(run.title), columns.title),
                    GAP,
                    column(run.took, columns.took, right=True),
                    GAP,
                    column(run.run, columns.run),
                    GAP,
                    *run.trigger,
                ],
                self.width,
            )
        ]
        failure = entry.failure
        excerpted = {job['id'] for job in failure.latest_attempt_jobs()} if failure and not failure.resolution else set()
        for job in jobs:
            passed = job.color == GREEN
            row: Line = [
                Cell(' ' * columns.repo_at),
                Cell('└ ', DIM),
                Cell(job.symbol, job.color),
                Cell(' '),
                column(Cell(job.step, DIM), columns.title_at + columns.title - columns.step_at),
                GAP,
                column(Cell(job.took, job.color), columns.took, right=True),
                GAP,
                column(Cell(job.name, '', job.job.get('html_url') or ''), columns.run),
                GAP,
                Cell(job.where, DIM if passed else ''),
            ]
            lines.append(clip(row, self.width))
            if job.job['id'] in excerpted:
                for excerpt in self.board.excerpt(job.job['id']):
                    lines.append(clip([Cell(' ' * columns.step_at), Cell('│ ', RED), Cell(clean(excerpt))], self.width))
        return lines


def rows_of(line: str, width: int) -> int:
    return max(1, -(-width_of(ESCAPE.sub('', line)) // max(1, width)))


def cut(block: list[str], rows: int, width: int, renderer: AnsiRenderer) -> list[str]:
    """The block's first lines that fit in rows, its last row counting the jobs left below."""
    kept: list[str] = []
    used = 0
    for i, line in enumerate(block):
        if used + rows_of(line, width) > rows - 1:
            hidden = sum(1 for rest in block[i:] if '└ ' in ESCAPE.sub('', rest))
            more = f'{hidden} more job{"" if hidden == 1 else "s"}' if hidden else 'more'
            return [*kept, renderer.line(clip([Cell(' ' * 4), Cell(f'└ … {more}, below the bottom of the screen', DIM)], width))]
        kept.append(line)
        used += rows_of(line, width)
    return kept


@dataclass
class PollSummary:
    """What the header and footer say about the poll the board came from."""

    repos: int
    interval: float
    rates: dict[str, tuple[int, int, int]]
    holds: dict[str, tuple[float, str]]
    live: str
    errors: list[str]
    source: str = ''


def render(board: Board, summary: PollSummary, keep: int, width: int, height: int | None, renderer: AnsiRenderer) -> list[str]:
    layout = Layout(board, width)
    entries = board.entries(keep)
    every = [entry for group in GROUPS for entry in entries[group]]
    runs = {id(e): layout.run_row(e) for e in every}
    jobs = {id(e): layout.rows(e) for e in every}
    every_job = [job for rows in jobs.values() for job in rows]

    def widest(texts: list[str], label: str, most: int = 0) -> int:
        wanted = max(width_of(text) for text in [label, *texts])
        return min(wanted, most) if most else wanted

    columns = Columns(
        age=widest([r.age.text for r in runs.values()], COLUMN_LABELS[0]),
        repo=widest([r.repo.text for r in runs.values()], COLUMN_LABELS[1]),
        title=0,
        took=widest([r.took.text for r in runs.values()] + [j.took for j in every_job], COLUMN_LABELS[3]),
        run=widest([r.run.text for r in runs.values()] + [j.name for j in every_job], COLUMN_LABELS[4]),
    )
    step_lead = columns.title_at - columns.step_at
    title = max(
        [width_of(COLUMN_LABELS[2]), *(width_of(r.title) for r in runs.values()), *(width_of(j.step) - step_lead for j in every_job)]
    )
    trigger = max([width_of(COLUMN_LABELS[-1]), *(line_width(r.trigger) for r in runs.values()), *(width_of(j.where) for j in every_job)])
    # Past the screen's width the trigger column gives way first, then the run column, then the title.
    over = columns.title_at + title + columns.took + columns.run + 3 * len(GAP.text) + trigger - width
    over -= min(max(over, 0), max(trigger - TRIGGER_LEAST, 0))
    run = columns.run - min(max(over, 0), max(columns.run - RUN_MOST, 0))
    over -= columns.run - run
    columns = replace(columns, run=run, title=max(width_of(COLUMN_LABELS[2]), title - max(over, 0)))
    blocks = {id(e): [renderer.line(line) for line in layout.block(e, runs[id(e)], jobs[id(e)], columns)] for e in every}

    header: Line = [
        Cell(time.strftime('%H:%M:%S'), BOLD),
        GAP,
        Cell(f'Watching {summary.repos} repo{"" if summary.repos == 1 else "s"}'),
    ]
    if summary.live:
        header += [GAP, Cell(f'· {summary.live}', DIM)]
    for resource, name in (('core', 'REST'), ('graphql', 'GraphQL')):
        if resource in summary.rates:
            remaining, limit, reset = summary.rates[resource]
            minutes = math.ceil((reset - board.now) / 60)
            resets = f'resets {minutes} min from now' if minutes > 0 else 'resets now'
            header += [GAP, Cell(f'· {name} {remaining}/{limit} left, {resets}', DIM)]
    for resource, (until, because) in summary.holds.items():
        if until > board.now:
            name = 'GraphQL' if resource == 'graphql' else 'REST'
            header += [GAP, Cell(f'· {name} held until {time.strftime("%H:%M:%S", time.localtime(until))}: {because}', RED)]
    if summary.source:
        header += [GAP, Cell(f'· {summary.source}', DIM)]
    labels: Line = [Cell('  '), Cell(COLUMN_LABELS[0], DIM, pad=columns.age, right=True), Cell(' ' * len(' ✓ '))]
    widths = (columns.repo, columns.title, columns.took, columns.run)
    for label, label_width, right in zip(COLUMN_LABELS[1:-1], widths, (False, False, True, False), strict=True):
        labels += [Cell(label, DIM, pad=label_width, right=right), GAP]
    labels.append(Cell(COLUMN_LABELS[-1], DIM))
    top = [renderer.line(clip(header, width)), '', renderer.line(clip(labels, width))]
    bottom = [renderer.line(clip([Cell(error, RED)], width)) for error in summary.errors]
    if bottom:
        bottom.insert(0, '')

    admitted = {id(e) for e in every}
    if height is not None:
        budget = height - len(top) - len(bottom) - 2 * len(GROUPS)
        standing = [e for e in entries['FAILED'] if e.failure and not e.failure.resolution]
        standing_ids = {id(e) for e in standing}
        rest = sorted(
            (e for g in ('FAILED', 'CANCELED', 'SUCCEEDED') for e in entries[g] if id(e) not in standing_ids),
            key=lambda e: e.failure.when if e.failure else epoch(e.run['updated_at']),
            reverse=True,
        )
        admitted = set()
        for entry in [*entries['RUNNING'], *entries['QUEUED'], *standing, *rest]:
            cost = sum(rows_of(line, width) for line in blocks[id(entry)])
            if cost > budget:
                if entry.group not in LIVE and id(entry) not in standing_ids:
                    break
                if budget < 2:
                    continue
                blocks[id(entry)] = cut(blocks[id(entry)], budget, width, renderer)
                cost = budget
            admitted.add(id(entry))
            budget -= cost

    totals = board.totals()
    out = list(top)
    for group in GROUPS:
        shown = [e for e in entries[group] if id(e) in admitted]
        counted = [e for e in shown if group in LIVE or (e.failure and not e.failure.resolution)]
        hidden = totals[group] - len(counted)
        count = f'{len(shown)}' + (f', {hidden} more not shown' if hidden > 0 else '')
        out += ['', renderer.line([Cell(f'{group} ({count})', GROUP_STYLE[group])])]
        for entry in shown:
            out += blocks[id(entry)]
    return out + bottom


class Screen:
    """The alternate screen, redrawn in place so a frame never flickers or scrolls."""

    def __init__(self, live: bool) -> None:
        self.live = live

    def __enter__(self) -> Screen:
        if self.live:
            sys.stdout.write('\033[?1049h\033[?25l')
        return self

    def __exit__(self, *_: object) -> None:
        if self.live:
            sys.stdout.write('\033[?25h\033[?1049l')
            sys.stdout.flush()

    def draw(self, lines: list[str]) -> None:
        if self.live:
            sys.stdout.write('\033[H' + '\n'.join(line + '\033[K' for line in lines) + '\033[J')
        else:
            sys.stdout.write('\n'.join(lines) + '\n')
        sys.stdout.flush()


def registry(names: list[str]) -> tuple[str, list[str]]:
    try:
        path = subprocess.run(['repos-registry'], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        sys.exit(f'watch-ci: repos-registry could not name the registry ({error}), so there is no list of repos to watch')
    data = json.loads(Path(path).read_text())
    every = [repo['name'] for repo in data['repos']]
    unknown = sorted(set(names) - set(every))
    if unknown:
        print(f'watch-ci: {path} has no repo named {", ".join(unknown)}', file=sys.stderr)
        sys.exit(2)
    return data['owner'], [repo for repo in every if not names or repo in names]


class SharedPoll:
    """One instance per repo set polls GitHub, and every other instance draws what it publishes.

    The first instance to take the lock leads. The kernel frees the lock however the leader
    exits, so the next instance to try takes over. Each instance on screen touches its own file
    under the viewers directory, and the leader polls while any of them is fresh.
    """

    def __init__(self, cache: Path, owner: str, repos: list[str]) -> None:
        key = hashlib.sha256(json.dumps([owner, sorted(repos)]).encode()).hexdigest()[:12]
        self.lock = cache / f'leader-{key}.lock'
        self.state = cache / f'shared-{key}.json'
        self.viewers = cache / f'viewers-{key}'
        self.mine = self.viewers / str(os.getpid())
        self.held: int | None = None

    def lead(self) -> bool:
        """Whether this instance polls: it already leads, or the lock is free and it takes it."""
        if self.held is not None:
            return True
        self.lock.parent.mkdir(parents=True, exist_ok=True)
        handle = os.open(self.lock, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(handle)
            return False
        os.ftruncate(handle, 0)
        os.write(handle, str(os.getpid()).encode())
        self.held = handle
        return True

    def seen(self) -> None:
        self.viewers.mkdir(parents=True, exist_ok=True)
        self.mine.touch()

    def other_viewers(self, now: float) -> int:
        """How many other instances were on screen in the last VIEWER_FRESH seconds. A file a crash left behind goes after a day."""
        fresh = 0
        with contextlib.suppress(OSError):
            for path in self.viewers.iterdir():
                age = now - path.stat().st_mtime
                if age > PRUNE_AFTER:
                    path.unlink(missing_ok=True)
                elif path != self.mine and age < VIEWER_FRESH:
                    fresh += 1
        return fresh

    def publish(self, poller: ActionsPoller, github: GitHub, live_note: str, errors: list[str]) -> None:
        """What the board needs that is not in the cache's bodies: the live view, the budgets, the holds and the errors."""
        state = {
            'pid': os.getpid(),
            'written': time.time(),
            'live_jobs': {str(run): {str(job): fields for job, fields in jobs.items()} for run, jobs in poller.live_jobs.items()},
            'running_check_runs': poller.running_check_runs,
            'live_error': poller.live_error,
            'live_took': poller.live_took,
            'rates': github.rates,
            'holds': github.holds,
            'live_note': live_note,
            'errors': errors,
            'references_read': {f'{kind}/{repo}': newest for (kind, repo), newest in poller.references_read.items()},
        }
        staged = self.state.with_name(self.state.name + '.new')
        staged.write_text(json.dumps(state))
        staged.replace(self.state)

    def adopt(self, poller: ActionsPoller, github: GitHub) -> Json:
        """Lay the leader's last published state over this instance's poller and return it, or nothing when none is readable."""
        try:
            state = json.loads(self.state.read_bytes())
            poller.live_jobs = {int(run): {int(job): fields for job, fields in jobs.items()} for run, jobs in state['live_jobs'].items()}
            poller.running_check_runs = state['running_check_runs']
            poller.live_error = state['live_error']
            poller.live_took = state['live_took']
            github.rates = {resource: tuple(rate) for resource, rate in state['rates'].items()}
            github.holds = {resource: tuple(hold) for resource, hold in state['holds'].items()}
            references = (key.split('/', 1) for key in state.get('references_read', {}))
            poller.references_read = {(kind, repo): state['references_read'][f'{kind}/{repo}'] for kind, repo in references}
        except (OSError, ValueError, KeyError, TypeError):
            return {}
        return state

    def leave(self) -> None:
        self.mine.unlink(missing_ok=True)
        if self.held is not None:
            os.close(self.held)


def token() -> str:
    try:
        return subprocess.run(['gh', 'auth', 'token'], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        sys.exit('watch-ci: `gh auth token` gave no token to read the API with; run `gh auth login`')


def on_screen() -> bool:
    """Whether a tmux client shows this pane. Outside tmux it is always on screen."""
    pane = os.environ.get('TMUX_PANE')
    if not pane or not os.environ.get('TMUX'):
        return True
    query = '#{session_attached} #{window_active} #{window_zoomed_flag} #{pane_active}'
    try:
        shown = subprocess.run(
            ['tmux', 'display-message', '-p', '-t', pane, query], capture_output=True, text=True, timeout=2
        ).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return True
    if len(shown) != 4:
        return True
    attached, window_active, zoomed, pane_active = shown
    return attached != '0' and window_active == '1' and (zoomed == '0' or pane_active == '1')


def cache_directory() -> Path:
    return Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'watch-ci'


def api_client() -> httpx2.AsyncClient:
    headers = {'Authorization': f'Bearer {token()}', 'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28'}
    return httpx2.AsyncClient(base_url=API, headers=headers, timeout=20)


async def watch(args: argparse.Namespace, owner: str, repos: list[str], live: bool) -> None:
    cache = cache_directory()
    renderer = AnsiRenderer(sys.stdout.isatty() and 'NO_COLOR' not in os.environ)
    shared = SharedPoll(cache, owner, repos)
    async with api_client() as client:
        github = GitHub(client, cache)
        watcher = Watcher(args, ActionsPoller(github, owner, repos), github, shared, renderer, live)
        try:
            with Screen(live) as screen:
                if args.once:
                    await watcher.fetch()
                    watcher.draw(screen)
                    return
                with contextlib.suppress(NotImplementedError):
                    asyncio.get_running_loop().add_signal_handler(signal.SIGWINCH, watcher.resized.set)
                fetching = asyncio.create_task(watcher.fetch_every_interval())
                try:
                    await watcher.draw_every_interval(screen)
                finally:
                    fetching.cancel()
        finally:
            shared.leave()


class Watcher:
    """One instance's two loops. Fetching never holds a frame back.

    The fetch loop leads the polling or leaves it to the leader. The draw loop redraws every interval
    from whatever has landed, and at once when the terminal is resized, so a slow poll delays only
    the data, never the clock on the screen.
    """

    def __init__(
        self, args: argparse.Namespace, poller: ActionsPoller, github: GitHub, shared: SharedPoll, renderer: AnsiRenderer, live: bool
    ) -> None:
        self.args = args
        self.poller = poller
        self.github = github
        self.shared = shared
        self.renderer = renderer
        self.live = live
        self.live_every = max(LIVE_EVERY_LEAST, args.interval)
        self.live_task: asyncio.Task[None] | None = None
        self.took_over = False
        self.on = True
        self.live_note = ''
        self.errors: list[str] = []
        self.source = ''
        self.resized = asyncio.Event()

    async def fetch_every_interval(self) -> None:
        while True:
            started = time.time()
            await self.fetch()
            await asyncio.sleep(max(self.args.interval - (time.time() - started), 0.0))

    async def fetch(self) -> None:
        """One poll when this instance leads and someone is watching. A follower fetches nothing."""
        started = time.time()
        if not self.shared.lead():
            return
        if not self.took_over:
            self.took_over = True
            self.shared.adopt(self.poller, self.github)
            self.poller.stagger(started)
            if not self.args.once:
                self.live_task = asyncio.create_task(self.poller.follow_live(self.live_every, self.landed))
        watchers = self.shared.other_viewers(started)
        self.poller.visible = self.on or watchers > 0
        self.source = f'polling for {watchers} other window{"" if watchers == 1 else "s"}' if watchers else ''
        if not self.poller.visible or self.github.held('core', started):
            return
        await self.poller.poll()
        await self.github.read_graphql_rate()
        if self.live_task is None:
            await self.poller.read_live()
            await self.poller.read_jobs(time.time())
        await self.poller.read_excerpts(Board(self.poller, time.time()).standing_failed_jobs(self.args.keep))
        self.landed()

    def landed(self) -> None:
        """New data is in: say how fresh the live view is, and publish it all to the other instances."""
        poller = self.poller
        self.live_note = ''
        if poller.running_check_runs:
            self.live_note = f'steps every {max(self.live_every, poller.live_took):.1f}s'
        elif poller.live_jobs:
            self.live_note = f'jobs every {LIVE_QUIET_EVERY:g}s while none runs'
        self.errors = [*self.github.errors, *([poller.live_error] if poller.live_error else [])]
        self.shared.publish(poller, self.github, self.live_note, self.errors)

    async def draw_every_interval(self, screen: Screen) -> None:
        """A frame on every tick, so the seconds on screen never skip one; a resize draws at once and keeps the ticks."""
        tick = time.time()
        while True:
            self.resized.clear()
            self.on = not self.live or on_screen()
            if self.on:
                self.shared.seen()
                self.draw(screen)
            now = time.time()
            if now >= tick:
                tick = now - (now - tick) % self.args.interval + self.args.interval
            with contextlib.suppress(TimeoutError):
                await asyncio.wait_for(self.resized.wait(), tick - now)

    def draw(self, screen: Screen) -> None:
        """One frame at the terminal's current size. A follower first lays the leader's latest state over its own."""
        if self.shared.held is None:
            state = self.shared.adopt(self.poller, self.github)
            self.live_note, self.errors = state.get('live_note', ''), state.get('errors', [])
            self.source = (
                f"drawn from pid {state['pid']}'s poll {time.time() - state['written']:.0f}s ago"
                if state
                else 'waiting for the polling instance to publish'
            )
        github = self.github
        summary = PollSummary(
            len(self.poller.repos), self.args.interval, dict(github.rates), dict(github.holds), self.live_note, self.errors, self.source
        )
        size = shutil.get_terminal_size((120, 0))
        board = Board(self.poller, time.time())
        screen.draw(render(board, summary, self.args.keep, size.columns, size.lines if self.live else None, self.renderer))


class NoAnswer(Exception):
    """A read that no attempt got an answer to: never reached, timed out, or a 429 or 5xx."""


class Refused(Exception):
    """A read GitHub answered and said no to."""

    def __init__(self, status: int, label: str) -> None:
        super().__init__(f'{API} refused {label}: HTTP {status}')
        self.status = status


class UnknownRef(Exception):
    """A ref that names no commit in the repo."""


@dataclass(frozen=True)
class Ending:
    """How a wait on a commit ended: the top conclusion, the exit code, and why where no verdict came."""

    conclusion: str
    code: int
    reason: str = ''


def state_of(run: Json) -> str:
    return clean(run['conclusion'] or run['status'])


def workflow_of(run: Json) -> str:
    return clean(run.get('name') or run.get('path'))


def retry_wait(answer: Any, attempt: int) -> float:
    """The server's Retry-After, or else a random fraction of 2^(attempt-1) seconds, never more than RETRY_WAIT_MOST."""
    said = answer.headers.get('retry-after', '') if answer is not None else ''
    return min(float(said) if said.isdigit() else random.uniform(0, 2 ** (attempt - 1)), RETRY_WAIT_MOST)


class CommitWait:
    """One `--commit REF --wait`: the commit's runs read every interval until they settle, then what became of them."""

    def __init__(self, args: argparse.Namespace, github: GitHub, poller: ActionsPoller, owner: str, repo: str, sha: str | None) -> None:
        self.args = args
        self.github = github
        self.poller = poller
        self.owner = owner
        self.repo = repo
        self.sha = sha
        self.started = time.time()
        self.seen: dict[int, Json] = {}
        self.no_answer = 'no read finished in time'
        self.last_answered: float | None = None
        self.runs_read = False

    def body_of_read(self, path: str) -> Path:
        return self.poller.body(COMMIT_READS, hashlib.sha256(path.encode()).hexdigest()[:16])

    async def out_of_hold(self) -> None:
        """Sleep through a rate-limit hold rather than send into it. The whole wait's --timeout still cuts this short."""
        until = self.github.holds.get('core', (0.0, ''))[0]
        now = time.time()
        if until > now:
            await asyncio.sleep(until - now)

    async def read(self, path: str, body: Path, label: str) -> None:
        """`GitHub.refresh` until it answers or READ_ATTEMPTS have not, raising NoAnswer or Refused."""
        github = self.github
        for attempt in range(1, READ_ATTEMPTS + 1):
            await self.out_of_hold()
            github.errors.clear()
            await github.refresh(path, body, label)
            if not github.errors:
                self.no_answer, self.last_answered = '', time.time()
                return
            answer = github.last_answer
            held = github.held('core', time.time())
            if answer is not None and answer.status_code != 429 and answer.status_code < 500 and not held:
                raise Refused(answer.status_code, label)
            self.no_answer = f'{github.errors[-1]}: {github.holds["core"][1]}' if held else github.errors[-1]
            if attempt < READ_ATTEMPTS and not held:
                await asyncio.sleep(retry_wait(answer, attempt))
        raise NoAnswer(f'{self.no_answer}, {READ_ATTEMPTS} attempts')

    async def commit_on_github(self) -> str:
        path = f'/repos/{self.owner}/{self.repo}/commits/{quote(self.args.commit, safe="/")}'
        body = self.body_of_read(path)
        unknown = UnknownRef(f'no commit named {self.args.commit!r} in {self.owner}/{self.repo}')
        try:
            await self.read(path, body, f'{self.repo} commit {self.args.commit}')
        except Refused as refused:
            if refused.status in (404, 422):
                raise unknown from refused
            raise
        found = self.github.load(body)
        if not isinstance(found, dict) or not found.get('sha'):
            raise unknown
        return found['sha']

    async def read_runs(self, sha: str) -> None:
        path = f'/repos/{self.owner}/{self.repo}/actions/runs?head_sha={sha}&per_page={RUNS_OF_COMMIT_MOST}'
        body = self.body_of_read(path)
        await self.read(path, body, f'{self.repo} runs of {sha[:7]}')
        for run in (self.github.load(body) or {}).get('workflow_runs', []):
            before = self.seen.get(run['id'])
            if (state_of(before) if before else None) != state_of(run) and (self.runs_read or run['status'] != 'completed'):
                print(f'{time.strftime("%H:%M:%S")} {workflow_of(run)} {run["id"]} {state_of(run)}', file=sys.stderr, flush=True)
            self.seen[run['id']] = run
        self.runs_read = True

    async def follow(self, sha: str) -> Ending:
        """Read until every run seen has completed and a read at least an interval after the last of them finished finds no new run."""
        interval = self.args.interval
        settling: set[int] = set()
        while True:
            try:
                await self.read_runs(sha)
            except NoAnswer:
                if self.last_answered is None or time.time() - self.last_answered >= NO_ANSWER_MOST:
                    raise
                await asyncio.sleep(interval)
                continue
            now = time.time()
            if not self.seen:
                left = self.started + self.args.start_within - now
                if left <= 0:
                    return Ending('no_run_started', EXIT_NO_VERDICT, f'no run of {sha} started within {self.args.start_within:g}s')
                await asyncio.sleep(min(interval, left))
                continue
            if all(run['status'] == 'completed' for run in self.seen.values()):
                finished = max(epoch(run['updated_at']) for run in self.seen.values())
                if set(self.seen) == settling or now - finished >= interval:
                    return self.verdict()
                settling = set(self.seen)
            else:
                settling = set()
            await asyncio.sleep(interval)

    def verdict(self) -> Ending:
        if all(run['conclusion'] in PASSED_CONCLUSIONS for run in self.seen.values()):
            return Ending('success', EXIT_PASSED)
        return Ending('failure', EXIT_FAILED)

    def still_going(self) -> str:
        return ', '.join(f'{workflow_of(run)} {run["id"]} {state_of(run)}' for run in self.seen.values() if run['status'] != 'completed')

    def without_answer(self, why: str) -> Ending:
        going = self.still_going()
        return Ending(
            'no_answer', EXIT_NO_ANSWER, f'no answer from {API}: {why}' + (f'; still going at the last answer: {going}' if going else '')
        )

    def at_timeout(self) -> Ending:
        timeout = f'--timeout {self.args.timeout:g}s'
        if self.no_answer:
            return self.without_answer(f'{self.no_answer}, until {timeout} passed')
        if not self.seen:
            return Ending('no_run_started', EXIT_NO_VERDICT, f'no run of {self.sha} started before {timeout} passed')
        going = self.still_going()
        return Ending('timed_out', EXIT_NO_VERDICT, f'{timeout} passed with runs still going: {going}') if going else self.verdict()

    async def failed_jobs(self, run: Json) -> list[Json]:
        """The failed jobs of the run's latest attempt, each with the log lines naming its failure, from the cache the board shares."""
        try:
            path = self.poller.jobs_path(self.repo, run['id'])
            await self.read(path, self.poller.body('jobs-every-attempt', run['id']), f'{self.repo} jobs {run["id"]}')
        except (NoAnswer, Refused) as error:
            print(f'watch-ci: could not read the jobs of run {run["id"]}: {error}', file=sys.stderr)
        jobs = [job for job in self.poller.rest_jobs(run['id']) if job['run_attempt'] == run['run_attempt'] and failed(job)]
        for start in range(0, len(jobs), EXCERPTS_PER_POLL):
            await self.poller.read_excerpts([(self.repo, job) for job in jobs[start : start + EXCERPTS_PER_POLL]])
        return [
            {
                'id': job['id'],
                'name': clean(job['name']),
                'url': job.get('html_url'),
                'failed_step': next((clean(step['name']) for step in job.get('steps') or [] if failed(step)), None),
                'excerpt': [clean(line) for line in self.poller.excerpt(job['id'])],
            }
            for job in jobs
        ]

    async def record_of(self, run: Json, read_jobs: bool) -> Json:
        unpassed = run['status'] == 'completed' and run['conclusion'] not in PASSED_CONCLUSIONS
        return {
            'id': run['id'],
            'workflow': workflow_of(run),
            'status': run['status'],
            'conclusion': run['conclusion'],
            'url': run['html_url'],
            'event': run.get('event'),
            'head_branch': run.get('head_branch'),
            'run_attempt': run.get('run_attempt'),
            'created_at': run.get('created_at'),
            'run_started_at': run.get('run_started_at'),
            'updated_at': run.get('updated_at'),
            'failed_jobs': await self.failed_jobs(run) if read_jobs and unpassed else [],
        }

    async def report(self, ending: Ending) -> int:
        """The runs on stdout, as lines or one JSON object, and why no verdict came on stderr."""
        read_jobs = ending.conclusion not in ('no_answer', 'refused')
        runs = [await self.record_of(run, read_jobs) for run in sorted(self.seen.values(), key=lambda run: run['id'])]
        if self.args.json:
            record = {
                'repo': f'{self.owner}/{self.repo}',
                'ref': self.args.commit,
                'sha': self.sha,
                'conclusion': ending.conclusion,
                'reason': ending.reason,
                'waited_seconds': round(time.time() - self.started, 1),
                'runs': runs,
            }
            print(json.dumps(record, indent=2))
        else:
            for line in commit_run_lines(runs):
                print(line)
        if ending.reason:
            print(f'watch-ci: {ending.reason}', file=sys.stderr)
        return ending.code

    async def run(self) -> int:
        self.poller.prune(self.started)
        try:
            async with asyncio.timeout(self.args.timeout):
                self.sha = self.sha or await self.commit_on_github()
                ending = await self.follow(self.sha)
        except TimeoutError:
            ending = self.at_timeout()
        except NoAnswer as error:
            ending = self.without_answer(str(error))
        except Refused as error:
            ending = Ending('refused', EXIT_FAILED, str(error))
        return await self.report(ending)


def commit_run_lines(runs: list[Json]) -> list[str]:
    """One aligned line per run, and under each failed job its name and the log lines naming its failure."""
    states = [run['conclusion'] or run['status'] for run in runs]
    state_width = max(map(len, states), default=0)
    workflow_width = max((len(run['workflow']) for run in runs), default=0)
    lines = []
    for run, state in zip(runs, states, strict=True):
        lines.append(f'{state:<{state_width}}  {run["workflow"]:<{workflow_width}}  {run["id"]}  {run["url"]}')
        for job in run['failed_jobs']:
            lines.append(f'  {job["name"]}')
            lines.extend(f'    {excerpt}' for excerpt in job['excerpt'])
    return lines


def origin_repo() -> tuple[str, str] | None:
    """The owner and name this directory's origin remote points at on GitHub, or None where it has no such remote."""
    try:
        url = subprocess.run(['git', 'remote', 'get-url', 'origin'], capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    match = REMOTE_URL.fullmatch(url)
    return (match['owner'], match['name']) if match and 'github' in match['host'].lower() else None


def commit_in_checkout(ref: str) -> str | None:
    """The full sha the ref names in this directory's repo, or None where it names no commit here."""
    try:
        found = subprocess.run(
            ['git', 'rev-parse', '--verify', '--quiet', '--end-of-options', f'{ref}^{{commit}}'], capture_output=True, text=True
        )
    except OSError:
        return None
    return found.stdout.strip() if found.returncode == 0 else None


async def wait_on_commit(args: argparse.Namespace, owner: str, repo: str, sha: str | None) -> int:
    if task := asyncio.current_task():
        asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, task.cancel)
    async with api_client() as client:
        github = GitHub(client, cache_directory())
        return await CommitWait(args, github, ActionsPoller(github, owner, [repo]), owner, repo, sha).run()


def refuse_commit_wait_flags(parser: argparse.ArgumentParser, args: argparse.Namespace) -> None:
    """Every usage error of this mode, decided before anything is read."""
    if args.commit is None or not args.wait:
        parser.error('--commit and --wait come together: --commit REF --wait')
    if not args.commit:
        parser.error('--commit needs a ref, such as HEAD')
    if args.keep is not None or args.once:
        parser.error('-k and --once belong to the board, which --commit --wait does not draw')
    if len(args.repo) > 1:
        parser.error('--commit --wait reads one repo, so --repo comes once')
    if args.interval is not None and args.interval < COMMIT_INTERVAL_LEAST:
        parser.error(f'-n under {COMMIT_INTERVAL_LEAST:g} with --commit --wait would spend the shared REST pool: got {args.interval:g}')
    if args.start_within is not None and args.start_within < 0:
        parser.error(f'--start-within cannot be negative: got {args.start_within:g}')
    if args.timeout is not None and args.timeout <= 0:
        parser.error(f'--timeout has to be positive: got {args.timeout:g}')


def commit_wait_command(parser: argparse.ArgumentParser, args: argparse.Namespace) -> int:
    refuse_commit_wait_flags(parser, args)
    args.interval = args.interval if args.interval is not None else COMMIT_INTERVAL
    args.start_within = args.start_within if args.start_within is not None else START_WITHIN
    args.timeout = args.timeout if args.timeout is not None else WAIT_TIMEOUT
    origin = origin_repo()
    if args.repo:
        owner, [repo] = registry(args.repo)
    elif origin:
        owner, repo = origin
    else:
        parser.error('--commit needs --repo NAME here, since this directory has no GitHub origin remote to take the repo from')
    here = origin is not None and (origin[0].lower(), origin[1].lower()) == (owner.lower(), repo.lower())
    sha = commit_in_checkout(args.commit) if here else None
    try:
        return asyncio.run(wait_on_commit(args, owner, repo, sha))
    except UnknownRef as error:
        print(f'watch-ci: {error}', file=sys.stderr)
        return EXIT_USAGE
    except (KeyboardInterrupt, asyncio.CancelledError):
        print('watch-ci: interrupted before a verdict', file=sys.stderr)
        return EXIT_INTERRUPTED


def interrupt(*_: object) -> None:
    raise KeyboardInterrupt


def main() -> int:
    parser = argparse.ArgumentParser(
        prog='watch-ci',
        description='Watch the GitHub Actions runs on every repo in the registry, grouped by\n'
        'state and redrawn in place.\n\n'
        'Each run names what it ran for: the pull request it tested or merged, the tag on\n'
        'its commit, the commit itself and its title. Standing failures show the log\n'
        'lines that name the failure.\n\n'
        "With --commit REF --wait it draws no board. It blocks on that commit's runs and\n"
        'prints one line per run, with each failed job and the log lines naming its failure:\n\n'
        '  watch-ci --commit HEAD --wait --json',
        epilog='exit codes with --commit --wait:\n'
        '  0  every run concluded success, skipped or neutral\n'
        '  1  a run concluded anything else, or GitHub refused a read\n'
        '  2  usage error, or a ref naming no commit\n'
        '  3  no verdict: no run within --start-within, or runs still going at --timeout\n'
        '  4  no answer from the API',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        '-n', '--interval', type=float, metavar='SECONDS', help='seconds between polls (default 1; with --commit default 20, least 5)'
    )
    parser.add_argument('-k', '--keep', type=int, metavar='RUNS', help='most finished runs listed per group (default 10)')
    parser.add_argument(
        '--repo',
        action='append',
        default=[],
        metavar='NAME',
        help="watch only this repo; repeat for more. With --commit, the commit's repo, once",
    )
    parser.add_argument('--once', action='store_true', help='print one screen and exit')
    parser.add_argument('--commit', metavar='REF', help='wait on this commit instead of drawing the board; comes with --wait')
    parser.add_argument('--wait', action='store_true', help='block until the commit has a verdict; comes with --commit')
    parser.add_argument(
        '--start-within', type=float, metavar='SECONDS', help='with --commit: exit 3 where no run has started by then (default 120)'
    )
    parser.add_argument(
        '--timeout', type=float, metavar='SECONDS', help='with --commit: exit 3 where runs are still going by then (default 3600)'
    )
    parser.add_argument('--json', action='store_true', help='with --commit: print one JSON object instead of lines')
    args = parser.parse_args()
    if args.commit is not None or args.wait:
        return commit_wait_command(parser, args)
    if args.start_within is not None or args.timeout is not None or args.json:
        parser.error('--start-within, --timeout and --json belong to --commit --wait')
    args.interval = args.interval if args.interval is not None else 1
    args.keep = args.keep if args.keep is not None else 10
    owner, repos = registry(args.repo)
    signal.signal(signal.SIGTERM, interrupt)
    with contextlib.suppress(KeyboardInterrupt):
        asyncio.run(watch(args, owner, repos, live=not args.once and sys.stdout.isatty()))
    return 0


if __name__ == '__main__':
    sys.exit(main())
