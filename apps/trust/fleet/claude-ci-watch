#!/usr/bin/env bash
# Stream one repo's CI and deploy failures from ntfy to stdout, whole alert per
# block. Exists so a single Claude session can watch the repo it is working in
# without every session seeing every project's failures.
#
# Deliberately does not touch ntfy-client.service or its client.yml: that
# subscriber is the desktop notifier and should keep alerting on everything.
# This is a second, read-only subscription that lives and dies with whoever ran
# it, so nothing here changes what any other session or machine sees.
#
# Subscribes rather than tailing ~/.local/state/ntfy/notify.log, which is the
# obvious shortcut and loses the alert: the log holds one flattened line, so the
# Reason and the Loki query never survive. The JSON stream carries the whole
# body as one field.
#
# Matches the repo only where an alert actually names the app — the CI title and
# the deploy body's first line. Matching the name anywhere in the alert put every
# deploy failure in front of the homelab repo, because each one carries a runbook
# URL under datapointchris/homelab.
#
# Reads the token from the hand-managed ntfy client config rather than carrying
# one, so no secret enters this repo.
#
# Under trust/fleet rather than common/ because of what it does when it runs
# somewhere else. The host is a private address on the machine's own network, the
# transport is plain HTTP carrying a bearer token, and a dropped stream
# reconnects every five seconds forever. On another network that address belongs
# to somebody else's machine, so the loop is an authenticated request repeated at
# whatever is really there — which is the shape lateral movement has. The
# coordinate is what keeps it off machines that are not on that network. Before
# it existed, the only thing keeping it off them was their happening to have no
# ntfy config.
#
# The host is never compiled in. A default would be this repo carrying one
# network's topology, and on any other network it would send the token to
# whatever answered at that address — the wrong answer, arrived at silently.
# CLAUDE_CI_WATCH_NTFY_HOST is a `required:` entry in install/flags.yml instead,
# so an unset value is a `dotfiles check` failure rather than a surprise here.

set -euo pipefail

NTFY_HOST="${CLAUDE_CI_WATCH_NTFY_HOST:?set it in ~/.env; install/flags.yml declares it}"
NTFY_TOPICS="${CLAUDE_CI_WATCH_TOPICS:-ci-failures,homelab-alerts}"
NTFY_CONFIG="${CLAUDE_CI_WATCH_CONFIG:-$HOME/.config/ntfy/client.yml}"

die() {
  echo "claude-ci-watch: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: claude-ci-watch [REPO|--all]

Stream CI and deploy failures from ntfy, filtered to one repo.

  (no argument)  the repo containing the working directory
  REPO           that repo by name
  --all          every failure, unfiltered

Runs until interrupted, reconnecting if the stream drops. Only failures are
published, so a healthy repo is silent — status goes to stderr so you can tell
that apart from a stream that never connected.

Environment:
  CLAUDE_CI_WATCH_NTFY_HOST   required. The ntfy server to subscribe to. This
                              machine declares it; there is no default.
  CLAUDE_CI_WATCH_SINCE       replay a window first, e.g. 12h. The way to see
                              the filter work without waiting for a failure.
  CLAUDE_CI_WATCH_TOPICS, CLAUDE_CI_WATCH_CONFIG
EOF
}

repo=""
case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --all) repo="" ;;
  "") repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)") ;;
  -*) die "unknown option: $1" ;;
  *) repo="$1" ;;
esac

[ -r "$NTFY_CONFIG" ] || die "no readable ntfy config at $NTFY_CONFIG"
token=$(rg -o 'default-token:\s*(\S+)' -r '$1' "$NTFY_CONFIG" || true)
[ -n "$token" ] || die "no default-token in $NTFY_CONFIG"

# stderr, not stdout: a Monitor watching this treats every stdout line as an
# alert, and status is not one.
echo "claude-ci-watch: ${repo:-all repos} via $NTFY_HOST/$NTFY_TOPICS" >&2

# Only failures are ever published, so a healthy repo produces nothing and a
# broken subscription looks exactly the same. Fail loudly here instead: a bad
# token or a topic this token cannot read is the difference between silence
# that means "green" and silence that means "never connected".
code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $token" \
  "$NTFY_HOST/$NTFY_TOPICS/json?poll=1&since=1s" || true)
case "$code" in
  200) echo "claude-ci-watch: connected, waiting (only failures are published)" >&2 ;;
  000) die "cannot reach $NTFY_HOST — on the fleet network?" ;;
  401 | 403) die "ntfy refused the token for $NTFY_TOPICS (HTTP $code)" ;;
  *) die "ntfy returned HTTP $code for $NTFY_TOPICS" ;;
esac

# Quoted heredoc: every `$` below is jq's, not the shell's, and the quoted
# delimiter is what says so to both a reader and shellcheck.
filter=$(
  cat <<'JQ'
  select(.event == "message")
  | select($repo == ""
      or ((.title // "") | test("^CI failed:\\s*" + $repo + "\\s*$"; "i"))
      or ((.message // "") | test("(^|\\n)Deploy failed:\\s*" + $repo + "\\s*(\\n|$)"; "i")))
  | "\(.title)\n\(.message)"
JQ
)

# A subscription delivers only what arrives after it connects, so replaying a
# window is the only way to see the filter work without waiting for a failure.
url="$NTFY_HOST/$NTFY_TOPICS/json"
[ -n "${CLAUDE_CI_WATCH_SINCE:-}" ] && url="$url?since=$CLAUDE_CI_WATCH_SINCE"

while true; do
  # --unbuffered or jq holds matched alerts in its buffer until the stream ends,
  # which for a subscription is never.
  curl -sN -H "Authorization: Bearer $token" "$url" \
    | jq --unbuffered -r --arg repo "$repo" "$filter" || true
  # A healthy stream stays open for hours, so this line is rare. Repeating every
  # five seconds is the visible signature of a subscription that cannot hold.
  echo "claude-ci-watch: stream closed, reconnecting in 5s" >&2
  sleep 5
done
