#!/usr/bin/env bash
# shellcheck disable=SC2016  # fzf preview commands use single quotes intentionally
# ================================================================
# workflows - Personal Workflow Quick Reference
# ================================================================
# Command-line interface for browsing multi-step workflows
# ================================================================

set -euo pipefail

# Source formatting library
SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"

WORKFLOWS_DIR="${WORKFLOWS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/workflows}"

show_help() {
  print_header "Workflows - Personal Process Reference" "brightcyan"
  echo ""
  echo "Quick reference for multi-step workflows and procedures."
  echo ""

  print_section "Commands" "brightmagenta"
  echo "  $(print_cyan "workflows")                     Show this help"
  echo "  $(print_cyan "workflows") <term>              Search for workflows matching term"
  echo "  $(print_cyan "workflows search") [term]       Search and preview workflows with fzf"
  echo "  $(print_cyan "workflows list")                List all available workflows"
  echo "  $(print_cyan "workflows learn")               Show a random workflow (direct output)"
  echo "  $(print_cyan "workflows random")              Show a random workflow (paginated)"
  echo "  $(print_cyan "workflows show") <name>         Show specific workflow"
  echo "  $(print_cyan "workflows new") <name>          Create a new workflow and open in \$EDITOR"
  echo ""

  print_section "Examples" "brightyellow"
  echo "  $(print_green "workflows")                       # Show this help"
  echo "  $(print_green "workflows git")                   # Search for 'git'"
  echo "  $(print_green "workflows search docker")         # Search for 'docker'"
  echo "  $(print_green "workflows list")                  # List all workflow names"
  echo "  $(print_green "workflows learn")                 # Show a random workflow"
  echo "  $(print_green "workflows show tmux-sessions")    # Show specific workflow"
  echo ""

  print_section "Location" "brightblue"
  echo "  Workflows: $(print_cyan "$WORKFLOWS_DIR")"
  echo "  Format:    $(print_cyan "*.md files")"
}

# Check if workflows directory exists
if [[ ! -d "$WORKFLOWS_DIR" ]]; then
  print_error "Workflows directory not found: $WORKFLOWS_DIR"
  exit 1
fi

# Strip leading YAML frontmatter (tags metadata) so cards render clean
strip_frontmatter() {
  awk 'NR==1 && $0=="---"{f=1;next} f && $0=="---"{f=0;next} !f' "$1"
}

# Render a card without its frontmatter, using bat when available
render_card() {
  local file="$1"
  shift
  # sed '/./,$!d' drops leading blank lines left behind after frontmatter
  strip_frontmatter "$file" | sed '/./,$!d' | bat --style=plain --language=markdown "$@"
}

# Search and preview workflows with fzf
cmd_search() {
  # Join all arguments as search query (handles multi-word searches)
  local query="$*"

  local fzf_opts=(
    --layout=reverse
    --preview "workflows __render '$WORKFLOWS_DIR/{}.md'"
    --preview-window=right:60%
    --prompt 'Workflow: '
    --header 'Select a workflow to view | Enter to open with bat'
  )

  # Add initial query if provided
  if [[ -n "$query" ]]; then
    fzf_opts+=(--query "$query")
  fi

  local selected
  selected=$(
    find -L "$WORKFLOWS_DIR" -type f -name "*.md" | \
    sed 's|^'"$WORKFLOWS_DIR"'/||' | \
    sed 's/\.md$//' | \
    sort | \
    fzf "${fzf_opts[@]}"
  )

  if [[ -n "$selected" ]]; then
    render_card "$WORKFLOWS_DIR/$selected.md"
  fi
}

# List all workflows
cmd_list() {
  print_section "Available Workflows" "brightcyan"
  find -L "$WORKFLOWS_DIR" -type f -name "*.md" | \
    sed 's|^'"$WORKFLOWS_DIR"'/||' | \
    sed 's/\.md$//' | \
    sort | \
    while read -r workflow; do
      echo "  • $(print_green "$workflow")"
    done
}

# Show random workflow (with bat for colored output)
cmd_random() {
  local workflow
  workflow=$(find -L "$WORKFLOWS_DIR" -type f -name "*.md" | shuf -n 1)

  if [[ -z "$workflow" ]]; then
    print_warning "No workflows found"
    exit 1
  fi

  render_card "$workflow"
}

# Show random workflow (colored output without pager for shell startup)
cmd_learn() {
  local workflow
  workflow=$(find -L "$WORKFLOWS_DIR" -type f -name "*.md" | shuf -n 1)

  if [[ -z "$workflow" ]]; then
    print_warning "No workflows found"
    exit 1
  fi

  render_card "$workflow" --paging=never
}

# Create a new workflow file and open in $EDITOR
cmd_new() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    print_error "Workflow name required"
    echo "Usage: workflows new <name>"
    exit 1
  fi

  # Slugify: lowercase, spaces to hyphens, strip non-alphanumeric except hyphens
  local slug
  slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-')

  # Prefer writing to the dotfiles source dir (so it's synced) by resolving
  # where existing symlinks point. Fall back to WORKFLOWS_DIR if none exist.
  local target_dir="$WORKFLOWS_DIR"
  local existing
  existing=$(find "$WORKFLOWS_DIR" -maxdepth 1 -name "*.md" -type l | head -1)
  if [[ -n "$existing" ]]; then
    target_dir=$(dirname "$(readlink -f "$existing")")
  fi

  local filepath="$target_dir/$slug.md"

  if [[ -f "$filepath" ]]; then
    print_error "Workflow already exists: $slug"
    echo "  $filepath"
    exit 1
  fi

  cat > "$filepath" <<EOF
# $name

EOF

  # Create symlink in WORKFLOWS_DIR if we wrote to a different directory
  if [[ "$target_dir" != "$WORKFLOWS_DIR" ]]; then
    ln -sf "$filepath" "$WORKFLOWS_DIR/$slug.md"
  fi

  print_success "Created: $slug"
  echo "  $filepath"
  echo ""

  local editor="${EDITOR:-nvim}"
  exec "$editor" "$filepath"
}

# Show specific workflow
cmd_show() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    print_error "Workflow name required"
    echo "Usage: workflows show <name>"
    echo ""
    echo "Available workflows:"
    cmd_list
    exit 1
  fi

  # Remove .md extension if provided
  name="${name%.md}"

  local filepath="$WORKFLOWS_DIR/$name.md"

  if [[ ! -f "$filepath" ]]; then
    print_error "Workflow not found: $name"
    echo ""
    echo "Available workflows:"
    cmd_list
    exit 1
  fi

  render_card "$filepath"
}

# Main command routing
case "${1:-}" in
  "")
    # No args - show help
    show_help
    ;;

  __render)
    # Internal: render a card (frontmatter stripped) for the fzf preview
    render_card "$2" --color=always
    ;;

  search)
    # Search with optional query: workflows search [term...]
    shift
    cmd_search "$@"
    ;;

  list|ls)
    cmd_list
    ;;

  learn)
    cmd_learn
    ;;

  random|rand)
    cmd_random
    ;;

  show|view)
    cmd_show "${2:-}"
    ;;

  new)
    cmd_new "${2:-}"
    ;;

  help|--help|-h)
    show_help
    ;;

  *)
    # Any unknown command is treated as a search query
    # This allows: workflows git, workflows docker logs, etc.
    cmd_search "$@"
    ;;
esac
