#!/usr/bin/env bash
# Two-pane diff review: the change in Diffview on the left, Claude on the right.
#
# The range defaults to everything committed since the last `review-diff mark`,
# recorded in this tool's own watermark store. A tmux keybinding must not depend
# on an installed Python app being present and healthy, so the cadence register
# is a reminder that this exists and nothing more — marking the cadence done and
# advancing the watermark are two acts against two stores.
#
# The store is one append-only JSONL file per machine under
# $XDG_STATE_HOME/review-diff. Append-only means no read-modify-write race
# between two shells, and the review history comes free. Per machine because
# Syncthing replicates whole files and cannot merge them: two boxes appending to
# one file produce .sync-conflict copies. A read takes the newest entry for the
# repo across every file in the directory, so a review done on the Mac counts at
# the Arch desk.
#
# Entries are keyed on the git remote, never the working-copy path: $HOME differs
# between macOS (/Users/chris) and Arch (/home/chris), so a path key makes every
# repo look unreviewed after a desk switch — the file syncs correctly and
# silently does nothing.
#
# nvim listens on a socket so `review-diff here` can ask it what the cursor is
# sitting on. That is what lets the Claude pane answer "explain what I'm looking
# at" without anything being pasted between the two panes.

set -euo pipefail

FALLBACK_WINDOW='7 days'
WATERMARK_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/review-diff"

usage() {
  cat <<'EOF'
Usage: review-diff [range]
       review-diff <command>

Opens a review window: the diff in Diffview on the left, Claude on the right.
With no range, reviews everything committed since your last `review-diff mark`
in this repo.

Commands:
  working           Review uncommitted changes instead of a commit range
  range             Print the range that would be reviewed, then exit
  mark              Record that this repo is reviewed up to now
  here              Print file:line under the cursor in the review nvim
EOF
}

die() {
  echo "review-diff: $1" >&2
  exit 1
}

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
  git rev-parse HEAD >/dev/null 2>&1 || die "this repository has no commits yet"
}

require_tmux() {
  [[ -n ${TMUX:-} ]] || die "not inside tmux — this opens a two-pane window"
}

# Keyed on the repo, since a review is scoped to one, and two repos under review
# at once must not collide on the socket.
socket_path() {
  local root
  root="$(git rev-parse --show-toplevel)"
  local tmpdir="${TMPDIR:-/tmp}"
  echo "${tmpdir%/}/review-diff-$(basename "$root").sock"
}

# Identifies the repo across machines. The remote is stable; the checkout path is
# not, because $HOME differs between macOS and Arch.
repo_key() {
  local url
  url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [[ -n $url ]]; then
    echo "$url"
    return 0
  fi
  # No remote — collapse $HOME so the key at least survives the two machines'
  # different home directories. A repo outside $HOME keeps its real path, since
  # a `~` prefix there would name a location that does not exist.
  local top
  top="$(git rev-parse --show-toplevel)"
  case "$top" in
    "$HOME"/*) echo "~${top#"$HOME"}" ;;
    *) echo "$top" ;;
  esac
}

watermark_file() {
  local machine
  machine="$(uname -n | cut -d. -f1 | tr '[:upper:]' '[:lower:]')"
  echo "${WATERMARK_DIR}/watermarks-${machine}.jsonl"
}

mark_reviewed() {
  command -v jq >/dev/null 2>&1 || die "jq is required to record a watermark"
  local key stamp file
  key="$(repo_key)"
  stamp="$(date +%Y-%m-%dT%H:%M:%S%z)"
  file="$(watermark_file)"

  mkdir -p "$WATERMARK_DIR"
  # jq builds the line so a remote URL containing a quote or backslash cannot
  # produce a JSONL row that no longer parses.
  jq -cn --arg repo "$key" --arg at "$stamp" '{repo: $repo, at: $at}' >>"$file"
  echo "review-diff: marked $key reviewed as of $stamp"
}

# Empty when nothing has been marked for this repo, which the caller treats as
# "fall back to the fixed window" rather than as an error. Reads every machine's
# file, so the newest review wins wherever it happened.
last_review_date() {
  command -v jq >/dev/null 2>&1 || return 0
  [[ -d $WATERMARK_DIR ]] || return 0

  local key
  key="$(repo_key)"
  cat "$WATERMARK_DIR"/watermarks-*.jsonl 2>/dev/null \
    | jq -r --arg repo "$key" 'select(.repo == $repo) | .at' 2>/dev/null \
    | sort \
    | tail -1
}

resolve_range() {
  local since
  since="$(last_review_date)"

  local base=""
  local origin=""

  if [[ -n $since ]]; then
    # A full timestamp, not a date, so a commit made later on the day of the last
    # review is not shown again on the next run.
    base="$(git rev-list -1 --before="$since" HEAD 2>/dev/null || true)"
    origin="everything since your last review at $since"
  fi

  if [[ -z $base ]]; then
    base="$(git rev-list -1 --before="$FALLBACK_WINDOW ago" HEAD 2>/dev/null || true)"
    origin="the last $FALLBACK_WINDOW — no review recorded yet"
  fi

  # Nothing precedes the window, so there is no base commit to exclude. The root
  # commit itself falls outside a two-dot range; a repo this young is better
  # read from its README than from a diff.
  if [[ -z $base ]]; then
    base="$(git rev-list --max-parents=0 HEAD | tail -1)"
    origin="the whole history bar the root commit — this repo is younger than the window"
  fi

  echo "review-diff: reviewing $origin" >&2
  echo "$base..HEAD"
}

# The window is the unit: a review is a task in flight, which is what a window
# means in this tmux setup, and both panes closing takes the window with them.
open_review() {
  local range="$1"
  local prompt="$2"

  local root
  root="$(git rev-parse --show-toplevel)"
  local sock
  sock="$(socket_path)"

  # A socket left behind by a killed nvim makes `here` fail with a connection
  # error rather than the readable "no review running" message.
  rm -f "$sock"

  # Track the pane by id, not by "window.0" — pane-base-index is 1 here, so an
  # index literal picks the wrong pane or none at all.
  local pane
  pane="$(tmux new-window -P -F '#{pane_id}' -n review -c "$root" \
    "nvim --listen '$sock' -c 'DiffviewOpen $range'")"

  tmux split-window -h -l 45% -t "$pane" -c "$root" "claude '/review-diff $prompt'"
  tmux select-pane -t "$pane"
}

print_here() {
  local sock
  sock="$(socket_path)"

  [[ -S $sock ]] || die "no review nvim listening at $sock — start one with 'review-diff'"

  # Diffview's older-revision buffers answer with a diffview:// URI rather than a
  # real path. Normalising it here would need the git-dir layout; the caller has
  # the repo root and resolves the tail itself.
  nvim --server "$sock" --remote-expr 'expand("%:p") . ":" . line(".")'
}

main() {
  case "${1:-}" in
    --help | -h)
      usage
      ;;
    here)
      require_repo
      print_here
      ;;
    range)
      require_repo
      resolve_range
      ;;
    mark)
      require_repo
      mark_reviewed
      ;;
    working)
      require_repo
      require_tmux
      open_review "" working
      ;;
    "")
      require_repo
      require_tmux
      local range
      range="$(resolve_range)"
      open_review "$range" "$range"
      ;;
    *)
      require_repo
      require_tmux
      git rev-parse --verify --quiet "$1" >/dev/null \
        || git rev-parse --verify --quiet "${1%%..*}" >/dev/null \
        || die "'$1' is not a revision or range in this repository"
      open_review "$1" "$1"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
