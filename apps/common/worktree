        }


def color_enabled(stream: TextIO) -> bool:
    """Whether to color output on `stream`.

    NO_COLOR is the user saying they do not want color and wins outright.
    FORCE_COLOR answers the different question "is this a terminal", which is what
    an fzf preview has to be able to say yes to.
    """
    if os.environ.get('NO_COLOR'):
        return False
    if os.environ.get('FORCE_COLOR'):
        return True
    return stream.isatty()


def build_console(stream: TextIO) -> Console:
    """A console that never wraps: the caller has already sized every column, and
    a terminal narrower than a row should scroll rather than reflow it."""
    color = color_enabled(stream)
    return Console(file=stream, force_terminal=color, no_color=not color, width=10_000, soft_wrap=True)


OUT = build_console(sys.stdout)
ERR = build_console(sys.stderr)


def say_ok(message: str) -> None:
    ERR.print(f'  [green]{CHECK}[/] {escape(message)}', highlight=False)


def say_info(message: str) -> None:
    ERR.print(f'  [blue]{INFO}[/] {escape(message)}', highlight=False)


def say_warning(message: str) -> None:
    ERR.print(f'  [yellow]{WARNING}[/] {escape(message)}', highlight=False)


def say_error(message: str) -> None:
    first, _, rest = message.partition('\n')
    ERR.print(f'  [red]{CROSS}[/] {escape(first)}', highlight=False)
    if rest:
        ERR.print(escape(rest), highlight=False)


ECHO = True

# The commands that change nothing, so have nothing to announce.
READS = frozenset({'list', 'show', 'choose'})


def set_echo(enabled: bool) -> None:
    global ECHO
    ECHO = enabled


def run(argv: Sequence[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    """The only place a subprocess starts, so none of them can run unannounced.

    The line is `shlex.join`ed and carries absolute paths, which makes it the
    command itself rather than a description of one: a run that stopped somewhere
    unexpected is replayed by pasting the line back. `-q` is what turns it off,
    and the fzf preview passes it because a preview pane is a rendered artifact.
    """
    if ECHO:
        ERR.print(f'    [green]$ {escape(shlex.join(argv))}[/]', highlight=False)
    return subprocess.run(argv, capture_output=True, text=True, **kwargs)


def ctl(*args: str) -> dict[str, Any]:
    """Ask the multiplexer, in the port's words, and read back its record.

    Every multiplexer effect in this file goes through here, so what this command
    does to a workspace is a definition rather than a search. The port's exit
    codes are the vocabulary: 2 is a refusal a caller could have avoided, and
    anything else non-zero is the multiplexer itself failing. Collapsing the two
    is what makes a caller retry a command that will never work.
    """
    # Before any `--`, never after it. Everything past that separator is the
    # command to run in the pane, so a flag appended to the end is handed to
    # `claude` as an argument and the port is asked for its default output —
    # which parses as nothing and blames the JSON rather than the placement.
    argv = list(args)
    cut = argv.index('--') if '--' in argv else len(argv)
    done = run([MUXCTL, *argv[:cut], '--json', *argv[cut:]])
    said = port_said(done.stderr)
    if done.returncode == 2:
        raise Refused(said or f'{MUXCTL} refused', fault=Fault.PORT_REFUSED)
    if done.returncode != 0:
        raise Refused(said or f'{MUXCTL} failed', fault=Fault.PORT_FAILED)
    if said:
        say_warning(said)
    return json.loads(done.stdout)


def port_said(stderr: str) -> str:
    """The port's own prose, with the machine-readable refusal line dropped."""
    lines = [line for line in stderr.strip().splitlines() if not line.startswith('{')]
    return '\n'.join(lines).strip()


def ctl_text(*args: str) -> str:
    """The same door, for a verb whose product is text rather than a record.

    Failure is empty rather than raised. Every caller is reporting on a pane that
    has already gone wrong, and losing the diagnosis because the diagnosis could
    not be read is the worse outcome.
    """
    done = run([MUXCTL, *args])
    return done.stdout.strip() if done.returncode == 0 else ''


def git(cwd: Path, *args: str) -> str:
    """Run git in `cwd` and return its stdout, raising on a non-zero exit."""
    return run(['git', '-C', str(cwd), *args], check=True).stdout.strip()


def git_optional(cwd: Path, *args: str) -> str | None:
    """The same read, answering None when git refuses.

    Only for a read whose absence is itself a fact — a remote ref nothing has
    fetched, a HEAD symref a --no-tags clone never received. Anywhere else a git
    failure means a broken worktree, and that has to be seen rather than defaulted.
    """
    result = run(['git', '-C', str(cwd), *args])
    return result.stdout.strip() if result.returncode == 0 else None


def git_effect(cwd: Path, *args: str) -> subprocess.CompletedProcess[str]:
    """Run git for its effect, handing the result back for the caller to judge."""
    return run(['git', '-C', str(cwd), *args])


def worktree_root() -> Path:
    """Where every worktree this tool makes lives, and the only index of them."""
    return Path(os.environ.get('WORKTREE_ROOT') or Path.home() / '.worktrees')


def briefs_dir() -> Path:
    """Where a spawned session's brief is kept, which is an XDG base directory like
    every other path this tool writes.

    State rather than cache or data: nothing recomputes a brief, no human authored it,
    and deleting one changes what a session was told rather than costing a rebuild. Not
    a synced store either — a brief is about one spawn on one machine, and replicating
    it to every box would put another machine's instructions in this one's directory.
    """
    state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local' / 'state')
    return state / 'worktree' / 'briefs'


def display_path(path: Path) -> str:
    """`~`-relative, which is how a path reads in a table."""
    home = Path.home()
    return f'~/{path.relative_to(home)}' if path.is_relative_to(home) else str(path)


def primary_checkout(path: Path) -> Path | None:
    """The checkout that owns .git, which `git worktree list` prints first by
    definition. None when `path` is not inside a git repository at all."""
    listing = git_optional(path, 'worktree', 'list', '--porcelain')
    if not listing or not listing.startswith('worktree '):
        return None
    return Path(listing.splitlines()[0].removeprefix('worktree '))


def default_branch(path: Path) -> str:
    """origin's own idea of its default branch, so a repo that never adopted `main`
    still lands where it should.

    The remote HEAD is absent on a clone made with --no-tags, or on one whose ref
    was never set, hence the fallback.
    """
    ref = git_optional(path, 'symbolic-ref', '--quiet', 'refs/remotes/origin/HEAD')
    return ref.rsplit('/', 1)[-1] if ref else 'main'


def in_linked_worktree(path: Path) -> bool:
    return git(path, 'rev-parse', '--git-dir') != git(path, 'rev-parse', '--git-common-dir')


def divergence(path: Path, base: str) -> tuple[int | None, int | None]:
    """Commits behind and ahead of origin/<base>.

    (None, None) where that ref does not exist: a clone that has never fetched has
    no answer, and reporting zero would read as up to date.
    """
    counts = git_optional(path, 'rev-list', '--left-right', '--count', f'origin/{base}...HEAD')
    if counts is None:
        return None, None
    behind, ahead = counts.split()
    return int(behind), int(ahead)


def commit_session(path: Path, ahead: int | None) -> str | None:
    """The session HEAD's `Agent-Session` trailer names, where HEAD is ahead of the base.

    A commit already on the base says nothing about who holds this tree, so none is read.
    """
    if not ahead:
        return None
    return git_optional(path, 'log', '-1', '--format=%(trailers:key=Agent-Session,valueonly)') or None


def changed_paths(path: Path, base: str) -> tuple[str, ...] | None:
    """Every path changed since the tree left origin/<base>, committed or not.

    From the merge base, so the base branch's own later edits are not counted. NUL-separated,
    because git otherwise quotes a name holding a space or a non-ASCII byte.
    """
    tracked = git_optional(path, 'diff', '--name-only', '-z', '--merge-base', f'origin/{base}')
    if tracked is None:
        return None
    untracked = git(path, 'ls-files', '--others', '--exclude-standard', '-z')
    return tuple(sorted({name for name in (*tracked.split('\0'), *untracked.split('\0')) if name}))


def live_sessions() -> tuple[Session, ...] | None:
    """Live Claude Code sessions, from the tool that owns the registry, or None when
    the question could not be asked at all.

    claude-sessions does the pid liveness test, and does it on the box where a pid
    means something.

    None rather than an empty tuple, which is the same split `ahead` makes and for a
    heavier reason. `list` only annotates rows with this, so an unanswerable read
    costs it a column. `sweep` gates a removal on it, and an empty tuple there reads
    as *nobody is in this worktree* — which is exactly the sentence that is not known.
    """
    if shutil.which('claude-sessions') is None:
        return None
    result = run(['claude-sessions', '--json'])
    if result.returncode != 0:
        say_warning('claude-sessions failed; the sessions in each worktree are unknown')
        return None
    return tuple(
        Session(
            name=row['name'],
            status=row['status'],
            waiting=row.get('waiting'),
            cwd=Path(row['cwd']),
            tmux=row.get('tmux'),
            pid=row.get('pid'),
        )
        for row in json.loads(result.stdout)
    )


def sessions_at(sessions: Sequence[Session] | None, path: Path) -> tuple[Session, ...] | None:
    """The sessions standing in one worktree, or None when nobody could be asked.

    A session's cwd descends below the directory it started in, so a worktree
    claims everything at or under its own path.
    """
    if sessions is None:
        return None
    return tuple(session for session in sessions if session.cwd == path or path in session.cwd.parents)


def scan(root: Path) -> list[tuple[str, bool, Path]]:
    """Every worktree on the machine, as (repo, is_checkout, path).

    Ordered by repo, with each checkout ahead of the worktrees cut from it. The
    checkout is read back out of git rather than guessed from the path, because
    $WORKTREE_ROOT names the repo and nothing else — where that repo is cloned is
    a fact only git holds.
    """
    checkouts: dict[Path, str] = {}
    linked: list[tuple[str, Path]] = []

    for candidate in sorted(root.glob('*/*')):
        if not (candidate / '.git').exists():
            continue
        checkout = primary_checkout(candidate)
        if checkout is None:
            continue
        repo = checkout.name
        checkouts[checkout] = repo
        linked.append((repo, candidate))

    rows = [(repo, True, checkout) for checkout, repo in checkouts.items()]
    rows += [(repo, False, path) for repo, path in linked]
    return sorted(rows, key=lambda row: (row[0], not row[1], str(row[2])))


def narrow(rows: Sequence[tuple[str, bool, Path]], repo: str | None) -> tuple[list[tuple[str, bool, Path]], tuple[str, ...]]:
    """The scanned rows of the named repo, and what to say when it has none.

    Every row when no repo is named. A name no row carries gets back the repos the
    root does hold, and a close match where difflib finds one. The exit stays each
    verb's empty-result one: a repo's directory goes with its last worktree, so the
    root cannot tell a misspelling from a repo with nothing left.
    """
    if repo is None:
        return list(rows), ()
    chosen = [row for row in rows if row[0] == repo]
    if chosen:
        return chosen, ()

    known = sorted({name for name, _, _ in rows})
    near = difflib.get_close_matches(repo, known, n=1)
    miss = [f'No worktree under {display_path(worktree_root())} belongs to {repo}']
    if near:
        miss.append(f'Did you mean {near[0]}?')
    miss.append(f'Repos with a worktree there: {", ".join(known)}' if known else 'No repo has a worktree there')
    return [], tuple(miss)


def say_miss(miss: Sequence[str]) -> None:
    """`narrow`'s lines for a name no worktree carries: the finding, then what the root holds."""
    if not miss:
        return
    finding, *hints = miss
    say_warning(finding)
    for hint in hints:
        say_info(hint)


def describe(repo: str, path: Path, checkout: bool, sessions: Sequence[Session] | None) -> Worktree:
    base = default_branch(path)
    behind, ahead = divergence(path, base)
    branch, landing = held_branch(path)
    return Worktree(
        repo=repo,
        path=path,
        checkout=checkout,
        branch=branch,
        base=base,
        ahead=ahead,
        behind=behind,
        state=State.DIRTY if git(path, 'status', '--porcelain') else State.CLEAN,
        sessions=sessions_at(sessions, path),
        # A HEAD pointing at a commit that no landing record names. There is no branch
        # behind it, so `published` and the ahead count are answers about nothing.
        detached=branch == 'HEAD',
        landing=landing is not None,
        changed_paths=changed_paths(path, base),
        agent_session=commit_session(path, ahead),
    )


def describe_all(rows: Sequence[tuple[str, bool, Path]], sessions: Sequence[Session] | None) -> list[Worktree]:
    """Every scanned row as a Worktree, skipping any git refuses to speak about."""
    found = []
    for repo, checkout, path in rows:
        try:
            found.append(describe(repo, path, checkout, sessions))
        except subprocess.CalledProcessError as error:
            say_warning(f'skipping {display_path(path)}: git refused ({error.stderr.strip() or error})')
        except Refused as refusal:
            say_warning(f'skipping {display_path(path)}: {refusal.reason}')
    return found


def discover(repo_filter: str | None) -> tuple[list[Worktree], tuple[str, ...]]:
    """Read the world once: every worktree, with what it carries and who is in it.

    The second half is `narrow`'s lines for a named repo with no worktree, and is
    empty otherwise.

    Local reads only. `sweep` fetches before it describes, and does it in the open
    rather than behind a flag here, because the failures of that fetch decide
    whether its verdicts mean anything.
    """
    rows, miss = narrow(scan(worktree_root()), repo_filter)
    return describe_all(rows, live_sessions()), miss


def fetch_checkouts(rows: Sequence[tuple[str, bool, Path]]) -> set[Path]:
    """Update every checkout with --prune, returning the ones git could not reach.

    The failures are the return value because they are load-bearing. Every remote
    fact below is read out of refs/remotes/origin, which outlives a branch deleted
    on the remote until a prune, so a checkout whose fetch failed can only produce
    a verdict about the remote it never reached.
    """
    failed = set()
    for _, checkout, path in rows:
        if checkout and git_effect(path, 'fetch', '--prune', '--quiet', 'origin').returncode != 0:
            failed.add(path)
    return failed


def remote_branches(checkout: Path) -> frozenset[str] | None:
    """Every branch origin still carries, or None when git could not be asked.

    One read per repo rather than a probe per worktree: the answer is the same for
    every worktree cut from the same checkout. lstrip=3 drops `refs/remotes/origin`
    and leaves the branch, slashes in its name included.
    """
    listing = git_optional(checkout, 'for-each-ref', '--format=%(refname:lstrip=3)', 'refs/remotes/origin/')
    if listing is None:
        return None
    return frozenset(listing.splitlines())


def published(path: Path, branch: str) -> bool:
    """Whether the branch was ever pushed under its own name.

    `new` cuts the branch from origin/<base>, and git's branch.autoSetupMerge points
    it at origin/<base> rather than at itself. `git push -u origin HEAD` is what moves
    the upstream onto the branch's own ref. So a branch still tracking the base never
    left this machine, and its remote branch cannot have been deleted because it never
    existed.
    """
    merge = git_optional(path, 'config', '--get', f'branch.{branch}.merge')
    return merge == f'refs/heads/{branch}'


def landed(path: Path, base: str, tip: str = 'HEAD') -> bool | None:
    """Whether tip's work is already on origin/<base>, by ancestry or by content.

    `land`, `drop` and `sweep` all ask this, so the one that refuses as nothing to land
    and the one that refuses to delete unlanded work never disagree about a branch.

    Ancestry is asked first and is the whole answer whenever it holds: a tip reachable
    from origin/<base> is the same history, so nothing here is anywhere else. That is
    the ordinary merge, and it is the case the commit count was already right about.

    A history rewritten on its way onto the base branch is the case it was wrong about.
    A squash collapses the branch into one commit. GitHub's "update branch with rebase"
    replays it onto a newer base, server-side, where nothing can move the local ref.
    Either way the landed work carries new shas and this ref still points at the
    originals. `origin/<base>..HEAD` then counts those originals for as long as the
    branch exists, so work merged months ago cannot be told apart from work that never
    left the machine.

    Content is what tells them apart, asked as the merge itself. `merge-tree
    --write-tree` merges tip into origin/<base> without moving a ref, an index or a
    file, and a merge whose tree is origin/<base>'s own adds nothing to it. That holds
    however the work arrived: squashed, replayed, cherry-picked, or alongside later edits
    to the same file. A deletion, a rename's missing half and a mode change each leave
    the tree different, and a conflict is work the base does not hold, so each reads as
    unlanded. No path list is read, so no name git quotes and no directory the caller
    stands in can change the answer.

    A branch whose commits net out to no change has nothing to lose, so it has landed.
    The commits go with the directory and what they carried is nothing. None wherever
    git could not be asked, which is a third answer rather than a false one: both
    `--is-ancestor` and `merge-tree` exit 1 for *no* and above that for a failure, a
    git older than `GIT_FLOOR` among them. Reading a failure as a *no* would keep a
    worktree on a question nobody answered, while reading it as a *yes* would delete
    one on the same.
    """
    ancestry = git_effect(path, 'merge-base', '--is-ancestor', tip, f'origin/{base}')
    if ancestry.returncode == 0:
        return True
    if ancestry.returncode > 1:
        return None

    merged = git_effect(path, 'merge-tree', '--write-tree', f'origin/{base}', tip)
    if merged.returncode == 1:
        return False
    if merged.returncode != 0:
        return None
    unchanged = git_optional(path, 'rev-parse', f'origin/{base}^{{tree}}')
    if unchanged is None:
        return None
    return merged.stdout.split('\n', 1)[0].strip() == unchanged


@dataclass(frozen=True)
class Evidence:
    """Everything read from git or the machine before a sweep decides anything.

    Gathering it up here is what makes `held_by` a function of its arguments: the
    decision to delete a directory is then reachable in a test that has no repository
    behind it, and every branch of it can be reached on purpose rather than by
    building the state that happens to produce it.
    """

    published: bool
    fetched: bool
    remote: frozenset[str] | None
    landed: bool | None


def held_by(worktree: Worktree, evidence: Evidence) -> Kept | None:
    """Why this worktree survives a sweep, or None when every check clears it.

    Pure. Ordered so the reason a reader is given is the one they would have named
    themselves: what is in the tree, then who is in it, then what is in the branch.

    Every check that can be unanswerable is tested for that first, and separately from
    being false. The two are one value in git's own vocabulary — an empty session list,
    a missing remote ref — and collapsing them here means an unreachable origin reads
    as a deleted branch, which is the reading that authorizes the removal.

    What is in the branch is asked as *are its changes on the base branch*, never as
    *are its commits*. The commit count answers the second and is right about it; a
    branch rewritten on its way onto the base branch keeps a count above zero for the
    rest of its life, and no later check can undo a keep the count already decided.
    """
    if worktree.state is State.DIRTY:
        return Kept.DIRTY
    if worktree.sessions is None:
        return Kept.SESSIONS_UNREADABLE
    if worktree.sessions:
        return Kept.SESSION
    if worktree.landing:
        return Kept.LANDING_STOPPED
    if worktree.detached:
        return Kept.DETACHED
    if not evidence.fetched:
        return Kept.UNFETCHED_REMOTE
    if worktree.ahead is None:
        return Kept.UNFETCHED_BASE
    if evidence.landed is None:
        return Kept.UNREADABLE_LANDING
    if not evidence.landed:
        return Kept.UNLANDED
    if not evidence.published:
        return Kept.UNPUBLISHED
    if evidence.remote is None:
        return Kept.REMOTE_UNREADABLE
    if worktree.branch in evidence.remote:
        return Kept.REMOTE_LIVE
    return None


def session_cell(worktree: Worktree) -> str:
    """`?` where nobody could be asked, the same mark an unreadable ahead count gets."""
    if worktree.sessions is None:
        return '?'
    return ', '.join(f'{session.name} ({session.status})' for session in worktree.sessions)


def cells(worktree: Worktree) -> tuple[str, ...]:
    ahead = '?' if worktree.ahead is None else str(worktree.ahead)
    return (display_path(worktree.path), worktree.branch, ahead, str(worktree.state), session_cell(worktree))


def render_table(worktrees: Sequence[Worktree]) -> list[str]:
    """The listing, column-aligned, with its header first.

    Widths come from the rows in hand rather than from constants: a listing of
    every repo is as wide as its longest path and a single repo's is not, so a
    fixed width either truncates the one or pads the other. The last column is
    left unpadded — nothing follows it, and session names run long.
    """
    rows = [COLUMNS, *(cells(worktree) for worktree in worktrees)]
    widths = [max(len(row[column]) for row in rows) for column in range(len(COLUMNS) - 1)]
    return ['  '.join([*(cell.ljust(width) for cell, width in zip(row, widths, strict=False)), row[-1]]).rstrip() for row in rows]


def cmd_list(repo_filter: str | None, as_json: bool) -> int:
    worktrees, miss = discover(repo_filter)
    say_miss(miss)

    if as_json:
        OUT.print(json.dumps([worktree.as_json() for worktree in worktrees], indent=2), markup=False, highlight=False)
        return 0

    if miss:
        return 0

    if not worktrees:
        scope = f' for {repo_filter}' if repo_filter else ''
        say_info(f'No worktrees{scope} under {display_path(worktree_root())}')
        return 0

    for line in render_table(worktrees):
        OUT.print(line, markup=False, highlight=False)
    return 0


def resolve_worktree(argument: str | None) -> Worktree:
    """The worktree a `show` is about: the one named, or the one you are standing in."""
    path = Path(argument).expanduser().resolve() if argument else Path.cwd()
    if not path.is_dir():
        raise Refused(f'No such directory: {path}')
    checkout = primary_checkout(path)
    if checkout is None:
        raise Refused(f'Not a git worktree: {path}')
    top = Path(git(path, 'rev-parse', '--show-toplevel'))
    return describe(checkout.name, top, top == checkout, live_sessions())


def cmd_show(argument: str | None) -> int:
    worktree = resolve_worktree(argument)
    label = worktree.repo if worktree.checkout else f'{worktree.repo}/{worktree.path.name}'
    ahead = '?' if worktree.ahead is None else worktree.ahead
    behind = '?' if worktree.behind is None else worktree.behind

    OUT.print(f'[cyan]{escape(label)}[/]', highlight=False)
    OUT.print(display_path(worktree.path), markup=False, highlight=False)
    OUT.print(f'{worktree.branch} — {ahead} ahead, {behind} behind {worktree.base}, {worktree.state}', markup=False, highlight=False)

    section('changes', git(worktree.path, 'status', '--porcelain'))
    section('commits', git_optional(worktree.path, 'log', '--oneline', f'origin/{worktree.base}..HEAD'))
    show_sessions(worktree)
    return 0


def section(heading: str, body: str | None) -> None:
    if not body:
        return
    OUT.print('')
    OUT.print(f'[cyan]{heading}[/]', highlight=False)
    for line in body.splitlines():
        OUT.print(f'  {line}', markup=False, highlight=False)


def show_sessions(worktree: Worktree) -> None:
    """The session block, ending in each session's live pane.

    The pane rather than a summary, for the same reason tmux-sessions previews
    one: two sessions in one worktree are told apart by what is on their screens
    and by nothing else.
    """
    OUT.print('')
    OUT.print('[cyan]session[/]', highlight=False)
    if worktree.sessions is None:
        OUT.print('  unknown — claude-sessions could not be asked', markup=False, highlight=False)
        return
    if not worktree.sessions:
        OUT.print('  none', markup=False, highlight=False)
        return

    for session in worktree.sessions:
        detail = [session.status]
        if session.waiting:
            detail.append(f'waiting on {session.waiting}')
        if session.tmux:
            detail.append(session.tmux)
        OUT.print(f'  {session.name} — {", ".join(detail)}', markup=False, highlight=False)
        pane = capture_pane(session.tmux) if session.tmux else None
        for line in (pane or '').splitlines():
            OUT.print(f'  {line}', markup=False, highlight=False)


def registered_pane(address: str) -> str:
    """The part of a registry address the multiplexer will still answer to.

    The registry spells a pane as `<session>:@<window>.%<pane>` and records it when
    the session starts, so the first two fields rot the moment the pane is moved.
    The last one does not, and it is the only one worth handing on. A session name
    may itself contain a dot, so the split comes from the right.
    """
    return address.rsplit('.', 1)[-1]


def capture_pane(address: str) -> str | None:
    """What is on a session's screen, color included, or None where unreadable.

    Two sessions in one worktree are told apart by what is on their screens, and
    a Claude pane is mostly color.
    """
    screen = ctl_text('pane', 'read', registered_pane(address), '--lines', '40', '--color')
    return screen or None


def preview_command() -> str:
    """`show`, addressed to the fzf field carrying the path.

    sys.executable rather than the script itself: this process already resolved
    the dependencies into an environment, and going back through the shebang would
    make uv resolve them again on every keystroke that moves the cursor.

    `show` is a read, so it echoes none of the git behind the preview, which
    would otherwise be redrawn on every keystroke that moves the cursor.
    """
    interpreter = shlex.quote(sys.executable)
    script = shlex.quote(str(Path(__file__).resolve()))
    return f'FORCE_COLOR=1 {interpreter} {script} show {{1}}'


def cmd_choose(repo_filter: str | None) -> int:
    if shutil.which('fzf') is None:
        raise Refused("fzf is not installed — 'worktree list' is the read that needs no terminal")

    worktrees, miss = discover(repo_filter)
    if miss:
        raise Refused(*miss)
    if not worktrees:
        scope = f' for {repo_filter}' if repo_filter else ''
        raise Refused(f'No worktrees{scope} under {display_path(worktree_root())}')

    header, *rendered = render_table(worktrees)
    rows = [f'{FZF_DELIMITER}{header}', *(f'{w.path}{FZF_DELIMITER}{line}' for w, line in zip(worktrees, rendered, strict=True))]

    picker = 'fzf-tmux' if os.environ.get('TMUX') and shutil.which('fzf-tmux') else 'fzf'
    result = run(
        [
            picker,
            '--delimiter',
            FZF_DELIMITER,
            '--with-nth',
            '2..',
            '--header-lines',
            '1',
            '--no-sort',
            '--ansi',
            '--border-label',
            ' worktrees ',
            '--prompt',
            '  ',
            '--bind',
            'tab:down,btab:up',
            '--preview-window',
            'down,65%,wrap,border-top',
            '--preview',
            preview_command(),
        ],
        input='\n'.join(rows),
    )

    chosen = result.stdout.strip()
    if result.returncode != 0 or not chosen:
        return 0
    OUT.print(chosen.split(FZF_DELIMITER, 1)[0], markup=False, highlight=False)
    return 0


def require_checkout(cwd: Path) -> Path:
    checkout = primary_checkout(cwd)
    if checkout is None:
        raise Refused('Not inside a git repository')
    return checkout


def require_clean(cwd: Path) -> None:
    dirty = git(cwd, 'status', '--porcelain')
    if not dirty:
        return
    raise Refused(
        f'This worktree has uncommitted changes\n{dirty}',
        "Commit them (git commit -m ... -- <paths>) or 'worktree drop --force'",
    )


def prune_repo_dir(path: Path) -> None:
    """`git worktree remove` takes the leaf and leaves the repo directory behind, so
    $WORKTREE_ROOT silently accumulates empty shells of repos carrying nothing."""
    parent = path.parent
    if parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()


class Disposal(StrEnum):
    """Which half of a disposal happened, so a caller can say the true sentence.

    The directory and the ref go separately, and after BRANCH_KEPT the directory is
    already gone. A single failure value cannot express that, and both callers then
    report a worktree still standing when what survived was the branch.
    """

    DONE = 'done'
    NOT_REMOVED = 'not_removed'
    BRANCH_KEPT = 'branch_kept'


def dispose(checkout: Path, path: Path, branch: str, *, force: bool) -> tuple[Disposal, str]:
    """Remove a worktree and delete its branch. The member says how far it got.

    Neither result is discarded. A removal that fails silently is how a worktree
    outlives the landing that announced success — the commits reach the base branch,
    the directory stays, and $WORKTREE_ROOT grows a tree whose work is already
    elsewhere.

    `force` removes a tree carrying changes, which only a caller that has offered to
    lose them may ask for.

    -D rather than -d, in every caller, and the evidence is the caller's rather than
    git's. `branch -d` asks whether the branch is merged into the *checkout's* HEAD,
    and the checkout is a different tree whose local base branch is only as current as
    its last pull. It refuses a branch that merged on the remote hours ago, and it
    accepts one merged into a base that has since been rewritten. Every caller here
    proves the branch's changes are already on `origin/<base>` — the branch they were
    actually merged into — immediately before calling.
    """
    removal = git_effect(checkout, 'worktree', 'remove', *(['--force'] if force else []), str(path))
    if removal.returncode != 0:
        return Disposal.NOT_REMOVED, removal.stderr.strip() or 'git refused to remove the worktree'

    prune_repo_dir(path)
    deletion = git_effect(checkout, 'branch', '--quiet', '-D', branch)
    if deletion.returncode != 0:
        return Disposal.BRANCH_KEPT, deletion.stderr.strip() or f'git refused to delete {branch}'
    return Disposal.DONE, ''


def confirm(question: str) -> bool:
    """A y/N a human has to type, on stderr beside everything else written for one.

    Only ever called behind an isatty check. Nothing here invents an answer: a caller
    with no terminal to ask is refused rather than defaulted either way.
    """
    ERR.print(f'  {escape(question)} [y/N] ', end='', highlight=False)
    return sys.stdin.readline().strip().lower() in ('y', 'yes')


def declares_setup(path: Path) -> bool:
    """Whether the repo declares a `setup` target to make a checkout runnable.

    Asked of the tree rather than of a registry, because the target is the
    declaration — a repo opts in by having one and there is nothing else to keep
    in step. Every way of not having one answers False: no `task` installed, no
    Taskfile, a Taskfile that does not declare it.
    """
    if shutil.which('task') is None:
        return False
    listed = run(['task', '--list-all', '--json'], cwd=path)
    if listed.returncode != 0:
        return False
    try:
        tasks = json.loads(listed.stdout).get('tasks', [])
    except json.JSONDecodeError:
        return False
    return any(task.get('name') == 'setup' for task in tasks)


def provision(path: Path) -> None:
    """Run the repo's own `task setup` in a new worktree.

    A worktree is a clean checkout, so everything gitignored is absent — the
    virtualenv, node_modules, and whatever else has no manifest. What that means
    is the repo's to say; this only decides when to ask.

    It blocks, and on a large front end it blocks for a minute. That is the
    right trade: the alternative is handing back a path that looks ready and
    fails at the first command the session runs in it.

    A failure is reported rather than raised. The worktree exists either way,
    and destroying it would lose the isolation that was the point.
    """
    if not declares_setup(path):
        return
    say_info('Provisioning — running `task setup`')
    if run(['task', 'setup'], cwd=path).returncode != 0:
        say_warning('task setup failed; the worktree exists but is not provisioned')


def create_worktree(cwd: Path, checkout: Path, slug: str) -> Path:
    """Cut a worktree off origin's default branch, provision it, and return its path.

    Shared by `new` and `spawn` so the two cannot drift: a session started by `spawn`
    would otherwise be the one landing in a tree that `task setup` never ran in, and
    nothing about that failure would name the branch they took differently.
    """
    path = worktree_root() / checkout.name / slug

    if path.exists():
        raise Refused(f'Already exists: {path}')

    base = default_branch(cwd)
    git_effect(cwd, 'fetch', '--quiet', 'origin')
    created = git_effect(cwd, 'worktree', 'add', '--quiet', str(path), '-b', slug, f'origin/{base}')
    if created.returncode != 0:
        raise Refused(created.stderr.strip() or f'git could not create {path}')

    provision(path)
    return path


def cmd_new(slug: str) -> int:
    cwd = Path.cwd()
    checkout = require_checkout(cwd)
    path = create_worktree(cwd, checkout, slug)

    say_ok(f'Isolated at {path}')
    OUT.print(str(path), markup=False, highlight=False)
    return 0


def require_tool(name: str, why: str) -> None:
    if shutil.which(name) is None:
        raise Refused(f'{name} is not installed', why, fault=Fault.TOOL_MISSING)


def require_caller_pane() -> str:
    """The pane a spawn is placed against, which is the caller's own.

    Asked of the multiplexer rather than read out of the environment. Every
    multiplexer says somewhere which pane a process is in and each says it
    differently, so the variable to read is the one fact this command would
    otherwise have to know a multiplexer to know.

    Outside one there is no pane, and a session started anyway would be a process
    nobody can see — which is the failure this refuses rather than produces.
    """
    require_tool(MUXCTL, 'A spawned session lands in a pane, and this is what opens one')
    try:
        return str(ctl('pane', 'current')['pane'])
    except Refused as refusal:
        # Only a refusal is the environment. Anything else is the port itself
        # failing, and its own sentence names a cause this one would replace with
        # advice that cannot fix it.
        if refusal.fault is not Fault.PORT_REFUSED:
            raise
        raise Refused(
            refusal.reason,
            'Run this from a session that is itself in a pane',
            fault=Fault.NO_TMUX,
        ) from refusal


def require_unoccupied(path: Path) -> None:
    """Refuse to put a second session into a worktree that already holds one.

    An unreadable registry refuses too. *Nobody is here* and *nobody could be asked* are
    the same empty list, and reading the second as the first is what authorizes the
    collision — the same split `held_by` keeps for its four unanswerable members.
    """
    sessions = sessions_at(live_sessions(), path)
    if sessions is None:
        raise Refused(
            f'Cannot tell whether a session is already in {display_path(path)}',
            'claude-sessions is what answers that, and two sessions in one worktree is the collision this tool exists to prevent',
            fault=Fault.SESSIONS_UNREADABLE,
        )
    if sessions:
        raise Refused(
            f'{display_path(path)} already holds {", ".join(session.name for session in sessions)}',
            'Spawn under a different slug, or send that session a message instead of a second session',
            fault=Fault.WORKTREE_OCCUPIED,
        )


def resolve_destination(cwd: Path, checkout: Path, slug: str | None) -> Destination:
    """Where the session will stand: a worktree of its own, or the checkout itself.

    The absent slug is structural scope: the argument's presence selects it, never a
    flag.

    An existing worktree is attached to rather than refused, and its branch is read back
    out of git rather than assumed to be the slug: a session standing there may have
    moved it.
    """
    if slug is None:
        occupants = sessions_at(live_sessions(), checkout)
        if occupants:
            names = ', '.join(session.name for session in occupants)
            say_warning(f'{display_path(checkout)} already holds {names}, and this session will share its index')
            say_info('Give it a slug if it will commit; with none it gets no branch, which is what makes sharing a checkout safe')
        return Destination(checkout, None, worktree=False)

    path = worktree_root() / checkout.name / slug
    if not path.exists():
        return Destination(create_worktree(cwd, checkout, slug), slug, worktree=True, created=True)

    if primary_checkout(path) is None:
        raise Refused(
            f'{display_path(path)} exists but is not a worktree', 'Remove it, or spawn under a different slug', fault=Fault.NOT_A_WORKTREE
        )
    require_unoccupied(path)
    return Destination(path, held_branch(path)[0], worktree=True)


def unwind(checkout: Path, where: Destination) -> None:
    """Take back a worktree this run cut, after something later refused.

    Only ever called for one this run created, and never for one it attached to: the
    second holds work somebody else is doing. `dispose` is the same removal `land` and
    `drop` use, and its result is reported rather than raised — the caller is already
    raising the refusal that brought us here, and a failed cleanup must not replace it.
    """
    if where.branch is None:
        return
    outcome, detail = dispose(checkout, where.path, where.branch, force=True)
    if outcome is Disposal.DONE:
        say_info(f'Removed {display_path(where.path)}, which this run had just created')
        return
    say_warning(f'{display_path(where.path)} was created by this run and is still here: {detail}')


def keep_brief(source: Path, repo: str, slug: str | None) -> Path:
    """Copy the brief somewhere it outlives its author, and return the copy.

    The session reads its brief once, at launch, so the file has to survive only until
    then — but the caller writing it has no way to know when that is, and a coordinator
    writing briefs into its own scratch directory would be racing its agents' startup.

    Kept rather than deleted afterwards because it is the only record of what a session
    was told, which is what a later reader needs to tell a wrong agent from a wrong brief.

    `mkstemp` mints the name rather than a timestamp, because two spawns in one second
    have no distinguishing part left — and that is not a rare case. A coordinator
    dispatches several reviewers at once, none of them carries a slug, and they all name
    the same repo. The loser's brief is overwritten and the winner's session is launched
    against instructions written for somebody else.

    The copy opens with `spawned_by_front_matter`, where the spawner is a session.
    """
    stamp = dt.datetime.now().strftime('%Y%m%d-%H%M%S')
    briefs_dir().mkdir(parents=True, exist_ok=True)
    handle, minted = tempfile.mkstemp(dir=briefs_dir(), prefix=f'{repo}-{slug or "checkout"}-{stamp}-', suffix='.md')
    os.close(handle)

    destination = Path(minted)
    destination.write_text(spawned_by_front_matter() + source.read_text())
    return destination


def spawned_by_front_matter() -> str:
    """A YAML block naming who wrote the brief, or '' where no session or trace did.

    A brief is read long after it is written, so it carries its writer's session id,
    `traceparent` and `baggage`, and a reader links back to the span that spawned the
    session. Each value is a JSON string, which YAML reads back as the same string
    whatever punctuation a baggage header holds.
    """
    fields = {
        'session_id': os.environ.get('CLAUDE_CODE_SESSION_ID', ''),
        'traceparent': os.environ.get('TRACEPARENT', ''),
        'baggage': os.environ.get('BAGGAGE', ''),
    }
    held = [f'  {key}: {json.dumps(value)}' for key, value in fields.items() if value]
    return '\n'.join(['---', 'spawned_by:', *held, '---', '', '']) if held else ''


def flow_in(baggage: str) -> str:
    """The flow a W3C `baggage` header carries, or '' where it carries none.

    Members are comma-separated `key=value`, each with optional `;properties`, and the
    last of a repeated key wins. A value that is not a trace id, or is the all-zero one
    W3C calls invalid, reads as no flow. The dotfiles run record parses it the same way,
    and this script runs without that package, so it carries its own.
    """
    flow = ''
    for member in baggage.split(','):
        key, _, value = member.partition(';')[0].partition('=')
        if key.strip() == FLOW_MEMBER:
            flow = value.strip()
    return flow if TRACE_ID.fullmatch(flow) and flow != '0' * 32 else ''


def resource_attributes(inherited: str, added: dict[str, str]) -> str:
    """`inherited`'s pairs less any whose key `added` sets, then `added`'s.

    So a session spawned by one that was itself spawned names its own spawner, and
    every other pair the machine set survives. Each value is percent-encoded, as the
    variable's W3C baggage format asks.
    """
    kept = [pair for pair in inherited.split(',') if pair.strip() and pair.partition('=')[0].strip() not in added]
    return ','.join([*kept, *(f'{key}={quote(value, safe="")}' for key, value in added.items())])


def spawner_environment() -> list[str]:
    """The `env` prefix joining a spawned session to the session that spawned it.

    A tmux pane takes its environment from the tmux server rather than from the command
    that opened it, so what the spawner holds reaches the pane only on the command line.
    An interactive Claude Code session ignores an incoming `TRACEPARENT` and copies its
    resource attributes onto every span, so the spawner's session id rides in
    `OTEL_RESOURCE_ATTRIBUTES`. A flow rides there too, where the spawner's `BAGGAGE`
    holds one, and `BAGGAGE` carries it on to the new session's Bash calls.

    Empty where the spawner holds neither, so `claude` starts as it would without it.
    """
    baggage = os.environ.get('BAGGAGE', '')
    flow = flow_in(baggage)
    held = {SPAWNED_BY_SESSION: os.environ.get('CLAUDE_CODE_SESSION_ID', ''), FLOW_MEMBER: flow}
    added = {key: value for key, value in held.items() if value}
    if not added:
        return []
    assignments = [f'OTEL_RESOURCE_ATTRIBUTES={resource_attributes(os.environ.get("OTEL_RESOURCE_ATTRIBUTES", ""), added)}']
    if flow:
        assignments.append(f'BAGGAGE={baggage}')
    return ['env', *assignments]


def open_session_pane(
    caller: str, workdir: Path, prompt: str, *, below: bool, window_name: str | None, per_window: int | None, claude_args: list[str]
) -> dict[str, Any]:
    """Ask for a pane to run a session in, and return what the multiplexer made.

    The request is intent rather than geometry. A reviewer names the pane it
    reviews and the multiplexer puts it directly beneath; a worker asks for room
    and gets whatever the multiplexer has that can be followed. Neither says how
    wide, which way to split, or which window — those are answers, and asking for
    them here would make one multiplexer's answer the only implementable one.

    A worker's window name goes to the port as the name of its work, which is how
    the window list says what each worker is doing. How the multiplexer shows it is
    the adapter's business. A reviewer sends none, because it sits under the worker
    the name already describes. `per_window` is sent only when given, so its
    default and the counts it refuses are the port's to say.

    `readable` in the record is the multiplexer's claim that the pane can be
    followed. False is a real answer: it says nowhere on this client can be, which
    is worth a warning and is not worth refusing a session over.
    """
    role = REVIEWER if below else WORKER
    partner = ['--for', caller] if below else []
    named = ['--window-name', window_name] if window_name and not below else []
    seats = ['--per-window', str(per_window)] if per_window is not None else []
    # The `--` before the prompt keeps a variadic flag such as --add-dir from taking it.
    session = [*spawner_environment(), 'claude', '--permission-mode', 'bypassPermissions', *claude_args, '--', prompt]
    made = ctl('pane', 'open', role, *partner, *named, *seats, '--cwd', str(workdir), '--', *session)
    if not made.get('readable', True):
        say_warning(f'{made["pane"]} is {made.get("width")}x{made.get("height")}, which is small to follow an agent in')
    return made


def pane_report(pane: str) -> dict[str, Any]:
    """What the multiplexer says about a pane: its state, its status, its pid.

    One call rather than three, because the three answers come from one record and
    asking separately is three chances for them to describe different moments.

    A pane that is gone comes back as a state rather than a refusal. Its absence is
    the answer a caller waiting on a launch is asking for.
    """
    return ctl('pane', 'status', pane)


def last_words(pane: str) -> str:
    """What a dead pane printed before it died, scrollback included.

    The whole scrollback rather than the visible region: a command that wrote one
    line and exited leaves that line above the window, so a capture of what is on
    screen comes back as blank lines and the multiplexer's own notice that the pane
    is dead — which says nothing the exit status has not already said.
    """
    return ctl_text('pane', 'read', pane, '--strip')


def claimants(sessions: Sequence[Session], pane: str) -> list[Session]:
    """Every registered session claiming one pane, by the only part of the address that
    survives the pane being moved.

    The registry spells a pane as `<tmux session>:@<window>.%<pane>`, and only the last
    field is compared. The other two rot when the pane moves. `tmux break-pane` gives it a
    new window and `tmux join-pane` can give it a new tmux session, while the registry
    keeps the address it recorded at startup — so the address as a whole names a place the
    pane has left.

    Through `registered_pane`, which owns that split.
    """
    return [session for session in sessions if session.tmux and registered_pane(session.tmux) == pane]


def session_in_pane(sessions: Sequence[Session], pane: str, pane_pid: int | None) -> str | None:
    """The registered session running in one pane.

    Not matched on the working directory, which is ambiguous by design here. A session
    with no slug stands in the primary checkout on purpose, and that is the one directory
    several sessions share — so a directory match returns whichever of them the registry
    lists first. Handing a caller the wrong name sends a real instruction to a session that
    never asked for it.

    A pane id does not identify a session on its own. Two things break it. A `claude`
    started from inside another session's pane inherits that pane's $TMUX_PANE and
    registers against it, so one pane can carry a second row for as long as that child
    lives. And ids are numbered per tmux server rather than per machine, so a row left by
    a session whose server is gone resolves to a live pane on another server belonging to
    someone else.

    The pid separates them wherever tmux will give one up, and it is compared rather than
    used as a tiebreak — a claimant that registers before the real session would otherwise
    be answered with, and the caller's next act is to send that name an instruction.

    Where `pane_pid` could not be read the pane alone decides, which is the fallback and
    not the rule. It is reached when tmux will not report a pid for the pane, which almost
    always means the pane is already gone — and the wait has a pane check of its own for
    exactly that.
    """
    for session in claimants(sessions, pane):
        if pane_pid is None or session.pid == pane_pid:
            return session.name
    return None


def await_registration(pane: str, timeout: float) -> Arrival:
    """Wait for the new session to appear in the registry, and name it.

    The name is the product of the whole command: a caller's next move is a message
    addressed to it, and there is nothing to address until the session has registered.

    The pane is watched alongside, because a launch that failed to start leaves no
    session to wait for — and without this the whole timeout is spent to report nothing
    but that the timeout elapsed. The corpse is read for its exit status and then killed,
    since `remain-on-exit` would otherwise leave a dead pane in the window forever.

    The command echo is off for the loop. It is one `claude-sessions` per second, and a
    reader watching for a name does not need sixty copies of the same line.
    """
    say_info('Waiting for the session to register')
    deadline = time.monotonic() + timeout
    echoing = ECHO
    set_echo(False)
    try:
        # Read once, before anything has had time to move: the pane's process does not
        # change for its lifetime, and it is what tells the session apart from any other
        # row claiming the same pane.
        pane_pid = pane_report(pane).get('pid')
        while time.monotonic() < deadline:
            time.sleep(POLL_SECONDS)

            sessions = live_sessions()
            if sessions is None:
                return Arrival(Registration.REGISTRY_UNREADABLE)
            name = session_in_pane(sessions, pane, pane_pid)
            if name:
                return Arrival(Registration.REGISTERED, session=name)

            # A row claiming this pane and carrying no pid at all is the producer's output
            # having changed shape, not a session still starting. Waiting it out would
            # spend the whole timeout and then blame `claude` for a pane that is healthy.
            if pane_pid is not None and any(claimant.pid is None for claimant in claimants(sessions, pane)):
                return Arrival(Registration.NO_PID_IN_REGISTRY)

            report = pane_report(pane)
            state = Pane(report['state'])
            if state is Pane.RUNNING:
                continue
            output = last_words(pane) if state is Pane.DEAD else ''
            # Closed rather than left standing. A dead pane holds its corpse open so
            # its exit status can be read, and once it has been the pane is a hole in
            # the layout that nothing else will collect.
            ctl('pane', 'close', pane)
            return Arrival(Registration.PANE_DIED, status=report.get('exit_code'), output=output)
    finally:
        set_echo(echoing)

    return Arrival(Registration.TIMED_OUT)


def announce(spawned: Spawned, timeout: float) -> None:
    """Everything a human reads about a spawn, on stderr beside the rest of it."""
    say_ok(f'Spawned in pane {spawned.pane}, {display_path(spawned.path)}')
    if spawned.branch:
        say_info(f'branch {spawned.branch}')
    say_info(f'brief {display_path(spawned.brief)}')

    arrival = spawned.arrival
    match arrival.registration:
        case Registration.REGISTERED:
            say_ok(f'Session {arrival.session}')
        case Registration.PANE_DIED:
            status = 'an unreadable status' if arrival.status is None else f'status {arrival.status}'
            say_error(f'`claude` exited with {status} before a session registered')
            if arrival.output:
                say_info('what the pane printed:')
                ERR.print(escape(arrival.output), highlight=False)
        case Registration.TIMED_OUT:
            say_error(f'No session registered in {spawned.pane} within {timeout:g}s')
            say_info('The pane is still running; `claude-sessions` will name it if it registers late')
        case Registration.REGISTRY_UNREADABLE:
            say_error('claude-sessions stopped answering, so the session in that pane cannot be named')
        case Registration.NO_PID_IN_REGISTRY:
            say_error('claude-sessions reported a session in that pane with no pid, so it cannot be told from a nested one')
            say_info('The pane is running; the field this needs is `pid` in claude-sessions --json')


def cmd_spawn(
    slug: str | None,
    brief: str,
    *,
    below: bool,
    window_name: str | None,
    per_window: int | None,
    timeout: float,
    as_json: bool,
    claude_args: list[str],
) -> int:
    """Start a Claude session in a pane of its own, and name it.

    Everything that can refuse is settled before anything is created —
    a missing tmux, an absent brief or an occupied worktree costs nothing to discover
    and would otherwise be found after a pane, a branch and a directory already exist.
    """
    caller = require_caller_pane()
    require_tool('claude', 'It is the session this starts')
    require_tool('claude-sessions', 'It is what names the session that lands in the pane')

    source = Path(brief).expanduser()
    if not source.is_file():
        raise Refused(
            f'No brief at {source}',
            'Write the brief to a file — a prompt long enough to be one does not survive quoting',
            fault=Fault.BRIEF_MISSING,
        )
    if not source.read_text().strip():
        raise Refused(f'{source} is empty', 'A session given nothing to read will ask what it is for', fault=Fault.BRIEF_EMPTY)

    cwd = Path.cwd()
    checkout = require_checkout(cwd)
    # Copied before the worktree is cut, so the one thing a later refusal can leave
    # behind is a file in a state directory rather than a branch and a checkout.
    kept = keep_brief(source, checkout.name, slug)
    where = resolve_destination(cwd, checkout, slug)

    # The multiplexer can still refuse after the worktree exists: a reviewer's worker
    # already reviewed, a --per-window under one, a tmux call that fails. What it would leave is a branch and a
    # provisioned checkout that `sweep` will not collect, because nothing was ever pushed
    # and it is held as UNPUBLISHED. So the one thing this command created gets unwound
    # before the refusal reaches the caller.
    try:
        made = open_session_pane(
            caller,
            where.path,
            BRIEF_PROMPT.format(brief=kept),
            below=below,
            window_name=window_name or slug,
            per_window=per_window,
            claude_args=claude_args,
        )
    except Refused:
        if where.created:
            unwind(checkout, where)
        raise

    pane = str(made['pane'])
    spawned = Spawned(
        repo=checkout.name,
        path=where.path,
        branch=where.branch,
        worktree=where.worktree,
        pane=pane,
        brief=kept,
        claude_args=claude_args,
        arrival=await_registration(pane, timeout),
    )

    # The prose first, so a terminal interleaving the two streams reads in the order the
    # run happened rather than ending on the line it opened with.
    announce(spawned, timeout)

    if as_json:
        OUT.print(json.dumps(spawned.as_json(), indent=2), markup=False, highlight=False)
    elif spawned.arrival.session:
        OUT.print(spawned.arrival.session, markup=False, highlight=False)

    # Non-zero without a name, because the caller's next move is a message to it. A spawn
    # reported as success with nothing to address is the failure that reads as working.
    return 0 if spawned.arrival.registration is Registration.REGISTERED else 1


def cmd_land() -> int:
    cwd = Path.cwd()
    checkout = require_checkout(cwd)
    if not in_linked_worktree(cwd):
        raise Refused(
            "Not in a worktree — 'land' is what hands one back to the primary checkout",
            "Run 'worktree new <slug>' first, or commit directly if no other session is here",
        )
    require_git_floor(cwd)

    base = default_branch(cwd)
    path = Path(git(cwd, 'rev-parse', '--show-toplevel'))
    branch = resume_landing(cwd, base)
    require_clean(cwd)

    landed = land_branch(cwd, branch, base)
    how = f'merged as {landed.sha}' if landed.merge else f'at {landed.sha}'
    say_ok(f'Landed {landed.commits} commit(s) on {base}, {how}')
    outcome, detail = dispose(checkout, path, branch, force=False)
    if outcome is Disposal.NOT_REMOVED:
        say_warning(f'{display_path(path)} is still here: {detail}')
    elif outcome is Disposal.BRANCH_KEPT:
        say_warning(f'Removed {display_path(path)}, but branch {branch} is still here: {detail}')

    catch_up_checkout(checkout, base)
    say_info(f'cd {checkout}')
    return 0


class Merging(StrEnum):
    """Which merge a landing's detached HEAD holds, and so whether it may be made again."""

    CLEAN = 'clean'
    """`land` made it with nothing to resolve, so it holds nothing the branch does
    not, and the next run drops it and merges again."""

    CONFLICT = 'conflict'
    """It stopped for the session to resolve. The resolution exists only in this
    merge, so it is kept and never made again."""


@dataclass(frozen=True)
class Landing:
    branch: str
    merging: Merging
    onto: str


@dataclass(frozen=True)
class Landed:
    commits: int
    sha: str
    merge: bool


def git_said(result: subprocess.CompletedProcess[str]) -> str:
    """What git printed about a failure, which it writes to either stream."""
    return result.stderr.strip() or result.stdout.strip()


def require_git_floor(cwd: Path) -> None:
    said = git(cwd, '--version')
    found = re.search(r'(\d+)\.(\d+)', said)
    if found and (int(found[1]), int(found[2])) >= GIT_FLOOR:
        return
    floor = '.'.join(map(str, GIT_FLOOR))
    raise Refused(
        f"{said} is older than {floor}, the first git with 'merge-tree --write-tree', which land needs",
        f"Install git {floor} or newer, then run 'worktree land' again",
    )


def landing_record(cwd: Path) -> Path:
    return Path(git(cwd, 'rev-parse', '--path-format=absolute', '--git-path', LANDING_RECORD))


def record_landing(cwd: Path, landing: Landing) -> None:
    """Written beside the record and renamed over it, so a run killed mid-write leaves the old one."""
    record = landing_record(cwd)
    staged = record.with_name(f'{record.name}.new')
    staged.write_text(json.dumps({'branch': landing.branch, 'merging': landing.merging.value, 'onto': landing.onto}) + '\n')
    staged.replace(record)


def read_landing(cwd: Path) -> Landing | None:
    record = landing_record(cwd)
    if not record.exists():
        return None
    try:
        fields = json.loads(record.read_text())
        return Landing(branch=fields['branch'], merging=Merging(fields['merging']), onto=fields['onto'])
    except (ValueError, KeyError, TypeError) as unreadable:
        raise Refused(
            f'{record} does not say which landing is under way ({unreadable})',
            "Delete it, put HEAD back with 'git switch <branch>' if it is detached, then run 'worktree land' again",
        ) from unreadable


def held_branch(path: Path) -> tuple[str, Landing | None]:
    """The branch this worktree holds, and the landing that detached HEAD from it, if one did.

    HEAD names the branch, except while a stopped landing has it detached, when the
    record does. `HEAD` where neither does: a worktree someone detached by hand.
    """
    on = git_optional(path, 'symbolic-ref', '--quiet', '--short', 'HEAD')
    if on is not None:
        return on, None
    landing = read_landing(path)
    return (landing.branch if landing else 'HEAD'), landing


def is_ancestor(cwd: Path, older: str, newer: str) -> bool:
    """`--is-ancestor` exits 1 for *no* and above that for a failure, which is no answer."""
    asked = git_effect(cwd, 'merge-base', '--is-ancestor', older, newer)
    if asked.returncode > 1:
        raise Refused(f'git could not say whether {older} is part of {newer}\n{git_said(asked)}')
    return asked.returncode == 0


def merge_in_progress(cwd: Path) -> bool:
    return git_optional(cwd, 'rev-parse', '--quiet', '--verify', 'MERGE_HEAD') is not None


def unmerged_paths(cwd: Path) -> tuple[str, ...]:
    """A listing git could not make refuses, because an empty one means nothing is left to resolve."""
    listing = git_effect(cwd, 'diff', '--name-only', '-z', '--diff-filter=U')
    if listing.returncode != 0:
        raise Refused(f'git could not list the paths the merge left unresolved\n{git_said(listing)}')
    return tuple(sorted({name for name in listing.stdout.split('\0') if name}))


def conflict_refusal(branch: str, base: str, paths: Sequence[str]) -> Refused:
    return Refused(
        f'Merging {branch} into origin/{base} stopped on a conflict in {", ".join(paths)}',
        "Resolve it here and stage it with 'git add'; 'worktree land' then commits the merge and lands it",
        "'git merge --abort' gives the merge up, and 'worktree land' then starts again from the branch",
    )


def resume_landing(cwd: Path, base: str) -> str:
    """The branch to land, once whatever an earlier `land` left on HEAD is settled.

    A worktree on its branch is the ordinary case, and a record beside it is stale:
    the session put HEAD back itself. A resolution it committed before switching is
    taken onto the branch first, because its sha is already recorded. A detached HEAD
    with no record is not a landing, so it is refused rather than guessed at.

    A clean merge is dropped, because the branch ref is what every merge starts from.
    A conflicted one is finished. The resolution is committed through the hooks unless
    the session committed it already, and the branch fast-forwards onto it. A lost race
    after that merges the new main onto the resolution rather than resolving it again.
    """
    branch, landing = held_branch(cwd)
    if landing is None and branch != 'HEAD':
        adopt_committed_resolution(cwd, branch)
        landing_record(cwd).unlink(missing_ok=True)
        return branch
    if landing is None:
        raise Refused(
            'HEAD is detached here, and no landing is under way',
            "Switch to the branch to land with 'git switch <branch>', then run 'worktree land' again",
        )
    if landing.merging is Merging.CONFLICT:
        finish_resolved_merge(cwd, landing.branch, base)
    elif merge_in_progress(cwd):
        git_effect(cwd, 'merge', '--abort')
    return_to_branch(cwd, landing.branch)
    return landing.branch


def finish_resolved_merge(cwd: Path, branch: str, base: str) -> None:
    """Commit a staged resolution, then move the branch onto the merge that holds it.

    A HEAD the branch is not part of is a merge the session gave up with `--abort`,
    which leaves the branch where it was.
    """
    if merge_in_progress(cwd):
        if paths := unmerged_paths(cwd):
            raise conflict_refusal(branch, base, paths)
        if git_effect(cwd, 'diff', '--quiet').returncode != 0:
            raise Refused('The resolution is not all staged', "Stage it with 'git add', then run 'worktree land' again")
        committed = git_effect(cwd, 'commit', '--quiet', '--no-edit')
        if committed.returncode != 0:
            raise Refused(
                f'git commit refused the resolved merge\n{git_said(committed)}', "Fix what it says, then run 'worktree land' again"
            )

    tip = git(cwd, 'rev-parse', f'refs/heads/{branch}')
    head = git(cwd, 'rev-parse', 'HEAD')
    if head != tip and is_ancestor(cwd, tip, head):
        git(cwd, 'update-ref', f'refs/heads/{branch}', head, tip)


def adopt_committed_resolution(cwd: Path, branch: str) -> None:
    """Fast-forward the branch onto a resolved merge the session committed, then switched away from.

    The stopped landing's record names the main it merged onto, and HEAD's own reflog
    still holds the commit: the newest one whose parents are that main and the branch
    tip. A merge the session gave up left no such commit, so the branch stays put.
    """
    stopped = read_landing(cwd)
    if stopped is None or stopped.merging is not Merging.CONFLICT or stopped.branch != branch:
        return
    tip = git(cwd, 'rev-parse', f'refs/heads/{branch}')
    visited = git_effect(cwd, 'log', '--walk-reflogs', '--format=%H %P', 'HEAD')
    for line in visited.stdout.splitlines():
        resolved, *parents = line.split()
        if parents == [stopped.onto, tip]:
            moved = git_effect(cwd, 'merge', '--ff-only', '--quiet', resolved)
            if moved.returncode != 0:
                raise Refused(
                    f'Could not move {branch} onto the merge resolved here, {resolved}\n{git_said(moved)}',
                    f"Put HEAD on it with 'git switch --detach {resolved}', then run 'worktree land' again",
                )
            return


def return_to_branch(cwd: Path, branch: str) -> None:
    switched = git_effect(cwd, 'switch', '--quiet', branch)
    if switched.returncode != 0:
        raise Refused(f'Could not put this worktree back on {branch}\n{git_said(switched)}')
    landing_record(cwd).unlink(missing_ok=True)


def fetch_base(cwd: Path, base: str) -> str:
    """origin/<base> as origin holds it now.

    A fetch that fails refuses, because a merge made against a stale base is a
    merge the next push throws away.
    """
    fetched = git_effect(cwd, 'fetch', '--quiet', 'origin')
    if fetched.returncode != 0:
        raise Refused(f'Could not fetch origin, so nothing was pushed\n{git_said(fetched)}')
    return git(cwd, 'rev-parse', f'refs/remotes/origin/{base}')


def leads_with(cwd: Path, main: str, tip: str) -> bool:
    """Whether main sits on tip's first-parent line, so a fast-forward keeps main's own line first.

    A branch that merged main in holds it as a second parent. A fast-forward onto that
    puts the branch's commits on main's first-parent line and moves every landing since
    the branch was cut off it, as a foxtrot merge does. The first-parent walk from tip
    stops at what main already holds, so the oldest commit it reaches has main as its
    first parent exactly when main leads.
    """
    line = git(cwd, 'rev-list', '--first-parent', '--reverse', f'{main}..{tip}').split('\n', 1)[0]
    return bool(line) and git(cwd, 'rev-parse', f'{line}^') == main


def land_branch(cwd: Path, branch: str, base: str) -> Landed:
    """Push the branch onto origin/<base>, by fast-forward or by a merge with main first.

    The branch ref, never HEAD, is what lands, since HEAD may hold a merge from a run
    that stopped. A push with no force is the lock. One refused while origin/<base>
    moved lost a race, so the next pass merges onto the new main. One refused while it
    stood still failed for another reason, and that is git's to explain.
    """
    main = fetch_base(cwd, base)
    for _ in range(PUSH_TRIES):
        tip = git(cwd, 'rev-parse', f'refs/heads/{branch}')
        merging = not leads_with(cwd, main, tip)
        if merging:
            held = landed(cwd, base, tip)
            if held is None:
                raise Refused(f'git could not say whether the work here is already on origin/{base}', "Run 'worktree land' again")
            if held:
                raise nothing_to_land(base)
        commits = int(git(cwd, 'rev-list', '--count', f'{main}..{tip}'))
        if merging:
            merge_onto(cwd, branch, base, main)

        pushed = git_effect(cwd, 'push', '--quiet', 'origin', f'HEAD:{base}')
        if pushed.returncode == 0:
            if merging:
                run_post_merge_hooks(cwd)
            return Landed(commits=commits, sha=git(cwd, 'rev-parse', 'HEAD'), merge=merging)
        if merging:
            return_to_branch(cwd, branch)
        moved = fetch_base(cwd, base)
        if moved == main:
            raise Refused(
                f'Pushing to origin/{base} failed, and origin/{base} has not moved\n{git_said(pushed)}',
                "Nothing was pushed. Fix what git says above, then run 'worktree land' again",
            )
        main = moved
    raise Refused(f'origin/{base} moved again during each of {PUSH_TRIES} pushes, so nothing was pushed', "Run 'worktree land' again")


def nothing_to_land(base: str) -> Refused:
    return Refused(f'Nothing to land: the work here is already on origin/{base}')


def merge_onto(cwd: Path, branch: str, base: str, main: str) -> None:
    """Make the landing merge on a detached `main`, so main is its first parent.

    Porcelain `git merge`, so the hooks run on it as on any commit a session makes:
    `prepare-commit-msg` stamps the agent trailers and `commit-msg` checks the
    subject. That check runs conventional commits `--strict`, which refuses git's own
    `Merge branch` line, hence the `chore:` subject.

    A lost race drops this merge, so it is made with `dotfiles.postMergeAfterPush`
    set, and `land_branch` runs `post-merge` once the push lands. A `post-merge`
    hook that skips while the key is set acts only on a merge that reached main.

    A conflict stops inside git's merge state, which holds the only copy of the
    resolution in progress, so nothing here aborts one.
    """
    record_landing(cwd, Landing(branch, Merging.CLEAN, main))
    detached = git_effect(cwd, 'switch', '--quiet', '--detach', main)
    if detached.returncode != 0:
        landing_record(cwd).unlink(missing_ok=True)
        raise Refused(f'Could not detach at origin/{base} to merge onto it\n{git_said(detached)}')

    subject = f'chore: merge {branch} into {base}'
    merged = git_effect(cwd, '-c', 'dotfiles.postMergeAfterPush=true', 'merge', '--no-ff', '--no-edit', '--log', '-m', subject, branch)
    if merged.returncode == 0:
        return
    if merge_in_progress(cwd):
        # Recorded before the paths are listed, so a listing that fails leaves a run
        # that finishes the merge rather than one that aborts it.
        record_landing(cwd, Landing(branch, Merging.CONFLICT, main))
        if paths := unmerged_paths(cwd):
            raise conflict_refusal(branch, base, paths)
        git_effect(cwd, 'merge', '--abort')
    return_to_branch(cwd, branch)
    raise Refused(
        f'git merge refused to merge {branch} into origin/{base}\n{git_said(merged)}',
        "Nothing was pushed. Fix what git says above, then run 'worktree land' again",
    )


def run_post_merge_hooks(cwd: Path) -> None:
    """Run `post-merge` on the merge that just landed, as git runs it after a merge.

    A hook that fails cannot undo a pushed merge, so what it said is printed and the
    landing goes on.
    """
    ran = git_effect(cwd, 'hook', 'run', '--ignore-missing', 'post-merge', '--', '0')
    if said := (ran.stderr + ran.stdout).strip():
        ERR.print(escape(said), highlight=False)


def catch_up_checkout(checkout: Path, base: str) -> None:
    """The checkout is now behind, and in dotfiles a checkout is deployed machine
    state — so leaving it stale is not cosmetic.

    Fast-forward it only when it is clean and on the branch we landed on: another
    session may be working there, and its tree is not ours to move. `--ff-only`
    makes no commit, so a checkout holding commits of its own on <base> is refused
    rather than merged into, and says so. The command it prints is the same catch-up
    as a pull, which a session's Bash hook lets through.
    """
    catch_up = 'git pull --ff-only'
    head = git(checkout, 'rev-parse', '--abbrev-ref', 'HEAD')
    if head != base:
        say_warning(f'{checkout} is on {head}, not {base} — run `{catch_up}` there once it is back on {base}')
        return
    if git(checkout, 'status', '--porcelain'):
        say_warning(f'{checkout} has local changes — run `{catch_up}` there when free')
        return

    git_effect(checkout, 'fetch', '--quiet', 'origin')
    merged = git_effect(checkout, 'merge', '--ff-only', '--quiet', f'origin/{base}')
    if merged.returncode != 0:
        say_warning(f'{checkout} is left as it was, because it cannot fast-forward to origin/{base}: {git_said(merged)}')
        return
    say_ok(f'Caught up {checkout}')


def cmd_drop(force: bool) -> int:
    cwd = Path.cwd()
    checkout = require_checkout(cwd)
    if not in_linked_worktree(cwd):
        raise Refused('Not in a worktree')

    base = default_branch(cwd)
    branch, _ = held_branch(cwd)
    tip = 'HEAD' if branch == 'HEAD' else f'refs/heads/{branch}'
    path = Path(git(cwd, 'rev-parse', '--show-toplevel'))

    if not force:
        require_clean(cwd)
        # The same question `land` and `sweep` ask, for the same reason: a count above
        # zero is a rewritten history as often as it is unlanded work, and the two need
        # opposite answers. This one runs on local refs alone, so a base branch nobody
        # has fetched since the merge reads as unlanded — which refuses, and refusing
        # is the half of this that costs nothing to be wrong about.
        elsewhere = landed(cwd, base, tip)
        if elsewhere is None:
            raise Refused(
                f'Cannot tell whether the work here is already on origin/{base}',
                "Fetch and look; 'worktree drop --force' drops it either way",
            )
        if not elsewhere:
            unlanded = int(git(cwd, 'rev-list', '--count', f'origin/{base}..{tip}'))
            raise Refused(
                f'{unlanded} commit(s) here, and merging them would still change origin/{base}',
                f"'git cherry origin/{base} HEAD' if they landed under new shas; "
                "'worktree land' to keep them, 'worktree drop --force' to lose them",
            )

    outcome, detail = dispose(checkout, path, branch, force=True)
    if outcome is Disposal.NOT_REMOVED:
        raise Refused(f'Could not drop {display_path(path)}: {detail}')
    if outcome is Disposal.BRANCH_KEPT:
        # The drop itself happened, so this is a warning rather than a refusal.
        say_warning(f'Branch {branch} is still here: {detail}')

    say_ok(f'Dropped {path}')
    say_info(f'cd {checkout}')
    return 0


def cmd_sweep(repo_filter: str | None, assume_yes: bool) -> int:
    """Dispose of every worktree whose work is finished, from wherever you are standing.

    `land` and `drop` both read Path.cwd() and refuse outside a linked worktree, so
    neither can reach one you are not in. Work that goes through a PR is merged on
    GitHub and the remote branch deleted there, and nothing ever runs `drop` — so the
    directories accumulate, and every tool that reports branch state reports each one
    forever.
    """
    rows, miss = narrow(scan(worktree_root()), repo_filter)
    if miss:
        # Not "Nothing to sweep", which reads as a clean run over a repo it never found.
        say_miss(miss)
        return 0
    unreached = fetch_checkouts(rows)
    worktrees = describe_all(rows, live_sessions())

    # Owner by path rather than by `repo`, which is a directory basename and so is not
    # unique across a machine: ~/code/thing and ~/tools/thing are two repos with one
    # name. This is the command that deletes, so it asks git which checkout owns each
    # tree rather than joining on a string that can collide.
    owners: dict[Path, Path] = {}
    remotes: dict[Path, frozenset[str] | None] = {}
    for worktree in worktrees:
        if worktree.checkout:
            continue
        owner = primary_checkout(worktree.path)
        if owner is None:
            continue
        owners[worktree.path] = owner
        if owner not in remotes:
            remotes[owner] = remote_branches(owner)

    finished: list[Worktree] = []
    kept: list[tuple[Worktree, Kept]] = []
    for worktree in worktrees:
        if worktree.checkout or worktree.path not in owners:
            continue
        owner = owners[worktree.path]
        evidence = Evidence(
            published=published(worktree.path, worktree.branch),
            fetched=owner not in unreached,
            remote=remotes[owner],
            landed=landed(worktree.path, worktree.base),
        )
        reason = held_by(worktree, evidence)
        if reason is None:
            finished.append(worktree)
        else:
            kept.append((worktree, reason))

    for worktree, reason in kept:
        say_info(f'{display_path(worktree.path)} — kept, {reason}')

    if not finished:
        scope = f' of {repo_filter}' if repo_filter else ''
        say_ok(f'Nothing to sweep: {len(kept)} worktree(s){scope} checked, none merged with its remote branch deleted')
        return 0

    ERR.print('')
    for worktree in finished:
        ERR.print(f'  [red]remove[/] {escape(display_path(worktree.path))}  [dim]{escape(worktree.branch)}[/]', highlight=False)
    ERR.print('')

    if not assume_yes:
        if not sys.stdin.isatty():
            # Usage, not failure: the remedy is an argument, and only that is worth
            # reinvoking with. Exit 1 here would be the code a half-finished removal
            # also returns, which a caller has to tell apart to know whether to retry.
            say_error(f'Refusing to remove {len(finished)} worktree(s) with no terminal to ask')
            say_info('Pass --yes to sweep unattended')
            return USAGE_ERROR
        if not confirm(f'Remove {len(finished)} worktree(s) and delete their branches?'):
            say_info('Nothing removed')
            return 0

    swept = 0
    for worktree in finished:
        # Re-read against the branch these changes actually merged into, immediately
        # before the write. Everything above was measured during the scan, and a session
        # that committed into the worktree since then would lose the only copy. Anything
        # other than a plain True holds the tree, so a read that failed cannot pass for
        # a branch with nothing left to lose — and it keeps its own reason here, as it
        # does on the scan path, because the two send a reader to different places.
        still_landed = landed(worktree.path, worktree.base)
        if still_landed is not True:
            reason = Kept.UNLANDED if still_landed is False else Kept.UNREADABLE_LANDING
            say_warning(f'{display_path(worktree.path)} — kept, {reason}')
            continue

        outcome, detail = dispose(owners[worktree.path], worktree.path, worktree.branch, force=False)
        if outcome is Disposal.NOT_REMOVED:
            say_warning(f'{display_path(worktree.path)} is still here: {detail}')
            continue
        if outcome is Disposal.BRANCH_KEPT:
            say_warning(f'Removed {display_path(worktree.path)}, but branch {worktree.branch} is still here: {detail}')
            continue
        swept += 1

    say_ok(f'Swept {swept} of {len(finished)} worktree(s)')
    return 0 if swept == len(finished) else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog='worktree',
        description=(
            'Give a session its own index, and land it on main without a PR.\n'
            '\n'
            'Start with `worktree new <slug>`, or `worktree spawn <slug> --brief <file>` for a\n'
            'session in a pane of its own. Commit in it, then finish from inside it with\n'
            '`worktree land`. `worktree drop` abandons it instead, and `worktree sweep`\n'
            'collects worktrees whose pull request merged on GitHub.\n'
            '\n'
            'Options go after the command they belong to: `worktree land -q`, never `worktree -q land`.'
        ),
        # Raw, so the examples keep their columns. The default formatter reflows an
        # epilog into a paragraph, which is what stopped one being written here.
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            'Examples:\n'
            '  worktree new parser-fix                  isolate a session; prints the path\n'
            '  worktree list dotfiles                   one repo, not every repo there\n'
            '  worktree list dotfiles --json            the same rows for a script to read\n'
            '  worktree spawn parser-fix --brief b.md   a session in its own worktree\n'
            '  worktree spawn --brief review.md         a reviewer, in the checkout\n'
            '  worktree spawn --brief r.md -- --model sonnet   claude gets what follows --\n'
            '  worktree land                            land on main by merge or fast-forward, clean up\n'
            '  worktree drop                            remove it without landing\n'
            '  worktree sweep dotfiles --yes            remove finished worktrees\n'
            '\n'
            'Worktrees live under $WORKTREE_ROOT (default ~/.worktrees/<repo>/<slug>).\n'
            "'list' and 'choose' read every repo there unless you name one, which is what\n"
            'the positional repo is for — piping --json through a jq filter on .repo is\n'
            'the same narrowing done by hand.\n'
            'Every command a write runs is echoed to stderr as you could re-type it; -q hides them.\n'
            "'list', 'show' and 'choose' move nothing and echo nothing.\n"
            "For work that grew into a large feature, 'git push -u origin HEAD' and open a PR instead."
        ),
    )
    commands = parser.add_subparsers(dest='command', metavar='<command>')

    # argparse parses a group's options before the subcommand name, so a -q
    # declared on `parser` turns `worktree land -q` into an unrecognized argument.
    # A parent puts it on every leaf, which is where it is typed.
    quiet = argparse.ArgumentParser(add_help=False)
    quiet.add_argument('-q', '--quiet', action='store_true', help='hide the commands this runs')
    # A read echoes nothing, so -q is accepted for the callers that pass it and
    # left out of the help, where it would promise to hide what is never shown.
    read_quiet = argparse.ArgumentParser(add_help=False)
    read_quiet.add_argument('-q', '--quiet', action='store_true', help=argparse.SUPPRESS)

    repo_help = "narrow to one repo, by its checkout's directory name (~/.claude is .claude)"

    new = commands.add_parser(
        'new',
        parents=[quiet],
        help="isolate a session off origin's default branch, run the repo's `task setup`, print the path",
        description=(
            'Create a worktree of the repo holding the current directory, on a new branch off '
            "origin's default branch, run that repo's `task setup` in it, and print its path. "
            'It takes no -C, --repo or --json: the repo is the one you stand in, so to isolate work '
            'in another repo, run it from that checkout (`cd <checkout> && worktree new <slug>`). '
            'The path is the only thing it prints to stdout.'
        ),
    )
    new.add_argument('slug', help='names both the directory and the branch')

    spawn = commands.add_parser(
        'spawn',
        parents=[quiet],
        help='start a Claude session in a pane: with a slug in a worktree, without one in the checkout',
        description=(
            'Open a pane, launch `claude` in it against a written brief, and print the name the session '
            'registered under. '
            'A slug names the branch, so `spawn <slug>` creates or attaches a worktree and puts the session in '
            'it, and `spawn` with no slug stands the session in the primary checkout with no branch — which is '
            'what a reviewer needs, since a session inside a worktree is refused any `git -C` that leaves it. '
            'The brief is copied and the session reads the copy, whose path `--json` returns. '
            'Arguments after `--` go to `claude` ahead of the prompt, so '
            '`spawn --brief r.md --below -- --agent reviewer --model sonnet --effort medium` '
            'starts that agent on that model. '
            'It exits non-zero when no session registered, because the name is the product.'
        ),
    )
    spawn.add_argument(
        'slug', nargs='?', help='names the directory and the branch; without it the session stands in the checkout and gets no branch'
    )
    spawn.add_argument(
        '--brief', required=True, metavar='PATH', help='the file the session is told to read; it is copied, and the copy is what it reads'
    )
    spawn.add_argument('--below', action='store_true', help='a reviewer, placed directly under the pane it reviews rather than beside it')
    spawn.add_argument(
        '--window-name',
        metavar='NAME',
        help='what the window list calls this work, in place of the slug; a session with neither lands in a window called agents',
    )
    spawn.add_argument(
        '--per-window',
        type=int,
        metavar='N',
        help=(
            "how many of the calling pane's workers share a window side by side; 1 gives this one a window of its own. "
            "Without it the multiplexer's default applies. A worker never opens beside the pane that spawned it"
        ),
    )
    spawn.add_argument(
        '--timeout',
        type=float,
        default=REGISTRATION_TIMEOUT,
        metavar='SECONDS',
        help=f'how long to wait for the session to register (default {REGISTRATION_TIMEOUT:g})',
    )
    spawn.add_argument('--json', action='store_true', dest='as_json', help='the session, pane, path, branch and brief for a script to read')
    spawn.set_defaults(subparser=spawn)

    commands.add_parser(
        'land',
        parents=[quiet],
        help='fast-forward or merge onto the default branch, then clean up',
        description=(
            'Put the worktree you are standing in onto the default branch, with no pull request. '
            f'It refuses outside a worktree, on a dirty tree, on a git older than {".".join(map(str, GIT_FLOOR))}, '
            'and when the work is already on origin/<base>. '
            'It fetches, then pushes the branch to <base> as a fast-forward where origin/<base> has not moved. '
            'Where it has, it pushes a merge whose first parent is origin/<base>, with the subject '
            '`chore: merge <branch> into <base>`, so no commit changes its sha. '
            'A conflict stops it inside that merge: resolve and stage it, then run land again, which commits '
            'the merge and lands it. '
            f'A push that loses a race to another landing fetches and merges again, {PUSH_TRIES} pushes in all. '
            'It then removes the worktree and deletes its branch. '
            'Last, it fast-forwards the primary checkout, but only when that checkout is clean and on '
            '<base>; otherwise it says so and leaves the checkout alone.'
        ),
    )

    drop = commands.add_parser(
        'drop',
        parents=[quiet],
        help='abandon the worktree you are in, without landing it',
        description=(
            'Remove the worktree holding the current directory, and delete its branch, without landing it. '
            'It takes no slug and no --repo: run it from inside the worktree to drop. '
            'It asks nothing, so it has no --yes. '
            'Instead it refuses a dirty tree, and commits that origin/<base> does not carry; '
            '`worktree land` keeps them and --force throws them away. '
            '`worktree sweep` is the one that removes already-merged worktrees from anywhere.'
        ),
    )
    drop.add_argument('--force', action='store_true', help='throw the work away, commits included')
    # Caught here for `list --all`'s reason, and one worse failure of its own. A
    # slug is what the name invites, and every recorded attempt was piped into a
    # pager — so argparse exited 2 into a pipe whose own status was 0, and the
    # caller read success. This is the only chance to say the command takes none.
    drop.add_argument('slug', nargs='?', help=argparse.SUPPRESS)
    drop.set_defaults(subparser=drop)

    # `sweep` is the counterpart to `drop`, not a bulk spelling of it. `drop` abandons
    # work that was never landed and needs you standing in it; `sweep` disposes of work
    # that is already merged, anywhere on the machine, and refuses anything unlanded.
    sweep = commands.add_parser(
        'sweep',
        parents=[quiet],
        help='remove every finished worktree on the machine: merged, and deleted on the remote',
        description=(
            'Remove every worktree whose work is finished, and delete its branch. '
            'A worktree qualifies only when its tree is clean, no session is standing in it, '
            'its changes are already on origin/<base>, and the branch it was pushed to '
            'under its own name has since been deleted on the remote. Everything else is kept, '
            'with the reason printed. '
            'It lists what it will remove and asks first; without a terminal it removes nothing '
            'unless --yes is passed.'
        ),
    )
    sweep.add_argument('repo', nargs='?', help=repo_help)
    sweep.add_argument('--yes', action='store_true', help='remove without asking; required when there is no terminal')

    listing = commands.add_parser('list', parents=[read_quiet], help="every worktree on this machine, or one repo's")
    listing.add_argument('repo', nargs='?', help=repo_help)
    listing.add_argument('--json', action='store_true', dest='as_json', help='the same rows for a script to read')
    # Scope is structural here: `list` is the whole machine and `list <repo>` is
    # one repo. --all is caught rather than left to argparse's "unrecognized
    # arguments", because it is the spelling a flag-shaped habit reaches for and
    # the error is the only chance to teach the argument.
    listing.add_argument('--all', action='store_true', help=argparse.SUPPRESS)
    listing.set_defaults(subparser=listing)

    show = commands.add_parser('show', parents=[read_quiet], help='what one worktree carries, and which session is in it')
    show.add_argument('path', nargs='?', help='defaults to the worktree you are standing in')

    choose = commands.add_parser('choose', parents=[read_quiet], help='pick one with fzf; prints the path it chose')
    choose.add_argument('repo', nargs='?', help=repo_help)

    return parser


def dispatch(parser: argparse.ArgumentParser, args: argparse.Namespace) -> int:
    match args.command:
        case 'new':
            return cmd_new(args.slug)
        case 'spawn':
            return cmd_spawn(
                args.slug,
                args.brief,
                below=args.below,
                window_name=args.window_name,
                per_window=args.per_window,
                timeout=args.timeout,
                as_json=args.as_json,
                claude_args=args.claude_args,
            )
        case 'land':
            return cmd_land()
        case 'drop':
            if args.slug:
                args.subparser.error(
                    f"no slug: 'worktree drop' removes the worktree you are standing in, so cd to {args.slug} "
                    "and run it there — or 'worktree sweep <repo>' for work that already merged"
                )
            return cmd_drop(args.force)
        case 'sweep':
            return cmd_sweep(args.repo, args.yes)
        case 'list':
            if args.all:
                args.subparser.error("no --all: 'worktree list' is already every repo, and 'worktree list <repo>' narrows it")
            return cmd_list(args.repo, args.as_json)
        case 'show':
            return cmd_show(args.path)
        case 'choose':
            return cmd_choose(args.repo)
        case _:
            parser.print_help()
            return 0


def split_claude_args(argv: list[str]) -> tuple[list[str], list[str]]:
    """The arguments `worktree` reads, and the ones after `--` that `spawn` hands to `claude`.

    Split before argparse sees them, because argparse would read `--model` after `--` as
    a value for spawn's optional slug. The same `--` cargo run and kubectl exec use.
    """
    if '--' not in argv:
        return argv, []
    at = argv.index('--')
    return argv[:at], argv[at + 1 :]


def main() -> int:
    parser = build_parser()
    own, claude_args = split_claude_args(sys.argv[1:])
    args = parser.parse_args(own)
    if claude_args and args.command != 'spawn':
        parser.error(f'only spawn passes arguments after -- to claude, and {args.command} was given {" ".join(claude_args)}')
    args.claude_args = claude_args
    set_echo(args.command not in READS and not getattr(args, 'quiet', False))
    try:
        return dispatch(parser, args)
    except Refused as refusal:
        say_error(refusal.reason)
        for hint in refusal.hints:
            say_info(hint)
        return USAGE_ERROR if refusal.fault in USAGE_FAULTS else 1


if __name__ == '__main__':
    sys.exit(main())
