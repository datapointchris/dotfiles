#!/usr/bin/env bash
# Every open PR you have, across the repos the registry names, as JSON.
#
# The one implementation. `fleet prs` calls it, doit's dashboard lane calls it,
# and the `prs` picker calls it — three consumers that were on their way to
# three copies of the same gh query, which would have disagreed the first time
# one of them learned about a second forge.
#
# Lives in dotfiles rather than in fleet because fleet is not installed on every
# machine and this has to be. The registry is: repos.json says which repos exist
# and `provider` says who hosts them, so the same command answers on a box where
# that is GitHub and one where it is Bitbucket.
#
# Grouped by provider, one bulk query per provider that has one. GitHub does, so
# a 79-repo registry still costs a single API call rather than 79. A provider
# without a bulk search falls back to per-repo, which is why bbkt is a loop.
#
# Output is a JSON array, one object per PR, sorted oldest first — the backlog is
# a gauge and age is what it measures.

set -euo pipefail

# $REPOS_JSON is declared in install/flags.yml as a machine-local value, because
# where a machine keeps its registry is that machine's fact and not this repo's.
# There is deliberately no fallback to a known location: a default would be the
# hardcoded path one indirection later, and it fails by reading the wrong file
# rather than by saying the value is unset.
REGISTRY="${REPOS_JSON:-${XDG_CONFIG_HOME:-$HOME/.config}/repos.json}"
LANE=""

die() {
  echo "pr-list: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: pr-list [--registry PATH] [--lane]

Prints every open PR across the registry's repos as a JSON array, oldest first.

Each object: repo, slug, number, title, url, branch, base, draft, created_at,
age_days, path. `branch` is the identifier to type — a number is a per-repo
counter and collides across the registry, whereas `gh` and `bbkt` both accept a
branch anywhere they accept a number. `base` is what the PR targets, so a PR
stacked on another names its parent rather than the default branch. `path` is
empty when the repo is not checked out on this machine.

--lane emits doit's lane document instead, so `doit dashboard` can read this
directly and no consumer has to carry a copy of the shape.
EOF
}

command -v jq >/dev/null 2>&1 || die "jq is required"

while [ $# -gt 0 ]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --registry)
      REGISTRY="${2:-}"
      shift 2
      ;;
    --lane)
      LANE=1
      shift
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -f "$REGISTRY" ] || die "no registry at $REGISTRY"

# status is required, so it is matched plainly rather than defaulted. Supplying a
# default here is what let the readers disagree: this one and fleet counted an
# entry with no status, indy and relate dropped it, and every list looked
# plausible. The registry repo rejects an entry without one at commit time.
# Per-repo provider wins over the file's, for a registry that mixes hosts.
repos_for() {
  jq -r --arg want "$1" '
    (.provider // "github") as $default
    | .repos[]
    | select(.status == "active")
    | select((.provider // $default) == $want)
    | [.name, .path] | @tsv
  ' "$REGISTRY"
}

# name → expanded path, for every active repo, so a PR can be opened locally.
paths_json() {
  jq --arg home "$HOME" '
    [ .repos[]
      | select(.status == "active")
      | {key: .name, value: (.path | sub("^~"; $home))}
    ] | from_entries
  ' "$REGISTRY"
}

# GraphQL rather than `gh search prs`, whose field set has no headRefName or
# baseRefName — the branch is simply unreachable through it, and appending the
# flag fails with "Unknown JSON field". The alternative was `gh pr list --json
# headRefName` per repo, which reads better and costs one request per repo; that
# is the fan-out the bulk search exists to avoid. This keeps the single call.
GITHUB_SEARCH='
{
  search(query: "author:@me is:pr is:open", type: ISSUE, first: 100) {
    nodes {
      ... on PullRequest {
        number
        title
        url
        headRefName
        baseRefName
        isDraft
        createdAt
        repository { name nameWithOwner }
      }
    }
  }
}'

# GitHub: one search for everything you authored, then keep what the registry
# names. Searching by author rather than per repo is what makes this one call;
# filtering afterwards is what keeps it honest about scope.
from_github() {
  local names
  names=$(repos_for github | cut -f1)
  [ -n "$names" ] || return 0

  command -v gh >/dev/null 2>&1 || {
    echo "pr-list: gh is not installed; skipping GitHub repos" >&2
    return 0
  }

  local raw
  if ! raw=$(gh api graphql -f query="$GITHUB_SEARCH" 2>&1); then
    echo "pr-list: gh could not list PRs (check 'gh auth status'): ${raw%%$'\n'*}" >&2
    return 0
  fi

  # `type: ISSUE` searches issues and PRs from one index, so a node the inline
  # fragment does not match arrives as `{}`. `is:pr` should prevent it; without
  # the guard one would emit a row of nulls, and a null number is a hard
  # unmarshal failure in fleet rather than a visibly empty row.
  jq -n --argjson prs "$raw" --arg names "$names" '
    ($names | split("\n") | map(select(length > 0))) as $wanted
    | $prs.data.search.nodes[]
    | select(.number != null)
    | select(.repository.name as $n | $wanted | index($n))
    | {
        repo: .repository.name,
        slug: .repository.nameWithOwner,
        number: .number,
        title: .title,
        url: .url,
        branch: .headRefName,
        base: .baseRefName,
        draft: .isDraft,
        created_at: .createdAt,
      }
  '
}

# Bitbucket: bbkt is repo-scoped, so this is a loop by necessity rather than by
# choice. It runs in each checkout because that is how bbkt resolves the repo.
from_bitbucket() {
  command -v bbkt >/dev/null 2>&1 || {
    if [ -n "$(repos_for bitbucket)" ]; then
      echo "pr-list: bbkt is not installed; skipping Bitbucket repos" >&2
    fi
    return 0
  }

  local name path raw
  while IFS=$'\t' read -r name path; do
    [ -n "$name" ] || continue
    path="${path/#\~/$HOME}"
    [ -d "$path" ] || continue

    if ! raw=$(cd "$path" && bbkt pr list --json 2>/dev/null); then
      echo "pr-list: bbkt could not list PRs in $name" >&2
      continue
    fi

    # bbkt's own field names, mapped once here so no consumer sees them.
    jq -r --arg repo "$name" '
      (if type == "array" then . else (.values // .pull_requests // []) end)[]
      | {
          repo: $repo,
          slug: $repo,
          number: (.id // .number),
          title: .title,
          url: (.links.self[0].href // .url // ""),
          branch: (.fromRef.displayId // .source.branch.name // ""),
          base: (.toRef.displayId // .destination.branch.name // ""),
          draft: (.draft // false),
          created_at: (
            if (.createdDate | type) == "number" then (.createdDate / 1000 | todate)
            else (.created_at // .createdDate // "")
            end
          ),
        }
    ' <<<"$raw"
  done < <(repos_for bitbucket)
}

{
  from_github
  from_bitbucket
} | jq -s --argjson paths "$(paths_json)" '
  map(
    . + {
      age_days: (
        if (.created_at | length) > 0
        then ((now - (.created_at | fromdateiso8601)) / 86400 | floor)
        else 0
        end
      ),
      path: ($paths[.repo] // ""),
    }
  )
  | sort_by(.created_at)
' | if [ -n "$LANE" ]; then
  # doit's contract, emitted here so the dashboard needs no adapter and no copy
  # of this shape. Thresholds are short on purpose: a PR is meant to be read the
  # day it lands, not eventually.
  jq '{
    schema_version: 1,
    generated_at: (now | todate),
    lanes: [{
      name: "prs",
      title: "PRS",
      meta: (if length == 0 then "none open"
             else "\(length) open · oldest \(map(.age_days) | max)d" end),
      rows: (sort_by(-.age_days) | .[:5] | map({
        label: .repo,
        text: (if .draft then "\(.title) (draft)" else .title end),
        note: "\(.age_days)d",
        urgency: (if .age_days >= 7 then "overdue" elif .age_days >= 3 then "due" else "none" end),
        handle: "prs",
      })),
      grid: [],
      total: length,
      hints: ["prs --list"],
    }]
  }'
else
  cat
fi
