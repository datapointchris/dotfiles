#!/usr/bin/env bash
# Every open PR you have, across the repos the registry names, as JSON.
#
# The one implementation. `fleet prs` calls it, doit's dashboard lane calls it,
# and the `prs` picker calls it — three consumers that were on their way to
# three copies of the same gh query, which would have disagreed the first time
# one of them learned about a second forge.
#
# Lives in dotfiles rather than in fleet because fleet is not installed on every
# machine and this has to be. The registry is: repos.json says which repos exist
# and `provider` says who hosts them, so the same command answers on a box where
# that is GitHub and one where it is Bitbucket.
#
# Grouped by provider, one bulk query per provider that has one. GitHub does, so
# a 79-repo registry still costs a single API call rather than 79. A provider
# without a bulk search falls back to per-repo, which is why bbkt is a loop.
#
# Output is a JSON array, one object per PR, sorted oldest first — the backlog is
# a gauge and age is what it measures.

set -euo pipefail

# $DOTFILES_REPOS_REGISTRY, then repos_registry in dotfiles' own config, which
# the trust overlay deploys — ~/.config/dotfiles/config.toml on the fleet, and the
# same path off it naming a different file. Both rungs, in that order, because
# src/dotfiles/settings.py SHARED_PATHS declares both for this one setting and a
# reader honouring only one of them answers differently from `dotfiles config
# show` while both look right.
#
# The config carries the machine's answer rather than a variable alone: ~/.env is
# a shell file, so an unattended caller sources no profile and saw nothing, which
# is the whole reason the shared $REPOS_JSON came out.
#
# yq rather than a grep, and it is on every machine including the work box. There
# is no fallback to a known location: a default would be the hardcoded path one
# indirection later, and it fails by reading the wrong file rather than by saying
# nothing named one. An unset value leaves REGISTRY empty and the -f test below
# reports it.
DOTFILES_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/config.toml"
REGISTRY="${DOTFILES_REPOS_REGISTRY:-}"
if [ -z "$REGISTRY" ] && [ -f "$DOTFILES_CONFIG" ]; then
  # -oy is not cosmetic: without it yq warns on stderr that its default output
  # format changed, on every single invocation.
  REGISTRY="$(yq -p toml -oy -r '.repos_registry // ""' "$DOTFILES_CONFIG")"
fi
REGISTRY="${REGISTRY/#\~/$HOME}"
LANE=""

die() {
  echo "pr-list: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: pr-list [--registry PATH] [--lane]

Prints every open PR across the registry's repos as a JSON array, oldest first.

Each object: repo, slug, number, title, url, branch, base, draft, created_at,
age_days, path. `branch` is the identifier to type — a number is a per-repo
counter and collides across the registry, whereas `gh` and `bbkt` both accept a
branch anywhere they accept a number. `base` is what the PR targets, so a PR
stacked on another names its parent rather than the default branch. `slug` is
`owner/name` and is the only field that identifies a repository uniquely; `repo`
is a bare basename and can collide with an upstream project. `path` is empty when
the repo is not checked out here, and equally when the checkout of that name turns
out to be a different repository.

--lane emits doit's lane document instead, so `doit dashboard` can read this
directly and no consumer has to carry a copy of the shape.
EOF
}

command -v jq >/dev/null 2>&1 || die "jq is required"
command -v yq >/dev/null 2>&1 || die "yq is required, to read repos_registry from $DOTFILES_CONFIG"

while [ $# -gt 0 ]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
      ;;
    --registry)
      REGISTRY="${2:-}"
      shift 2
      ;;
    --lane)
      LANE=1
      shift
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -n "$REGISTRY" ] || die "nothing names a registry: set repos_registry in $DOTFILES_CONFIG"
[ -f "$REGISTRY" ] || die "no registry at $REGISTRY"

# status is required, so it is matched plainly rather than defaulted. Supplying a
# default here is what let the readers disagree: this one and fleet counted an
# entry with no status, indy and relate dropped it, and every list looked
# plausible. The registry repo rejects an entry without one at commit time.
# Per-repo provider wins over the file's, for a registry that mixes hosts.
repos_for() {
  jq -r --arg want "$1" '
    (.provider // "github") as $default
    | .repos[]
    | select(.status == "active")
    | select((.provider // $default) == $want)
    | [.name, .path] | @tsv
  ' "$REGISTRY"
}

# name → expanded path, for every active repo, so a PR can be opened locally.
paths_json() {
  jq --arg home "$HOME" '
    [ .repos[]
      | select(.status == "active")
      | {key: .name, value: (.path | sub("^~"; $home))}
    ] | from_entries
  ' "$REGISTRY"
}

# origin's owner/name, from either remote spelling. The trailing `[:/]` in the
# pattern is what makes one expression cover both: it eats `git@host:` and
# `https://host/` alike, leaving the last two components.
remote_slug() {
  git -C "$1" remote get-url origin 2>/dev/null \
    | sed -e 's|\.git$||' -e 's|^.*[:/]\([^/]*\)/\([^/]*\)$|\1/\2|' \
    | tr '[:upper:]' '[:lower:]'
}

# slug → path, but only where the checkout of that name really is that repository.
#
# The registry identifies a repo by BASENAME, and the GitHub query searches all of
# GitHub, so a PR you authored against someone else's project of the same name
# resolves to your own clone. `typos` is the live case — the registry holds
# ~/code/typos and `crate-ci/typos` is a real upstream. Handing that row a path is
# worse than handing it nothing: `prs` fetches `pull/<number>/head` from YOUR
# origin, which is a different PR or none, and then diffs whatever it got.
#
# Costed per PR rather than per registry entry, which is what makes the git call
# affordable — this runs for the handful of repos with an open PR, not for all of
# them. That is the objection which sank deriving owners registry-wide.
#
# Bitbucket rows carry a bare name as their slug, since bbkt is repo-scoped and
# already ran inside the checkout. Those are trusted without a remote lookup;
# `*/*` is the test for a slug that actually names an owner.
verified_paths() {
  local rows="$1" paths="$2" slug name path out='{}'

  while IFS=$'\t' read -r slug name; do
    [ -n "$slug" ] || continue
    path=$(jq -r --arg n "$name" '.[$n] // ""' <<<"$paths")
    [ -n "$path" ] || continue

    # A registered path that is not on disk passes straight through, unverified.
    # Nothing can be asked of a checkout that does not exist, and withholding the
    # path here would cost `prs` its more precise "registered at X, which does
    # not exist" — a repo you have not cloned yet, reported as one you have not
    # registered. It is also harmless: that row dies before it can fetch.
    if [ -d "$path" ]; then
      case "$slug" in
        */*) [ "$(remote_slug "$path")" = "$(tr '[:upper:]' '[:lower:]' <<<"$slug")" ] || continue ;;
      esac
    fi

    out=$(jq --arg s "$slug" --arg p "$path" '. + {($s): $p}' <<<"$out")
  done < <(jq -r '.[] | [.slug, .repo] | @tsv' <<<"$rows" | sort -u)

  printf '%s\n' "$out"
}

# GraphQL rather than `gh search prs`, whose field set has no headRefName or
# baseRefName — the branch is simply unreachable through it, and appending the
# flag fails with "Unknown JSON field". The alternative was `gh pr list --json
# headRefName` per repo, which reads better and costs one request per repo; that
# is the fan-out the bulk search exists to avoid. This keeps the single call.
GITHUB_SEARCH='
{
  search(query: "author:@me is:pr is:open", type: ISSUE, first: 100) {
    nodes {
      ... on PullRequest {
        number
        title
        url
        headRefName
        baseRefName
        isDraft
        createdAt
        repository { name nameWithOwner }
      }
    }
  }
}'

# GitHub: one search for everything you authored, then keep what the registry
# names. Searching by author rather than per repo is what makes this one call;
# filtering afterwards is what keeps it honest about scope.
from_github() {
  local names
  names=$(repos_for github | cut -f1)
  [ -n "$names" ] || return 0

  command -v gh >/dev/null 2>&1 || {
    echo "pr-list: gh is not installed; skipping GitHub repos" >&2
    return 0
  }

  local raw
  if ! raw=$(gh api graphql -f query="$GITHUB_SEARCH" 2>&1); then
    echo "pr-list: gh could not list PRs (check 'gh auth status'): ${raw%%$'\n'*}" >&2
    return 0
  fi

  # `type: ISSUE` searches issues and PRs from one index, so a node the inline
  # fragment does not match arrives as `{}`. `is:pr` should prevent it; without
  # the guard one would emit a row of nulls, and a null number is a hard
  # unmarshal failure in fleet rather than a visibly empty row.
  jq -n --argjson prs "$raw" --arg names "$names" '
    ($names | split("\n") | map(select(length > 0))) as $wanted
    | $prs.data.search.nodes[]
    | select(.number != null)
    | select(.repository.name as $n | $wanted | index($n))
    | {
        repo: .repository.name,
        slug: .repository.nameWithOwner,
        number: .number,
        title: .title,
        url: .url,
        branch: .headRefName,
        base: .baseRefName,
        draft: .isDraft,
        created_at: .createdAt,
      }
  '
}

# Bitbucket: bbkt is repo-scoped, so this is a loop by necessity rather than by
# choice. It runs in each checkout because that is how bbkt resolves the repo.
from_bitbucket() {
  command -v bbkt >/dev/null 2>&1 || {
    if [ -n "$(repos_for bitbucket)" ]; then
      echo "pr-list: bbkt is not installed; skipping Bitbucket repos" >&2
    fi
    return 0
  }

  local name path raw
  while IFS=$'\t' read -r name path; do
    [ -n "$name" ] || continue
    path="${path/#\~/$HOME}"
    [ -d "$path" ] || continue

    if ! raw=$(cd "$path" && bbkt pr list --json 2>/dev/null); then
      echo "pr-list: bbkt could not list PRs in $name" >&2
      continue
    fi

    # bbkt's own field names, mapped once here so no consumer sees them.
    jq -r --arg repo "$name" '
      (if type == "array" then . else (.values // .pull_requests // []) end)[]
      | {
          repo: $repo,
          slug: $repo,
          number: (.id // .number),
          title: .title,
          url: (.links.self[0].href // .url // ""),
          branch: (.fromRef.displayId // .source.branch.name // ""),
          base: (.toRef.displayId // .destination.branch.name // ""),
          draft: (.draft // false),
          created_at: (
            if (.createdDate | type) == "number" then (.createdDate / 1000 | todate)
            else (.created_at // .createdDate // "")
            end
          ),
        }
    ' <<<"$raw"
  done < <(repos_for bitbucket)
}

# Two passes, because the path a row deserves depends on the row: the set of
# repositories to verify is not known until the PRs are in hand.
rows=$(
  {
    from_github
    from_bitbucket
  } | jq -s '
    map(
      . + {
        age_days: (
          if (.created_at | length) > 0
          then ((now - (.created_at | fromdateiso8601)) / 86400 | floor)
          else 0
          end
        ),
      }
    )
    | sort_by(.created_at)
  '
)

jq --argjson verified "$(verified_paths "$rows" "$(paths_json)")" '
  map(. + {path: ($verified[.slug] // "")})
' <<<"$rows" | if [ -n "$LANE" ]; then
  # doit's contract, emitted here so the dashboard needs no adapter and no copy
  # of this shape. Thresholds are short on purpose: a PR is meant to be read the
  # day it lands, not eventually.
  jq '{
    schema_version: 1,
    generated_at: (now | todate),
    lanes: [{
      name: "prs",
      title: "PRS",
      meta: (if length == 0 then "none open"
             else "\(length) open · oldest \(map(.age_days) | max)d" end),
      rows: (sort_by(-.age_days) | .[:5] | map({
        label: .repo,
        text: (if .draft then "\(.title) (draft)" else .title end),
        note: "\(.age_days)d",
        urgency: (if .age_days >= 7 then "overdue" elif .age_days >= 3 then "due" else "none" end),
        handle: "prs",
      })),
      grid: [],
      total: length,
      hints: ["prs --list"],
    }]
  }'
else
  cat
fi
