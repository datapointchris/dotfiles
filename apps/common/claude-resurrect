#!/usr/bin/env bash
# claude-resurrect - carry Claude Code sessions across a tmux server restart.
#
# tmux-resurrect restores panes and their working directories, never the
# programs inside them. Adding `claude` to @resurrect-processes does not help:
# resurrect replays the saved command line, and a session id is not in claude's
# argv. It lives in Claude's own registry, so the id is captured while the
# sessions are alive and replayed as `claude --resume` once the panes are back.
#
# The registry is keyed by pid and Claude clears dead entries when a new session
# starts, which is why this snapshots at save time rather than reading the
# registry after a crash. Pane ids (%3) are regenerated by a restore, so the
# sidecar records the index address that resurrect reproduces instead.

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"

show_help() {
  # shellcheck source=/dev/null
  source "$SHELL_DIR/formatting.sh"
  help_header "claude-resurrect" "Carry Claude Code sessions across a tmux restart."
  help_usage "claude-resurrect <save|restore>"

  help_section "Commands"
  help_row "save" "" "Record every live session's id against its pane"
  help_row "restore" "" "Resume each recorded session in the pane it held"

  help_section "Notes"
  help_row "" "" "Driven by @resurrect-hook-post-save-all and -post-restore-all"
  help_row "" "" "restore skips a pane already running something, so it is idempotent"
  help_row "" "" "A pane whose directory no longer matches is left alone"
  help_end
}

# Mirrors tmux-resurrect's own resolution so the sidecar lands beside the
# snapshot it belongs to. resurrect expands a leading ~ in the option value.
sidecar_path() {
  local dir
  dir=$(tmux show-option -gqv '@resurrect-dir' 2>/dev/null || true)
  [[ -n $dir ]] || dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  dir="${dir/#\~/$HOME}"
  printf '%s/claude-sessions.json\n' "$dir"
}

# The registry addresses a pane by id (%3). Those are regenerated when the
# server restarts, so resolve to the index address while the pane still exists.
pane_index_address() {
  tmux display-message -p -t "$1" '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null
}

save_sessions() {
  command -v claude-sessions >/dev/null 2>&1 || return 0

  # Without a server every pane lookup fails, and writing that result would
  # replace a good record with an empty one — losing what a restore needs.
  tmux info >/dev/null 2>&1 || return 0

  local sidecar
  sidecar=$(sidecar_path)
  mkdir -p "$(dirname "$sidecar")"

  local rows=""
  local recorded=0
  local descriptor reference address
  while IFS= read -r descriptor; do
    reference=$(printf '%s' "$descriptor" | jq -r '.tmux')
    address=$(pane_index_address "$reference") || continue
    [[ -n $address ]] || continue
    rows+=$(printf '%s' "$descriptor" | jq -c --arg pane "$address" '{sessionId, name, cwd, pane: $pane}')
    rows+=$'\n'
    recorded=$((recorded + 1))
  done < <(claude-sessions --json 2>/dev/null | jq -c '.[] | select(.tmux != null and .tmux != "-")')

  printf '%s' "$rows" | jq -s '.' >"$sidecar.tmp"
  mv "$sidecar.tmp" "$sidecar"

  if [[ -t 1 ]]; then
    printf 'recorded %s sessions\n' "$recorded"
  fi
}

# A session that was killed before it exchanged anything never wrote a
# transcript, and `claude --resume` on it fails with "No conversation found".
# Searching by name avoids reimplementing Claude's cwd-to-directory encoding,
# which this has no claim on.
transcript_exists() {
  local found
  found=$(fd -HI --max-results 1 "^$1\.jsonl$" "$HOME/.claude/projects" 2>/dev/null)
  [[ -n $found ]]
}

# A pane is only claimed when it is sitting at a shell in the directory the
# session was saved from. Anything else means the layout moved underneath us,
# and resuming there would drop a session into the wrong project.
pane_is_available() {
  local pane=$1 expected_cwd=$2
  local current actual_cwd

  current=$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null) || return 1
  case "$current" in
    bash | zsh | sh | fish | dash) ;;
    *) return 1 ;;
  esac

  actual_cwd=$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null) || return 1
  [[ $actual_cwd == "$expected_cwd" ]]
}

restore_sessions() {
  local sidecar
  sidecar=$(sidecar_path)
  [[ -f $sidecar ]] || return 0

  local resumed=0
  local pane session_id cwd
  while IFS=$'\t' read -r pane session_id cwd; do
    [[ -n $pane && -n $session_id ]] || continue
    pane_is_available "$pane" "$cwd" || continue
    transcript_exists "$session_id" || continue
    tmux send-keys -t "$pane" "claude --resume $session_id" Enter
    resumed=$((resumed + 1))
  done < <(jq -r '.[] | [.pane, .sessionId, .cwd] | @tsv' "$sidecar" 2>/dev/null)

  if [[ -t 1 ]]; then
    printf 'resumed %s sessions\n' "$resumed"
  fi
}

main() {
  case "${1:-}" in
    save) save_sessions ;;
    restore) restore_sessions ;;
    -h | --help | help | '') show_help ;;
    *)
      printf 'claude-resurrect: unknown command %s\n' "$1" >&2
      return 1
      ;;
  esac
}

main "$@"
