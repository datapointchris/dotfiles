#!/usr/bin/env bash
# claude-resurrect - resume a Claude Code session here, from the warehouse's copy.
#
# `claude --resume` reads only a transcript on this box. Where a warehouse holds
# every box's sessions and its restore command is installed, a session this box
# lacks, or holds only the start of, is rebuilt from it first. A tmux restart
# needs none of this: tmux-restore saves each pane's `claude --resume <id>`, and
# the transcript is already here.

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"

show_help() {
  # shellcheck source=/dev/null
  source "$SHELL_DIR/formatting.sh"
  help_header "claude-resurrect" "Resume a Claude Code session here, from the warehouse's copy."
  help_usage "claude-resurrect resume <session-id>"

  help_section "Commands"
  help_row "resume" "<session-id>" "Bring one session up to the warehouse's copy, then resume it here"

  help_section "Notes"
  help_row "" "" "resume always asks the warehouse, so a copy here takes turns added on another box"
  help_row "" "" "resume takes a full session id, and falls back to the copy here"
  help_end
}

# A session that was killed before it exchanged anything never wrote a
# transcript, and `claude --resume` on it fails with "No conversation found".
# Searching by name avoids reimplementing Claude's cwd-to-directory encoding,
# which this has no claim on.
transcript_exists() {
  local found
  found=$(fd -HI --max-results 1 "^$1\.jsonl$" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" 2>/dev/null)
  [[ -n $found ]]
}

# Writes what the warehouse holds of a session where claude looks for it. A copy
# here holding only the start of the warehouse's is extended; any other file here
# is kept. It exits 1 where any file stayed unwritten, so callers ask
# transcript_exists whether the session itself arrived.
restore_from_warehouse() {
  command -v fleet >/dev/null 2>&1 || return 1
  fleet machine claude-sessions restore "$1"
}

# The restore runs even where a transcript is here, because a copy here may hold
# only the turns before the session moved to another box. Where the warehouse is
# unreachable or holds nothing yet, the copy here is resumed as it stands.
resume_session() {
  local session_id=${1:-}
  if [[ ! $session_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    printf 'claude-resurrect: resume needs a full session id, as 7c904dcd-10cb-4713-8e81-3433a18197ef\n' >&2
    return 2
  fi
  restore_from_warehouse "$session_id" || true
  if ! transcript_exists "$session_id"; then
    printf 'claude-resurrect: no transcript of %s to resume\n' "$session_id" >&2
    return 1
  fi
  exec claude --permission-mode bypassPermissions --resume "$session_id"
}

main() {
  case "${1:-}" in
    resume) resume_session "${2:-}" ;;
    -h | --help | help | '') show_help ;;
    *)
      printf 'claude-resurrect: unknown command %s\n' "$1" >&2
      return 1
      ;;
  esac
}

main "$@"
