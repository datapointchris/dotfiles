#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""menu-dashboard - the human single pane of glass. Invoked as `menu dashboard`.

Answers "what is outstanding across everything?" in one glance: open tasks,
habits still due, what you're learning, what you're reading, maintenance due, the
next project items, and what's approaching.

Lanes, not a merged list. Each lane is independently ordered by its own backend
and you pick one by time and energy — there is no cross-source ranking, no
scoring, and no metrics, because a single ordering over unlike things would be
invented rather than meaningful.

This is a renderer, nothing more. Every backend speaks `--json` and owns its own
domain rules (which book is next, which habit is due today, when a Lab is
overdue); the dashboard only lays out what they return. That is why it needs no
dependencies and no knowledge of any app's semantics.

Not to be confused with `forge brief`, which is the dev brief across *repos* for
a coding session. Same plumbing, different audience — see ~/dev/vision.md.
"""

import argparse
import json
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from dataclasses import field
from datetime import date
from datetime import datetime
from enum import StrEnum
from pathlib import Path

# menu-dashboard is symlinked onto PATH; resolve the real path so the repo-root
# menucore package (shared with menu-review and menu-labs) is importable.
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from menucore import CYAN
from menucore import DIM
from menucore import GREEN
from menucore import RED
from menucore import RESET
from menucore import YELLOW

# One call per backend, run concurrently. `icb overview` and `learning overview`
# are composites on their side precisely so this stays one call each.
BACKENDS = {
    "icb": ["icb", "overview", "--json"],
    "learning": ["learning", "overview", "--json"],
    "review": ["menu-review", "list", "--json"],
    "labs": ["menu-labs", "list", "--json"],
}

# Generous against a measured happy path of well under a second. Because the
# backends run in parallel this is also the worst-case total, not a per-backend
# penalty.
BACKEND_TIMEOUT_SECONDS = 5.0

# The dashboard is a glance: three rows a lane, or ten when you asked for that
# one lane specifically.
ROW_CAP = 3
FOCUSED_ROW_CAP = 10

# The `icb overview` schema this build understands. A newer one is reported
# rather than half-read: dotfiles and ichrisbirch install independently.
ICB_SCHEMA_VERSION = 1

MAX_WIDTH = 100
LABEL_WIDTH = 8
NOTE_WIDTH = 22

# How many habit names the single due row spells out before summarising.
HABITS_NAMED = 4

# How many queued books to list; the rest of the pile is a count in the heading.
READING_QUEUE_ROWS = 3


class BackendFailure(StrEnum):
    NOT_INSTALLED = "not-installed"
    TIMED_OUT = "timed-out"
    FAILED = "failed"
    UNREADABLE = "unreadable"


@dataclass(frozen=True)
class JsonResult:
    """What one backend call produced — facts only, no interpretation."""

    payload: object | None = None
    exit_code: int | None = None
    stderr: str = ""
    failure: BackendFailure | None = None
    timeout: float | None = None


@dataclass(frozen=True)
class Row:
    label: str
    text: str
    note: str = ""


@dataclass
class LaneView:
    name: str
    title: str
    meta: str = ""
    rows: list[Row] = field(default_factory=list)
    total: int = 0
    hint: str = ""
    reason: str = ""
    available: bool = True


def run_json(command: list[str], timeout: float) -> JsonResult:
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except FileNotFoundError:
        return JsonResult(failure=BackendFailure.NOT_INSTALLED)
    except subprocess.TimeoutExpired:
        return JsonResult(failure=BackendFailure.TIMED_OUT, timeout=timeout)

    stderr = completed.stderr.strip()
    if completed.returncode != 0:
        return JsonResult(exit_code=completed.returncode, stderr=stderr, failure=BackendFailure.FAILED)
    try:
        return JsonResult(payload=json.loads(completed.stdout), exit_code=0, stderr=stderr)
    except json.JSONDecodeError:
        return JsonResult(exit_code=0, stderr=stderr, failure=BackendFailure.UNREADABLE)


def first_line(text: str) -> str:
    return text.strip().splitlines()[0] if text.strip() else ""


def backend_reason(name: str, result: JsonResult | None) -> str:
    """Turn a failed call into one actionable line."""
    if result is None:
        return f"{name} was not queried"
    if result.failure is BackendFailure.NOT_INSTALLED:
        return f"{name} is not installed on this machine"
    if result.failure is BackendFailure.TIMED_OUT:
        return f"{name} timed out after {result.timeout:g}s"
    if result.failure is BackendFailure.UNREADABLE:
        return f"{name} returned unreadable --json output"
    if result.failure is BackendFailure.FAILED:
        # Exit 2 is reserved for usage errors across these CLIs, so a rejected
        # `overview` means the installed binary predates the command.
        if result.exit_code == 2:
            return f"installed {name} predates `overview` — reinstall it"
        return first_line(result.stderr) or f"{name} exited {result.exit_code}"
    return ""


def fetch_backends(names: list[str], timeout: float) -> dict[str, JsonResult]:
    commands = {name: BACKENDS[name] for name in names}
    with ThreadPoolExecutor(max_workers=max(1, len(commands))) as pool:
        futures = {name: pool.submit(run_json, command, timeout) for name, command in commands.items()}
        return {name: future.result() for name, future in futures.items()}


def icb_context(results: dict[str, JsonResult], sections: tuple[str, ...]) -> tuple[dict | None, str]:
    """The icb payload plus any reason the given sections are degraded.

    A payload is refused outright only when the call failed or its schema is
    newer than this build understands. A section-keyed warning still returns the
    payload: that lane degrades, the rest of the snapshot does not.
    """
    result = results.get("icb")
    if result is None or result.payload is None:
        return None, backend_reason("icb", result)

    payload = result.payload
    if not isinstance(payload, dict):
        return None, "icb returned unreadable --json output"

    version = payload.get("schema_version", 0)
    if version > ICB_SCHEMA_VERSION:
        return None, f"icb overview schema v{version} is newer than this dashboard — update dotfiles"

    for warning in payload.get("warnings") or []:
        if warning.get("section") in sections:
            return payload, warning.get("message", "")
    return payload, ""


def unavailable(name: str, title: str, reason: str) -> LaneView:
    return LaneView(name=name, title=title, reason=reason, available=False)


def build_tasks_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    payload, reason = icb_context(results, ("tasks",))
    if payload is None:
        return unavailable("tasks", "TASKS", reason)

    section = payload.get("tasks") or {}
    items = section.get("items") or []
    total = section.get("total", len(items))
    rows = [Row(str(task.get("priority", "")), task.get("name", ""), task.get("category", "")) for task in items]
    return LaneView(
        name="tasks",
        title="TASKS",
        meta=f"{total} open",
        rows=rows,
        total=total,
        hint="icb tasks todo",
        reason=reason,
    )


def build_habits_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    payload, reason = icb_context(results, ("habits",))
    if payload is None:
        return unavailable("habits", "HABITS", reason)

    section = payload.get("habits") or {}
    due = section.get("due_today") or []
    done = section.get("completed_today") or []
    current_total = section.get("current_total", len(due) + len(done))

    # One row, not one per habit: a dozen single-name rows would swamp every
    # other lane, and which habits are outstanding reads fine as a list.
    rows = []
    if due:
        names = [habit.get("name", "") for habit in due]
        shown = names[:HABITS_NAMED]
        remainder = f" +{len(names) - len(shown)} more" if len(names) > len(shown) else ""
        rows.append(Row("due", " · ".join(shown) + remainder))
    return LaneView(
        name="habits",
        title="HABITS",
        meta=f"{len(done)} of {current_total} done today",
        rows=rows,
        total=len(rows),
        hint="icb habits list --current",
        reason=reason,
    )


def build_reading_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    payload, reason = icb_context(results, ("reading",))
    if payload is None:
        return unavailable("reading", "READING", reason)

    section = payload.get("reading") or {}
    reading = section.get("reading") or []
    next_up = section.get("next_up") or []
    article = section.get("current_article")

    # Only a few of the queue are worth listing: the rest is reported as a count
    # below, and letting the row total track icb's --limit would make the "N
    # more" line an artifact of an unrelated backend cap.
    rows = round_robin(
        [Row("reading", book.get("title", ""), book.get("author", "")) for book in reading],
        [Row("next", book.get("title", ""), book.get("author", "")) for book in next_up[:READING_QUEUE_ROWS]],
        [Row("article", article.get("title", ""))] if article else [],
    )
    # The unread pile is a standing backlog, not a thing to be behind on, so it
    # is reported as context rather than as rows you failed to get to.
    queued = section.get("next_up_total", len(next_up))
    return LaneView(
        name="reading",
        title="READING",
        meta=f"{len(reading)} reading · {queued} queued",
        rows=rows,
        total=len(rows),
        hint="icb books list --ownership owned",
        reason=reason,
    )


def build_projects_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    payload, reason = icb_context(results, ("project_items",))
    if payload is None:
        return unavailable("projects", "PROJECTS", reason)

    section = payload.get("project_items") or {}
    next_items = section.get("next") or []
    blocked = section.get("blocked") or []
    next_total = section.get("next_total", len(next_items))
    blocked_total = section.get("blocked_total", len(blocked))

    rows = [Row("next", item.get("title", "")) for item in next_items]
    rows += [Row("blocked", item.get("title", "")) for item in blocked]
    return LaneView(
        name="projects",
        title="PROJECTS",
        meta=f"{next_total} next · {blocked_total} blocked",
        rows=rows,
        total=next_total + blocked_total,
        hint="icb items list",
        reason=reason,
    )


def build_upcoming_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    payload, reason = icb_context(results, ("countdowns", "events"))
    if payload is None:
        return unavailable("upcoming", "UPCOMING", reason)

    countdowns = payload.get("countdowns") or {}
    events = payload.get("events") or {}

    entries = []
    for countdown in countdowns.get("items") or []:
        entries.append((countdown.get("due_date", ""), countdown.get("name", ""), "countdown"))
    for event in events.get("items") or []:
        entries.append((event_date(event.get("date", "")), event.get("name", ""), "event"))
    entries.sort(key=lambda entry: entry[0])

    rows = [Row(relative_day(due, today), name, kind) for due, name, kind in entries]
    total = countdowns.get("total", 0) + events.get("total", 0)
    return LaneView(
        name="upcoming",
        title="UPCOMING",
        rows=rows,
        total=total,
        hint="icb countdowns list",
        reason=reason,
    )


def build_learning_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    result = results.get("learning")
    if result is None or not isinstance(result.payload, dict):
        return unavailable("learning", "LEARNING", backend_reason("learning", result))

    payload = result.payload
    section = payload.get("current_section") or {}
    rows = []
    meta = ""
    if section:
        progress = section.get("progress") or {}
        completed = progress.get("completed_items", 0)
        total_items = progress.get("total_items", 0)
        meta = f"{section.get('name', '')} · {completed}/{total_items}"

    track_rows = []
    for track in payload.get("tracks") or []:
        unit = (track.get("current_unit") or {}).get("name")
        if not unit:
            continue
        progress = track.get("progress") or {}
        note = f"{progress.get('completed_items', 0)}/{progress.get('total_items', 0)}"
        track_rows.append(Row("track", f"{track.get('display_name', '')} — {unit}", note))

    in_progress = [Row("doing", resource.get("title", "")) for resource in payload.get("in_progress_resources") or []]
    rows = round_robin(in_progress, track_rows)

    return LaneView(
        name="learning",
        title="LEARNING",
        meta=meta,
        rows=rows,
        total=len(rows),
        hint="learning overview",
    )


def build_maintenance_lane(results: dict[str, JsonResult], today: date) -> LaneView:
    review = results.get("review")
    labs = results.get("labs")

    rows = []
    reasons = []
    review_due = 0
    labs_due = 0

    if isinstance(review.payload if review else None, list):
        for item in review.payload:
            if is_due_row(item):
                review_due += 1
                rows.append(Row("review", item.get("id", ""), overdue_note(item)))
    else:
        reasons.append(backend_reason("menu-review", review))

    if isinstance(labs.payload if labs else None, list):
        for item in labs.payload:
            if item.get("scheduled") and is_due_row(item):
                labs_due += 1
                rows.append(Row("lab", item.get("id", ""), overdue_note(item)))
    else:
        reasons.append(backend_reason("menu-labs", labs))

    if len(reasons) == 2:
        return unavailable("maintenance", "MAINTENANCE", "; ".join(reasons))

    rows.sort(key=lambda row: row.note)
    return LaneView(
        name="maintenance",
        title="MAINTENANCE",
        meta=f"{review_due} review · {labs_due} lab due",
        rows=rows,
        total=len(rows),
        hint="menu review · menu labs",
        reason="; ".join(reasons),
    )


def round_robin(*groups: list[Row]) -> list[Row]:
    """Order rows so every kind gets a slot before any kind gets a second one.

    The row cap is deliberately small, so a straight concatenation would let one
    kind fill the lane: three books in progress would hide what is next, which is
    the least useful ordering of exactly the same rows.
    """
    ordered = []
    for index in range(max((len(group) for group in groups), default=0)):
        for group in groups:
            if index < len(group):
                ordered.append(group[index])
    return ordered


def is_due_row(item: dict) -> bool:
    """A row is due when it has never been done, or is at/past its due date.

    Mirrors menucore.is_due over the `overdue` field the backends already
    computed — the dashboard never re-derives a cadence itself.
    """
    overdue = item.get("overdue")
    return overdue is None or overdue >= 0


def overdue_note(item: dict) -> str:
    overdue = item.get("overdue")
    if overdue is None:
        return "never done"
    if overdue == 0:
        return "due today"
    return f"overdue {overdue}d"


def event_date(timestamp: str) -> str:
    """The calendar date of an RFC3339 event timestamp, for sorting alongside
    countdowns, which carry a bare date."""
    try:
        return datetime.fromisoformat(timestamp).astimezone().date().isoformat()
    except ValueError:
        return timestamp[:10]


def relative_day(due: str, today: date) -> str:
    """A gutter-width label. Beyond a season out, days stop meaning anything and
    the exact day is noise, so it degrades to the month."""
    try:
        delta = (date.fromisoformat(due) - today).days
    except ValueError:
        return due
    if delta <= 0:
        return "today"
    if delta <= 90:
        return f"in {delta}d"
    return due[:7]


LANE_BUILDERS = (
    ("tasks", ("icb",), build_tasks_lane),
    ("habits", ("icb",), build_habits_lane),
    ("learning", ("learning",), build_learning_lane),
    ("reading", ("icb",), build_reading_lane),
    ("maintenance", ("review", "labs"), build_maintenance_lane),
    ("projects", ("icb",), build_projects_lane),
    ("upcoming", ("icb",), build_upcoming_lane),
)

LANE_NAMES = [name for name, _, _ in LANE_BUILDERS]


def backends_for(lane_names: list[str]) -> list[str]:
    """Only the backends the selected lanes actually need, so `--lane tasks`
    makes exactly one call."""
    needed = []
    for name, backends, _ in LANE_BUILDERS:
        if name not in lane_names:
            continue
        for backend in backends:
            if backend not in needed:
                needed.append(backend)
    return needed


def build_lanes(results: dict[str, JsonResult], today: date, lane_names: list[str]) -> list[LaneView]:
    return [build(results, today) for name, _, build in LANE_BUILDERS if name in lane_names]


def terminal_width() -> int:
    return min(shutil.get_terminal_size(fallback=(80, 24)).columns, MAX_WIDTH)


def clip(text: str, width: int) -> str:
    if width <= 0:
        return ""
    return text if len(text) <= width else text[: width - 1] + "…"


def render_lanes(lanes: list[LaneView], today: date, row_cap: int) -> None:
    width = terminal_width()
    print(f"{CYAN}Dashboard{RESET} {DIM}· {today.strftime('%a %d %b')}{RESET}")
    print(f"{CYAN}{'━' * width}{RESET}")

    for lane in (lane for lane in lanes if lane.available):
        render_lane(lane, width, row_cap)

    degraded = [lane for lane in lanes if not lane.available]
    if degraded:
        print()
        for lane in degraded:
            print(f"  {YELLOW}{lane.name:<12}{RESET}{DIM}unavailable — {lane.reason}{RESET}")


def render_lane(lane: LaneView, width: int, row_cap: int) -> None:
    heading = f"\n{CYAN}{lane.title}{RESET}"
    if lane.meta:
        heading += f"  {DIM}{lane.meta}{RESET}"
    print(heading)

    if not lane.rows:
        print(f"  {DIM}—{RESET}")
    else:
        note_width = NOTE_WIDTH if any(row.note for row in lane.rows) else 0
        text_width = max(20, width - 3 - LABEL_WIDTH - (note_width + 1 if note_width else 0))
        for row in lane.rows[:row_cap]:
            label = f"{YELLOW}{row.label:<{LABEL_WIDTH}}{RESET}"
            text = clip(row.text, text_width)
            # A row without a note gets no padding and no colour codes, so the
            # line ends where its text does rather than in trailing escapes.
            if not row.note:
                print(f"  {label} {text}")
                continue
            colour = RED if row.note.startswith("overdue") or row.note == "never done" else DIM
            print(f"  {label} {text:<{text_width}} {colour}{clip(row.note, note_width)}{RESET}")

    more = lane.total - min(len(lane.rows), row_cap)
    if more > 0 or lane.hint:
        trailer = f"… {more} more · " if more > 0 else ""
        print(f"  {DIM}{trailer}{lane.hint}{RESET}")
    if lane.reason:
        print(f"  {YELLOW}partial — {lane.reason}{RESET}")


def lanes_as_json(lanes: list[LaneView], today: date, row_cap: int) -> str:
    payload = {
        "generated_at": datetime.now().isoformat(timespec="seconds"),
        "lanes": [
            {
                "name": lane.name,
                "title": lane.title,
                "meta": lane.meta,
                "status": "ok" if lane.available else "unavailable",
                "reason": lane.reason or None,
                "rows": [{"label": row.label, "text": row.text, "note": row.note} for row in lane.rows],
                "total": lane.total,
                "more": max(0, lane.total - min(len(lane.rows), row_cap)),
            }
            for lane in lanes
        ],
    }
    return json.dumps(payload, indent=2)


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="menu dashboard",
        description="Everything outstanding across your apps, in lanes.",
    )
    parser.add_argument(
        "--lane",
        action="append",
        choices=LANE_NAMES,
        metavar="NAME",
        help=f"Show only this lane (repeatable): {', '.join(LANE_NAMES)}",
    )
    parser.add_argument("--json", action="store_true", help="Output the lane model as JSON")
    parser.add_argument(
        "--timeout",
        type=float,
        default=BACKEND_TIMEOUT_SECONDS,
        help=f"Seconds to wait for each backend (default {BACKEND_TIMEOUT_SECONDS:g})",
    )
    return parser.parse_args(argv)


def main() -> int:
    args = parse_args(sys.argv[1:])
    lane_names = args.lane or LANE_NAMES
    # Asking for one lane means you want to see it, not glance at it.
    row_cap = FOCUSED_ROW_CAP if args.lane else ROW_CAP

    results = fetch_backends(backends_for(lane_names), args.timeout)
    today = date.today()
    lanes = build_lanes(results, today, lane_names)

    if args.json:
        print(lanes_as_json(lanes, today, row_cap))
    else:
        render_lanes(lanes, today, row_cap)
    # A read-only glance always succeeds: degradation is shown per lane, and a
    # consumer of --json checks lanes[].status rather than the exit code.
    return 0


if __name__ == "__main__":
    sys.exit(main())
