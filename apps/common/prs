#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["rich>=13.0.0"]
# ///
"""Pick one of your open PRs, from anywhere, and open its diff to read.

    prs              pick one and open it in a tmux window
    prs list         print them instead, one row each

Lives in dotfiles rather than in fleet because every machine has this and only
some have fleet. The data comes from `pr-list`, the one place that knows how to
ask a provider for PRs; this is the renderer, the picker and the window.

Fetches, never checks out. `gh pr checkout` switches branches, which aborts
outright when the repo has uncommitted work and disturbs it when it does not —
for reading, that is all cost. Check it out yourself to run the code.

nvim listens on a socket so a Claude split into the window can be asked what is
under the cursor. That session did not write the code, which is exactly why it
is the right one to ask.

Python rather than shell because the work here is arithmetic: measuring cells,
padding columns and colouring them. The previous version did that in jq inside a
heredoc, where there is no padding primitive and a string repeated zero times
comes back as null. fzf is still the picker — it is the picker everywhere else on
this machine, and a reimplementation would be a worse one that also had to be
maintained.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

from rich.console import Console
from rich.text import Text

# Days before a PR reads as stale, then as ignored. A PR is meant to be read the
# day it lands, so both are short on purpose.
AGEING = 3
STALE = 7

# One glyph per status column, always the same character, coloured by state. A
# tick for approved beside a cross for changes-requested reads better and aligns
# worse: nothing guarantees two different glyphs the same cell width, so a row
# differing only in review state would sit a column off from the one above it.
CHECKS_GLYPH = '●'
REVIEW_GLYPH = '◆'

CHECK_STYLES = {'SUCCESS': 'green', 'FAILURE': 'red', 'ERROR': 'red'}
REVIEW_STYLES = {'APPROVED': 'green', 'CHANGES_REQUESTED': 'red', 'REVIEW_REQUIRED': 'cyan'}

LEGEND = f'{CHECKS_GLYPH} checks   {REVIEW_GLYPH} review   green ok · red blocked · dim none yet'


@dataclass(frozen=True)
class PullRequest:
    """One open PR, as `pr-list` reports it.

    `slug` is `owner/name` and identifies the repository; `repo` is the bare
    basename and is a label. The two are not interchangeable — pr-list searches
    all of GitHub and filters to the registry, so a PR you authored upstream in
    someone else's project can arrive under a `repo` that matches one of yours.

    The three diff counts are None, never 0, from a provider that does not report
    them. A PR nobody counted is not a PR that changed nothing.
    """

    repo: str
    slug: str
    number: int
    title: str
    branch: str
    base: str
    draft: bool
    age_days: int
    path: str
    additions: int | None
    deletions: int | None
    changed_files: int | None
    review: str
    checks: str

    @classmethod
    def from_json(cls, row: dict) -> PullRequest:
        return cls(
            repo=row['repo'],
            slug=row['slug'],
            number=row['number'],
            title=row['title'],
            branch=row['branch'],
            base=row['base'],
            draft=row['draft'],
            age_days=row['age_days'],
            path=row['path'],
            additions=row.get('additions'),
            deletions=row.get('deletions'),
            changed_files=row.get('changed_files'),
            review=row.get('review') or '',
            checks=row.get('checks') or '',
        )


def fetch() -> list[PullRequest]:
    """Every open PR the registry knows about. Raises if `pr-list` fails."""
    result = subprocess.run(['pr-list'], capture_output=True, text=True, check=True)
    return [PullRequest.from_json(row) for row in json.loads(result.stdout)]


def stack_parents(prs: list[PullRequest]) -> dict[tuple[str, str], int]:
    """`(slug, branch) -> number`, so a PR targeting another can name its parent.

    What counts as stacked is read out of the listing — a base that is some other
    open PR's head — because pr-list reports no default branch, so testing base
    against a literal "main" would mark every row of a repo defaulting to master.

    Keyed on slug and branch together rather than on branch alone. Branch names
    recur across a registry, and pairing two repos' `session-refresh` would
    invent a stack that does not exist.
    """
    return {(pr.slug, pr.branch): pr.number for pr in prs if pr.branch}


def age_cell(pr: PullRequest) -> Text:
    style = 'red' if pr.age_days >= STALE else 'yellow' if pr.age_days >= AGEING else 'dim'
    return Text(f'{pr.age_days}d', style=style)


def diff_cell(pr: PullRequest) -> Text:
    """Files changed, then the two counts. A dash when the provider reports none.

    Every style goes on its own span, never on the `Text` itself. A base style is
    merged into each span rather than overridden, so a base of `dim` here renders
    the additions dim green — which is the one colour on the row that has to
    carry at a glance.
    """
    if pr.additions is None:
        return Text('—', style='dim')
    cell = Text()
    cell.append(f'{pr.changed_files}f ', style='dim')
    cell.append(f'+{pr.additions}', style='green')
    cell.append(' ')
    cell.append(f'-{pr.deletions}', style='red')
    return cell


def branch_cell(pr: PullRequest, parents: dict[tuple[str, str], int]) -> Text:
    """The branch, and the PR it is stacked on where there is one.

    The marker sits inside this cell rather than in a column of its own, which
    would cost every row the width to say something about a handful. The parent
    shows as its number — two long branch names in one cell is the unreadable
    version.
    """
    cell = Text()
    cell.append(pr.branch or '-', style='blue')
    parent = parents.get((pr.slug, pr.base))
    if parent is not None and parent != pr.number:
        # One space, never two. Columns are separated by a run of two, so a wider
        # gap here reads as a column boundary and the marker becomes a field of
        # its own — which is what pushes the title out of the picker's view.
        cell.append(f' ← #{parent}', style='yellow')
    return cell


def title_cell(pr: PullRequest) -> Text:
    if pr.draft:
        return Text(f'{pr.title} (draft)', style='dim')
    return Text(pr.title)


def status_cell(pr: PullRequest) -> Text:
    """CI on the left, review on the right. Dim means nothing has happened yet.

    An unrecognised check state is yellow rather than dim: GitHub adds rollup
    states, and a new one is in flight, not absent.
    """
    checks = CHECK_STYLES.get(pr.checks, 'dim' if not pr.checks else 'yellow')
    cell = Text()
    cell.append(CHECKS_GLYPH, style=checks)
    cell.append(REVIEW_GLYPH, style=REVIEW_STYLES.get(pr.review, 'dim'))
    return cell


def compose(prs: list[PullRequest], *, header: bool = False) -> list[Text]:
    """One `Text` per PR, columns aligned across the whole set.

    Widths are measured on `cell_len`, which counts what a terminal draws rather
    than how many characters there are. Padding on `len` is what puts an em dash
    or a wide glyph a column out.

    The title is last and unbounded. Everything before it is a field you retype,
    and the truncated end of a row must never be one of those.

    The header is measured with the rows rather than printed separately, which is
    the only way a label and its column stay the same width. The picker asks for
    none: fzf carries its own, where it does not become a selectable row.
    """
    parents = stack_parents(prs)
    columns = [
        [status_cell(pr) for pr in prs],
        [Text(pr.repo, style='cyan') for pr in prs],
        [Text(f'#{pr.number}', style='yellow') for pr in prs],
        [diff_cell(pr) for pr in prs],
        [age_cell(pr) for pr in prs],
        [branch_cell(pr, parents) for pr in prs],
        [title_cell(pr) for pr in prs],
    ]
    if header:
        # `ST` is two cells wide, exactly like the two glyphs beneath it, so the
        # label costs the row nothing.
        labels = ('ST', 'REPO', 'PR', 'DIFF', 'AGE', 'BRANCH', 'TITLE')
        for column, label in zip(columns, labels, strict=True):
            column.insert(0, Text(label, style='bold'))
    # The quantities right-align, so the digits stack: a ragged `#7` under `#118`
    # reads as a different field, and `-2` under `-386` hides the magnitude that
    # is the only reason the column is there.
    right_aligned = {2, 3, 4}
    widths = [max(cell.cell_len for cell in column) for column in columns]

    rows = []
    for index in range(len(columns[0])):
        row = Text()
        for position, column in enumerate(columns):
            cell = column[index].copy()
            padding = widths[position] - cell.cell_len
            if position in right_aligned:
                row.append(' ' * padding)
                row.append(cell)
            else:
                row.append(cell)
                # No padding after the last column: trailing spaces would widen
                # every fzf row to the longest title and scroll the short ones.
                if position < len(columns) - 1:
                    row.append(' ' * padding)
            if position < len(columns) - 1:
                row.append('  ')
        rows.append(row)
    return rows


def to_lines(rows: list[Text], *, color: bool) -> list[str]:
    """Rendered rows, with the escape codes in or stripped out.

    Colour is a parameter rather than a call to `isatty` in here, so the caller
    that knows whether it is writing to a pipe is the one that decides.
    """
    console = Console(force_terminal=color, no_color=not color, width=10_000, soft_wrap=True)
    with console.capture() as captured:
        for row in rows:
            console.print(row)
    return captured.get().rstrip('\n').split('\n')


def empty_state(*, interactive: bool) -> int:
    """Not a failure: pr-list read every repo in the registry and found none.

    The pause is what makes the answer readable at all. This normally runs as
    `display-popup -E`, which tears the popup down the instant the command exits,
    so a line printed on the way out flashes past and the keybinding reads as
    dead.
    """
    print('No open PRs across the registry.')
    print('  pr-list  prints the listing this reads')
    if interactive:
        input('press enter to close ')
    return 0


def cmd_list(prs: list[PullRequest], *, color: bool) -> int:
    for line in to_lines(compose(prs, header=True), color=color):
        print(line)
    return 0


def pick(prs: list[PullRequest]) -> PullRequest | None:
    """Run fzf over the rendered rows and return the chosen PR.

    The index leads in a hidden field, so the choice survives a title containing
    a tab or a leading number, and nothing has to be matched back by name.

    No `--height`: this fills whatever it is given, which is the tmux popup when
    it runs from a keybinding and the terminal when it does not. Size belongs to
    the caller, in one place.
    """
    lines = to_lines(compose(prs), color=True)
    stdin = '\n'.join(f'{index}\t{line}' for index, line in enumerate(lines))
    label = f' open PRs · {len(prs)} '
    result = subprocess.run(
        [
            'fzf',
            '--ansi',
            '--delimiter=\t',
            '--with-nth=2',
            '--no-sort',
            '--reverse',
            '--border=rounded',
            f'--border-label={label}',
            f'--header={LEGEND}',
            '--prompt=pr ❯ ',
            '--pointer=▸',
        ],
        input=stdin,
        capture_output=True,
        text=True,
        check=False,
    )
    chosen = result.stdout.strip()
    if not chosen:
        return None
    return prs[int(chosen.split('\t')[0])]


def open_review(pr: PullRequest) -> int:
    """Fetch the PR ref and open its diff in a new tmux window."""
    if not pr.path:
        return fail(f'{pr.repo} is not checked out on this machine')
    checkout = Path(pr.path)
    if not checkout.is_dir():
        return fail(f'{pr.repo} is registered at {checkout}, which does not exist')

    # The base comes from the listing rather than from the default branch: a PR
    # stacked on another targets its parent, and diffing that against main shows
    # both as one change. The local lookup stays for a provider whose listing
    # does not report a base.
    base = pr.base or default_branch(checkout)
    if not base:
        return fail(f'could not work out what PR #{pr.number} is based on')

    ref = f'refs/remotes/origin/pr/{pr.number}'
    if not git(checkout, 'fetch', '--quiet', '--force', 'origin', f'pull/{pr.number}/head:{ref}'):
        return fail(f'could not fetch PR #{pr.number} in {pr.repo}')
    git(checkout, 'fetch', '--quiet', 'origin', base)
    if not git(checkout, 'rev-parse', '--verify', '--quiet', f'origin/{base}'):
        return fail(f'{pr.repo} has no origin/{base} to diff against')

    socket = Path(tempfile.gettempdir()) / f'fleet-pr-{pr.repo}-{pr.number}.sock'
    socket.unlink(missing_ok=True)

    # Three-dot: from where the branch diverged to its tip, which is what the
    # forge shows. Two-dot would render commits the base gained since branching
    # as changes this PR reverted.
    subprocess.run(
        [
            'tmux',
            'new-window',
            '-n',
            f'pr {pr.repo} #{pr.number}',
            '-c',
            str(checkout),
            f"nvim --listen '{socket}' -c 'DiffviewOpen origin/{base}...{ref}'",
        ],
        check=True,
    )
    return 0


def default_branch(checkout: Path) -> str:
    head = git_output(checkout, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD')
    return head.removeprefix('origin/')


def git(checkout: Path, *args: str) -> bool:
    return subprocess.run(['git', '-C', str(checkout), *args], capture_output=True, text=True, check=False).returncode == 0


def git_output(checkout: Path, *args: str) -> str:
    result = subprocess.run(['git', '-C', str(checkout), *args], capture_output=True, text=True, check=False)
    return result.stdout.strip()


def fail(message: str) -> int:
    print(f'prs: {message}', file=sys.stderr)
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog='prs',
        description='Pick an open PR and open its diff in a tmux window.',
        epilog='With no arguments, opens the picker. Needs tmux, which is where the review window goes.',
    )
    # A verb rather than a flag, because `list` is the fleet's word for the set
    # and a flag that switches the whole act is a subcommand wearing a disguise.
    subcommands = parser.add_subparsers(dest='command', metavar='[list]')
    subcommands.add_parser('list', help='print every open PR as a table instead of picking one')
    arguments = parser.parse_args()

    if not shutil.which('pr-list'):
        return fail('pr-list is required')

    try:
        prs = fetch()
    except subprocess.CalledProcessError as error:
        return fail(f'pr-list failed: {error.stderr.strip() or error}')

    if arguments.command == 'list':
        if not prs:
            print('No open PRs across the registry.')
            return 0
        return cmd_list(prs, color=sys.stdout.isatty())

    if not prs:
        return empty_state(interactive=sys.stdin.isatty())

    # Only the picker path needs these. `--list` is readable on a machine with no
    # tmux and no editor, and refusing to print there would be refusing to answer
    # a question that was fully answerable.
    if not os.environ.get('TMUX'):
        return fail('not inside tmux — this opens a review window')
    for tool in ('fzf', 'nvim', 'git'):
        if not shutil.which(tool):
            return fail(f'{tool} is required')

    chosen = pick(prs)
    if chosen is None:
        return 0
    return open_review(chosen)


if __name__ == '__main__':
    sys.exit(main())
