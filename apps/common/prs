# Days before a PR reads as stale, then as ignored. A PR is meant to be read the
# day it lands, so both are short on purpose.
AGEING = 3
STALE = 7

# Nerd Font glyphs, one per field. Never emoji: an emoji is two cells wide in
# some terminals and one in others, so a column carrying one cannot be aligned.
#
# The icon for a field never changes with its state — only its color does. Two
# different glyphs are not guaranteed the same cell width either, so a row
# differing only in review state would sit a column off from the one above it.
CHECKS_ICON = ''
REVIEW_ICON = ''
FILES_ICON = ''
ADDED_ICON = ''
REMOVED_ICON = ''
AGE_ICON = ''
BRANCH_ICON = ''
NUMBER_ICON = ''
PATH_ICON = ''
STACK_ICON = ''
DIFF_ICON = ''
BROWSER_ICON = ''
COMMENT_ICON = ''
MERGE_ICON = ''
# Each carries its codepoint in the comment beside it. These are private-use
# characters, so a diff viewer, a clipboard, or a terminal without the font all
# render them identically to each other and to nothing at all — the codepoint is
# the only form of the name that reads anywhere and can be grepped for.
PAGE_ICON = ''  # U+F15C file-text, beside FILES_ICON's file
AUDIT_ICON = ''  # U+F41E octicon checklist, beside DIFF_ICON and MERGE_ICON
CLOSE_ICON = ''  # U+F057 times-circle, the mate of CHECKS_ICON's check-circle

# Picked against each font's cmap rather than by looking at a terminal. U+F544,
# the Material robot and the obvious glyph for a review, is in none of the seven
# Nerd Fonts installed here — and a glyph the font lacks draws as tofu, whose
# width is the terminal's guess rather than one cell, so it takes the whole
# column out of line for the same reason the paragraph above rules out emoji.
# `fontTools.ttLib.TTFont(path).getBestCmap()` is what answers.

CHECK_STYLES = {'SUCCESS': 'green', 'FAILURE': 'red', 'ERROR': 'red'}
REVIEW_STYLES = {'APPROVED': 'green', 'CHANGES_REQUESTED': 'red', 'REVIEW_REQUIRED': 'cyan'}

# The state in words. A legend under the table made you carry a color from the
# bottom of the window back up to a glyph; saying it on the row costs a column
# and removes the lookup entirely.
CHECK_WORDS = {'SUCCESS': 'passing', 'FAILURE': 'failing', 'ERROR': 'failing', '': 'not run'}
REVIEW_WORDS = {'APPROVED': 'approved', 'CHANGES_REQUESTED': 'changes', 'REVIEW_REQUIRED': 'required', '': 'no review'}

# Breathing room around the table: one row top and bottom, twelve columns each
# side. More on the sides than the top, because the sides are where a list runs
# into its own border and the top already has a rule under the header.
SIDE_PAD = 12

# The width the fields are spread across. It has to match the popup in tmux.conf
# minus its border and padding — `display-popup -w 150` less a border and
# SIDE_PAD each side leaves 124, and 120 keeps a margin. Spreading to less than the window is what left the list huddled
# against the left edge with the rest of the popup empty.
TABLE_WIDTH = 120


def spread(rows: list[list[Text]], width: int, right: frozenset[int] = frozenset()) -> list[Text]:
    """A table laid out to fill the width, every row on the same column stops.

    Widths are measured down each column across every row, so every line lands on
    the same stops rather than each being spaced independently.

    Filling the width is the point. Packed left, five short fields sit in a
    huddle against the edge with the rest of the window empty beside them, and
    nothing about the shape says which field is which.

    The slack is dealt out one column at a time from the left, so a line ends
    exactly on `width` rather than a few short of it. Columns named in `right`
    are right-aligned inside their stop, so digits stack.
    """
    widths = [max(row[index].cell_len for row in rows) for index in range(len(rows[0]))]
    slack = max(width - sum(widths), len(widths) - 1)
    gap, extra = divmod(slack, len(widths) - 1)

    laid_out = []
    for row in rows:
        line = Text()
        for index, cell in enumerate(row):
            if index:
                line.append(' ' * (gap + (1 if index <= extra else 0)))
            padding = ' ' * (widths[index] - cell.cell_len)
            if index in right:
                line.append(padding)
                line.append(cell)
            else:
                line.append(cell)
                line.append(padding)
        laid_out.append(line)
    return laid_out


@dataclass(frozen=True)
class PullRequest:
    """One open PR, as `pull-requests` reports it.

    `slug` is `owner/name` and identifies the repository; `repo` is the bare
    basename and is a label. The two are not interchangeable — pull-requests searches
    all of GitHub and filters to the registry, so a PR you authored upstream in
    someone else's project can arrive under a `repo` that matches one of yours.

    The three diff counts are None, never 0, from a provider that does not report
    them. A PR nobody counted is not a PR that changed nothing.

    `review` is the provider's decision and `reviews` is how many were submitted.
    A review can set no decision, so the two disagree routinely.
    """

    repo: str
    slug: str
    number: int
    title: str
    branch: str
    base: str
    draft: bool
    age_days: int
    path: str
    additions: int | None
    deletions: int | None
    changed_files: int | None
    review: str
    reviews: int
    checks: str
    provider: str
    body: str

    @classmethod
    def from_json(cls, row: dict) -> PullRequest:
        return cls(
            repo=row['repo'],
            slug=row['slug'],
            number=row['number'],
            title=row['title'],
            branch=row['branch'],
            base=row['base'],
            draft=row['draft'],
            age_days=row['age_days'],
            path=row['path'],
            additions=row.get('additions'),
            deletions=row.get('deletions'),
            changed_files=row.get('changed_files'),
            review=row.get('review') or '',
            reviews=row.get('reviews') or 0,
            checks=row.get('checks') or '',
            provider=row.get('provider') or '',
            body=row.get('body') or '',
        )


def fetch() -> list[PullRequest]:
    """Every open PR the registry knows about. Raises if `pull-requests` fails."""
    result = subprocess.run(['pull-requests'], capture_output=True, text=True, check=True)
    return [PullRequest.from_json(row) for row in json.loads(result.stdout)]


def stack_parents(prs: list[PullRequest]) -> dict[tuple[str, str], int]:
    """`(slug, branch) -> number`, so a PR targeting another can name its parent.

    What counts as stacked is read out of the listing — a base that is some other
    open PR's head — because pull-requests reports no default branch, so testing base
    against a literal "main" would mark every row of a repo defaulting to master.

    Keyed on slug and branch together rather than on branch alone. Branch names
    recur across a registry, and pairing two repos' `session-refresh` would
    invent a stack that does not exist.
    """
    return {(pr.slug, pr.branch): pr.number for pr in prs if pr.branch}


def age_cell(pr: PullRequest) -> Text:
    style = 'red' if pr.age_days >= STALE else 'yellow' if pr.age_days >= AGEING else 'dim'
    return Text(f'{AGE_ICON}  {pr.age_days}d', style=style)


def diff_column(prs: list[PullRequest]) -> list[Text]:
    """Files changed, then the two counts, each aligned against the rows above.

    Built over the whole set rather than per row. The cell holds three numbers,
    and right-aligning it as one string lines up only its right edge — `+76 -941`
    lands under `+25 -2` with neither the plus nor the minus in a column. Each
    part gets its own width instead, so the signs stack.

    A dash, never `+0 -0`, from a provider that reports nothing. It is padded to
    the same total so the column edge stays straight.

    Every style goes on its own span, never on the `Text` itself. A base style is
    merged into each span rather than overridden, so a base of `dim` here renders
    the additions dim green — the one color on the row that has to carry at a
    glance.
    """
    counted = [pr for pr in prs if pr.additions is not None]
    files = max((len(f'{FILES_ICON} {pr.changed_files}') for pr in counted), default=0)
    added = max((len(f'{ADDED_ICON} {pr.additions}') for pr in counted), default=0)
    removed = max((len(f'{REMOVED_ICON} {pr.deletions}') for pr in counted), default=0)
    total = files + added + removed + 4

    cells = []
    for pr in prs:
        cell = Text()
        if pr.additions is None:
            cell.append('—'.rjust(total), style='dim')
        else:
            cell.append(f'{FILES_ICON} {pr.changed_files}'.rjust(files), style='dim')
            cell.append('  ')
            cell.append(f'{ADDED_ICON} {pr.additions}'.rjust(added), style='green')
            cell.append('  ')
            cell.append(f'{REMOVED_ICON} {pr.deletions}'.rjust(removed), style='red')
        cells.append(cell)
    return cells


def branch_cell(pr: PullRequest, parents: dict[tuple[str, str], int]) -> Text:
    """The branch, and the PR it is stacked on where there is one.

    The marker sits inside this cell rather than in a column of its own, which
    would cost every row the width to say something about a handful. The parent
    shows as its number — two long branch names in one cell is the unreadable
    version.
    """
    cell = Text()
    cell.append(f'{BRANCH_ICON}  ', style='blue')
    cell.append(pr.branch or '-', style='blue')
    parent = parents.get((pr.slug, pr.base))
    if parent is not None and parent != pr.number:
        # One space, never two. Columns are separated by a run of two, so a wider
        # gap here reads as a column boundary and the marker becomes a field of
        # its own — which is what pushes the title out of the picker's view.
        cell.append(f' {STACK_ICON} #{parent}', style='yellow')
    return cell


def title_cell(pr: PullRequest) -> Text:
    if pr.draft:
        return Text(f'{pr.title} (draft)', style='dim')
    return Text(pr.title)


def checks_cell(pr: PullRequest) -> Text:
    """CI state, in words. An unrecognized rollup is yellow rather than dim:
    GitHub adds states, and a new one is in flight rather than absent."""
    style = CHECK_STYLES.get(pr.checks, 'dim' if not pr.checks else 'yellow')
    cell = Text()
    cell.append(f'{CHECKS_ICON}  ', style=style)
    cell.append(f'checks {CHECK_WORDS.get(pr.checks, pr.checks.lower())}', style=style)
    return cell


def review_cell(pr: PullRequest) -> Text:
    """The provider's decision where there is one, and otherwise how many reviews were submitted.

    The decision leads because it is the one that gates the merge, and a count
    cannot displace it.
    """
    if not pr.review and pr.reviews:
        style = REVIEW_STYLES['REVIEW_REQUIRED']
        word = f'{pr.reviews} posted'
    else:
        style = REVIEW_STYLES.get(pr.review, 'dim')
        word = REVIEW_WORDS.get(pr.review, pr.review.lower())
    cell = Text()
    cell.append(f'{REVIEW_ICON}  ', style=style)
    cell.append(f'review {word}', style=style)
    return cell


# Between the status column and the fields beside it.
COLUMN_GAP = 4

LABELS = ('TITLE', 'DIFF', 'AGE', 'BRANCH')

# The quantities right-align, so the digits stack: `-2` under `-386` hides the
# magnitude that is the only reason the column is there.
RIGHT_ALIGNED = frozenset({1, 2})


def where_cell(pr: PullRequest) -> Text:
    """Where the PR is on this disk, which is what you go on to open.

    The repo name is a label and two of them can collide across a registry; the
    path is what identifies a checkout. Written `~`-rooted, the way you would
    type it.

    A repo the registry names but this machine has not cloned has no path, so it
    falls back to the name — the row still has to say which repo it is, and it is
    the one `prs` will refuse to open.
    """
    cell = Text()
    cell.append(f'{PATH_ICON}  ', style='cyan')
    if not pr.path:
        cell.append(pr.repo, style='cyan')
        cell.append('  not cloned here', style='dim')
        return cell
    home = str(Path.home())
    cell.append(pr.path.replace(home, '~', 1) if pr.path.startswith(home) else pr.path, style='cyan')
    return cell


def number_cell(pr: PullRequest) -> Text:
    cell = Text()
    cell.append(f'{NUMBER_ICON}  ', style='yellow')
    cell.append(f'#{pr.number}', style='yellow')
    return cell


@dataclass(frozen=True)
class Action:
    """One thing you can do to a PR, and which providers can do it.

    `providers` empty means every provider — the diff and the branch name are
    local git and the browser is a URL, so none of the three asks a provider
    anything.

    `key` is the letter that reaches it from either menu. It is a property of the
    action rather than of a menu so both bind the same letter, and a letter
    learned on the list still works one screen deeper.
    """

    name: str
    key: str
    icon: str
    label: str
    detail: str
    providers: frozenset[str] = frozenset()

    def supported(self, provider: str) -> bool:
        return not self.providers or provider in self.providers


# Ordered by how often each is wanted, with the three reading actions first. The
# two that change the pull request are last, so the arrow keys reach them
# slowest; each is reachable at once by its letter from anywhere, and the confirm
# each prints is what guards it. Merge sits below close because a closed PR
# reopens and a merged one does not.
#
# Letters are the first letter of the thing, not of the label — `b` is the
# branch and `o` is open-in-browser, because two actions starting with `b` would
# make one of them arbitrary. `x` for close is the one that names nothing: `c` is
# already the comment, and `x` is what closes a thing everywhere else on a
# keyboard, which beats a second arbitrary letter taken off `close`.
ACTIONS = (
    Action('diff', 'd', DIFF_ICON, 'view diff', 'fetch the ref and open it in a tmux window'),
    Action('page', 'p', PAGE_ICON, 'page and comments', 'the description and every comment, in a pager', frozenset({'github'})),
    Action('review', 'r', AUDIT_ICON, 'claude review', 'open a Claude window running /review-pr on it'),
    Action('browser', 'o', BROWSER_ICON, 'open in browser', 'the same page, handed to your browser'),
    Action('branch', 'b', BRANCH_ICON, 'copy branch', 'the branch name, to the system clipboard'),
    Action('comment', 'c', COMMENT_ICON, 'comment', 'write one in $EDITOR and post it', frozenset({'github'})),
    Action('close', 'x', CLOSE_ICON, 'close', 'close it unmerged — asks once, and enter is no', frozenset({'github'})),
    Action('merge', 'm', MERGE_ICON, 'merge', 'merge it — asks once, and enter is yes'),
)

# What fzf hands back on the first line of its output when one of these is
# pressed. Enter leaves that line empty, which is how "open the action menu" and
# "do this one thing" are told apart.
EXPECT = ','.join(action.key for action in ACTIONS)


def compose(prs: list[PullRequest], *, width: int) -> tuple[Text, list[list[Text]]]:
    """The header line, then each PR as two lines.

    The status column carries one state per line in words — checks on the first,
    review on the second. It replaced a legend under the table, which made you
    take a color from the bottom of the window back up to a glyph. Saying it on
    the row costs a column and removes the lookup.

    Everything else you scan by is on the first line: title, size, age, branch.
    The second carries where it lives on this disk and its number, which are what
    you want once you have already chosen the row.

    Widths are measured on `cell_len`, which counts what a terminal draws rather
    than how many characters there are. Padding on `len` is what puts an em dash
    or a wide glyph a column out.
    """
    parents = stack_parents(prs)
    checks = [checks_cell(pr) for pr in prs]
    reviews = [review_cell(pr) for pr in prs]
    status_label = Text('STATUS', style='bold')
    status_width = max(cell.cell_len for cell in [*checks, *reviews, status_label])

    labels = [Text(label, style='bold') for label in LABELS]
    rows = [[title_cell(pr), diff, age_cell(pr), branch_cell(pr, parents)] for pr, diff in zip(prs, diff_column(prs), strict=True)]
    header, *laid_out = spread([labels, *rows], width - status_width - COLUMN_GAP, RIGHT_ALIGNED)

    def lead(cell: Text) -> Text:
        """The status cell padded to its column, so both lines start together."""
        line = cell.copy()
        line.append(' ' * (status_width - cell.cell_len + COLUMN_GAP))
        return line

    items = []
    for pr, check, review, row in zip(prs, checks, reviews, laid_out, strict=True):
        first = lead(check)
        first.append(row)

        second = lead(review)
        second.append(where_cell(pr))
        second.append('   ')
        second.append(number_cell(pr))
        items.append([first, second])

    titled = lead(status_label)
    titled.append(header)
    return titled, items


def to_lines(rows: list[Text], *, color: bool) -> list[str]:
    """Rendered rows, with the escape codes in or stripped out.

    Color is a parameter rather than a call to `isatty` in here, so the caller
    that knows whether it is writing to a pipe is the one that decides.
    """
    console = Console(force_terminal=color, no_color=not color, width=10_000, soft_wrap=True)
    with console.capture() as captured:
        for row in rows:
            console.print(row)
    return captured.get().rstrip('\n').split('\n')


def empty_state(*, interactive: bool) -> int:
    """Not a failure: pull-requests read every repo in the registry and found none.

    The pause is what makes the answer readable at all. This normally runs as
    `display-popup -E`, which tears the popup down the instant the command exits,
    so a line printed on the way out flashes past and the keybinding reads as
    dead.
    """
    print('No open PRs across the registry.')
    print('  pull-requests  prints the listing this reads')
    if interactive:
        input('press enter to close ')
    return 0


def cmd_list(prs: list[PullRequest], *, color: bool) -> int:
    """The table, with the header set off from the rows and the rows spaced out.

    A blank line under the header stops the labels reading as a first result, and
    one between rows is what makes a six-column row scan as a unit rather than as
    part of a block.
    """
    header, items = compose(prs, width=TABLE_WIDTH)
    margin = ' ' * SIDE_PAD
    print()
    print(margin + to_lines([header], color=color)[0])
    for item in items:
        print()
        print()
        for line in to_lines(item, color=color):
            print(margin + line)
    print()
    return 0


def expected(stdout: str) -> tuple[Action | None, str]:
    """Split fzf's `--expect` output into the key pressed and the row chosen.

    The key is its own first line, empty when the choice was made with enter. The
    row follows and is two lines here, so this splits once and strips only the
    remainder — stripping the whole thing first would eat the empty key line and
    leave the row where the key belongs.
    """
    key, _, rest = stdout.partition('\n')
    return next((action for action in ACTIONS if action.key == key.strip()), None), rest.strip()


def shortcut_legend() -> Text:
    """The keys, as a footer line under the list.

    Every action is named, including the ones a provider cannot do. Which of them is
    live depends on the row under the cursor, and a legend that changed as you
    moved would be read as flicker rather than as information.
    """
    line = Text()
    for index, action in enumerate(ACTIONS):
        if index:
            line.append('   ')
        line.append(action.key, style='bold cyan')
        line.append(f' {action.label}', style='dim')
    return line


# The shift arrows are fzf's own defaults for `preview-up` and `preview-down` and
# always were; what was missing was anything on screen saying so, so a description
# longer than the pane read as one that had been truncated.
#
# The half-page pair has no default binding at all, so PREVIEW_BINDS below is what
# puts it on ctrl-u and ctrl-d. Both letters are free here only because
# `--no-input` removed the query line — with one, ctrl-u is unix-line-discard and
# ctrl-d is delete-char/eof, which aborts fzf rather than scrolling anything.
SCROLL_KEYS = (('shift-↑ shift-↓', 'scroll a line'), ('ctrl-u ctrl-d', 'scroll half a page'))

PREVIEW_BINDS = 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down'


def scroll_legend() -> Text:
    """How to move the description, as a footer under the action menu.

    Only under the menu, never under the list. The list has no preview to scroll,
    and a footer naming keys that do nothing there is worse than no footer.
    """
    line = Text()
    for index, (keys, what) in enumerate(SCROLL_KEYS):
        if index:
            line.append('   ')
        line.append(keys, style='bold cyan')
        line.append(f' {what}', style='dim')
    return line


def pick(prs: list[PullRequest]) -> tuple[PullRequest, Action | None] | None:
    """Run fzf over the rendered rows, and return the PR with any key pressed on it.

    An action key returns that action and skips the menu entirely: `m` on a row
    goes straight to the merge confirm. Enter returns no action, which is what
    opens the menu.

    The index leads in a hidden field, so the choice survives a title containing
    a tab or a leading number, and nothing has to be matched back by name.

    No `--height`: this fills whatever it is given, which is the tmux popup when
    it runs from a keybinding and the terminal when it does not. Size belongs to
    the caller, in one place.

    Column titles go in the header and the key legend in the footer. They are two
    different kinds of thing and putting both at the top made the legend read as
    a second header row, whatever the spacing.

    The titles are composed with the rows rather than written separately, which
    is the only thing that keeps a label over its own column.

    `--gap` puts a blank line between rows; the two borders rule the header and
    the footer off from them. All of it is spacing fzf owns — emitting blank
    lines instead would make them selectable rows with no PR behind them.

    No border of its own: tmux draws the popup's. Two nested frames around one
    list read as a mistake, and the tmux one has to be there — without it the
    popup has no frame to redraw against and a busy pane behind it bleeds
    through the top line or two.

    Records are NUL-separated so a PR can be two lines and still be one item.
    With newline-separated input its title would be a second, selectable row with
    no PR behind it, which is the same fault as faking the gaps.
    """
    header, items = compose(prs, width=TABLE_WIDTH)
    stdin = '\0'.join(f'{index}\t' + '\n'.join(to_lines(item, color=True)) for index, item in enumerate(items))
    result = subprocess.run(
        [
            'fzf',
            '--ansi',
            '--read0',
            # Paint no background of its own. fzf fills the list area with its
            # `bg` and leaves the padding to whatever is behind, so the padded
            # frame came out a different color from the rows inside it. `-1` is
            # terminal default for both, which is the popup's own background.
            '--color=bg:-1,gutter:-1,preview-bg:-1',
            '--delimiter=\t',
            '--with-nth=2',
            '--no-sort',
            '--reverse',
            '--gap=2',
            '--border=none',
            '--header-border=bottom',
            '--footer-border=top',
            # Setting any section border makes fzf draw one round the list and
            # the input too, which is the rule down the left edge. Only the two
            # horizontal ones above and below are wanted.
            '--list-border=none',
            '--input-border=none',
            '--no-scrollbar',
            # No search line. An open backlog is a handful of rows — if it ever
            # got long enough to need filtering, the backlog is the problem. It
            # is also what frees the letters: with nothing to type into, a bare
            # `m` is a binding rather than a query.
            '--no-input',
            f'--expect={EXPECT}',
            f'--padding=1,{SIDE_PAD}',
            f'--header={to_lines([header], color=True)[0]}',
            f'--footer={to_lines([shortcut_legend()], color=True)[0]}',
            # Both blanked. fzf reserves a column at the left for the pointer
            # and, once items are multi-line, draws `╻┃╹` down the side of each
            # one — a white rule against the rows that reads as a border the
            # table does not have. The highlight already says which row is
            # current.
            # Empty, not a space. The gutter fzf paints down the left is as wide
            # as the pointer, and a space still reserves the column — which is the
            # bar. It is colored `bg+` by default, so it vanishes on whichever
            # row is current and reads as a border everywhere else.
            '--pointer=',
            '--marker=',
            '--marker-multi-line=',
        ],
        input=stdin,
        capture_output=True,
        text=True,
        check=False,
    )
    action, chosen = expected(result.stdout)
    if not chosen:
        return None
    return prs[int(chosen.split('\t')[0])], action


def describe(pr: PullRequest) -> Text:
    """The PR as a page: what it is, then the description its author wrote.

    Shown under the actions rather than beside them. The choices are a short
    fixed list and the description is long, so the list stays put at the top
    while the pane beneath it changes size with whatever it is carrying.
    """
    page = Text()
    page.append(f'{pr.title}\n', style='bold')
    page.append(f'{pr.slug}  #{pr.number}', style='dim')
    page.append('   ')
    page.append(pr.branch, style='blue')
    page.append('  into  ', style='dim')
    page.append(f'{pr.base}\n\n', style='blue')
    if pr.body.strip():
        page.append(rendered(pr.body))
    else:
        page.append('No description.', style='dim')
    return page


def rendered(body: str) -> Text:
    """A PR body as markdown rather than as the source someone typed.

    A body here is written to be read — headings, fenced code, backticked paths,
    bullets — and printed raw it arrives as `##` and backticks with no styling at
    all, which is the same characters the author was trying to get away from.

    Rendered locally out of the body the listing already carries, so opening the
    menu costs nothing. Asking GitHub for its own rendering is the `page`
    action, which is a network round trip and therefore a thing you press rather
    than something that happens on every arrow key.

    Wrapped at TABLE_WIDTH, which the preview pane shares with the table above
    it. Passing a width at all is the load-bearing part: `Console` falls back to
    80 columns when it cannot see a terminal, and it cannot see one here, since
    this renders into a temporary file that fzf `cat`s. Left to itself every body
    would wrap at 80 inside a pane half again as wide.
    """
    console = Console(force_terminal=True, width=TABLE_WIDTH, soft_wrap=False)
    with console.capture() as captured:
        console.print(Markdown(body.rstrip()))
    return Text.from_ansi(captured.get().rstrip('\n'))


def action_line(action: Action, pr: PullRequest) -> Text:
    """One menu row. Unsupported ones stay, dimmed, and say why.

    Hiding an action a provider cannot do would make the menu a different shape per
    provider, so you would learn where `merge` sits and then find it somewhere
    else. Dimmed, the list is the same list everywhere.

    The key leads its own column rather than sitting inside the label. A row is
    read to find the action and pressed to take it, and a column of single
    letters down the left is what makes the second reading possible at a glance.
    """
    live = action.supported(pr.provider)
    line = Text()
    line.append(f'{action.key}  ', style='bold cyan' if live else 'dim')
    line.append(f'{action.icon}  ', style='' if live else 'dim')
    line.append(action.label.ljust(18), style='bold' if live else 'dim')
    line.append(action.detail if live else f'not available on {pr.provider}', style='dim')
    return line


def choose_action(pr: PullRequest) -> Action | None:
    """The action menu for one PR, with its description in the pane above.

    The same letters work here as on the list, so arriving by enter and then
    pressing `m` does what pressing `m` a screen earlier would have done.
    """
    page = to_lines([describe(pr)], color=True)
    with tempfile.NamedTemporaryFile('w', suffix='.txt', delete=False) as handle:
        handle.write('\n'.join(page))
        preview = handle.name

    rows = [f'{index}\t{line}' for index, line in enumerate(to_lines([action_line(a, pr) for a in ACTIONS], color=True))]
    try:
        result = subprocess.run(
            [
                'fzf',
                '--ansi',
                '--delimiter=\t',
                '--with-nth=2',
                '--no-sort',
                '--reverse',
                # No `--gap` here, unlike the list. A blank line between rows costs
                # one row per action, and eight actions plus their gaps overflow a
                # list pane that is 35% of a popup 60% of the screen tall — merge,
                # the last row, falls below the fold on an 83-row terminal. The
                # rows are one line each and lead with a column of single letters,
                # which is separation enough without spending a row on it.
                '--border=none',
                '--list-border=none',
                '--input-border=none',
                '--no-scrollbar',
                # No search line here. A short fixed list of choices is an
                # arrow-key list, not something you filter, and a prompt invites
                # typing that then does nothing useful.
                '--no-input',
                f'--expect={EXPECT}',
                '--color=bg:-1,gutter:-1,preview-bg:-1',
                '--pointer=',
                '--marker=',
                f'--padding=1,{SIDE_PAD}',
                f'--footer={to_lines([scroll_legend()], color=True)[0]}',
                '--footer-border=top',
                f'--bind={PREVIEW_BINDS}',
                '--preview',
                f'cat {preview}',
                '--preview-window=down,65%,wrap,border-top',
            ],
            input='\n'.join(rows),
            capture_output=True,
            text=True,
            check=False,
        )
    finally:
        Path(preview).unlink(missing_ok=True)

    pressed, chosen = expected(result.stdout)
    if pressed:
        return pressed
    if not chosen:
        return None
    return ACTIONS[int(chosen.split('\t')[0])]


def open_review(pr: PullRequest) -> int:
    """Fetch the PR ref and open its diff in a new tmux window."""
    if not pr.path:
        return fail(f'{pr.repo} is not checked out on this machine')
    checkout = Path(pr.path)
    if not checkout.is_dir():
        return fail(f'{pr.repo} is registered at {checkout}, which does not exist')

    # The base comes from the listing rather than from the default branch: a PR
    # stacked on another targets its parent, and diffing that against main shows
    # both as one change. The local lookup stays for a provider whose listing
    # does not report a base.
    base = pr.base or default_branch(checkout)
    if not base:
        return fail(f'could not work out what PR #{pr.number} is based on')

    ref = f'refs/remotes/origin/pr/{pr.number}'
    if not git(checkout, 'fetch', '--quiet', '--force', 'origin', f'pull/{pr.number}/head:{ref}'):
        return fail(f'could not fetch PR #{pr.number} in {pr.repo}')
    git(checkout, 'fetch', '--quiet', 'origin', base)
    if not git(checkout, 'rev-parse', '--verify', '--quiet', f'origin/{base}'):
        return fail(f'{pr.repo} has no origin/{base} to diff against')

    socket = Path(tempfile.gettempdir()) / f'fleet-pr-{pr.repo}-{pr.number}.sock'
    socket.unlink(missing_ok=True)

    # Three-dot: from where the branch diverged to its tip, which is what the
    # provider shows. Two-dot would render commits the base gained since branching
    # as changes this PR reverted.
    return window(
        f'diff {pr.repo} #{pr.number}',
        f"nvim --listen '{socket}' -c 'DiffviewOpen origin/{base}...{ref}'",
        cwd=checkout,
    )


def in_repo(pr: PullRequest) -> Path | None:
    """bbkt resolves the repo from the working directory, so it needs one."""
    return Path(pr.path) if pr.path and Path(pr.path).is_dir() else None


def open_browser(pr: PullRequest) -> int:
    if pr.provider == 'github':
        return run(['gh', 'pr', 'view', str(pr.number), '--repo', pr.slug, '--web'])
    checkout = in_repo(pr)
    if not checkout:
        return fail(f'{pr.repo} is not checked out here, and bbkt resolves the repo from the directory')
    return run(['bbkt', 'pr', 'open', str(pr.number)], cwd=checkout)


def copy_branch(pr: PullRequest) -> int:
    """The branch, not the number: a number is a per-repo counter and collides
    across the registry, and both providers take a branch anywhere they take one."""
    clipboard = next((tool for tool in ('wl-copy', 'pbcopy', 'xclip') if shutil.which(tool)), None)
    if not clipboard:
        return fail('no clipboard tool found — install wl-clipboard, or xclip')
    argv = [clipboard, '-selection', 'clipboard'] if clipboard == 'xclip' else [clipboard]
    subprocess.run(argv, input=pr.branch, text=True, check=True)
    print(f'copied  {pr.branch}')
    return 0


def comment(pr: PullRequest) -> int:
    """GitHub only. bbkt has no comment verb at all — see `bbkt pr --help`."""
    return run(['gh', 'pr', 'comment', str(pr.number), '--repo', pr.slug])


def read_page(pr: PullRequest) -> int:
    """GitHub's own rendering of the PR, in a pager in a tmux window.

    `GH_FORCE_TTY` is what makes this worth having. gh prints a `key:\tvalue`
    dump when it is not writing to a terminal and renders the real page — colored
    header, state, branch, check rollup, and the body through its markdown
    renderer — when it is. It is not writing to a terminal here, because it is
    writing to a pager. The width is passed rather than left as `100%`: gh
    measures the pipe, not the window, and gets no width from it at all.

    `--comments` is the reason this exists beside the menu's own preview. The
    preview carries the body, which the listing already holds; the review threads
    and the discussion are only on GitHub, and this is the one action that
    fetches them.

    `less -R` rather than `bat`: this is already colored ANSI, and bat would be a
    second thing deciding how to paginate what gh has finished formatting.

    Opens in no particular directory, unlike the two actions beside it. `--repo`
    is what names the PR, so nothing here reads a checkout — and a `-c` naming a
    repo the registry knows and this machine has not cloned is a directory tmux
    would refuse to start a window in.
    """
    return window(
        f'page {pr.repo} #{pr.number}',
        f'GH_FORCE_TTY={TABLE_WIDTH} gh pr view {pr.number} --repo {pr.slug} --comments | less -R',
        cwd=None,
    )


def claude_review(pr: PullRequest) -> int:
    """A Claude window with `/review-pr` already typed, run where the PR lives.

    A window rather than this process, because the review runs several agents and
    takes minutes. Nothing here waits for it.

    The session is new, so it holds nothing about how the code was written. That
    is what the skill wants: a review carries weight only from a reader who did
    not write the diff, and a session started from the picker has read none of it.

    The repo is passed even though the window opens in the checkout. `prs` reaches
    PRs across the whole registry, and the argument is what keeps the review on
    the PR you pointed at when the directory says otherwise.
    """
    checkout = in_repo(pr)
    if not checkout:
        return fail(f'{pr.repo} is not checked out here, and a review needs the code')
    return window(f'review {pr.repo} #{pr.number}', f"claude '/review-pr {pr.number} {pr.repo}'", cwd=checkout)


def window(name: str, command: str, *, cwd: Path | None) -> int:
    """Run a command in a new tmux window, named, and hand the terminal to it.

    Shared by the three actions that open one. Each was `tmux new-window` written
    out, and they disagreed about whether `-c` was passed at all — which decides
    whether the window inherits the popup's directory or the repo's.
    """
    argv = ['tmux', 'new-window', '-n', name]
    if cwd:
        argv += ['-c', str(cwd)]
    return run([*argv, command])


def close(pr: PullRequest, *, interactive: bool) -> int:
    """Closing asks once and defaults to no, which is the opposite of merge.

    The asymmetry is deliberate and is about which mistake is recoverable. A merge
    confirmed by reflex lands work that was going to land anyway; a close
    confirmed by reflex discards a branch nobody reviewed, and the PR reopens but
    the moment someone would have read it does not.

    So this takes `y` and nothing else, and `--comment` is not offered: a close
    worth explaining is worth explaining in the thread, where `c` already goes.
    """
    if interactive:
        answer = input(f'close {pr.slug} #{pr.number} — {pr.title}?  [y/N] ')
        if answer.strip().lower() not in {'y', 'yes'}:
            print('left open')
            return 0
    return run(['gh', 'pr', 'close', str(pr.number), '--repo', pr.slug])


def merge(pr: PullRequest, *, interactive: bool) -> int:
    """Merging is the one action here that cannot be taken back, so it asks once.

    Enter is yes. The prompt exists to show which PR is about to land, not to
    make landing one a chore, and a default of no meant typing a letter to
    confirm every merge that was never in doubt. Anything that is not yes aborts,
    so a stray key still stops it — the safety is in the unrecognized answer
    rather than in the default.

    `--merge` is what makes this one prompt instead of four. Without a method gh
    runs its own wizard: which method, whether to delete the branch, then a
    submit step. Every answer is already settled — a PR lands as a merge commit
    rather than a squash or a rebase, and the `forge` tool sets
    `delete_branch_on_merge` on the repo, so GitHub deletes the remote branch and
    nothing here touches the local one.
    """
    if interactive:
        answer = input(f'merge {pr.slug} #{pr.number} — {pr.title}?  [Y/n] ')
        if answer.strip().lower() not in {'', 'y', 'yes'}:
            print('left alone')
            return 0
    if pr.provider == 'github':
        return run(['gh', 'pr', 'merge', str(pr.number), '--repo', pr.slug, '--merge'])
    checkout = in_repo(pr)
    if not checkout:
        return fail(f'{pr.repo} is not checked out here, and bbkt resolves the repo from the directory')
    return run(['bbkt', 'pr', 'merge', str(pr.number)], cwd=checkout)


def run(argv: list[str], cwd: Path | None = None) -> int:
    """Hand the terminal over. These are interactive — gh opens an editor, both
    providers prompt — so nothing here captures their output."""
    try:
        return subprocess.run(argv, cwd=cwd, check=False).returncode
    except FileNotFoundError:
        return fail(f'{argv[0]} is not installed')


def perform(action: Action, pr: PullRequest, *, interactive: bool) -> int:
    if not action.supported(pr.provider):
        return fail(f'{action.label} is not available on {pr.provider}')
    if action.name == 'diff':
        return open_review(pr)
    if action.name == 'page':
        return read_page(pr)
    if action.name == 'review':
        return claude_review(pr)
    if action.name == 'browser':
        return open_browser(pr)
    if action.name == 'branch':
        return copy_branch(pr)
    if action.name == 'comment':
        return comment(pr)
    if action.name == 'close':
        return close(pr, interactive=interactive)
    return merge(pr, interactive=interactive)


def default_branch(checkout: Path) -> str:
    head = git_output(checkout, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD')
    return head.removeprefix('origin/')


def git(checkout: Path, *args: str) -> bool:
    return subprocess.run(['git', '-C', str(checkout), *args], capture_output=True, text=True, check=False).returncode == 0


def git_output(checkout: Path, *args: str) -> str:
    result = subprocess.run(['git', '-C', str(checkout), *args], capture_output=True, text=True, check=False)
    return result.stdout.strip()


def fail(message: str) -> int:
    print(f'prs: {message}', file=sys.stderr)
    return 1


def help_screen() -> None:
    """The screen, in the grammar every other tool on this PATH draws.

    The key rows come off `ACTIONS` rather than being written out, so a new action
    cannot arrive with a binding the screen does not mention. That is the same
    tuple the menu and the footer are built from.

    The scroll keys come off `SCROLL_KEYS` for the same reason, and are the one
    set here that is not an action — they move the description rather than doing
    anything to the pull request.
    """
    help_header('prs')
    help_text('Pick an open PR and open its diff in a tmux window.')
    help_usage('prs', 'prs list')

    help_section('Commands')
    help_row('prs', '', 'pick a PR, then act on it')
    help_row('prs list', '', 'print every open PR as a table instead of picking one')

    help_section('Keys')
    help_text('On the list, and again in the action menu.')
    for action in ACTIONS:
        help_row(action.key, action.label, action.detail)
    help_row('enter', '', 'open the action menu for the row under the cursor')

    help_section('Reading the description')
    help_text('In the action menu, where the description sits under the choices.')
    for keys, what in SCROLL_KEYS:
        help_row(keys, '', what)

    help_section('Options')
    help_row('-h, --help', '', 'show this screen')
    help_text('', 'Needs tmux, which is where the review window goes.')
    help_end()


class Parser(argparse.ArgumentParser):
    """The grammar prints as it goes, so the screen is printed rather than
    returned. argparse's `-h` calls `print_help` and exits, which is the whole
    path that has to be intercepted."""

    def print_help(self, file: object = None) -> None:
        help_screen()


def main() -> int:
    parser = Parser(prog='prs')
    # A verb rather than a flag, because `list` is the fleet's word for the set
    # and a flag that switches the whole act is a subcommand wearing a disguise.
    # `parser_class` so `prs list --help` draws the same screen rather than
    # argparse's, which names `positional arguments` on a verb that takes none.
    subcommands = parser.add_subparsers(dest='command', metavar='[list]', parser_class=Parser)
    subcommands.add_parser('list')
    arguments = parser.parse_args()

    if not shutil.which('pull-requests'):
        return fail('pull-requests is required')

    try:
        prs = fetch()
    except subprocess.CalledProcessError as error:
        return fail(f'pull-requests failed: {error.stderr.strip() or error}')

    if arguments.command == 'list':
        if not prs:
            print('No open PRs across the registry.')
            return 0
        return cmd_list(prs, color=sys.stdout.isatty())

    if not prs:
        return empty_state(interactive=sys.stdin.isatty())

    # Only the picker path needs these. `--list` is readable on a machine with no
    # tmux and no editor, and refusing to print there would be refusing to answer
    # a question that was fully answerable.
    if not os.environ.get('TMUX'):
        return fail('not inside tmux — this opens a review window')
    for tool in ('fzf', 'nvim', 'git'):
        if not shutil.which(tool):
            return fail(f'{tool} is required')

    picked = pick(prs)
    if picked is None:
        return 0
    chosen, action = picked
    if action is None:
        action = choose_action(chosen)
    if action is None:
        return 0
    return perform(action, chosen, interactive=sys.stdin.isatty())


if __name__ == '__main__':
    sys.exit(main())
