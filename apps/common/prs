#!/usr/bin/env bash
# Pick one of your open PRs, from anywhere, and open its diff to read.
#
# Shell rather than part of fleet because every machine has this and only some
# have fleet. The data comes from `pr-list`, which is the one place that knows
# how to ask a provider for PRs; this is the picker and the window.
#
# Fetches, never checks out. `gh pr checkout` switches branches, which aborts
# outright when the repo has uncommitted work and disturbs it when it does not —
# for reading, that is all cost. Check it out yourself to run the code.
#
# nvim listens on a socket so a Claude split into the window can be asked what is
# under the cursor. That session did not write the code, which is exactly why it
# is the right one to ask.

set -euo pipefail

die() {
  echo "prs: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: prs [--list]

Pick an open PR and open its diff in a tmux window. --list prints them instead.
EOF
}

# Both surfaces print the branch, so what a branch cell says lives in one
# definition rather than in each. A stack shows as `branch ← #parent` inside the
# cell rather than as a sixth column, which would cost every row width to say
# something about a handful. The parent is its number: two long branch names in
# one cell is the unreadable version.
#
# What counts as stacked is read out of the listing — a base that is some other
# open PR's head — because pr-list reports no default branch, so testing base
# against a literal "main" would mark every row of a repo that defaults to
# master. The lookup is keyed on slug and branch together. Branch names recur
# across the registry, and `repo` is a bare basename — pr-list searches all of
# GitHub and filters to the registry by name alone, so a PR authored upstream in
# someone else's `typos` arrives under the same `repo` as your own and would be
# paired with it. `open_pr_heads` reads the whole listing, so it is built once
# and passed in rather than rebuilt per row.
#
# `repo_cell` is the display half of that same collision. pr-list only fills
# `path` once it has confirmed the local checkout really is the PR's repository,
# so an empty one means this row is not the registry repo it shares a name with —
# and the cell widens to the full `owner/name` to say so. Showing the slug on
# every row instead would charge every line for the rare case.
#
# A quoted heredoc rather than a single-quoted string: shellcheck reads jq's own
# `$heads` and `$p` in a bare assignment as shell expansions it should warn about
# (SC2016), and it does not follow them into the jq call that consumes them.
branch_cell_jq=$(
  cat <<'JQ'
def open_pr_heads:
  reduce (.[] | select((.branch // "") != "")) as $p
    ({}; .[$p.slug][$p.branch] = $p.number);
def branch_cell($heads):
  (if (.branch // "") == "" then "-" else .branch end) as $cell
  | ($heads[.slug][.base // ""] // null) as $parent
  | if $parent == null or $parent == .number then $cell
    else "\($cell) ← #\($parent)" end;
def repo_cell:
  if (.path // "") == "" then .slug else .repo end;
JQ
)

case "${1:-}" in
  --help | -h)
    usage
    exit 0
    ;;
  --list)
    # Labelled, and the branch before the title, because this is the shape
    # `gh pr list` and `bbkt pr list` both already print — five unlabelled
    # columns read as a log line rather than a table. The title goes last as the
    # one unbounded field: anything after it either misaligns when a title runs
    # long or forces an arbitrary clip width, and the columns before it are the
    # ones you retype, which must never be the truncated end of a row.
    #
    # The space inside the stack marker is only safe because `-s` is a tab; drop
    # it and column splits the marker into two columns.
    pr-list | jq -r "$branch_cell_jq"'
      if length == 0 then "No open PRs."
      else
        open_pr_heads as $heads
        | ["REPO", "PR", "AGE", "BRANCH", "TITLE"],
        (.[] | [
          repo_cell,
          "#\(.number)",
          "\(.age_days)d",
          branch_cell($heads),
          (if .draft then "\(.title) (draft)" else .title end)
        ])
      end
      | if type == "array" then @tsv else . end
    ' | column -t -s $'\t'
    exit 0
    ;;
  "") ;;
  *) die "unknown argument: $1" ;;
esac

[ -n "${TMUX:-}" ] || die "not inside tmux — this opens a review window"
for tool in jq fzf nvim git; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
done

prs_json=$(pr-list)
[ "$(jq 'length' <<<"$prs_json")" -gt 0 ] || die "no open PRs"

# The index leads and is hidden (--with-nth=2..), so the choice survives a title
# containing a tab or a leading number.
#
# The branch rides in the displayed line because fzf can only match what it
# shows: without it, typing the branch you are working on finds nothing, and the
# branch is the one thing you know for certain about the PR you came to read.
#
# It carries the stack marker too. This is the surface where a PR is chosen for
# review, so a child reading here as ordinary work against the default branch is
# where the omission actually costs a wrong review.
chosen=$(jq -r "$branch_cell_jq"'
  open_pr_heads as $heads
  | to_entries[]
  | [
    .key,
    (.value | repo_cell),
    "#\(.value.number)",
    "\(.value.age_days)d",
    (.value | branch_cell($heads)),
    .value.title
  ]
  | @tsv
' <<<"$prs_json" \
  | fzf --delimiter=$'\t' --with-nth='2..' --no-sort --prompt='pr > ' --height=40% --reverse) || exit 0
[ -n "$chosen" ] || exit 0

idx=${chosen%%$'\t'*}
pr=$(jq --argjson i "$idx" '.[$i]' <<<"$prs_json")

repo=$(jq -r '.repo' <<<"$pr")
number=$(jq -r '.number' <<<"$pr")
path=$(jq -r '.path' <<<"$pr")

[ -n "$path" ] || die "$repo is not checked out on this machine"
[ -d "$path" ] || die "$repo is registered at $path, which does not exist"

# Take the base from the listing rather than assuming the default branch: a PR
# stacked on another targets its parent, and diffing that against main shows both
# as one. pr-list carries it, so the round trip a `gh pr view` per PR cost is
# gone; the local fallback stays for a provider whose listing does not report it.
base=$(jq -r '.base // ""' <<<"$pr")
[ -n "$base" ] || base=$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
[ -n "$base" ] || die "could not work out what PR #$number is based on"

ref="refs/remotes/origin/pr/$number"
git -C "$path" fetch --quiet --force origin "pull/$number/head:$ref" \
  || die "could not fetch PR #$number in $repo"
git -C "$path" fetch --quiet origin "$base" 2>/dev/null || true

git -C "$path" rev-parse --verify --quiet "origin/$base" >/dev/null \
  || die "$repo has no origin/$base to diff against"

sock="${TMPDIR:-/tmp}/fleet-pr-${repo}-${number}.sock"
rm -f "$sock"

# Three-dot: from where the branch diverged to its tip, which is what the forge
# shows. Two-dot would render commits the base gained since branching as changes
# this PR reverted.
tmux new-window -n "pr $repo #$number" -c "$path" \
  "nvim --listen '$sock' -c 'DiffviewOpen origin/$base...$ref'"
