#!/usr/bin/env bash
# shellcheck shell=bash

### CREDIT ###
# https://github.com/ivours/awsprofile

### USAGE ###
# This script must be SOURCED to work with shell prompts:
#   source aws-profiles
# or
#   . aws-profiles
#
# DO NOT run as: ./aws-profiles (environment variables won't persist)
#
#   source aws-profiles --refresh   re-resolve every account before listing
#
# Everything except the export is in aws_profiles.py — config parsing, the STS
# lookups, the menu and the prompt. Exporting into the shell you are sitting in
# is the one thing a subprocess cannot do, so this file stays shell and stays
# sourced. It reads a decision from the helper's stdout while the menu goes to
# stderr, which is what lets the answer be captured without hiding the UI.

_AWS_PROFILES_PY="$HOME/.local/share/aws-profiles/aws_profiles.py"

if [[ ! -f "$_AWS_PROFILES_PY" ]]; then
  echo "aws-profiles: helper not found at $_AWS_PROFILES_PY — run 'dotfiles link'" >&2
else
  _aws_profiles_decision=$(/usr/bin/python3 "$_AWS_PROFILES_PY" "$@")

  IFS=$'\t' read -r _aws_action _aws_profile _aws_region <<<"$_aws_profiles_decision"

  case "${_aws_action:-}" in
    set)
      export AWS_PROFILE="$_aws_profile"
      if [[ -n "$_aws_region" ]]; then
        export AWS_REGION="$_aws_region"
        export AWS_DEFAULT_REGION="$_aws_region"
        echo "AWS profile $_aws_profile and region $_aws_region have been set."
      else
        echo "AWS profile $_aws_profile has been set."
      fi
      ;;
    clear)
      unset AWS_PROFILE AWS_REGION AWS_DEFAULT_REGION
      echo "The AWS profile has been cleared."
      ;;
  esac
fi

unset _AWS_PROFILES_PY _aws_profiles_decision _aws_action _aws_profile _aws_region
