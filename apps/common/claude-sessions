#!/usr/bin/env bash
# ================================================================
# claude-sessions - Live Claude Code sessions on this machine
# ================================================================
# Reads the session registry directly. `claude agents --json` is the
# supported interface and was measured against it: ~356ms per call, because
# it boots a full node process, against a few milliseconds per session here.
# It also omits the tmux pane that makes a row worth jumping to.
#
# This is the per-machine half of a fleet-wide listing: `fleet claude
# sessions list` reaches other boxes by running this over ssh, so the
# registry read has one implementation and the liveness test runs where the
# pid means something.
# ================================================================

set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
REGISTRY_DIR="$CONFIG_DIR/sessions"
PROJECTS_DIR="$CONFIG_DIR/projects"

# Claude Code writes a session's title lines again every few dozen lines, so the
# newest sits well inside the last mebibyte of even a large transcript.
readonly TITLE_TAIL_BYTES=1048576

readonly PANE_FORMAT=$'#{pane_id}\t#{window_id}\t#{session_name}\t#{window_index}\t#{window_name}\t#{automatic-rename}'

# A /rename or `claude -n` writes a `custom-title` line, and Claude Code writes an
# `ai-title` line it generates from the first prompt. The newest of each is kept,
# and a rename outranks the generated title, as in Claude Code's own session list.
# The jq programs sit in quoted heredocs, which keep their `$` variables from the
# shell. `read -d ''` reaches the end with no NUL, so it returns 1.
IFS= read -r -d '' TITLES_BY_SESSION <<'JQ' || true
reduce (inputs | fromjson? | select(type == "object" and (.sessionId | type) == "string")) as $line ({};
  if $line.type == "custom-title" and ($line.customTitle | type) == "string" then .[$line.sessionId].custom = $line.customTitle
  elif $line.type == "ai-title" and ($line.aiTitle | type) == "string" then .[$line.sessionId].ai = $line.aiTitle
  else . end)
| map_values([.custom, .ai] | map(select(. != null and . != "")) | first)
JQ
readonly TITLES_BY_SESSION

# A live session's registry file can carry no `status`. It reads as `unknown`
# rather than a null each reader would render its own way. `tmux` is the pane's
# address when the session started, and `window` is the window holding that pane
# now, because a pane moved to another window keeps its id.
IFS= read -r -d '' ROWS <<'JQ' || true
def pane_id: (.tmux // "") | (capture("\\.(?<pane>%[0-9]+)$").pane // null);
($panes | split("\n") | map(split("\t") | select(length == 6)
  | {key: .[0], value: {id: .[1], tmuxSession: .[2], index: (.[3] | tonumber? // null), name: .[4], automaticRename: (.[5] == "1")}})
  | from_entries) as $windows
| map({name, nameSource, title: (if (.sessionId | type) == "string" then $titles[.sessionId] else null end),
       sessionId, status: (.status // "unknown"), waiting: .waitingFor, cwd, tmux,
       window: (pane_id as $pane | if $pane then $windows[$pane] else null end),
       pid, agent, kind, entrypoint, startedAt})
| if $shape == "array" then .
  elif $shape == "object" then .[0]
  else .[] | [.name, .status, (.waiting // "-"), .cwd, (.tmux // "-")] | @tsv
  end
JQ
readonly ROWS

# formatting.sh is sourced here rather than at the top because the hot path
# runs over ssh from another machine, and every file this needs is another
# way for a row to go missing from the fleet listing.
show_help() {
  SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
  source "$SHELL_DIR/formatting.sh"
  help_header "claude-sessions" "Live Claude Code sessions on this machine."
  help_usage "claude-sessions [--self] [--json]"

  help_section "Output"
  help_row "claude-sessions" "" "TSV: name, status, waiting, dir, pane"
  help_row "claude-sessions --json" "" "The same rows as a JSON array"
  help_row "claude-sessions --self" "" "Only the session this process runs inside"
  help_row "claude-sessions --self --json" "" "That one row as a JSON object"

  help_section "Notes"
  help_row "" "" "NAME is the address peers message, as /list-agents shows it"
  help_row "" "" "STATUS is unknown where the session's registry file holds none"
  help_row "" "" "--json adds title: the transcript's last /rename, else its generated title"
  help_row "" "" "--json adds window: the tmux window holding the session's pane now"
  help_row "" "" "This machine only; a fleet-wide listing runs this on each box"
  help_row "" "" "--self exits 1 when no session owns the caller"
  help_end
}

# One compact descriptor per *live* session. The registry keeps one file per
# process, written at startup and removed on a clean exit, so a killed session
# leaves a file behind with a stale `status`. Trusting that field would report
# the dead as idle; the pid is the only honest liveness test, and it is only
# honest on the box that owns it.
#
# Each file is parsed alone. jq reads several files as one stream, so a file
# caught half-written would run its unterminated string into the next one and
# hide every session after it. A file that will not parse, or that vanished
# with its session, is skipped.
live_descriptors() {
  local file line
  for file in "$REGISTRY_DIR"/*.json; do
    [[ -f $file ]] || continue
    line=$(jq -R -s -r 'fromjson? | "\(.pid) \(tojson)"' "$file" 2>/dev/null) || continue
    [[ -n $line ]] || continue
    kill -0 "${line%% *}" 2>/dev/null && printf '%s\n' "${line#* }"
  done
  return 0
}

# The session this process is running inside, found by walking the parent chain
# until a pid the registry knows. A session has no other vantage on itself: the
# registry is keyed by pid, /list-agents omits the caller by construction, and
# nothing in the environment carries the name.
#
# procStart pins the identity wherever /proc answers. A descriptor outlives a
# session killed without a clean exit, so a recycled pid could otherwise put a
# dead session's name on a live one, and a wrong address is the whole fault this
# lookup exists to prevent. An answer missing from either side is not a mismatch.
owning_descriptor() {
  local pid=$$ start recorded
  while [[ -n $pid && $pid -gt 1 ]]; do
    if [[ -f $REGISTRY_DIR/$pid.json ]]; then
      start=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true)
      recorded=$(jq -r '.procStart // empty' "$REGISTRY_DIR/$pid.json")
      if [[ -z $start || -z $recorded || $start == "$recorded" ]]; then
        jq -c . "$REGISTRY_DIR/$pid.json"
        return 0
      fi
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d '[:space:]')
  done
  return 1
}

# A JSON object from session id to title, for the descriptors on stdin. Claude
# Code keeps a transcript under its launch directory with every character other
# than a letter or digit made a `-`. A session that moved into a worktree keeps
# writing there, so a transcript missing from its `cwd` is found by its id.
session_titles() {
  local -a transcripts=()
  local id cwd transcript
  while IFS=$'\t' read -r id cwd; do
    transcript=$PROJECTS_DIR/${cwd//[^A-Za-z0-9]/-}/$id.jsonl
    if [[ ! -f $transcript ]]; then
      transcript=$(compgen -G "$PROJECTS_DIR/*/$id.jsonl" | head -n 1) || true
    fi
    [[ -n $transcript && -f $transcript ]] && transcripts+=("$transcript")
  done < <(jq -r 'select((.sessionId | type) == "string" and (.cwd | type) == "string") | [.sessionId, .cwd] | @tsv')
  if ((${#transcripts[@]} == 0)); then
    printf '{}\n'
    return 0
  fi
  tail -q -c "$TITLE_TAIL_BYTES" -- "${transcripts[@]}" 2>/dev/null \
    | rg --no-config --no-line-number '"type": ?"(custom|ai)-title"' \
    | jq -R -n "$TITLES_BY_SESSION"
}

# The descriptors on stdin as the rows readers see, in the shape $1 names:
# array, object or tsv. The table shows neither title nor window, so it reads
# no transcript and asks no tmux server.
rows() {
  local shape=$1 descriptors titles='{}' panes=''
  descriptors=$(cat)
  if [[ $shape != tsv ]]; then
    titles=$(session_titles <<<"$descriptors") || true
    [[ -n $titles ]] || titles='{}'
    # A box with no tmux server answers with no panes, and every window is null.
    panes=$(tmux list-panes -a -F "$PANE_FORMAT" 2>/dev/null) || panes=''
  fi
  jq -r -s --arg shape "$shape" --argjson titles "$titles" --arg panes "$panes" "$ROWS" <<<"$descriptors"
}

main() {
  local want_json=false want_self=false descriptor shape

  while [[ $# -gt 0 ]]; do
    case $1 in
      -h | --help | help)
        show_help
        return 0
        ;;
      --json) want_json=true ;;
      --self) want_self=true ;;
      *)
        printf 'claude-sessions: unknown argument %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done

  if [[ $want_self == true ]]; then
    if [[ ! -d $REGISTRY_DIR ]] || ! descriptor=$(owning_descriptor); then
      printf 'claude-sessions: no live session owns this process\n' >&2
      return 1
    fi
    shape=tsv
    [[ $want_json == true ]] && shape=object
    printf '%s\n' "$descriptor" | rows "$shape"
    return 0
  fi

  if [[ ! -d $REGISTRY_DIR ]]; then
    [[ $want_json == true ]] && printf '[]\n'
    return 0
  fi

  shape=tsv
  [[ $want_json == true ]] && shape=array
  live_descriptors | rows "$shape"
}

main "$@"
