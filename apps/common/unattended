#!/usr/bin/env bash
# unattended - run a command with nobody watching, and report it if it dies.
#
# A scheduled job that fails on a workstation reports to nobody. Grafana and Loki
# watch the homelab and stop at the VLAN boundary — no workstation appears in
# `inventory/hosts.yml` — and no unit here carries an OnFailure. So a timer that
# died at 04:00 is discovered whenever someone happens to look.
#
# This wraps the command instead of using systemd's OnFailure, which would be the
# idiomatic answer on Linux and does not exist at all on macOS: launchd has no
# failure hook, so the Macs would need a wrapper regardless and building both
# means maintaining two mechanisms for one job. Wrapping also captures what the
# command actually said, where an OnFailure handler has to go mine the journal
# afterwards — and on macOS there is no journal to mine.
#
# It lives here rather than in fleet because every machine has this and only some
# have fleet, the same split as `pr-list` and `claude-sessions`. A box without
# fleet still runs its jobs; it just reports nowhere.

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"

DETAIL_LINES=100
# Enough to diagnose from, and a bound on what a runaway job can put in the
# store. The journal has the rest on Linux; on macOS this is all there is, which
# is why it is not lower.

show_help() {
  source "$SHELL_DIR/formatting.sh"
  help_header "unattended" "Run a command with nobody watching, and report it if it dies."
  help_usage "unattended [options] -- <command> [args...]"

  help_section "Options"
  help_row "--key" "KEY" "Stable identity of the problem (default: unattended/<command>-<subcommand>)"
  help_row "--title" "TEXT" "One line saying what is wrong (default: what exited with what)"
  help_row "--source" "NAME" "What produced the report (default: unattended)"
  help_row "--ok-exit" "N[,N…]" "Exit codes that mean the command answered (default: 0)"

  help_section "Examples"
  help_row "unattended -- backup-nightly" "" "Report if it exits non-zero"
  help_row "unattended --ok-exit 0,3 -- dotfiles check" "" "3 is a verdict, not a failure"

  help_section "Notes"
  help_row "" "" "The command's exit code is always passed through unchanged"
  help_row "" "" "stdout and stderr are merged, so the report carries what was said"
  help_row "" "" "Reporting never fails the run: no fleet, or a failed report, changes nothing"
  help_row "" "" "Run 'fleet errors list' for what has been reported"
  help_end
}

# Identity of the problem, not of the occurrence — a key carrying the moment
# turns one problem into one row per firing, which is how an inbox stops being
# read. The command and its first subcommand are what distinguish two jobs run
# from the same binary.
#
# Arguments:
#   $1  the command
#   $2  its subcommand, already normalised, or empty
# Outputs:
#   the derived key, on stdout
derive_key() {
  if [ -n "${2:-}" ]; then
    printf 'unattended/%s-%s' "${1##*/}" "$2"
  else
    printf 'unattended/%s' "${1##*/}"
  fi
}

# Arguments:
#   $1  the exit code
#   $2  the file holding the run's merged output
# Outputs:
#   the detail body, on stdout
build_detail() {
  local status="$1" captured="$2" total
  total=$(wc -l <"$captured" | tr -d ' ')
  if [ "$total" -gt "$DETAIL_LINES" ]; then
    printf 'exited %s; last %s of %s output lines:\n\n' "$status" "$DETAIL_LINES" "$total"
    tail -n "$DETAIL_LINES" "$captured"
  else
    printf 'exited %s:\n\n' "$status"
    cat "$captured"
  fi
}

main() {
  local key='' title='' source_name='unattended' ok_exits='0'

  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help | help)
        show_help
        exit 0
        ;;
      --key | --title | --source | --ok-exit)
        if [ $# -lt 2 ]; then
          printf 'unattended: %s needs a value\n' "$1" >&2
          exit 2
        fi
        case "$1" in
          --key) key="$2" ;;
          --title) title="$2" ;;
          --source) source_name="$2" ;;
          --ok-exit) ok_exits="$2" ;;
        esac
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        printf 'unattended: unknown option %s\n' "$1" >&2
        exit 2
        ;;
    esac
  done

  if [ $# -eq 0 ]; then
    printf 'unattended: no command given; put it after --\n' >&2
    exit 2
  fi

  # A flag is not a subcommand, and including one would put `-c` in the key of
  # every job that happens to be a shell invocation.
  local command_name="$1" subcommand="${2:-}"
  case "$subcommand" in
    -*) subcommand='' ;;
  esac
  [ -n "$key" ] || key=$(derive_key "$command_name" "$subcommand")

  local captured
  captured=$(mktemp)
  # shellcheck disable=SC2064  # expand captured now: it is gone by trap time otherwise
  trap "rm -f '$captured'" EXIT

  # tee rather than a plain redirect so the run still reaches the journal live —
  # a wrapper that swallowed the output until the end would make following a
  # slow job impossible. pipefail would report tee's status, so the command's
  # own comes from PIPESTATUS.
  local status=0
  set +e
  "$@" 2>&1 | tee "$captured"
  status=${PIPESTATUS[0]}
  set -e

  case ",$ok_exits," in
    *",$status,"*)
      exit "$status"
      ;;
  esac

  if command -v fleet >/dev/null 2>&1; then
    [ -n "$title" ] || title="${command_name##*/}${subcommand:+ $subcommand} exited $status"
    # Never fails the run. The job's own outcome is the thing being reported on,
    # and a wrapper that changed it would be reporting on itself.
    fleet errors report \
      --key "$key" \
      --title "$title" \
      --source "$source_name" \
      --detail "$(build_detail "$status" "$captured")" || true
  fi

  exit "$status"
}

main "$@"
