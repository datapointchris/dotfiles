#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# ///
"""Hold Go's build cache under a size, deleting the least recently used entries first.

    go-build-cache-trim --max-gib 20

Go trims its cache only by age: an entry unused for five days goes, and nothing
limits the total (`trimLimit` in cmd/go/internal/cache/cache.go). Many checkouts
of one repo, each building its own branch, fill a disk well inside five days.
This adds the size limit Go lacks, the way ccache's max_size does for C.

Go stamps an entry's mtime when a build uses it, at most once an hour, so mtime
orders entries by last use. An entry stamped within two hours may belong to a
build still running, so it stays even past the limit. Go's own trim keeps the
same margin.

The cache is the one `.zshenv` points Go at. A directory without Go's README is
refused, so a wrong path deletes nothing. One JSON line reports the run.
"""

import argparse
import contextlib
import json
import os
import shutil
import sys
import time
from pathlib import Path

GIB = 1024**3
IN_USE_SECONDS = 2 * 60 * 60
GO_README = 'This directory holds cached build artifacts from the Go build system.'


def cache_dir() -> Path:
    if gocache := os.environ.get('GOCACHE'):
        return Path(gocache)
    return Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'go-build'


def size_of(entry: os.DirEntry) -> int:
    """An output file's size, or the total under a directory, which is how Go caches a linked executable."""
    if not entry.is_dir(follow_symlinks=False):
        return entry.stat(follow_symlinks=False).st_size
    return sum((Path(root) / name).stat().st_size for root, _, names in os.walk(entry.path) for name in names)


def entries(cache: Path) -> list[tuple[float, int, str]]:
    """Each cache entry as (mtime, size, path), skipping Go's README, trim.txt and fuzz cache."""
    found = []
    for shard in os.scandir(cache):
        if not (shard.is_dir(follow_symlinks=False) and len(shard.name) == 2):
            continue
        for item in os.scandir(shard.path):
            if item.name.endswith(('-a', '-d')):
                with contextlib.suppress(FileNotFoundError):
                    found.append((item.stat(follow_symlinks=False).st_mtime, size_of(item), item.path))
    return found


def remove(path: str) -> None:
    """Go's own trim removes an executable's directory whole, and a file on its own."""
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path, ignore_errors=True)
    else:
        with contextlib.suppress(FileNotFoundError):
            os.remove(path)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--max-gib', type=float, required=True, help='size to hold the cache under, in GiB')
    args = parser.parse_args()
    limit = int(args.max_gib * GIB)
    cache = cache_dir()
    report: dict[str, object] = {'cache': str(cache), 'max_bytes': limit}

    if not cache.is_dir():
        print(json.dumps({**report, 'skipped': 'no cache here'}))
        return 0
    readme = cache / 'README'
    if not readme.is_file() or GO_README not in readme.read_text(errors='replace'):
        print(json.dumps({**report, 'refused': 'no Go README, so this is not a Go build cache'}))
        return 1

    now = time.time()
    found = sorted(entries(cache))
    total = sum(size for _, size, _ in found)
    report |= {'entries_before': len(found), 'bytes_before': total}

    removed = removed_bytes = 0
    newest_removed = None
    for mtime, size, path in found:
        if total <= limit or now - mtime < IN_USE_SECONDS:
            break
        remove(path)
        total -= size
        removed += 1
        removed_bytes += size
        newest_removed = mtime

    report |= {
        'entries_removed': removed,
        'bytes_removed': removed_bytes,
        'bytes_after': total,
        'newest_removed_unused_seconds': None if newest_removed is None else round(now - newest_removed),
        'over_limit_in_use': total > limit,
    }
    print(json.dumps(report))
    return 0


if __name__ == '__main__':
    sys.exit(main())
