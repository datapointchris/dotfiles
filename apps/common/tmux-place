#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Decide where an agent's pane goes, so that no pane ends up too small to read.

    tmux-place show                    every window this tool can place into
    tmux-place plan worker             where a worker would go, without going there
    tmux-place plan reviewer --for %26 where its reviewer would go
    tmux-place open worker -- <cmd>    make the pane and run <cmd> in it

A coordinator that dispatches agents by splitting its own pane divides the window
by two every time. Five splits in one column measured 186x15, which is too short
to follow an agent working, and the relief was `tmux break-pane` typed by hand.
This is that hand step: the window is measured, the pane goes where it still fits,
and when nothing fits the layout is rearranged until something does.

The decision is pure computation. `place()` takes window dimensions, the panes
already there, and what is being placed, and returns which pane to split, which
way, and how wide -- or that a window has to be opened. Every tmux call lives
below it and does what it was told. That is what makes the interesting behaviour
-- the size rule, pair adjacency, the coordinator's promotion -- reachable from a
test with no tmux running.

A pair is a unit. A reviewer sits directly below the worker it reviews, in that
worker's column, always, because the two are read against each other.

Panes are marked with tmux user options rather than tracked anywhere. A pane
carries its own role and its own partner, so `break-pane` and `join-pane` move a
pane without the marks going stale -- which is exactly what an address, a window
id or a process id does not survive.

A pane with no mark is one this tool did not place. It is neither a worker nor
spare room: it counts against what the window can hold and is never split, moved
or reused. Chris opens panes by hand constantly, and a layout that rearranged one
of them would lose work that nothing can recover.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from dataclasses import replace
from enum import StrEnum
from typing import Any

MIN_COLUMNS = 120
MIN_ROWS = 35
"""The smallest pane an agent can be followed in, measured rather than chosen.

A Claude session wraps its prose to the pane, and under about 120 columns the
wrapping breaks up a sentence badly enough that reading it stops being possible
at a glance. Under about 35 rows a tool call and its result cannot both be on
screen, so following the work means scrolling.

Every other number here is derived from these two against the window in front of
it. A 377x81 window holds three columns of 125 and two rows of 40; a narrower
client holds fewer, and that is the whole point of deriving rather than fixing a
layout that is right on one screen and collapses on the next.
"""

PANE_ROLE = 'place_role'
PANE_PAIR = 'place_pair'
"""The tmux pane user options carrying what a pane is, and whose reviewer it is.

Per-pane, so they ride along through `break-pane` and `join-pane` -- verified on
tmux 3.7c across both hops. `@place_pair` holds the worker's pane id on a
reviewer and is empty on everything else.
"""

MONITOR_COMMAND = 'abtop'
"""What goes beside the coordinator once it has a window of its own.

A machine without it promotes the coordinator anyway and says so. Losing a
dashboard is not a reason to leave five agents in one column.
"""

USAGE_ERROR = 2
"""A caller retries this with different arguments, as against a run that failed
on its own terms. argparse already exits 2 for a flag it cannot parse."""


class Usage(Exception):
    """Bad invocation or unusable input: exits 2, not 1."""


def err(*parts: object) -> None:
    """Diagnostics go to stderr; stdout carries data only."""
    print(*parts, file=sys.stderr)


class Role(StrEnum):
    COORDINATOR = 'coordinator'
    WORKER = 'worker'
    REVIEWER = 'reviewer'
    MONITOR = 'monitor'
    UNKNOWN = 'unknown'
    """A pane this tool did not place. Deliberately its own outcome rather than a
    fifth kind of ours: it is counted and never touched."""


PLACED = frozenset({Role.COORDINATOR, Role.WORKER, Role.REVIEWER, Role.MONITOR})
AGENTS = frozenset({Role.COORDINATOR, Role.WORKER, Role.REVIEWER})


class Direction(StrEnum):
    BESIDE = 'beside'
    BELOW = 'below'


@dataclass(frozen=True)
class Pane:
    pane_id: str
    left: int
    top: int
    width: int
    height: int
    role: Role = Role.UNKNOWN
    pair: str = ''


@dataclass(frozen=True)
class Window:
    """A window and its panes, where the dimensions are the reconciled ones.

    `#{window_width}` is not reliable on its own. A window that has never been
    displayed keeps tmux's default 80x24 while the panes inside it are sized to
    the real client -- measured on this server, where `@1` reported an 80x24
    window holding a 377x81 pane. Taking the larger of the two readings is what
    makes a detached or never-shown window place the same as an attached one,
    which is the case the whole size rule would otherwise get wrong.
    """

    window_id: str
    width: int
    height: int
    panes: tuple[Pane, ...] = ()
    session: str = ''

    @property
    def columns(self) -> tuple[tuple[Pane, ...], ...]:
        """The panes grouped into columns, left to right and top to bottom.

        Read off `pane_left` rather than off the layout string, because the
        question here is which panes share a column and a layout string answers
        the different question of how the splits nest.
        """
        grouped: dict[int, list[Pane]] = {}
        for pane in self.panes:
            grouped.setdefault(pane.left, []).append(pane)
        return tuple(tuple(sorted(group, key=lambda pane: pane.top)) for _, group in sorted(grouped.items()))

    def without(self, pane_id: str) -> Window:
        """This window as it would be with one pane gone, for costing a promotion."""
        return replace(self, panes=tuple(pane for pane in self.panes if pane.pane_id != pane_id))

    def holds(self, pane_id: str) -> bool:
        return any(pane.pane_id == pane_id for pane in self.panes)


def reconcile(width: int, height: int, panes: Sequence[Pane]) -> tuple[int, int]:
    """A window's real extent: the larger of what tmux calls it and what it renders.

    A pane's right edge is `pane_left + pane_width`, and the rightmost of those is
    how wide the window has to be. The heights come out one short of the window,
    because each pane gives a row to its border, so the reading is only ever used
    to correct a window that is reported far smaller than its own contents.
    """
    if not panes:
        return width, height
    return (
        max(width, max(pane.left + pane.width for pane in panes)),
        max(height, max(pane.top + pane.height for pane in panes)),
    )


def fits_across(width: int) -> int:
    """How many readable columns a given width holds, dividers included.

    `n` columns need `n * MIN_COLUMNS + (n - 1)`, so the answer is
    `(width + 1) // (MIN_COLUMNS + 1)`. The divider is why this is not a plain
    floor division: at 240 columns a plain floor says two and two 120-wide panes
    with a divider between them need 241.
    """
    return max(0, (width + 1) // (MIN_COLUMNS + 1))


def fits_down(height: int) -> int:
    """How many readable panes a given height stacks, dividers included."""
    return max(0, (height + 1) // (MIN_ROWS + 1))


def even_share(extent: int, parts: int) -> int:
    """One part's size when `extent` is divided `parts` ways with dividers between.

    The remainder goes to the last part, which is what tmux does when the columns
    are resized left to right.
    """
    return (extent - (parts - 1)) // parts if parts > 0 else extent


def ours(column: Sequence[Pane]) -> bool:
    """Whether a whole column is panes this tool placed.

    All of them, not any: a column holding one hand-made pane is somebody's work
    and splitting it would be the loss this tool exists to avoid.
    """
    return bool(column) and all(pane.role in PLACED for pane in column)


def free_columns(window: Window) -> int:
    """How many more columns this window can hold at a readable width.

    The width a hand-made pane occupies is subtracted before the rule is applied,
    along with its divider. Without that the count describes a window we do not
    have: a 250-wide pane somebody else opened leaves 126 columns of room, and
    dividing the whole 377 says three more columns fit.
    """
    theirs = [column for column in window.columns if not ours(column)]
    reserved = sum(column[0].width + 1 for column in theirs)
    mine = len(window.columns) - len(theirs)
    return max(0, fits_across(window.width - reserved) - mine)


def eligible(window: Window) -> bool:
    """Whether a pair may be placed in this window.

    Two conditions. It already holds an agent, so a window full of somebody
    else's work is never commandeered. And it holds no monitor -- the pane beside
    a promoted coordinator is what marks that window as the coordinator's own, so
    agents stop landing there once it exists.
    """
    roles = {pane.role for pane in window.panes}
    return bool(roles & AGENTS) and Role.MONITOR not in roles


def rightmost_ours(window: Window) -> Pane | None:
    """The top pane of the rightmost column this tool placed, or None.

    A new column is made by splitting an existing pane, so it has to be one of
    ours. Rightmost, so the new column arrives on the right and the panes already
    on screen do not shuffle sideways.
    """
    for column in reversed(window.columns):
        if ours(column):
            return column[0]
    return None


def pane_in(windows: Sequence[Window], pane_id: str) -> tuple[Window, Pane] | None:
    for window in windows:
        for pane in window.panes:
            if pane.pane_id == pane_id:
                return window, pane
    return None


@dataclass(frozen=True)
class Promotion:
    """Move the coordinator to a window of its own before the placement happens.

    Triggered by need: the window is full, and the coordinator is the one pane in
    it that has somewhere else to be. It is never reversed when agents finish and
    space frees up -- a layout that reflowed on every completion would move
    everything under the eye reading it, and nobody asked for that.
    """

    pane: str
    window_name: str
    monitor_width: int
    monitor_command: str

    def as_json(self) -> dict[str, Any]:
        return {
            'pane': self.pane,
            'window_name': self.window_name,
            'monitor_width': self.monitor_width,
            'monitor_command': self.monitor_command,
        }


@dataclass(frozen=True)
class Placement:
    """Where one pane goes, and what has to happen first.

    `window` empty means open a new one; `near` then says which window to open it
    after, so it lands in that window's session rather than wherever tmux would
    have put it.
    """

    role: Role
    window: str
    near: str
    target: str
    direction: Direction
    size: int
    balance: bool
    readable: bool
    why: str
    pair: str = ''
    promote: Promotion | None = None

    @property
    def opens_window(self) -> bool:
        return not self.window

    def as_json(self) -> dict[str, Any]:
        return {
            'role': str(self.role),
            'window': self.window,
            'near': self.near,
            'target': self.target,
            'direction': str(self.direction),
            'size': self.size,
            'balance': self.balance,
            'readable': self.readable,
            'why': self.why,
            'pair': self.pair,
            'opens_window': self.opens_window,
            'promote': self.promote.as_json() if self.promote else None,
        }


@dataclass(frozen=True)
class Request:
    """What is being placed, and who is asking.

    `caller` is the coordinator's pane. It is passed in rather than looked up
    because the first placement happens before anything is marked, and the pane
    running the command is the coordinator by definition.
    """

    role: Role
    caller: str
    partner: str = ''
    window_name: str = 'agents'
    monitor_command: str = MONITOR_COMMAND


def place(windows: Sequence[Window], request: Request) -> Placement:
    """Where the requested pane goes. Pure: nothing here touches tmux."""
    if request.role is Role.REVIEWER:
        return beneath(windows, request)
    if request.role is Role.WORKER:
        return alongside(windows, request)
    raise Usage(f'nothing places a {request.role}; place a worker or a reviewer')


def beneath(windows: Sequence[Window], request: Request) -> Placement:
    """A reviewer, directly below the worker it reviews.

    There is no search. The pair is the unit being read, so the reviewer's
    position is decided by its worker and the only open question is whether the
    result is tall enough -- which it is not when the client itself is under two
    readable rows, and saying so is better than putting the pair where it cannot
    be seen together.
    """
    if not request.partner:
        raise Usage('a reviewer needs the worker it reviews: --for %<pane>')

    found = pane_in(windows, request.partner)
    if found is None:
        raise Usage(f'no pane {request.partner} on this server')
    window, worker = found
    if worker.role is not Role.WORKER:
        raise Usage(f'{request.partner} is a {worker.role}, and a reviewer sits below a worker')

    taken = [pane for pane in window.panes if pane.role is Role.REVIEWER and pane.pair == worker.pane_id]
    if taken:
        raise Usage(f'{request.partner} already has a reviewer in {taken[0].pane_id}')

    rows = even_share(worker.height, 2)
    readable = rows >= MIN_ROWS and worker.height - 1 - rows >= MIN_ROWS
    why = f'below its worker in {window.window_id}, splitting {worker.height} rows into {rows} and {worker.height - 1 - rows}'
    if not readable:
        why += f'; each half needs {MIN_ROWS} rows and this client gives the window {window.height}'
    return Placement(
        role=Role.REVIEWER,
        window=window.window_id,
        near='',
        target=worker.pane_id,
        direction=Direction.BELOW,
        size=rows,
        balance=False,
        readable=readable,
        why=why,
        pair=worker.pane_id,
    )


def alongside(windows: Sequence[Window], request: Request) -> Placement:
    """A worker, in a new column of whichever window still has room for one.

    Three branches in order, and the order is the behaviour. Pack an existing
    window up to its ceiling first. Then free a column by promoting the
    coordinator, which is what turns the coordinator's window into three pairs
    rather than two pairs and an overflow. Only then open a window.
    """
    home = next((window for window in windows if window.holds(request.caller)), None)

    roomy = [window for window in windows if eligible(window) and free_columns(window) > 0]
    if roomy:
        chosen = min(roomy, key=lambda window: preference(window, request.caller))
        return column_in(chosen, 'has room for another column')

    if home is not None and eligible(home):
        opened = home.without(request.caller)
        if free_columns(opened) > 0 and any(pane.role is Role.WORKER for pane in opened.panes):
            promotion = Promotion(
                pane=request.caller,
                window_name=f'{request.window_name}-coordinator',
                monitor_width=MIN_COLUMNS,
                monitor_command=request.monitor_command,
            )
            placement = column_in(opened, 'the coordinator moved out, which freed its column')
            return replace(placement, promote=promotion)

    width = home.width if home is not None else 0
    height = home.height if home is not None else 0
    return Placement(
        role=Role.WORKER,
        window='',
        near=home.window_id if home is not None else '',
        target='',
        direction=Direction.BESIDE,
        size=width,
        balance=False,
        readable=width >= MIN_COLUMNS and height >= MIN_ROWS,
        why='every window this tool placed into is full, so the pair gets one of its own',
    )


def preference(window: Window, caller: str) -> tuple[int, int, int]:
    """Which of several roomy windows to fill: the fullest, then the caller's.

    Fullest first is what packing to the ceiling means. Spreading pairs evenly
    across half-empty windows reaches the same total in more windows, and every
    one of those is a window Chris has to switch to.
    """
    mine = len([column for column in window.columns if ours(column)])
    return (-mine, 0 if window.holds(caller) else 1, window_order(window.window_id))


def window_order(window_id: str) -> int:
    """`@11` sorts after `@2`, which a string comparison gets backwards."""
    digits = window_id.lstrip('@')
    return int(digits) if digits.isdigit() else 0


def column_in(window: Window, why: str) -> Placement:
    """A new column in a window that has room, and the width every column becomes.

    The split itself is made without a size and tmux halves the pane it lands on.
    The width is applied afterwards by resizing each column in turn, which is the
    only order that works: the pane being sized into existence has no id until it
    exists, and asking tmux for a pane wider than the one being split is refused.
    """
    target = rightmost_ours(window)
    if target is None:
        raise Usage(f'{window.window_id} holds no pane this tool placed, so there is nothing to split')

    theirs = [column for column in window.columns if not ours(column)]
    reserved = sum(column[0].width + 1 for column in theirs)
    mine = len(window.columns) - len(theirs) + 1
    width = even_share(window.width - reserved, mine)
    return Placement(
        role=Role.WORKER,
        window=window.window_id,
        near='',
        target=target.pane_id,
        direction=Direction.BESIDE,
        size=width,
        balance=not theirs,
        readable=width >= MIN_COLUMNS,
        why=f'{window.window_id} {why}, so {mine} columns of {width}',
    )


PANE_FIELDS = '\t'.join(
    (
        '#{window_id}',
        '#{pane_id}',
        '#{pane_left}',
        '#{pane_top}',
        '#{pane_width}',
        '#{pane_height}',
        f'#{{@{PANE_ROLE}}}',
        f'#{{@{PANE_PAIR}}}',
    )
)
"""An unset user option renders as an empty field rather than being dropped, so a
tab-separated row always carries eight fields and a pane with no marks parses the
same way as one with both."""

WINDOW_FIELDS = '#{window_id}\t#{window_width}\t#{window_height}\t#{session_name}'
"""The session name is last and is the only free-text field asked for.

A tmux session name can hold a space -- Chris has one called `de initiative` --
and nothing stops it holding a tab either, so a field after it would be shifted
by its contents. Reading one such field and splitting with a maxsplit puts
whatever it contains in the tail where it can do no harm. The window name would
be a second one, so it is not read at all; nothing here addresses a window by
name.
"""


def tmux(*args: str) -> str:
    done = subprocess.run(['tmux', *args], capture_output=True, text=True)
    if done.returncode != 0:
        raise Usage(f'tmux {" ".join(args)}: {done.stderr.strip()}')
    return done.stdout


def tmux_ok(*args: str) -> bool:
    """For a call whose failure is cosmetic. A pane already exists by then, and
    losing a running agent over a resize would be the worse outcome."""
    return subprocess.run(['tmux', *args], capture_output=True, text=True).returncode == 0


def read_role(name: str) -> Role:
    try:
        return Role(name)
    except ValueError:
        return Role.UNKNOWN


def parse_window(line: str) -> tuple[str, int, int, str]:
    """One `WINDOW_FIELDS` row: the id, its size, and the session it is in.

    The maxsplit is what makes the session name safe. It is the last field and it
    can hold anything, so the split stops before it and whatever it contains --
    spaces, tabs -- stays in the tail instead of shifting a column.
    """
    window_id, width, height, session = line.split('\t', 3)
    return window_id, int(width), int(height), session


def parse_pane(line: str) -> tuple[str, Pane]:
    """One `PANE_FIELDS` row: which window it is in, and the pane.

    Eight fields always, because an unset user option renders as an empty field
    rather than being dropped. So a pane nobody marked parses the same way as one
    carrying both marks, and comes back `UNKNOWN` rather than as a parse failure.
    """
    window_id, pane_id, left, top, width, height, role, pair = line.split('\t')
    return window_id, Pane(
        pane_id=pane_id,
        left=int(left),
        top=int(top),
        width=int(width),
        height=int(height),
        role=read_role(role),
        pair=pair,
    )


def read_workspace() -> tuple[Window, ...]:
    """Every window on the server, with its panes, sizes and marks."""
    sizes: dict[str, tuple[int, int, str]] = {}
    for line in tmux('list-windows', '-a', '-F', WINDOW_FIELDS).splitlines():
        window_id, width, height, session = parse_window(line)
        sizes[window_id] = (width, height, session)

    panes: dict[str, list[Pane]] = {}
    for line in tmux('list-panes', '-a', '-F', PANE_FIELDS).splitlines():
        window_id, pane = parse_pane(line)
        panes.setdefault(window_id, []).append(pane)

    windows = []
    for window_id, (width, height, session) in sizes.items():
        members = tuple(panes.get(window_id, ()))
        across, down = reconcile(width, height, members)
        windows.append(Window(window_id=window_id, width=across, height=down, session=session, panes=members))
    return tuple(windows)


def mark(pane_id: str, role: Role, pair: str = '') -> None:
    """Record what a pane is, on the pane itself."""
    tmux('set-option', '-p', '-t', pane_id, f'@{PANE_ROLE}', str(role))
    if pair:
        tmux('set-option', '-p', '-t', pane_id, f'@{PANE_PAIR}', pair)


def caller_pane() -> str:
    """The pane this ran in, which is the coordinator's.

    tmux exports $TMUX_PANE into everything it starts, so the address is already
    in the environment and nothing has to be passed. Outside tmux there is no
    workspace to place into and no pane to split.
    """
    if shutil.which('tmux') is None:
        raise Usage('tmux is not installed, and a pane is the only thing this places')
    pane = os.environ.get('TMUX_PANE')
    if not os.environ.get('TMUX') or not pane:
        raise Usage('not inside tmux, so there is no pane to place beside')
    return pane


def perform_promotion(promotion: Promotion) -> str:
    """Break the coordinator out to its own window and put the monitor beside it.

    `break-pane -d` leaves the focus where it was. The coordinator is mid-turn
    when this runs, and moving the cursor interrupts whoever is reading it.

    The monitor is best effort. A machine without it gets the promotion anyway,
    because the promotion is what relieves the crowded window and the dashboard
    is what goes in the space left over.
    """
    window = tmux('break-pane', '-d', '-P', '-F', '#{window_id}', '-s', promotion.pane, '-n', promotion.window_name).strip()
    if shutil.which(promotion.monitor_command) is None:
        err(f'{promotion.monitor_command} is not installed, so the coordinator gets its window without one')
        return window

    made = tmux(
        'split-window',
        '-d',
        '-h',
        '-l',
        str(promotion.monitor_width),
        '-P',
        '-F',
        '#{pane_id}',
        '-t',
        promotion.pane,
        promotion.monitor_command,
    ).strip()
    mark(made, Role.MONITOR)
    return window


COLUMN_FIELDS = '#{pane_id}\t#{pane_left}'


def balance_columns(window_id: str, width: int) -> None:
    """Reflow one window's columns to an even width, left to right.

    tmux halves the pane a split lands on, which is the whole reason a coordinator
    that dispatched four agents ends up reading its own work in a sixteenth of the
    window. Each column is resized in turn and the last is left alone to absorb
    the remainder, which is what `even_share` already assumed.

    The window is re-read rather than predicted, because this runs after the split
    and the pane it made had no id until then. One pane per column is enough: the
    panes in a stacked column share their width, so resizing any of them moves the
    whole column and a pair is sized by whichever half answers first.
    """
    leaders: dict[int, str] = {}
    for line in tmux('list-panes', '-t', window_id, '-F', COLUMN_FIELDS).splitlines():
        pane_id, left = line.split('\t')
        leaders.setdefault(int(left), pane_id)
    for edge in sorted(leaders)[:-1]:
        tmux_ok('resize-pane', '-t', leaders[edge], '-x', str(width))


def execute(placement: Placement, command: Sequence[str], cwd: str, window_name: str) -> str:
    """Carry out one placement and return the id of the pane it made.

    Everything is addressed by `#{pane_id}` and `#{window_id}`. Pane indices
    renumber on every split, so an index read before a split names a different
    pane after it -- measured while the geometry for this was being taken, where
    targeting index 3 after splitting index 2 hit the first column's lower half.

    `-P -F` is tmux's own answer for what it just made, so nothing is matched back
    afterwards by comparing a pane list before against after.

    `-f` is what makes a new column a column. Without it `split-window -h` splits
    the pane it was given, and the pane at the top of a stacked pair occupies only
    the upper half of its column -- so the new pane arrives beside that half while
    the reviewer underneath keeps spanning the original width. Measured: a second
    pair placed that way came out 125x20 with its neighbour's reviewer 251 columns
    wide across two columns. With `-f` the split is taken at the window's top
    level, the row stays flat, and the widths reflow. It is never used on a
    stacked split, where it would span the window and take the reviewer out of its
    worker's column.
    """
    if placement.promote is not None:
        perform_promotion(placement.promote)

    run = ['-c', cwd] if cwd else []
    payload = [shlex.join(command)] if command else []

    if placement.opens_window:
        after = ['-a', '-t', placement.near] if placement.near else []
        made = tmux('new-window', '-d', *after, '-n', window_name, '-P', '-F', '#{pane_id}', *run, *payload).strip()
    else:
        axis = ['-h', '-f'] if placement.direction is Direction.BESIDE else ['-v']
        # A size is given for a stacked split, where nothing reflows afterwards, and
        # withheld for a new column, where balancing sets every width at once. Asking
        # tmux for a column wider than the pane being split is refused outright.
        size = ['-l', str(placement.size)] if placement.direction is Direction.BELOW else []
        made = tmux('split-window', '-d', *axis, *size, '-P', '-F', '#{pane_id}', '-t', placement.target, *run, *payload).strip()

    mark(made, placement.role, placement.pair)

    if placement.balance:
        balance_columns(placement.window, placement.size)
    return made


def describe(placement: Placement) -> str:
    where = 'a new window' if placement.opens_window else f'{placement.direction} {placement.target} in {placement.window}'
    lines = []
    if placement.promote is not None:
        lines.append(f'first: move {placement.promote.pane} to a window named {placement.promote.window_name}')
        lines.append(f'       with {placement.promote.monitor_command} beside it at {placement.promote.monitor_width} columns')
    lines.append(f'place: {placement.role} {where}, {placement.size} {"rows" if placement.direction is Direction.BELOW else "columns"}')
    lines.append(f'  why: {placement.why}')
    if not placement.readable:
        lines.append(f'  ▲    under the {MIN_COLUMNS}x{MIN_ROWS} minimum, and there is nowhere on this client that is not')
    return '\n'.join(lines)


def request_from(args: argparse.Namespace) -> Request:
    return Request(
        role=Role(args.role),
        caller=caller_pane(),
        partner=args.partner or '',
        window_name=args.window_name,
        monitor_command=args.monitor,
    )


def cmd_show(as_json: bool) -> int:
    windows = read_workspace()
    if as_json:
        payload = [
            {
                'window': window.window_id,
                'session': window.session,
                'size': f'{window.width}x{window.height}',
                'columns': [[pane.pane_id for pane in column] for column in window.columns],
                'free': free_columns(window),
                'eligible': eligible(window),
                'panes': [
                    {'pane': pane.pane_id, 'role': str(pane.role), 'pair': pane.pair, 'size': f'{pane.width}x{pane.height}'}
                    for pane in window.panes
                ],
            }
            for window in windows
        ]
        print(json.dumps(payload, indent=2))
        return 0

    for window in windows:
        verdict = 'eligible' if eligible(window) else 'not placed into'
        size = f'{window.width}x{window.height}'
        room = f'{len(window.columns)} columns, {free_columns(window)} free'
        print(f'{window.window_id:5} {size:<9} {room}, {verdict}  [{window.session}]')
        for column in window.columns:
            for pane in column:
                pair = f' of {pane.pair}' if pane.pair else ''
                print(f'      {pane.pane_id:5} {pane.width}x{pane.height:<8} {pane.role}{pair}')
    return 0


def cmd_plan(args: argparse.Namespace) -> int:
    placement = place(read_workspace(), request_from(args))
    if args.json:
        print(json.dumps(placement.as_json(), indent=2))
    else:
        print(describe(placement))
    return 0


def cmd_open(args: argparse.Namespace) -> int:
    request = request_from(args)
    windows = read_workspace()

    # The coordinator is marked before anything is measured, because on the first
    # placement nothing carries a mark and an unmarked window is one this tool
    # will not place into. Marking the caller is what makes its window the
    # coordinator's rather than somebody else's.
    found = pane_in(windows, request.caller)
    if found is not None and found[1].role is Role.UNKNOWN:
        mark(request.caller, Role.COORDINATOR)
        windows = read_workspace()

    placement = place(windows, request)
    err(describe(placement))
    pane = execute(placement, args.command, args.cwd, args.window_name)

    if args.json:
        print(json.dumps(placement.as_json() | {'pane': pane}, indent=2))
    else:
        print(pane)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog='tmux-place', description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest='verb', required=True)

    show = sub.add_parser('show', help='every window this tool can place into')
    show.add_argument('--json', action='store_true', help='machine-readable output on stdout')

    for verb, help_text in [('plan', 'where a pane would go, without going there'), ('open', 'make the pane and run a command in it')]:
        command = sub.add_parser(verb, help=help_text)
        command.add_argument('role', choices=[str(Role.WORKER), str(Role.REVIEWER)], help='what is being placed')
        command.add_argument('--for', dest='partner', default='', metavar='%PANE', help='the worker a reviewer belongs to')
        command.add_argument('--window-name', default='agents', help='the name for a window this has to open (default: agents)')
        command.add_argument('--monitor', default=MONITOR_COMMAND, help=f'runs beside a promoted coordinator (default: {MONITOR_COMMAND})')
        command.add_argument('--json', action='store_true', help='machine-readable output on stdout')
        if verb == 'open':
            command.add_argument('--cwd', default='', help="the new pane's working directory")
            command.add_argument('command', nargs='*', help='what to run in it, after --')

    args = parser.parse_args()
    if args.verb == 'show':
        return cmd_show(args.json)
    if args.verb == 'plan':
        return cmd_plan(args)
    return cmd_open(args)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Usage as problem:
        err(f'tmux-place: {problem}')
        sys.exit(USAGE_ERROR)
