#!/usr/bin/env bash
# tool-usage - Report personal CLI tool usage frequency from shell history
# Note: add 'setopt EXTENDED_HISTORY' to .zshrc to enable last-used dates

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
# shellcheck source=/dev/null
source "$SHELL_DIR/formatting.sh"

HISTORY="${HISTFILE:-$HOME/.local/state/zsh/history}"

# Canonical registry location, matching toolbox's own resolution (TOOLBOX_REGISTRY
# env var, else ~/dev/tools.yml — Syncthing-synced, so this works on every machine)
REGISTRY="${TOOLBOX_REGISTRY:-$HOME/dev/tools.yml}"

if [[ ! -f "$HISTORY" ]]; then
  print_error "History file not found: $HISTORY"
  exit 1
fi

if [[ ! -f "$REGISTRY" ]]; then
  print_error "Tool registry not found: $REGISTRY"
  exit 1
fi

# Personal tools = the custom-tools category in the registry (the canonical,
# Syncthing-synced source of truth), so the list never goes stale.
mapfile -t TOOLS < <(yq -r '.tools | to_entries | map(select(.value.category == "custom-tools")) | .[].key' "$REGISTRY")

print_header "Tool Usage" "brightcyan"
echo ""

# Collect counts, then sort by usage descending
declare -a entries
for tool in "${TOOLS[@]}"; do
  # grep -c prints 0 and exits 1 on no match; `|| true` keeps the single 0
  # (a literal `echo 0` would append a second 0 and create phantom entries)
  count=$(grep -cE "(^: [0-9]+:[0-9]+;|^)${tool}( |$)" "$HISTORY" 2>/dev/null || true)
  entries+=("${count} ${tool}")
done

unused=()
while IFS=' ' read -r count tool; do
  if ((count == 0)); then
    unused+=("$tool")
  else
    echo "  $(print_green "$tool") — ${count}x"
  fi
done < <(printf '%s\n' "${entries[@]}" | sort -rn)

if ((${#unused[@]} > 0)); then
  echo ""
  print_section "Never used (in history)" "brightyellow"
  for t in "${unused[@]}"; do
    echo "  $(print_yellow "$t")"
  done
fi

echo ""
echo "  $(print_cyan "History:") $HISTORY  ($(wc -l <"$HISTORY") lines)"
echo "  $(print_cyan "Tip:") setopt EXTENDED_HISTORY in .zshrc to track dates"
echo ""
