#!/usr/bin/env bash
# menu - List personal CLI tools with descriptions from the tool registry

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"

# Canonical registry location, matching toolbox's own resolution (TOOLBOX_REGISTRY
# env var, else ~/dev/tools.yml — Syncthing-synced, so this works on every machine,
# not just ones with the dev repos checked out)
REGISTRY="${TOOLBOX_REGISTRY:-$HOME/dev/tools.yml}"

if [[ ! -f "$REGISTRY" ]]; then
  print_error "Tool registry not found: $REGISTRY"
  exit 1
fi

print_header "Personal Tools" "brightcyan"
echo ""

# Personal tools = the custom-tools category in the registry, sorted by name.
# One yq call emits "name<TAB>description" lines.
while IFS=$'\t' read -r name desc; do
  echo "  $(print_cyan "$name") — $desc"
done < <(yq -r '.tools | to_entries | map(select(.value.category == "custom-tools")) | sort_by(.key) | .[] | .key + "\t" + .value.description' "$REGISTRY")

echo ""
