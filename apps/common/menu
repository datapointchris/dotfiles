#!/usr/bin/env bash
# shellcheck disable=SC2016  # fzf preview command uses single quotes intentionally
# menu - Search across your tools, workflows, and skills, then jump to the right one.
#
# menu is a thin pointer over your collections. It builds one federated index
# (tools registry + tagged workflow cards + Claude skills) and delegates every
# display back to that collection's own tool. It owns no content of its own.

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"

REGISTRY="${TOOLBOX_REGISTRY:-$HOME/dev/tools.yml}"
WORKFLOWS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/workflows"
SKILLS_DIR="$HOME/.claude/skills"
FUNCTIONS_FILE="$SHELL_DIR/functions.sh"
ALIASES_FILE="$SHELL_DIR/aliases.sh"

# Registry membership tests, used to decide which lenses fire for a subject.
in_registry() { yq -e ".tools.\"$1\"" "$REGISTRY" >/dev/null 2>&1; }
is_custom_tool() { [[ "$(yq -r ".tools.\"$1\".category // \"\"" "$REGISTRY")" == "custom-tools" ]]; }
# A function is surfaced only if it carries the `#@name` discovery annotation
# (unannotated functions are internal helpers). An alias just has to be defined.
is_function() { grep -qE "^#@$1\$" "$FUNCTIONS_FILE" 2>/dev/null; }
is_alias() { grep -qE "^alias $1=" "$ALIASES_FILE" 2>/dev/null; }

# Pull one function's definition (annotation through its closing brace) or one
# alias line, for the preview and full view.
extract_function() { awk -v n="$1" '$0=="#@"n{p=1} p{print} p&&/^}/{exit}' "$FUNCTIONS_FILE"; }
extract_alias() { grep -E "^alias $1=" "$ALIASES_FILE"; }

show_help() {
  print_header "Menu - Search Your Tools, Workflows & Skills" "brightcyan"
  echo ""
  echo "A pointer across your collections. Search once, jump to the source."
  echo ""
  print_section "Usage" "brightmagenta"
  echo "  $(print_cyan "menu")               Interactive picker; Enter opens the full view"
  echo "  $(print_cyan "menu") <term>        Open the picker pre-filtered to <term>"
  echo "  $(print_cyan "menu find") <term>   Same as above"
  echo "  $(print_cyan "menu help")          Show this help"
  echo ""
  echo "  Enter on any result assembles every lens that has it:"
  echo "  help · toolbox · tldr · cheat · workflow · skill · function · alias."
  echo ""
  print_section "Review (what's due to revisit)" "brightyellow"
  echo "  $(print_cyan "menu review")           What's due now, most overdue first"
  echo "  $(print_cyan "menu review list")      Every registered item and its status"
  echo "  $(print_cyan "menu review done") <id> Mark an item done (advances its due date)"
  echo "  $(print_cyan "menu review edit")      Edit the register in \$EDITOR"
  echo ""
  print_section "Collections" "brightblue"
  echo "  $(print_cyan "[tool]")      tools registry ($REGISTRY)"
  echo "  $(print_cyan "[workflow]")  reference cards ($WORKFLOWS_DIR)"
  echo "  $(print_cyan "[skill]")     Claude skills ($SKILLS_DIR)"
  echo "  $(print_cyan "[func]")      shell functions ($FUNCTIONS_FILE)"
  echo "  $(print_cyan "[alias]")     shell aliases ($ALIASES_FILE)"
}

# Format raw "name<TAB>desc<TAB>tags" rows into the index line:
#   display <TAB> source <TAB> name
# Field 1 is both shown and searched (WYSIWYG). fzf can only search what it
# displays, so the searchable tokens — name, description/title, and tags — all
# live in the display column. You can see why any result matched, and tags stay
# the discovery contract because they are right there in the line.
build_rows() {
  local src="$1"
  awk -F'\t' -v src="$src" '{
    context = $2
    if ($3 != "") context = context "  " $3
    display = sprintf("%-10s %-22s %s", "[" src "]", $1, context)
    print display "\t" src "\t" $1
  }'
}

index_tools() {
  yq -r '.tools | to_entries | .[] |
    .key + "\t" + (.value.description // "") + "\t" + ((.value.tags // []) | join(" "))' \
    "$REGISTRY" | build_rows tool
}

index_workflows() {
  local f name title tags
  for f in "$WORKFLOWS_DIR"/*.md; do
    [[ -e "$f" ]] || continue
    name=$(basename "$f" .md)
    tags=$(awk -F'[][]' '/^tags:/{gsub(/,/, " ", $2); gsub(/^ +| +$/, "", $2); print $2; exit}' "$f")
    title=$(grep -m1 '^# ' "$f" | sed 's/^# *//' || true)
    printf '%s\t%s\t%s\n' "$name" "$title" "$tags"
  done | build_rows workflow
}

index_skills() {
  local d name desc
  for d in "$SKILLS_DIR"/*/; do
    [[ -f "${d}SKILL.md" ]] || continue
    name=$(basename "$d")
    # Skill descriptions can be long; keep the first sentence — it carries the
    # discovery keywords, and the rest is trigger/output detail that inflates
    # fuzzy matching. Cut only at a real boundary (punctuation + capital).
    desc=$(sed -n 's/^description: *//p' "${d}SKILL.md" | head -1 | sed -E 's/([.!?])[[:space:]]+[A-Z].*/\1/')
    printf '%s\t%s\t%s\n' "$name" "$desc" ""
  done | build_rows skill
}

# Shell functions carry a `#@name` / `#--> description` annotation (the same
# discovery convention toolbox parses). Emit those pairs; unannotated functions
# are internal helpers and stay hidden — the annotation IS the opt-in.
index_functions() {
  [[ -f "$FUNCTIONS_FILE" ]] || return 0
  awk '
    /^#@/ { name=substr($0,3); next }
    /^#-->/ && name != "" { desc=substr($0,6); sub(/^[[:space:]]+/,"",desc); print name "\t" desc "\t"; name="" }
  ' "$FUNCTIONS_FILE" | build_rows func
}

# Aliases: the `alias name=...` definition, with the immediately-preceding comment
# as the description when there is one.
index_aliases() {
  [[ -f "$ALIASES_FILE" ]] || return 0
  awk '
    /^#/ { desc=$0; sub(/^#[[:space:]]*/,"",desc); next }
    /^alias / { name=$0; sub(/^alias /,"",name); sub(/=.*/,"",name); print name "\t" desc "\t"; next }
    /^[[:space:]]*$/ { next }
    { desc="" }
  ' "$ALIASES_FILE" | build_rows alias
}

# The federated index: every collection's rows, sorted for stable dumps. fzf
# re-ranks by score regardless, so the sort only makes __index readable.
build_index() { { index_tools; index_workflows; index_skills; index_functions; index_aliases; } | sort; }

# Render one entry by delegating to the collection that owns it
cmd_preview() {
  local src="$1" name="$2"
  case "$src" in
    tool) toolbox show "$name" ;;
    workflow) workflows show "$name" ;;
    skill) bat --style=plain --color=always --language=markdown "$SKILLS_DIR/$name/SKILL.md" ;;
    func) extract_function "$name" | bat --style=plain --color=always --language=bash ;;
    alias) extract_alias "$name" | bat --style=plain --color=always --language=bash ;;
  esac
}

# One lens = one source of truth for a subject. Each renders a section header
# then delegates to the owning tool. Colors survive because the full view writes
# straight to stdout (the terminal), not into a pipe.
render_lens() {
  local lens="$1" subject="$2"
  case "$lens" in
    help)
      print_section "help — live flags ($subject --help)" "brightgreen"
      timeout 5 "$subject" --help 2>/dev/null || true
      ;;
    toolbox)
      print_section "toolbox — why you'd reach for it" "brightyellow"
      toolbox show "$subject"
      ;;
    tldr)
      print_section "tldr — common examples" "brightblue"
      tldr "$subject" 2>/dev/null || true
      ;;
    cheat)
      print_section "cheat — cheatsheet" "brightmagenta"
      cheat "$subject" 2>/dev/null || true
      ;;
    workflow)
      print_section "workflow — your reference card" "brightcyan"
      workflows show "$subject"
      ;;
    skill)
      print_section "skill — Claude skill" "brightgreen"
      bat --style=plain --color=always --language=markdown "$SKILLS_DIR/$subject/SKILL.md"
      ;;
    function)
      print_section "function — your shell function" "brightcyan"
      extract_function "$subject" | bat --style=plain --color=always --language=bash
      ;;
    alias)
      print_section "alias — your shell alias" "brightcyan"
      extract_alias "$subject" | bat --style=plain --color=always --language=bash
      ;;
  esac
  echo ""
}

# The full view for one subject: every lens that has content, in priority order
# (help → toolbox → tldr → cheat → workflow → skill). This is what the picker
# opens on Enter. Presence is probed cheaply first so only real sections render
# and the banner can name them. The --help lens fires only for your own tools
# that resolve on PATH — running --help on an arbitrary external command is
# unsafe, and externals are covered by tldr/cheat.
cmd_show() {
  local subject="${1:-}"
  [[ -n "$subject" ]] || return 1

  local lenses=()
  if is_custom_tool "$subject" && command -v "$subject" >/dev/null 2>&1; then lenses+=(help); fi
  if in_registry "$subject"; then lenses+=(toolbox); fi
  if tldr "$subject" >/dev/null 2>&1; then lenses+=(tldr); fi
  if cheat "$subject" >/dev/null 2>&1; then lenses+=(cheat); fi
  if [[ -f "$WORKFLOWS_DIR/$subject.md" ]]; then lenses+=(workflow); fi
  if [[ -f "$SKILLS_DIR/$subject/SKILL.md" ]]; then lenses+=(skill); fi
  if is_function "$subject"; then lenses+=(function); fi
  if is_alias "$subject"; then lenses+=(alias); fi

  if [[ ${#lenses[@]} -eq 0 ]]; then
    print_warning "Nothing known about '$subject' in any lens."
    echo "Lenses checked: help · toolbox · tldr · cheat · workflow · skill · function · alias"
    return 1
  fi

  print_header "$subject" "brightcyan"
  print_info "Lenses: ${lenses[*]}"
  echo ""
  local lens
  for lens in "${lenses[@]}"; do
    render_lens "$lens" "$subject"
  done
}

cmd_find() {
  local query="$*"
  local selected
  selected=$(
    build_index \
      | fzf --delimiter='\t' --with-nth=1 \
          --query="$query" \
          --preview 'menu __preview {2} {3}' \
          --preview-window=right:62% \
          --prompt='menu ❯ ' \
          --header='Search tools · funcs · aliases · workflows · skills | Enter for the full view'
  )
  [[ -n "$selected" ]] || return 0
  # Enter opens the full composite view (every lens), not just the owning
  # collection's card — finding and showing are one motion.
  cmd_show "$(cut -f3 <<<"$selected")"
}

case "${1:-}" in
  help | -h | --help) show_help ;;
  __index) build_index ;;
  __preview) cmd_preview "$2" "$3" ;;
  __show) cmd_show "$2" ;;
  review)
    # The temporal half (cadence register) lives in the menu-review helper —
    # dates and state are far cleaner in Python than in bash.
    shift
    exec menu-review "$@"
    ;;
  find)
    shift
    cmd_find "$@"
    ;;
  *) cmd_find "$@" ;;
esac
