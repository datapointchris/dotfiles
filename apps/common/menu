#!/usr/bin/env bash
# shellcheck disable=SC2016  # fzf preview command uses single quotes intentionally
# menu - Search across your tools, workflows, and skills, then jump to the right one.
#
# menu is a thin pointer over your collections. It builds one federated index
# (tools registry + tagged workflow cards + Claude skills) and delegates every
# display back to that collection's own tool. It owns no content of its own.

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
# shellcheck source=../../configs/common/.local/shell/formatting.sh
source "$SHELL_DIR/formatting.sh"

REGISTRY="${TOOLBOX_REGISTRY:-${XDG_DATA_HOME:-$HOME/.local/share}/toolbox/registry.yml}"
WORKFLOWS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/workflows"
SKILLS_DIR="$HOME/.claude/skills"
# Function/alias sources: the shared files plus the platform file (macos.sh /
# archlinux.sh / wsl.sh), which holds both. This matches what toolbox parses —
# menu read only the shared files before, so platform-specific shortcuts were
# searchable in `toolbox funcs` and the remind rotation but not in menu.
FUNCTION_FILES=("$SHELL_DIR/functions.sh")
ALIAS_FILES=("$SHELL_DIR/aliases.sh")
if [[ -n "${PLATFORM:-}" && -f "$SHELL_DIR/$PLATFORM.sh" ]]; then
  FUNCTION_FILES+=("$SHELL_DIR/$PLATFORM.sh")
  ALIAS_FILES+=("$SHELL_DIR/$PLATFORM.sh")
fi

# Registry membership tests, used to decide which lenses fire for a subject.
in_registry() { yq -e ".tools.\"$1\"" "$REGISTRY" >/dev/null 2>&1; }
is_custom_tool() { [[ "$(yq -r ".tools.\"$1\".category // \"\"" "$REGISTRY")" == "custom-tools" ]]; }
# A function is surfaced only if it carries the `#@name` discovery annotation
# (unannotated functions are internal helpers). An alias just has to be defined.
is_function() { grep -qsE "^#@$1\$" "${FUNCTION_FILES[@]}"; }
is_alias() { grep -qsE "^alias $1=" "${ALIAS_FILES[@]}"; }

# Pull one function's definition (annotation through its closing brace) or one
# alias line, for the preview and full view. FNR==1 resets across files so a
# function in the platform file is not confused by a brace in the shared one.
extract_function() { awk -v n="$1" 'FNR==1{p=0} $0=="#@"n{p=1} p{print} p&&/^}/{exit}' "${FUNCTION_FILES[@]}" 2>/dev/null; }
extract_alias() { grep -hE "^alias $1=" "${ALIAS_FILES[@]}" 2>/dev/null; }

# Git aliases come from git itself (so every config file resolves), not a file.
is_gitalias() { git config --get "alias.$1" >/dev/null 2>&1; }
extract_gitalias() { printf 'git %s = %s\n' "$1" "$(git config --get "alias.$1")"; }

# forgit maps short names (ga, gd, glo, ...) to fzf-interactive git actions. It
# is sourced after aliases.sh, so these live in no shell file menu already reads.
# Parse the default names from the plugin (none are overridden here); the forgit
# action doubles as the description.
FORGIT_PLUGIN="${FORGIT_PLUGIN:-${ZSH_PLUGINS_DIR:-$HOME/.config/zsh/plugins}/forgit/forgit.plugin.zsh}"
forgit_action() { grep -oE "forgit_[a-z_]+=\"\\\$\\{forgit_[a-z_]+:-$1\\}\"" "$FORGIT_PLUGIN" 2>/dev/null | sed -E 's/^forgit_([a-z_]+)=.*/\1/' | head -1; }
is_forgit() { [[ -n "$(forgit_action "$1")" ]]; }
extract_forgit() {
  local a
  a=$(forgit_action "$1")
  printf '%s → forgit::%s\ninteractive git %s, via fzf\n' "$1" "${a//_/::}" "${a//_/ }"
}

# tmux keybindings live in the tmux-commands workflow card so the in-tmux popup
# (prefix + t) and menu share one source of truth. The card is markdown tables of
# key | description, so take the first two cells of every table row whose key
# starts with a binding token. Separator rows, section headers and bare copy-mode
# keys (v, y) fail that test and are skipped.
#
# A key cell may contain an escaped pipe (`prefix + \|`), which would otherwise
# split as a column boundary, so those are swapped out before the split.
TMUX_COMMANDS_CARD="$WORKFLOWS_DIR/tmux-commands.md"
parse_tmux_keys() {
  [[ -f "$TMUX_COMMANDS_CARD" ]] || return 0
  awk '
    /^[[:space:]]*\|/ {
      line = $0
      gsub(/\\\|/, "\001", line)
      if (split(line, cells, /\|/) < 3) next
      key = cells[2]; desc = cells[3]
      gsub(/\001/, "|", key); gsub(/\001/, "|", desc)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", desc)
      if (key ~ /^(prefix|Ctrl|Alt)/) print key "\t" desc
    }
  ' "$TMUX_COMMANDS_CARD"
}
is_tmux_key() { parse_tmux_keys | cut -f1 | grep -qxF "$1"; }

show_help() {
  help_header "menu" "A pointer across your collections. Search once, jump to the source."
  help_usage "menu [<term>]" "menu <verb> [ARGS]"

  help_section "Commands"
  help_row "menu" "" "Launcher — your areas plus every tool you own"
  help_row "menu" "<term>" "Search, pre-filtered to <term>"
  help_row "menu find" "<term>" "Search (Enter opens the full view)"
  help_row "menu search" "<term>" "Search (same as menu find)"
  help_row "menu help" "" "Show this help"
  help_text "" \
    "  Enter on any result assembles every lens that has it:" \
    "  help · toolbox · tldr · cheat · workflow · skill · function · alias · git alias · forgit · tmux."

  help_section "Dashboard (everything outstanding)"
  help_row "menu dashboard" "" "Every lane: tasks, habits, learning, reading, maintenance, projects, upcoming"
  help_row "menu dashboard --lane" "<name>" "One lane, in more depth"
  help_row "menu dashboard --json" "" "The lane model as JSON"

  help_section "Review (what's due to revisit)"
  help_row "menu review" "" "What's due now, most overdue first"
  help_row "menu review list" "" "Every registered item and its status"
  help_row "menu review done" "<id>" "Mark an item done (advances its due date)"
  help_row "menu review edit" "" "Edit the register in \$EDITOR"

  help_section "Labs (hands-on practice)"
  help_row "menu labs" "" "What's due to practice now"
  help_row "menu labs list" "" "Every Lab and its schedule status"
  help_row "menu labs" "<id>" "Open a Lab to read while you work in another pane"
  help_row "menu labs flash" "" "Quick recall drill from your tool examples"
  help_row "menu labs done" "<id>" "Mark a Lab practiced (advances its schedule)"
  help_row "menu labs new" "<name>" "Scaffold a new Lab in \$EDITOR"

  help_section "Collections"
  help_row "[tool]" "" "tools registry ($REGISTRY)"
  help_row "[workflow]" "" "reference cards ($WORKFLOWS_DIR)"
  help_row "[skill]" "" "Claude skills ($SKILLS_DIR)"
  help_row "[func]" "" "shell functions ($SHELL_DIR/functions.sh + platform)"
  help_row "[alias]" "" "shell aliases ($SHELL_DIR/aliases.sh + platform)"
  help_row "[git]" "" "git aliases (git config alias.*)"
  help_row "[forgit]" "" "forgit fzf-git shortcuts ($FORGIT_PLUGIN)"
  help_row "[tmux]" "" "tmux keybindings ($TMUX_COMMANDS_CARD)"

  help_end
}

# Format raw "name<TAB>desc<TAB>tags" rows into the index line:
#   display <TAB> source <TAB> name
# Field 1 is both shown and searched (WYSIWYG). fzf can only search what it
# displays, so the searchable tokens — name, description/title, and tags — all
# live in the display column. You can see why any result matched, and tags stay
# the discovery contract because they are right there in the line.
build_rows() {
  local src="$1"
  awk -F'\t' -v src="$src" '{
    context = $2
    if ($3 != "") context = context "  " $3
    display = sprintf("%-10s %-22s %s", "[" src "]", $1, context)
    print display "\t" src "\t" $1
  }'
}

index_tools() {
  yq -r '.tools | to_entries | .[] |
    .key + "\t" + (.value.description // "") + "\t" + ((.value.tags // []) | join(" "))' \
    "$REGISTRY" | build_rows tool
}

index_workflows() {
  local f name title tags
  for f in "$WORKFLOWS_DIR"/*.md; do
    [[ -e "$f" ]] || continue
    name=$(basename "$f" .md)
    tags=$(awk -F'[][]' '/^tags:/{gsub(/,/, " ", $2); gsub(/^ +| +$/, "", $2); print $2; exit}' "$f")
    title=$(grep -m1 '^# ' "$f" | sed 's/^# *//' || true)
    printf '%s\t%s\t%s\n' "$name" "$title" "$tags"
  done | build_rows workflow
}

index_skills() {
  local d name desc
  for d in "$SKILLS_DIR"/*/; do
    [[ -f "${d}SKILL.md" ]] || continue
    name=$(basename "$d")
    # Skill descriptions can be long; keep the first sentence — it carries the
    # discovery keywords, and the rest is trigger/output detail that inflates
    # fuzzy matching. Cut only at a real boundary (punctuation + capital).
    desc=$(sed -n 's/^description: *//p' "${d}SKILL.md" | head -1 | sed -E 's/([.!?])[[:space:]]+[A-Z].*/\1/')
    printf '%s\t%s\t%s\n' "$name" "$desc" ""
  done | build_rows skill
}

# Shell functions carry a `#@name` / `#--> description` annotation (the same
# discovery convention toolbox parses). Emit those pairs; unannotated functions
# are internal helpers and stay hidden — the annotation IS the opt-in.
index_functions() {
  awk '
    FNR==1 { name="" }
    /^#@/ { name=substr($0,3); next }
    /^#-->/ && name != "" { desc=substr($0,6); sub(/^[[:space:]]+/,"",desc); print name "\t" desc "\t"; name=""; next }
    /^[^#]/ { name="" }
  ' "${FUNCTION_FILES[@]}" 2>/dev/null | build_rows func
}

# Aliases: the `alias name=...` definition, with the immediately-preceding comment
# as the description when there is one.
index_aliases() {
  awk '
    FNR==1 { desc="" }
    /^#/ { desc=$0; sub(/^#[[:space:]]*/,"",desc); next }
    /^alias / { name=$0; sub(/^alias /,"",name); sub(/=.*/,"",name); print name "\t" desc "\t"; next }
    /^[[:space:]]*$/ { next }
    { desc="" }
  ' "${ALIAS_FILES[@]}" 2>/dev/null | build_rows alias
}

# Git aliases (git co, git st, ...) — a whole shortcut vocabulary that lives in
# no shell file. Ask git itself so every config file resolves; the expansion is
# the description. Invoke them as `git <name>`.
index_git_aliases() {
  command -v git >/dev/null 2>&1 || return 0
  git config --get-regexp '^alias\.' 2>/dev/null | while read -r key val; do
    printf '%s\t%s\t%s\n' "${key#alias.}" "$val" ""
  done | build_rows git
}

# forgit plugin aliases: the fzf-interactive git shortcuts (ga, gd, glo, ...).
index_forgit() {
  [[ -f "$FORGIT_PLUGIN" ]] || return 0
  grep -oE 'forgit_[a-z_]+="\$\{forgit_[a-z_]+:-[a-zA-Z-]+\}"' "$FORGIT_PLUGIN" \
    | sed -E 's/forgit_([a-z_]+)="\$\{forgit_[a-z_]+:-([a-zA-Z-]+)\}"/\2\t\1/' \
    | awk -F'\t' '{gsub(/_/, " ", $2); print $1 "\tforgit: " $2 "\t"}' \
    | build_rows forgit
}

# tmux keybindings: one searchable row per binding (the key is the name, the
# action is the description). The row itself is the answer — search "split" and
# `prefix + |  split vertical` shows in the list. Enter opens the full card.
index_tmux_keys() {
  parse_tmux_keys | awk -F'\t' '{print $1 "\t" $2 "\t"}' | build_rows tmux
}

# The federated index: every collection's rows, sorted for stable dumps. fzf
# re-ranks by score regardless, so the sort only makes __index readable.
build_index() { {
  index_tools
  index_workflows
  index_skills
  index_functions
  index_aliases
  index_git_aliases
  index_forgit
  index_tmux_keys
} | sort; }

# Render one entry by delegating to the collection that owns it.
#
# In the preview pane we DO want bat's filename header (the width cost is fine),
# so add it explicitly on top of your global plain default — `--style=+header`
# is additive, so plain stays the default everywhere else. --decorations=always
# forces it to draw even though fzf captures our output over a pipe, and
# --file-name labels stdin content (extracted funcs/aliases) with its real path.
cmd_preview() {
  local src="$1" name="$2"
  local bat_header=(bat --style=+header --decorations=always --color=always)
  case "$src" in
    tool) toolbox show "$name" ;;
    workflow) workflows show "$name" ;;
    skill) "${bat_header[@]}" --language=markdown "$SKILLS_DIR/$name/SKILL.md" ;;
    func) extract_function "$name" | "${bat_header[@]}" --language=bash --file-name "$(lens_source function "$name")" ;;
    alias) extract_alias "$name" | "${bat_header[@]}" --language=bash --file-name "$(lens_source alias "$name")" ;;
    git) extract_gitalias "$name" | "${bat_header[@]}" --language=bash --file-name "$(lens_source gitalias "$name")" ;;
    forgit) extract_forgit "$name" ;;
    tmux) workflows __render "$TMUX_COMMANDS_CARD" ;;
  esac
}

# Where a subject physically lives for a given lens. Extracted content (funcs,
# aliases) and bat's plain default (from your bat config) both hide the origin,
# so selecting a result left you not knowing what file you'd landed in. The full
# view prints this path as a breadcrumb; the preview feeds it to bat --file-name.
lens_source() {
  case "$1" in
    function) grep -lsE "^#@$2\$" "${FUNCTION_FILES[@]}" 2>/dev/null | head -1 ;;
    alias) grep -lsE "^alias $2=" "${ALIAS_FILES[@]}" 2>/dev/null | head -1 ;;
    skill) echo "$SKILLS_DIR/$2/SKILL.md" ;;
    workflow) echo "$WORKFLOWS_DIR/$2.md" ;;
    forgit) echo "$FORGIT_PLUGIN" ;;
    tmuxkey) echo "$TMUX_COMMANDS_CARD" ;;
    gitalias) echo "git config: alias.$2" ;;
  esac
}

# One lens = one source of truth for a subject. Each renders a section header,
# names its source file, then delegates to the owning tool. The full view is
# piped into a pager (see cmd_show), so every delegate must force color even
# when its stdout is not a terminal — bat gets --color=always, cheat --colorize,
# and workflow cards go through `workflows __render` (which forces color) rather
# than `workflows show` (which does not).
render_lens() {
  local lens="$1" subject="$2"
  local src
  src=$(lens_source "$lens" "$subject")
  [[ -n "$src" ]] && print_info "↳ $src"
  case "$lens" in
    help)
      print_section "help — live flags ($subject --help)" "brightgreen"
      timeout 5 "$subject" --help 2>/dev/null || true
      ;;
    toolbox)
      print_section "toolbox — why you'd reach for it" "brightyellow"
      toolbox show "$subject"
      ;;
    tldr)
      print_section "tldr — common examples" "brightblue"
      tldr "$subject" 2>/dev/null || true
      ;;
    cheat)
      print_section "cheat — cheatsheet" "brightmagenta"
      cheat --colorize "$subject" 2>/dev/null || true
      ;;
    workflow)
      print_section "workflow — your reference card" "brightcyan"
      workflows __render "$WORKFLOWS_DIR/$subject.md"
      ;;
    skill)
      print_section "skill — Claude skill" "brightgreen"
      bat --color=always --language=markdown "$SKILLS_DIR/$subject/SKILL.md"
      ;;
    function)
      print_section "function — your shell function" "brightcyan"
      extract_function "$subject" | bat --color=always --language=bash
      ;;
    alias)
      print_section "alias — your shell alias" "brightcyan"
      extract_alias "$subject" | bat --color=always --language=bash
      ;;
    gitalias)
      print_section "git alias — invoke as git $subject" "brightcyan"
      extract_gitalias "$subject" | bat --color=always --language=bash
      ;;
    forgit)
      print_section "forgit — fzf-interactive git shortcut" "brightcyan"
      extract_forgit "$subject"
      ;;
    tmuxkey)
      print_section "tmux — keybinding reference" "brightcyan"
      workflows __render "$TMUX_COMMANDS_CARD"
      ;;
  esac
  echo ""
}

# Route the full view through a pager so you can scroll a long composite
# comfortably instead of fighting terminal scrollback. less -F prints directly
# when it fits one screen (short views feel inline); -R keeps the forced colors;
# -X leaves the output on the terminal after you quit (no alternate screen), so
# you can still select and copy any command from it. When our own stdout is not
# a terminal (piped, e.g. tests), skip paging and pass through.
page() {
  if [[ -t 1 ]]; then less -FRX; else cat; fi
}

# The full view for one subject: every lens that has content, in priority order
# (help → toolbox → tldr → cheat → workflow → skill). This is what the picker
# opens on Enter. Presence is probed cheaply first so only real sections render
# and the banner can name them. The --help lens fires only for your own tools
# that resolve on PATH — running --help on an arbitrary external command is
# unsafe, and externals are covered by tldr/cheat.
cmd_show() {
  local subject="${1:-}"
  [[ -n "$subject" ]] || return 1

  # tmux keybindings contain regex metacharacters (| { } [ \ +) that would
  # inject into the name-based grep probes below (a bare | reads as alternation
  # and matches everything). A keybinding is only ever a keybinding, so resolve
  # it first with the fixed-string is_tmux_key test and short-circuit.
  if is_tmux_key "$subject"; then
    {
      print_header "$subject" "brightcyan"
      print_info "Lenses: tmuxkey"
      echo ""
      render_lens tmuxkey "$subject"
    } | page
    return 0
  fi

  local lenses=()
  if is_custom_tool "$subject" && command -v "$subject" >/dev/null 2>&1; then lenses+=(help); fi
  if in_registry "$subject"; then lenses+=(toolbox); fi
  if tldr "$subject" >/dev/null 2>&1; then lenses+=(tldr); fi
  if cheat "$subject" >/dev/null 2>&1; then lenses+=(cheat); fi
  if [[ -f "$WORKFLOWS_DIR/$subject.md" ]]; then lenses+=(workflow); fi
  if [[ -f "$SKILLS_DIR/$subject/SKILL.md" ]]; then lenses+=(skill); fi
  if is_function "$subject"; then lenses+=(function); fi
  if is_alias "$subject"; then lenses+=(alias); fi
  if is_gitalias "$subject"; then lenses+=(gitalias); fi
  if is_forgit "$subject"; then lenses+=(forgit); fi

  if [[ ${#lenses[@]} -eq 0 ]]; then
    print_warning "Nothing known about '$subject' in any lens."
    echo "Lenses checked: help · toolbox · tldr · cheat · workflow · skill · function · alias · git alias · forgit · tmux"
    return 1
  fi

  local lens
  {
    print_header "$subject" "brightcyan"
    print_info "Lenses: ${lenses[*]}"
    echo ""
    for lens in "${lenses[@]}"; do
      render_lens "$lens" "$subject"
    done
  } | page
}

# The launcher: bare `menu` lists menu's own areas plus every custom tool you
# own (registry category custom-tools), so "what can I even run here" is one
# keystroke away — the fix for forgetting a tool exists. Selecting an area enters
# it; selecting a tool runs it with no args (which, per your CLI convention,
# shows that tool's help or status).
launcher_rows() {
  {
    printf 'dashboard\tEverything outstanding across your apps, in lanes\n'
    printf 'find\tSearch across tools, workflows, skills, funcs, aliases, git\n'
    printf 'review\tWhat is due to revisit (cadence register)\n'
    printf 'labs\tHands-on practice that is due now\n'
    yq -r '.tools | to_entries | .[]
      | select(.value.category == "custom-tools" and .key != "menu")
      | .key + "\t" + (.value.description // "")' "$REGISTRY"
  } | awk -F'\t' '{printf "%-16s %s\t%s\n", $1, $2, $1}'
}

cmd_launch_preview() {
  case "$1" in
    # A static description, not a live run: the preview re-runs on every
    # selection change and the dashboard queries the network.
    dashboard) printf 'Everything outstanding across your apps, in independent lanes:\ntasks, habits, learning, reading, maintenance, project items,\nupcoming. Read-only, one batched call per backend.\n\nInvoke directly: menu dashboard [--lane <name>] [--json]\n' ;;
    find) printf 'Federated search across every collection you own — tools,\nworkflows, skills, shell functions, aliases, git aliases, forgit,\ntmux keys. Enter opens the full composite view.\n\nInvoke directly: menu find <term>\n' ;;
    review) menu-review list 2>/dev/null || echo "What's due to revisit." ;;
    labs) menu-labs list 2>/dev/null || echo "Hands-on practice that's due." ;;
    *) toolbox show "$1" 2>/dev/null || printf 'No registry entry for %s.\n' "$1" ;;
  esac
}

launcher_run() {
  case "$1" in
    dashboard) exec menu-dashboard ;;
    find) cmd_find "" ;;
    review) exec menu-review ;;
    labs) exec menu-labs ;;
    *)
      printf '  %s\n' "$1"
      ;;
  esac
}

cmd_launch() {
  local selected
  selected=$(
    launcher_rows \
      | fzf --delimiter='\t' --with-nth=1 \
        --tiebreak=begin,length \
        --no-hscroll \
        --preview 'menu __launch_preview {2}' \
        --preview-window=right:62% \
        --prompt='menu ❯ ' \
        --header='Your areas & tools · Enter runs it · type to filter'
  )
  [[ -n "$selected" ]] || return 0
  launcher_run "$(cut -f2 <<<"$selected")"
}

cmd_find() {
  local query="$*"
  local selected
  selected=$(
    build_index \
      | fzf --delimiter='\t' --with-nth=1 \
        --query="$query" \
        --tiebreak=begin,length \
        --no-hscroll \
        --preview 'menu __preview {2} {3}' \
        --preview-window=right:62% \
        --prompt='menu ❯ ' \
        --header='Search tools · funcs · aliases · git · forgit · workflows · skills · tmux | Enter for the full view'
  )
  [[ -n "$selected" ]] || return 0
  # Enter opens the full composite view (every lens), not just the owning
  # collection's card — finding and showing are one motion.
  cmd_show "$(cut -f3 <<<"$selected")"
}

case "${1:-}" in
  "") cmd_launch ;;
  help | -h | --help) show_help ;;
  __index) build_index ;;
  __preview) cmd_preview "$2" "$3" ;;
  __launch_preview) cmd_launch_preview "$2" ;;
  __show) cmd_show "$2" ;;
  dashboard | dash)
    # The cross-app glance lives in the menu-dashboard helper: concurrent
    # subprocess fan-out and JSON composition are cleaner in Python than in bash.
    shift
    exec menu-dashboard "$@"
    ;;
  review)
    # The temporal half (cadence register) lives in the menu-review helper —
    # dates and state are far cleaner in Python than in bash.
    shift
    exec menu-review "$@"
    ;;
  labs | drill)
    # The practice half (hands-on Labs) lives in the menu-labs helper, same
    # reasoning as review: dates, state, and deck loading are cleaner in Python.
    shift
    exec menu-labs "$@"
    ;;
  find | search)
    # search and find are the same motion — one name to remember, not two.
    shift
    cmd_find "$@"
    ;;
  *) cmd_find "$@" ;;
esac
