#!/usr/bin/env bash
# shellcheck disable=SC2016  # fzf preview commands use single quotes intentionally
# ================================================================
# notes - Quick note-taking with zk
# ================================================================
# ================================================================

set -euo pipefail

SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"

NOTES_DIR="${ZK_NOTEBOOK_DIR:-$HOME/notes}"

show_help() {
  help_header "notes" "Command-line interface for managing notes across sections."
  help_usage "notes <verb> [section]"

  help_section "Commands"
  help_row "notes" "" "Show this help"
  help_row "notes search" "" "Search across all notes (full-text)"
  help_row "notes new" "[section]" "Create a new note (optionally specify section)"
  help_row "notes recent" "" "Browse recent notes"
  help_row "notes browse" "" "Browse notes by section"

  help_section "Examples"
  help_row "notes search" "" "# Full-text search, type to filter results"
  help_row "notes new" "" "# Pick a section, then create a note"
  help_row "notes new dev" "" "# Create a note directly in 'dev' section"
  help_row "notes recent" "" "# Browse last 50 notes"
  help_row "notes browse" "" "# Pick a section, browse its notes"

  help_section "Direct zk Access"
  help_text "  For full zk functionality, use 'zk' directly:"
  help_row "zk list" "" "# List all notes"
  help_row "zk journal" "\"...\"" "# Create journal entry"
  help_row "zk edit" "" "# Edit notes"

  help_section "Notebook"
  help_text "  Location: $NOTES_DIR" "  Config:   $HOME/.config/zk/config.toml"

  help_end

  # Warn rather than fail: help has to work before the notebook exists.
  if [[ ! -d "$NOTES_DIR" ]]; then
    print_warning "Notes directory not found: $NOTES_DIR - run: zk init $NOTES_DIR"
  fi
}

case "${1:-}" in
  help | --help | -h | "")
    show_help
    exit 0
    ;;
esac

if [[ ! -d "$NOTES_DIR" ]]; then
  print_error "Notes directory not found: $NOTES_DIR"
  echo "Run: zk init $NOTES_DIR"
  exit 1
fi

discover_sections() {
  find -L "$NOTES_DIR" -mindepth 1 -maxdepth 1 -type d ! -name ".*" -exec basename {} \; | sort
}

cmd_search() {
  local selected
  selected=$(
    FZF_DEFAULT_COMMAND="find -L '$NOTES_DIR' -type f -name '*.md' | sed 's|^$NOTES_DIR/||' | awk -F/ '{name=\$NF; sub(/\\.md$/,\"\",name); print name \"\\t\" \$0}'" \
      fzf --layout=reverse \
      --disabled \
      --bind "change:reload:rg --files-with-matches --no-messages --ignore-case {q} '$NOTES_DIR' | grep '\\.md\$' | sed 's|^$NOTES_DIR/||' | awk -F/ '{name=\$NF; sub(/\\.md$/,\"\",name); print name \"\\t\" \$0}' || true" \
      --bind "start:reload:rg --files-with-matches --no-messages --ignore-case '' '$NOTES_DIR' | grep '\\.md\$' | sed 's|^$NOTES_DIR/||' | awk -F/ '{name=\$NF; sub(/\\.md$/,\"\",name); print name \"\\t\" \$0}'" \
      --delimiter '\t' \
      --with-nth 1 \
      --preview 'rg --color=always --context=5 --ignore-case --pretty -- {q} '"$NOTES_DIR"'/{2} 2>/dev/null | fold -s -w $(tput cols) || bat -p --color always --wrap never '"$NOTES_DIR"'/{2} | fold -s -w $(tput cols)' \
      --preview-window=right:60% \
      --prompt 'Search: ' \
      --header 'Type to search note content | Enter to open'
  )

  if [[ -n "$selected" ]]; then
    local notepath
    notepath=$(echo "$selected" | cut -f2)
    ${EDITOR:-nvim} "$NOTES_DIR/$notepath"
  fi
}

cmd_new() {
  local section="$1"
  local sections=()
  # mapfile is bash 4; macOS ships 3.2.
  while IFS= read -r discovered; do
    sections+=("$discovered")
  done < <(discover_sections)

  if [[ ${#sections[@]} -eq 0 ]]; then
    print_warning "No sections found in: $NOTES_DIR"
    echo "Create a directory like: mkdir $NOTES_DIR/journal"
    exit 1
  fi

  if [[ -n "$section" ]]; then
    local found=0
    for s in "${sections[@]}"; do
      if [[ "$s" == "$section" ]]; then
        found=1
        break
      fi
    done

    if [[ $found -eq 0 ]]; then
      print_yellow "Section '$section' does not exist"
      section=""
    fi
  fi

  if [[ -z "$section" ]]; then
    section=$(printf "%s\n" "${sections[@]}" | gum choose --height=25)

    if [[ -z "$section" ]]; then
      exit 0
    fi
  fi

  local title
  title=$(gum input --placeholder "Note title")

  if [[ -z "$title" ]]; then
    exit 0
  fi

  if zk "$section" --help &>/dev/null; then
    zk "$section" "$title"
  else
    zk new "$NOTES_DIR/$section" --title "$title"
  fi
}

cmd_recent() {
  local selected
  selected=$(zk list --quiet --format "{{filename-stem}}\t{{path}}" --sort modified- --limit 50 \
    | fzf --layout=reverse \
      --delimiter '\t' \
      --with-nth 1 \
      --preview "bat -p --color always --wrap never $NOTES_DIR/{2} | fold -s -w \$(tput cols)" \
      --preview-window=right:60%)

  if [[ -n "$selected" ]]; then
    local notepath
    notepath=$(echo "$selected" | cut -f2)
    ${EDITOR:-nvim} "$NOTES_DIR/$notepath"
  fi
}

cmd_browse() {
  local sections=()
  # mapfile is bash 4; macOS ships 3.2.
  while IFS= read -r discovered; do
    sections+=("$discovered")
  done < <(discover_sections)

  if [[ ${#sections[@]} -eq 0 ]]; then
    print_warning "No sections found in: $NOTES_DIR"
    exit 1
  fi

  local section
  section=$(printf "%s\n" "${sections[@]}" | gum choose --height=25)

  if [[ -z "$section" ]]; then
    exit 0
  fi

  local selected
  selected=$(zk list --quiet --format "{{filename-stem}}\t{{path}}" "$section" \
    | fzf --layout=reverse \
      --delimiter '\t' \
      --with-nth 1 \
      --preview 'bat -p --color always --wrap never '"$NOTES_DIR"'/{2} | fold -s -w $(tput cols)' \
      --preview-window=right:60%)

  if [[ -n "$selected" ]]; then
    local notepath
    notepath=$(echo "$selected" | cut -f2)
    ${EDITOR:-nvim} "$NOTES_DIR/$notepath"
  fi
}

case "${1:-}" in
  search)
    cmd_search
    ;;

  new)
    cmd_new "${2:-}"
    ;;

  recent)
    cmd_recent
    ;;

  browse)
    cmd_browse
    ;;

  *)
    print_error "Unknown command: $1"
    echo "Run 'notes --help' for usage"
    exit 1
    ;;
esac
