#!/usr/bin/env bash
set -uo pipefail

# Front door for the dotfiles repo, reachable from any directory.
#
# `task` can only be used from inside the repo — it discovers Taskfile.yml by
# walking up from the working directory. This resolves the repo from its own
# symlink instead, so every verb works from anywhere.

resolve_repo_dir() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  # apps/common/dotfiles -> repo root
  cd -P "$(dirname "$source")/../.." && pwd
}

DOTFILES_DIR="$(resolve_repo_dir)"
export DOTFILES_DIR
export TERM=${TERM:-xterm}

# Sourced from the repo rather than ~/.local/shell: unlike other apps/ scripts
# this one always knows the repo path, so it works before symlinks are deployed.
source "$DOTFILES_DIR/configs/common/.local/shell/formatting.sh"
source "$DOTFILES_DIR/configs/common/.local/shell/logging.sh"

OPS_DIR="$DOTFILES_DIR/install/ops"

# Source of truth for both the help output and the dispatch below — a bats test
# asserts the two stay in agreement.
# Format: name|section|args|summary
COMMANDS=(
  "update|Manage|[GROUP...] [OPTIONS]|Update packages, tools, and plugins"
  "install|Manage|--machine NAME|Install tools from a machine manifest"
  "doctor|Manage||Health check: broken symlinks, package and flag drift"
  "env|Manage|<verb>|show, sync, check — manage ~/.env from the manifest"
  "link|Symlinks||Create symlinks for the common layer and this platform"
  "relink|Symlinks||Rebuild every symlink, pruning dangling ones"
  "symlinks|Symlinks|<verb>|link, relink, unlink, check, show"
  "test|Develop|[SUITE]|Run BATS suites: all, unit, integration, watch"
  "docs|Develop|<verb>|serve, build, deploy"
  "windows|Develop|<verb>|WSL only: setup, bundle, offline, sync"
  "pull|Repo||Pull the repo, relinking when deployed files changed"
  "status|Repo||Show working tree status and the last commit"
  "path|Repo||Print the repository path"
  "edit|Repo||Open the repository in \$EDITOR"
)

COMMAND_SECTIONS=(Manage Symlinks Develop Repo)

command_names() {
  local entry
  for entry in "${COMMANDS[@]}"; do
    echo "${entry%%|*}"
  done
}

usage() {
  local section entry name entry_section args summary

  help_header "dotfiles" "Manage the dotfiles repository from anywhere."
  help_usage "dotfiles <command> [ARGS]"

  for section in "${COMMAND_SECTIONS[@]}"; do
    help_section "$section"
    for entry in "${COMMANDS[@]}"; do
      IFS='|' read -r name entry_section args summary <<<"$entry"
      [[ "$entry_section" != "$section" ]] && continue
      help_row "$name" "$args" "$summary"
    done
  done

  help_end
  print_info "Run a command with --help for its own options, e.g. dotfiles update --help"
  exit "${1:-0}"
}

require_verb() {
  local command="$1" verb="$2" valid="$3"
  if [[ -z "$verb" ]]; then
    log_error "dotfiles $command requires a verb"
    print_info "Valid verbs: $valid"
    exit 1
  fi
}

cmd_windows() {
  local verb="${1:-}"
  require_verb windows "$verb" "setup, bundle, offline, sync"
  shift
  local setup="$DOTFILES_DIR/install/wsl/setup-windows.sh"
  case "$verb" in
    setup) bash "$setup" ;;
    bundle) bash "$setup" --bundle "$@" ;;
    offline) bash "$setup" --offline "$@" ;;
    sync) bash "$DOTFILES_DIR/install/wsl/sync-windows-shell.sh" ;;
    *)
      log_error "Unknown windows verb: $verb"
      print_info "Valid verbs: setup, bundle, offline, sync"
      exit 1
      ;;
  esac
}

cmd_pull() {
  local before after changed
  print_section "Pulling" "brightcyan"
  before=$(git -C "$DOTFILES_DIR" rev-parse HEAD)

  git -C "$DOTFILES_DIR" pull || exit 1

  after=$(git -C "$DOTFILES_DIR" rev-parse HEAD)
  if [[ "$before" == "$after" ]]; then
    log_success "Already up to date"
    return 0
  fi

  # A pull that adds or moves a deployed file leaves the machine stale until the
  # symlinks are rebuilt, so do it here rather than leaving it to be noticed later.
  changed=$(git -C "$DOTFILES_DIR" diff --name-only "$before" "$after" | grep -cE '^(apps|configs|shell)/')
  if [[ "$changed" -gt 0 ]]; then
    log_info "$changed deployed file(s) changed — relinking"
    bash "$OPS_DIR/symlinks.sh" relink
  fi
}

cmd_status() {
  print_section "Working tree" "brightcyan"
  git -C "$DOTFILES_DIR" status -sb
  print_section "Last commit" "brightgreen"
  git -C "$DOTFILES_DIR" log -1 --format='%h %s (%cr)'
}

main() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    "" | help | -h | --help)
      usage 0
      ;;
    update)
      bash "$DOTFILES_DIR/update.sh" "$@"
      ;;
    install)
      bash "$DOTFILES_DIR/install.sh" "$@"
      ;;
    doctor)
      bash "$OPS_DIR/doctor.sh"
      ;;
    env)
      bash "$OPS_DIR/env.sh" "$@"
      ;;
    link | relink)
      bash "$OPS_DIR/symlinks.sh" "$command"
      ;;
    symlinks)
      bash "$OPS_DIR/symlinks.sh" "$@"
      ;;
    test)
      bash "$OPS_DIR/test.sh" "$@"
      ;;
    docs)
      bash "$OPS_DIR/docs.sh" "$@"
      ;;
    windows)
      cmd_windows "$@"
      ;;
    pull)
      cmd_pull
      ;;
    status)
      cmd_status
      ;;
    path)
      echo "$DOTFILES_DIR"
      ;;
    edit)
      "${EDITOR:-nvim}" "$DOTFILES_DIR"
      ;;
    __commands)
      command_names
      ;;
    *)
      log_error "Unknown command: $command"
      print_info "Run 'dotfiles' for usage information"
      exit 1
      ;;
  esac
}

main "$@"
