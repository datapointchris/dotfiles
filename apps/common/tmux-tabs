#!/usr/bin/env bash
# Session tab strip for tmux.
#
# Sessions are the tabs, named "repo·task"; windows are the roles inside one
# task. The status bar draws the strip with #{S:}, which walks sessions in
# session-id order, while tmux's own switch-client -n/-p walk them
# alphabetically. Navigating with the built-ins would therefore land on a
# visually random tab, so next/prev re-derive the bar's own order here.
#
# Id order also means tabs never reshuffle: renaming a session leaves it in
# place and a new one is appended at the end, the way browser tabs behave.

set -euo pipefail

usage() {
  cat << 'EOF'
Usage: tmux-tabs <command> [args]

Commands:
  next              Focus the tab to the right (wraps)
  prev              Focus the tab to the left (wraps)
  new [name]        Open a tab; a bare name inherits the current repo prefix
  promote [name]    Move the focused window out into a tab of its own
  list              Print tabs in strip order, current one marked
  install-status    Move tmux's stock window row to the second status line

Sessions are named "repo·task" and render as "repo·task" in the strip.
EOF
}

require_server() {
  if ! tmux info > /dev/null 2>&1; then
    echo "tmux-tabs: no tmux server running" >&2
    exit 1
  fi
}

# The strip's order: session id ascending. Sorting from character 2 skips the
# leading "$" so $10 lands after $9 rather than between $1 and $2.
tab_order() {
  tmux list-sessions -F '#{session_id} #{session_name}' | sort -k1.2,1n | cut -d' ' -f2-
}

current_tab() {
  tmux display-message -p '#{session_name}'
}

# "=" makes the target an exact match; without it tmux would resolve the name as
# a prefix and could land on a different tab.
focus_tab() {
  tmux switch-client -t "=$1"
}

step() {
  local direction="$1"
  local current
  current="$(current_tab)"

  local tabs=()
  while IFS= read -r tab; do
    tabs+=("$tab")
  done < <(tab_order)

  local count=${#tabs[@]}
  if [[ $count -lt 2 ]]; then
    return 0
  fi

  local index=0
  local position
  for position in "${!tabs[@]}"; do
    if [[ ${tabs[position]} == "$current" ]]; then
      index=$position
      break
    fi
  done

  local target
  if [[ $direction == next ]]; then
    target=$(((index + 1) % count))
  else
    target=$(((index - 1 + count) % count))
  fi

  focus_tab "${tabs[target]}"
}

new_tab() {
  local requested="${1:-}"

  if [[ -z $requested ]]; then
    echo "tmux-tabs: new needs a name" >&2
    exit 1
  fi

  local name="$requested"
  if [[ $requested != *·* ]]; then
    local current
    current="$(current_tab)"
    name="${current%%·*}·$requested"
  fi

  if tmux has-session -t "=$name" 2> /dev/null; then
    focus_tab "$name"
    return 0
  fi

  tmux new-session -d -s "$name" -c "$(tmux display-message -p '#{pane_current_path}')"
  focus_tab "$name"
}

# Move the focused window out into a tab of its own, which is how a task that
# was started as a window in whatever session happened to be focused becomes a
# first-class tab. A lone window is renamed in place instead of being moved,
# since moving it would leave an empty session behind for tmux to destroy.
promote_window() {
  local requested="${1:-}"
  local source_session
  source_session="$(current_tab)"

  local task="${requested:-$(tmux display-message -p '#{window_name}')}"
  local name="$task"
  if [[ $task != *·* ]]; then
    name="${source_session%%·*}·$task"
  fi

  if tmux has-session -t "=$name" 2> /dev/null; then
    echo "tmux-tabs: tab '$name' already exists" >&2
    exit 1
  fi

  if [[ $(tmux display-message -p '#{session_windows}') -eq 1 ]]; then
    tmux rename-session -t "=$source_session" "$name"
    return 0
  fi

  local source_window
  source_window="$(tmux display-message -p '#{window_id}')"

  local placeholder
  placeholder="$(tmux new-session -d -P -F '#{window_id}' -s "$name")"
  tmux move-window -s "$source_window" -t "=$name:"
  tmux kill-window -t "$placeholder"
  focus_tab "$name"
}

list_tabs() {
  local current
  current="$(current_tab)"

  local tab
  while IFS= read -r tab; do
    if [[ $tab == "$current" ]]; then
      echo "* $tab"
    else
      echo "  $tab"
    fi
  done < <(tab_order)
}

# Sessions belong on the first status line, above the windows, but tmux draws
# status-format[0] topmost and ships the window row there. Copy that stock row
# down to line 2 and leave line 1 for the theme's session strip, which is
# sourced after this runs. The guard makes a config reload a no-op — by then
# line 1 holds the session strip and copying again would duplicate it.
install_status() {
  if tmux show-options -gv 'status-format[1]' | grep -q 'window-status-format'; then
    return 0
  fi
  tmux set-option -g 'status-format[1]' "$(tmux show-options -gv 'status-format[0]')"
}

case "${1:-}" in
  next)
    require_server
    step next
    ;;
  prev)
    require_server
    step prev
    ;;
  new)
    require_server
    new_tab "${2:-}"
    ;;
  promote)
    require_server
    promote_window "${2:-}"
    ;;
  list)
    require_server
    list_tabs
    ;;
  install-status)
    require_server
    install_status
    ;;
  *)
    usage
    ;;
esac
