#!/usr/bin/env bash
#
# packup - Create compressed backup archive of specified paths
#
# Creates a timestamped zstd-compressed archive with smart exclusions, live progress
# tracking, and statistics. Run `packup --help` for the flags.
#
# zstd at level 3 with -T0: 2-3x faster than gzip at a better ratio, multi-threaded
# across every core, and fast enough to stay interactive.
#
# .git is kept whatever it costs. node_modules and .venv are regenerable from a
# manifest and git history is not, so the space saved is not worth the trade.
#
# **Every cleanup operation in the EXIT trap ends in `|| true`.** A trap's return
# value becomes the script's exit code, and it runs *after* the main body exits
# successfully — so one failing test in there turns a good backup into exit 1.
# `[[ -n "$VAR" ]] && rm -f "$VAR"` returns 1 whenever VAR is unset, which is
# enough to do it.

set -euo pipefail

# ============================================================================
# Dependencies
# ============================================================================

# Source required shell libraries
SHELL_DIR="${SHELL_DIR:-$HOME/.local/shell}"
source "$SHELL_DIR/formatting.sh"
source "$SHELL_DIR/colors.sh"

# ============================================================================
# Configuration
# ============================================================================

# UPDATE_INTERVAL_NS (90ms): Balances visual feedback vs CPU overhead. Too fast thrashes
#   terminal rendering, too slow feels unresponsive. 90ms hits sweet spot.
readonly UPDATE_INTERVAL_NS=90000000 # 90ms update interval (smooth without thrashing)
readonly ARCHIVE_SPINNER_SLEEP=0.02  # 20ms: Responsive animation during archiving

# Braille dots are compact and don't disrupt the progress line layout.
readonly SPINNER_CHARS="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

# Default exclusion patterns for tar (common bloat to skip)
readonly DEFAULT_EXCLUDE_PATTERNS=(
  '.venv'
  'node_modules'
  '__pycache__'
  '.mypy_cache'
  '.ruff_cache'
  '.pytest_cache'
  'build'
  'dist'
  '*.pyc'
  '.DS_Store'
)

# ============================================================================
# Global Variables
# ============================================================================

# Command line arguments (name and dest are required, no defaults)
BACKUP_NAME=""
DEST_DIR=""
PATHS_TO_BACKUP=()
EXTRA_EXCLUDES=()

# Timing
OVERALL_START_TIME=""
ARCHIVE_START_TIME=""

# Progress tracking
ARCHIVE_SPINNER_PID=""
PROGRESS_FILE=""

# ============================================================================
# Usage and Help
# ============================================================================

usage() {
  help_header "packup" "Create timestamped compressed backup archives with progress tracking"
  help_usage "packup -n <name> -d <dest> [OPTIONS] <path1> [path2] [path3...]"

  help_section "Options"
  help_row "-n, --name" "<name>" "Backup name (required)"
  help_row "-d, --dest" "<path>" "Destination directory (required)"
  help_row "-e, --exclude" "<pattern>" "Additional exclusion pattern (repeatable)"
  help_row "-h, --help" "" "Show this help message"

  help_section "Examples"
  help_row "packup -n dotfiles -d ~/Documents dotfiles .config" "" "# Backup dotfiles to Documents"
  help_row "packup -n code -d /Volumes/External code" "" "# Backup to external drive"
  help_row "packup -n dotfiles -d ~/Documents --exclude .git dotfiles" "" "# Exclude additional patterns"
  help_row "packup -n snapshot -d /tmp dotfiles ~/.zshrc" "" "# Mix directories and files"

  # shellcheck disable=SC2088
  help_section "Restore"
  help_row "tar -xf backup.tar.zst" "" "# Extract to current directory"
  help_row "tar -xf backup.tar.zst -C ~/restore" "" "# Extract to specific directory"
  help_row "tar -tf backup.tar.zst | head" "" "# List contents without extracting"

  help_end
}

# ============================================================================
# Cleanup Handler
# ============================================================================
#
# CRITICAL: This function runs on EXIT/INT/TERM via trap. It must NEVER fail or it will
# override the script's exit code. Every command must succeed even in unexpected states.
#
# Why all the || true?
# With 'set -e', any command returning non-zero causes immediate exit. In a trap handler,
# this can override a successful script exit (exit 0) with failure (exit 1). Examples:
#   - kill: Returns 1 if process doesn't exist (common if already finished)
#   - [[ test ]] && command: Returns 1 if test is false (breaks set -e)
#   - rm -f: Safe alone, but [[ test ]] && rm -f fails if test is false!
#
# The Fix: Add || true to every operation that might fail in normal operation.
#
# Real bug we hit: Script exited with code 1 despite successful backup because cleanup
# trap's `[[ -n "$VAR" ]] && rm -f "$VAR"` returned 1 when VAR was unset. The `|| true`
# at the end ensures the line always succeeds.

cleanup() {
  # Kill background spinner process
  if [[ -n "${ARCHIVE_SPINNER_PID:-}" ]]; then
    kill "$ARCHIVE_SPINNER_PID" 2>/dev/null || true # May already be dead
  fi

  # Remove temporary IPC files
  if [[ -n "${PROGRESS_FILE:-}" ]]; then
    rm -f "$PROGRESS_FILE" "$PROGRESS_FILE.staging"
  fi

  # Clear progress line (cosmetic, can't fail)
  printf "\r\033[K"

  # Explicitly return success to preserve script's actual exit code
  return 0
}

# Install cleanup trap for normal exit, interrupts (Ctrl-C), and termination signals
# This ensures temp files and background processes are always cleaned up
trap cleanup EXIT INT TERM

# ============================================================================
# Argument Parsing
# ============================================================================

parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h | --help)
        usage
        exit 0
        ;;
      -n | --name)
        if [[ -z "${2:-}" ]]; then
          echo "Error: --name requires a name" >&2
          exit 1
        fi
        BACKUP_NAME="$2"
        shift 2
        ;;
      -d | --dest)
        if [[ -z "${2:-}" ]]; then
          echo "Error: --dest requires a directory path" >&2
          exit 1
        fi
        DEST_DIR="$2"
        shift 2
        ;;
      -e | --exclude)
        if [[ -z "${2:-}" ]]; then
          echo "Error: --exclude requires a pattern" >&2
          exit 1
        fi
        EXTRA_EXCLUDES+=("$2")
        shift 2
        ;;
      -*)
        echo "Error: Unknown option: $1" >&2
        usage
        exit 1
        ;;
      *)
        PATHS_TO_BACKUP+=("$1")
        shift
        ;;
    esac
  done

  # Show usage if no paths specified
  if [[ ${#PATHS_TO_BACKUP[@]} -eq 0 ]]; then
    usage
    exit 0
  fi

  # Validate required arguments
  if [[ -z "$BACKUP_NAME" ]]; then
    echo "Error: --name is required" >&2
    exit 1
  fi
  if [[ -z "$DEST_DIR" ]]; then
    echo "Error: --dest is required" >&2
    exit 1
  fi
}

# ============================================================================
# Path Validation
# ============================================================================

validate_paths() {
  local existing_paths=()
  local missing_paths=()

  echo ""
  print_banner "Backup Paths" "orange"

  # Check each path
  for path in "${PATHS_TO_BACKUP[@]}"; do
    # Normalize path: if absolute, use as-is; if relative, prepend HOME
    local full_path
    if [[ "$path" = /* ]]; then
      full_path="$path"
    else
      full_path="$HOME/$path"
    fi

    # Convert to relative path from HOME for tar (if inside HOME)
    local relative_path="$path"
    if [[ "$path" = /* ]]; then
      if [[ "$path" = "$HOME"* ]]; then
        relative_path="${path#"$HOME"/}"
      else
        relative_path="$path"
      fi
    fi

    if [[ -e "$full_path" ]]; then
      existing_paths+=("$relative_path")
      echo "  ✓ Found: $(color_bright_green "$full_path")"
    else
      missing_paths+=("$relative_path")
      echo "  ⊘ Skipping: $(color_bright_black "$full_path") $(color_yellow "(not found)")"
    fi
  done

  echo ""

  # Check if we have anything to backup
  if [[ ${#existing_paths[@]} -eq 0 ]]; then
    color_red "Error: No paths found to backup"
    exit 1
  fi

  # Check if destination directory exists
  if [[ ! -d "$DEST_DIR" ]]; then
    color_red "Error: Destination directory not found: $DEST_DIR"
    exit 1
  fi

  # Return the lists via globals (caller reads from these globals)
  EXISTING_PATHS=("${existing_paths[@]}")
  if [[ ${#missing_paths[@]} -gt 0 ]]; then
    MISSING_PATHS=("${missing_paths[@]}")
  else
    MISSING_PATHS=()
  fi
}

# ============================================================================
# Progress Display
# ============================================================================

# The spinner reads this file while the count loop writes it, and `echo >file`
# truncates before it writes. A read landing in that window gets an empty string,
# which reaches printf's %'d as `invalid number` on stderr across the progress
# line. Staging plus mv is rename(2), so a reader sees one value or the previous
# one and never a half-written file.
write_progress_count() {
  local count="$1"
  local progress_file="$2"

  echo "$count" >"$progress_file.staging"
  mv "$progress_file.staging" "$progress_file"
}

start_progress_count_only() {
  local progress_file="$1"
  local start_time="$2"

  set +m # Disable job control messages
  (
    local spinner_idx=0
    while [[ -f "$progress_file" ]]; do
      if [[ -r "$progress_file" ]]; then
        local count
        count=$(cat "$progress_file" 2>/dev/null || echo "0")

        # Calculate elapsed time
        local now
        now=$(date +%s)
        local elapsed=$((now - start_time))
        local time_str
        time_str=$(printf "%02d:%02d" $((elapsed / 60)) $((elapsed % 60)))

        local spinner_char="${SPINNER_CHARS:$spinner_idx:1}"
        printf "\r  \033[96m%s\033[0m [\033[93m%s\033[0m] Processing... \033[92m%'d\033[0m entries    " \
          "$spinner_char" "$time_str" "$count"
        spinner_idx=$(((spinner_idx + 1) % ${#SPINNER_CHARS}))
      fi
      sleep "$ARCHIVE_SPINNER_SLEEP"
    done
  ) &
  ARCHIVE_SPINNER_PID=$!
  disown 2>/dev/null || true # Prevent job control messages (allow to fail silently)
  set -m                     # Re-enable job control
}

# ============================================================================
# Archive Phase - Create compressed archive with progress
# ============================================================================

create_archive() {
  local backup_dest="$1"
  shift
  local existing_paths=("$@")

  print_info "Creating backup archive..."
  echo "  Destination: $(color_bright_magenta "$backup_dest")"
  echo ""

  # Start timing
  ARCHIVE_START_TIME=$(date +%s)

  # Determine working directory for tar:
  # - If all paths are relative or inside HOME: cd to HOME, use relative paths
  # - If any path is absolute outside HOME: use absolute paths from current dir
  local use_home=true
  local tar_paths=()

  for path in "${existing_paths[@]}"; do
    if [[ "$path" = /* ]]; then
      if [[ "$path" != "$HOME"/* ]]; then
        use_home=false
      fi
    fi
  done

  if [[ "$use_home" == true ]]; then
    cd "$HOME" || exit 1
    for path in "${existing_paths[@]}"; do
      if [[ "$path" = /* ]]; then
        tar_paths+=("${path#"$HOME"/}")
      else
        tar_paths+=("$path")
      fi
    done
  else
    for path in "${existing_paths[@]}"; do
      if [[ "$path" = /* ]]; then
        tar_paths+=("$path")
      else
        tar_paths+=("$HOME/$path")
      fi
    done
  fi

  # Initialize progress tracking
  PROGRESS_FILE="/tmp/packup_$$_progress"
  echo "0" >"$PROGRESS_FILE"

  start_progress_count_only "$PROGRESS_FILE" "$ARCHIVE_START_TIME"

  # Build tar exclude arguments from defaults + extras
  local exclude_args=()
  for pattern in "${DEFAULT_EXCLUDE_PATTERNS[@]}"; do
    exclude_args+=("--exclude=$pattern")
  done
  for pattern in "${EXTRA_EXCLUDES[@]}"; do
    exclude_args+=("--exclude=$pattern")
  done

  # ==========================================================================
  # Archive Creation - The Critical Section
  # ==========================================================================
  #
  # CRITICAL CONCEPT: Separating tar's archive data from verbose output
  #
  # tar's I/O streams:
  #   stdout: Archive data (binary tar stream)
  #   stderr: Verbose output with -v flag (one filename per line)
  #
  # Solution Pattern:
  #   {
  #     tar -cv ... | zstd ... > file    # Archive pipeline in grouped command
  #   } 2>&1 | {                          # Redirect stderr (verbose) to pipeline
  #     count lines                       # Count filenames for progress
  #   }
  #
  # Why the curly braces?
  #   Grouping { commands; } lets us redirect stderr of the ENTIRE pipeline.
  #   Without grouping, `tar | zstd 2>&1` would mix tar's verbose with zstd's output.
  #
  # Why `set +o pipefail`?
  #   tar returns exit code 1 for warnings (e.g., "file changed while reading")
  #   even when archive is successfully created. With pipefail, this would fail
  #   the entire script. We check archive validity after creation instead.

  set +o pipefail # Disable pipefail: tar warnings shouldn't fail the script

  {
    tar -cv "${exclude_args[@]}" "${tar_paths[@]}" \
      | zstd -T0 -3 >"$backup_dest"
  } 2>&1 \
    | {
      # Count loop: Read tar's verbose output (filenames) and update progress file
      local processed=0
      local last_update
      last_update=$(date +%s%N)
      while IFS= read -r _line; do
        processed=$((processed + 1))
        # Throttle updates to UPDATE_INTERVAL_NS (90ms) to avoid thrashing
        local now
        now=$(date +%s%N)
        if [[ $((now - last_update)) -ge $UPDATE_INTERVAL_NS ]]; then
          write_progress_count "$processed" "$PROGRESS_FILE"
          last_update=$now
        fi
      done
      write_progress_count "$processed" "$PROGRESS_FILE"
    }

  # Re-enable pipefail now that archiving is complete
  set -o pipefail

  # ==========================================================================
  # Post-Archive Cleanup and Validation
  # ==========================================================================

  # bash waits for every process in a pipeline, so the count loop's final write
  # has landed by the time control reaches here.
  PROCESSED_FILES=$(cat "$PROGRESS_FILE" 2>/dev/null || echo "0")

  rm -f "$PROGRESS_FILE" # the spinner loop exits when this is gone

  # `|| true` because wait returns non-zero when the process has already exited,
  # which under `set -e` fails the function despite a good archive.
  wait "$ARCHIVE_SPINNER_PID" 2>/dev/null || true

  printf "\r\033[K"

  # tar's exit code cannot say whether this worked: it returns 1 for non-fatal
  # warnings like "file changed while reading" over a valid, complete archive.
  # Existence and non-zero size are the only reliable signal.
  if [[ ! -f "$backup_dest" ]] || [[ ! -s "$backup_dest" ]]; then
    return 1 # Archive creation failed
  fi

  return 0 # Success!
}

# ============================================================================
# Statistics Display
# ============================================================================

display_statistics() {
  local backup_dest="$1"
  local num_items="$2"
  local num_missing="$3"

  # Calculate timing
  local end_time
  end_time=$(date +%s)
  local total_elapsed=$((end_time - OVERALL_START_TIME))
  local total_time_str
  total_time_str=$(printf "%02d:%02d" $((total_elapsed / 60)) $((total_elapsed % 60)))

  # Get compressed archive size (using wc -c for cross-platform reliability)
  # tr -d ' ' removes any leading spaces that wc might output on some platforms
  local compressed_size
  compressed_size=$(wc -c <"$backup_dest" 2>/dev/null | tr -d ' ' || echo 0)
  local compressed_size_hr
  compressed_size_hr=$(numfmt --to=iec-i --suffix=B "$compressed_size" 2>/dev/null || echo "$((compressed_size / 1048576))M")

  # Display statistics
  echo ""
  print_section "Backup Statistics" "brightcyan"
  echo ""
  echo "  Location:        $(color_bright_blue "$backup_dest")"
  echo "  Entries:         $(color_bright_green "$PROCESSED_FILES")"
  echo "  Compressed size: $(color_bright_green "$compressed_size_hr")"
  echo "  Items:           $(color_bright_green "$num_items") backed up"
  echo ""
  echo "  Time - Total:    $(color_bright_green "$total_time_str")"

  if [[ $num_missing -gt 0 ]]; then
    echo "  Skipped:         $(color_orange "$num_missing")"
  fi

  echo ""
  print_section "Notes" "brightyellow"
  echo ""
  local all_excludes=("${DEFAULT_EXCLUDE_PATTERNS[@]}" "${EXTRA_EXCLUDES[@]}")
  echo "  $(color_cyan "•") Excludes: $(color_bright_black "${all_excludes[*]:0:3}, ...")"
  echo "  $(color_cyan "•") Git history $(color_bright_black "(.git)") included for recovery"
  echo "  $(color_cyan "•") Backup saved to: $(color_bright_blue "$DEST_DIR")"
  echo ""

  # Success message
  echo ""
  echo -e "  \033[92m✓ Backup completed successfully!\033[0m"
  echo ""
}

# ============================================================================
# Main
# ============================================================================

main() {
  # Start timing
  OVERALL_START_TIME=$(date +%s)

  # Parse command line arguments
  parse_arguments "$@"

  # Validate paths exist and build lists
  validate_paths

  # Create backup filename (always zstd)
  local date_stamp
  date_stamp=$(date '+%Y-%m-%d_%H%M%S')
  local backup_name="${BACKUP_NAME}_${date_stamp}.tar.zst"
  local backup_dest="$DEST_DIR/$backup_name"

  # Archive phase - create compressed backup
  if create_archive "$backup_dest" "${EXISTING_PATHS[@]}"; then
    # Display final statistics
    display_statistics "$backup_dest" "${#EXISTING_PATHS[@]}" "${#MISSING_PATHS[@]}"
    exit 0
  else
    echo ""
    color_red "✗ Backup failed"
    exit 1
  fi
}

# Run main if executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
