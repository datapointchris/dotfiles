#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml"]
# ///
"""menu-review - the temporal half of menu: a terminal-native cadence register.

Answers "what should I revisit or run on a cadence?". Invoked as `menu review`.

Two files, by design:
  - review.yml            declarative config you hand-edit (description, cadence,
                          optional command). This tool only ever reads it, so your
                          comments and layout are never disturbed.
  - review-state.json     the last-done date per item, written by `done`.

The due date is derived, never stored: next_due = last_done + cadence. A new item
with no recorded done simply shows as never done. Storing only last_done means
there is no date to keep in sync and nothing to drift.
"""

import json
import os
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path

import yaml

REGISTER = Path(os.environ.get("MENU_REVIEW_REGISTER", Path.home() / "dev" / "review.yml"))
STATE = Path(os.environ.get("MENU_REVIEW_STATE", Path.home() / "dev" / "review-state.json"))

CADENCE_UNITS = {"d": 1, "w": 7, "mo": 30, "y": 365}

CYAN = "\033[0;96m"
YELLOW = "\033[0;93m"
GREEN = "\033[0;92m"
RESET = "\033[0m"
BAR = "━" * 48

TEMPLATE = """\
# Terminal-native review / cadence register, read by `menu review`.
#
# This file is declarative config — edit it freely; `menu review` only ever
# reads it. The done state lives in review-state.json, which the tool writes.
#
#   description  what to revisit or run
#   cadence      how often: <n>d / <n>w / <n>mo / <n>y  (e.g. 2w, 1mo)
#   command      optional; shown so you know what to run (not auto-run)

items:
  revisit-a-tool:
    description: Open menu, pick a tool you have not used lately, relearn it
    cadence: 1w
"""


def parse_cadence(token: str) -> int:
    """Days for a cadence token like 2w / 1mo / 10d / 1y (bare number = days)."""
    token = str(token).strip()
    num = "".join(c for c in token if c.isdigit())
    unit = "".join(c for c in token if c.isalpha())
    if not num:
        return 0
    return int(num) * CADENCE_UNITS.get(unit, 1)


def load_items() -> dict | None:
    """The register's items, or None if there is no register file yet."""
    if not REGISTER.exists():
        return None
    data = yaml.safe_load(REGISTER.read_text()) or {}
    return data.get("items") or {}


def load_state() -> dict:
    if not STATE.exists():
        return {}
    return json.loads(STATE.read_text() or "{}")


def save_state(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2) + "\n")


def statuses() -> list[dict]:
    """Every item with its derived overdue days, most urgent first.

    overdue is the number of days past due (negative = not yet due); None means
    the item has never been done, which sorts to the very top as most urgent.
    """
    items = load_items() or {}
    state = load_state()
    today = date.today()
    rows = []
    for item_id, meta in items.items():
        meta = meta or {}
        last = state.get(item_id)
        if last:
            next_due = date.fromisoformat(last) + timedelta(days=parse_cadence(meta.get("cadence", "")))
            overdue = (today - next_due).days
        else:
            overdue = None
        rows.append(
            {
                "id": item_id,
                "cadence": str(meta.get("cadence", "")),
                "desc": meta.get("description", "") or "",
                "command": meta.get("command", "") or "",
                "last": last,
                "overdue": overdue,
            }
        )
    rows.sort(key=lambda r: float("inf") if r["overdue"] is None else r["overdue"], reverse=True)
    return rows


def is_due(row: dict) -> bool:
    return row["overdue"] is None or row["overdue"] >= 0


def status_label(row: dict) -> str:
    overdue = row["overdue"]
    if overdue is None:
        return "never done"
    if overdue > 0:
        return f"overdue {overdue}d"
    if overdue == 0:
        return "due today"
    return f"in {-overdue}d"


def header(title: str) -> None:
    print(f"{CYAN}{BAR}{RESET}")
    print(f"{CYAN} {title}{RESET}")
    print(f"{CYAN}{BAR}{RESET}\n")


def render_item(row: dict) -> None:
    meta = f"every {row['cadence']}"
    if row["last"]:
        meta += f" · last {row['last']}"
    print(f"  {YELLOW}{row['id']:<20}{RESET}  {status_label(row)}  ·  {meta}")
    print(f"      {row['desc']}")
    if row["command"]:
        print(f"      {CYAN}↳ {row['command']}{RESET}")
    print()


def warn_no_register() -> None:
    print(f"No review register at {REGISTER}.")
    print(f"Add items there (see docs/apps/menu.md), or create one with {CYAN}menu review edit{RESET}.")


def cmd_due() -> int:
    if load_items() is None:
        warn_no_register()
        return 0
    rows = statuses()
    if not rows:
        print("The review register has no items yet.")
        return 0

    header("Review — what's due")
    due = [row for row in rows if is_due(row)]
    if due:
        for row in due:
            render_item(row)
        print(f"Mark one done:  {CYAN}menu review done <id>{RESET}")
        return 0

    print(f"{GREEN}✓{RESET} All caught up.")
    soonest = rows[0]  # sorted desc, so the least-overdue (soonest) is first
    print(f"  Next up: {YELLOW}{soonest['id']}{RESET} in {-soonest['overdue']}d.")
    return 0


def cmd_list() -> int:
    if load_items() is None:
        warn_no_register()
        return 0
    header("Review — full register")
    for row in statuses():
        render_item(row)
    return 0


def cmd_done(item_id: str) -> int:
    items = load_items()
    if items is None:
        warn_no_register()
        return 1
    if item_id not in items:
        print(f"No such item: {item_id}")
        print(f"See what's registered with {CYAN}menu review list{RESET}.")
        return 1
    today = date.today().isoformat()
    state = load_state()
    state[item_id] = today
    save_state(state)
    days = parse_cadence(items[item_id].get("cadence", ""))
    print(f"{GREEN}✓{RESET} Marked '{item_id}' done ({today}). Due again in {days}d.")
    return 0


def cmd_edit() -> int:
    if not REGISTER.exists():
        REGISTER.parent.mkdir(parents=True, exist_ok=True)
        REGISTER.write_text(TEMPLATE)
    subprocess.run([os.environ.get("EDITOR", "vi"), str(REGISTER)], check=False)
    return 0


def show_help() -> int:
    print("menu review — what's due to revisit\n")
    print("  menu review            What's due now, most overdue first")
    print("  menu review list       Every registered item and its status")
    print("  menu review done <id>  Mark an item done (advances its due date)")
    print("  menu review edit       Edit the register in $EDITOR")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return cmd_due()
    sub, rest = args[0], args[1:]
    if sub in ("help", "-h", "--help"):
        return show_help()
    if sub == "list":
        return cmd_list()
    if sub == "edit":
        return cmd_edit()
    if sub == "done":
        if not rest:
            print("Usage: menu review done <id>")
            return 1
        return cmd_done(rest[0])
    print(f"Unknown: menu review {sub}")
    print("Try: menu review · menu review list · menu review done <id> · menu review edit")
    return 1


if __name__ == "__main__":
    sys.exit(main())
