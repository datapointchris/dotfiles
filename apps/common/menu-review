#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml"]
# ///
"""menu-review - the temporal half of menu: a terminal-native cadence register.

Answers "what should I revisit or run on a cadence?". Invoked as `menu review`.

Two files, by design:
  - review.yml            declarative config you hand-edit (description, cadence,
                          optional command). This tool only ever reads it, so your
                          comments and layout are never disturbed.
  - review-state.json     the last-done date per item, written by `done`.

The due date is derived, never stored: next_due = last_done + cadence. A new item
with no recorded done simply shows as never done. Storing only last_done means
there is no date to keep in sync and nothing to drift.
"""

import os
import subprocess
import sys
from datetime import date
from pathlib import Path

import yaml

# menu-review is symlinked onto PATH; resolve the real path so the repo-root
# menucore package (shared with menu-labs) is importable. parents[2] is the repo
# root: apps/common/menu-review → apps/common → apps → <repo>.
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from menucore import CYAN
from menucore import GREEN
from menucore import RESET
from menucore import YELLOW
from menucore import header
from menucore import is_due
from menucore import load_state
from menucore import overdue_days
from menucore import parse_cadence
from menucore import save_state
from menucore import status_label

REGISTER = Path(os.environ.get("MENU_REVIEW_REGISTER", Path.home() / "dev" / "review.yml"))
STATE = Path(os.environ.get("MENU_REVIEW_STATE", Path.home() / "dev" / "review-state.json"))

TEMPLATE = """\
# Terminal-native review / cadence register, read by `menu review`.
#
# This file is declarative config — edit it freely; `menu review` only ever
# reads it. The done state lives in review-state.json, which the tool writes.
#
#   description  what to revisit or run
#   cadence      how often: <n>d / <n>w / <n>mo / <n>y  (e.g. 2w, 1mo)
#   command      optional; shown so you know what to run (not auto-run)

items:
  revisit-a-tool:
    description: Open menu, pick a tool you have not used lately, relearn it
    cadence: 1w
"""


def load_items() -> dict | None:
    """The register's items, or None if there is no register file yet."""
    if not REGISTER.exists():
        return None
    data = yaml.safe_load(REGISTER.read_text()) or {}
    return data.get("items") or {}


def statuses() -> list[dict]:
    """Every item with its derived overdue days, most urgent first.

    overdue is the number of days past due (negative = not yet due); None means
    the item has never been done, which sorts to the very top as most urgent.
    """
    items = load_items() or {}
    state = load_state(STATE)
    today = date.today()
    rows = []
    for item_id, meta in items.items():
        meta = meta or {}
        last = state.get(item_id)
        overdue = overdue_days(last, meta.get("cadence", ""), today)
        rows.append(
            {
                "id": item_id,
                "cadence": str(meta.get("cadence", "")),
                "desc": meta.get("description", "") or "",
                "command": meta.get("command", "") or "",
                "show": meta.get("show", "") or "",
                "last": last,
                "overdue": overdue,
            }
        )
    rows.sort(key=lambda r: float("inf") if r["overdue"] is None else r["overdue"], reverse=True)
    return rows


def render_item(row: dict) -> None:
    meta = f"every {row['cadence']}"
    if row["last"]:
        meta += f" · last {row['last']}"
    print(f"  {YELLOW}{row['id']:<20}{RESET}  {status_label(row['overdue'])}  ·  {meta}")
    print(f"      {row['desc']}")
    if row["command"]:
        print(f"      {CYAN}↳ {row['command']}{RESET}")
    print()


def warn_no_register() -> None:
    print(f"No review register at {REGISTER}.")
    print(f"Add items there (see docs/apps/menu.md), or create one with {CYAN}menu review edit{RESET}.")


def cmd_due() -> int:
    if load_items() is None:
        warn_no_register()
        return 0
    rows = statuses()
    if not rows:
        print("The review register has no items yet.")
        return 0

    header("Review — what's due")
    due = [row for row in rows if is_due(row["overdue"])]
    if due:
        for row in due:
            render_item(row)
        print(f"Mark one done:  {CYAN}menu review done <id>{RESET}")
        return 0

    print(f"{GREEN}✓{RESET} All caught up.")
    soonest = rows[0]  # sorted desc, so the least-overdue (soonest) is first
    print(f"  Next up: {YELLOW}{soonest['id']}{RESET} in {-soonest['overdue']}d.")
    return 0


def cmd_list() -> int:
    if load_items() is None:
        warn_no_register()
        return 0
    header("Review — full register")
    for row in statuses():
        render_item(row)
    return 0


def cmd_done(item_id: str) -> int:
    items = load_items()
    if items is None:
        warn_no_register()
        return 1
    if item_id not in items:
        print(f"No such item: {item_id}")
        print(f"See what's registered with {CYAN}menu review list{RESET}.")
        return 1
    today = date.today().isoformat()
    state = load_state(STATE)
    state[item_id] = today
    save_state(STATE, state)
    days = parse_cadence(items[item_id].get("cadence", ""))
    print(f"{GREEN}✓{RESET} Marked '{item_id}' done ({today}). Due again in {days}d.")
    return 0


def run_show(row: dict) -> None:
    """Run a due item's `show:` command and let its output print inline.

    Only the nudge calls this — a `show:` command produces live content and can
    have side effects (e.g. `toolbox remind` advances its round-robin so it cycles
    to the next neglected tool), so the manual `list`/`due` views only ever read.
    This is the one place a review item runs rather than being displayed, and it
    is opt-in per item: `command:` is shown, `show:` is run. Stdout is inherited
    so colored output survives, and a timeout keeps a slow command from wedging
    shell startup.
    """
    cmd = row.get("show")
    if not cmd:
        return
    # Flush first: our print() output is buffered, but the subprocess writes to
    # the inherited fd immediately, so without this its card jumps ahead of the
    # header and item list we just printed.
    sys.stdout.flush()
    try:
        subprocess.run(cmd, shell=True, timeout=10, check=False)
    except subprocess.TimeoutExpired:
        pass


def cmd_nudge() -> int:
    """Startup nudge: print only what's due, and nothing at all when caught up.

    This is what the first shell of each half-day calls. The twice-a-day slot
    gate lives in the shell caller (a cheap `date +%F-%p` compare), so this stays
    a pure renderer — it never throttles itself, it just shows due items or stays
    silent. Silence-when-caught-up is the whole point: a nudge you don't notice on
    a clear day is a nudge you'll still read on a busy one.
    """
    if load_items() is None:
        return 0
    due = [row for row in statuses() if is_due(row["overdue"])]
    if not due:
        return 0
    header("Review — due to revisit")
    for row in due:
        render_item(row)
    # After the list, expand any items carrying live content (e.g. the neglected
    # tool `toolbox remind` picks) so the roster stays scannable above it.
    for row in due:
        run_show(row)
    print(f"Mark one done:  {CYAN}menu review done <id>{RESET}")
    return 0


def cmd_edit() -> int:
    if not REGISTER.exists():
        REGISTER.parent.mkdir(parents=True, exist_ok=True)
        REGISTER.write_text(TEMPLATE)
    subprocess.run([os.environ.get("EDITOR", "vi"), str(REGISTER)], check=False)
    return 0


def show_help() -> int:
    print("menu review — what's due to revisit\n")
    print("  menu review            What's due now, most overdue first")
    print("  menu review list       Every registered item and its status")
    print("  menu review done <id>  Mark an item done (advances its due date)")
    print("  menu review edit       Edit the register in $EDITOR")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return cmd_due()
    sub, rest = args[0], args[1:]
    if sub in ("help", "-h", "--help"):
        return show_help()
    if sub == "list":
        return cmd_list()
    if sub == "nudge":
        return cmd_nudge()
    if sub == "edit":
        return cmd_edit()
    if sub == "done":
        if not rest:
            print("Usage: menu review done <id>")
            return 1
        return cmd_done(rest[0])
    print(f"Unknown: menu review {sub}")
    print("Try: menu review · menu review list · menu review done <id> · menu review edit")
    return 1


if __name__ == "__main__":
    sys.exit(main())
