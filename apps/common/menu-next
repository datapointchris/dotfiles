    help_header('menu next', 'What to do now, drawn from what you said matters.')
    help_usage('menu next [<verb>] [ARGS]')

    help_section('Commands')
    help_row('menu next', '', 'Draw what to do now (cached 15m)')
    help_row('menu next', '--explain', 'The same draw with every number behind it')
    help_row('menu next', '--reroll', 'Force a fresh draw before the cache expires')
    help_row('menu log', '<pursuit> [note]', 'Record having done it (also: menu next log)')
    help_row('menu next skip', '<pursuit>', 'Pass on one — suppressed, weight untouched')
    help_row('menu next list', '', 'Every pursuit, its weight and implied share')
    help_row('menu next drift', '[--days N]', 'Stated weight against what you actually did')
    help_row('menu next dormant', '', 'Pursuits gone colder than their weight implies')
    help_row('menu next edit', '', 'Edit the pursuits file in $EDITOR')

    help_section('Options')
    help_row('--ago', '<3h|2d>', 'Log something you did earlier')
