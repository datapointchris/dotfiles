# Offline bundle test image
#
# Ubuntu 26.04 because that is what the work WSL runs, and the point of this
# image is to be the same starting line: a machine with nothing installed and
# no route to GitHub. Only the packages an installer script needs are present,
# so anything a tool assumes is already there shows up as a failure here rather
# than on the remote machine.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

RUN apt-get update && apt-get install -y \
  ca-certificates \
  curl \
  file \
  git \
  gzip \
  jq \
  python3 \
  python3-yaml \
  tar \
  unzip \
  xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash testuser

USER testuser
WORKDIR /home/testuser
RUN mkdir -p /home/testuser/.local/bin
