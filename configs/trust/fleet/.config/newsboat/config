# Feeds come from a self-hosted FreshRSS over its Google Reader API, so the
# server address and the account are facts about one machine's own network. This
# repo is public and carries neither. `install/flags.yml` declares
# ~/.config/newsboat/local.config, which holds `freshrss-url` and
# `freshrss-login` and nothing else.
#
# Under trust/fleet rather than common/ because of what the include does when
# the file is absent: newsboat treats a missing include as a fatal config error
# and refuses to start. A machine with no FreshRSS to reach has no way to write
# that file, so it must not deploy a config that demands one.
include "~/.config/newsboat/local.config"

urls-source "freshrss"
freshrss-passwordeval "echo $FRESHRSS_PASSWORD"
refresh-on-startup yes
