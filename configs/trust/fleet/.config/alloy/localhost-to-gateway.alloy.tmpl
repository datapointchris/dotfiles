// This machine's OTLP agent. A program sends its telemetry to the default OTLP
// ports on localhost, and Alloy forwards it to the collector through a queue on
// disk. Telemetry written while the collector is out of reach waits there.
//
// Alloy reads every *.alloy file in this directory as one configuration. This file
// is the agent. Each other file reads one writer's records or metrics and sends them
// to the exporter below, so a new source of telemetry is a new file beside this one.

otelcol.receiver.otlp "local" {
  grpc {
    endpoint = "127.0.0.1:4317"
  }

  http {
    endpoint = "127.0.0.1:4318"
  }

  output {
    logs    = [otelcol.processor.transform.local_host.input]
    metrics = [otelcol.processor.transform.local_host.input]
    traces  = [otelcol.processor.transform.local_host.input]
  }
}

// A local program names its service and rarely its box, so the agent stamps the
// box here by its lowercased short hostname, as every record file does.
otelcol.processor.transform "local_host" {
  error_mode = "ignore"

  log_statements {
    context    = "resource"
    statements = [string.format("set(attributes[\"host.name\"], %q)", string.to_lower(string.split(constants.hostname, ".")[0]))]
  }

  metric_statements {
    context    = "resource"
    statements = [string.format("set(attributes[\"host.name\"], %q)", string.to_lower(string.split(constants.hostname, ".")[0]))]
  }

  trace_statements {
    context    = "resource"
    statements = [string.format("set(attributes[\"host.name\"], %q)", string.to_lower(string.split(constants.hostname, ".")[0]))]
  }

  output {
    logs    = [otelcol.exporter.otlphttp.collector.input]
    metrics = [otelcol.exporter.otlphttp.collector.input]
    traces  = [otelcol.exporter.otlphttp.collector.input]
  }
}

// Under the --storage.path the service passes Alloy.
otelcol.storage.file "queue" { }

// How far each record file has been read, so a restart ships nothing twice.
otelcol.storage.file "offsets" { }

otelcol.exporter.otlphttp "collector" {
  client {
    endpoint = "${OTLP_GATEWAY_ENDPOINT}"
  }

  // Capped in bytes, so the limit is disk rather than a count of batches.
  sending_queue {
    enabled    = true
    sizer      = "bytes"
    queue_size = 1073741824
    storage    = otelcol.storage.file.queue.handler

    // Sized in bytes, so a request stays under an OTLP receiver's default 20 MiB
    // body however many record files a first start reads at once.
    batch {
      sizer         = "bytes"
      min_size      = 1048576
      max_size      = 16777216
      flush_timeout = "1s"
    }
  }

  // Retried until the collector takes it, so time away costs queue space rather
  // than telemetry.
  retry_on_failure {
    enabled          = true
    max_elapsed_time = "0s"
  }
}

// Each failed retry logs at info, which away from the collector is one line every
// half minute into a log launchd never rotates.
logging {
  level = "warn"
}
