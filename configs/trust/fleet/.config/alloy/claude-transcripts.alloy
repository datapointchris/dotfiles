// Every line of every Claude Code transcript on this machine, whole, for the
// warehouse's bronze, named for this machine by its lowercased short hostname. The
// session, agent, workflow and project come from the path, because a line's own
// sessionId can differ. A workflow's agents and its journal sit a level below the
// session's subagents.
//
// Each OS reads only the project directories its own Claude Code writes. A desk
// running Claude Code under /Users links each `-Users-chris-<repo>` to
// `-home-chris-<repo>`, so a repo's sessions share one directory on every OS. On
// Linux a `-Users-` entry is such a link, which nothing here writes through. On
// macOS a `-home-`, `-tmp-` or `-var-` entry is named for a Linux path, and macOS
// reaches its own sessions in `-home-` through the `-Users-` links. So each file
// matches under one name, and the path a line carries is the resolved one, naming
// the real directory.
//
// Each poll stats every transcript the glob matches, and opens and checkpoints each
// one it keeps, at roughly 25 to 35 microseconds of CPU a transcript. So a 1s poll
// over a week of sessions holds about a tenth of a core. A 250ms poll over the same
// week holds about half, since a poll then takes longer than the interval. A file
// older than the window is not read, and once it is written again it is read whole,
// so a session resumed after a day ships every line again and bronze folds the
// copies. The window also bounds a first start to a day of lines.

// How far each transcript has been read, so a restart reads nothing twice.
otelcol.storage.file "transcript_offsets" { }

otelcol.receiver.filelog "claude_transcripts" {
  include = [
    string.format("%s/.claude/projects/%s/*.jsonl", sys.env("HOME"), {linux = "-[!U]*", darwin = "-[!htv]*"}[constants.os]),
    string.format("%s/.claude/projects/%s/*/subagents/*.jsonl", sys.env("HOME"), {linux = "-[!U]*", darwin = "-[!htv]*"}[constants.os]),
    string.format("%s/.claude/projects/%s/*/subagents/workflows/*/*.jsonl", sys.env("HOME"), {linux = "-[!U]*", darwin = "-[!htv]*"}[constants.os]),
  ]
  exclude_older_than         = "24h"
  start_at                   = "beginning"
  storage                    = otelcol.storage.file.transcript_offsets.handler
  fingerprint_size           = "1KiB"
  poll_interval              = "1s"
  max_log_size               = "16MiB"
  include_file_path          = true
  include_file_path_resolved = true
  include_file_record_number = true

  operators = [
    {type = "move", from = "attributes[\"log.file.path_resolved\"]", to = "attributes[\"log.file.path\"]"},
    {
      type       = "regex_parser",
      parse_from = "attributes[\"log.file.path\"]",
      regex      = "/(?P<project>[^/]+)/(?P<session>[^/]+?)(?:/subagents(?:/workflows/(?P<workflow>[^/]+))?/(?:agent-(?P<agent>[^/]+)|[^/]+))?\\.jsonl$",
      on_error   = "send_quiet",
    },
    {type = "move", from = "attributes.session", to = "attributes[\"session.id\"]"},
    {type = "move", if = "attributes.agent != nil and attributes.agent != \"\"", from = "attributes.agent", to = "attributes[\"agent.id\"]"},
    {type = "move", if = "attributes.workflow != nil and attributes.workflow != \"\"", from = "attributes.workflow", to = "attributes[\"workflow.id\"]"},
    {type = "remove", if = "attributes.agent != nil", field = "attributes.agent"},
    {type = "remove", if = "attributes.workflow != nil", field = "attributes.workflow"},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "claude.transcript.line"},
    {type = "add", field = "resource[\"service.name\"]", value = "claude-transcripts"},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
  ]

  // Reading waits while the queue is full, so a first read never drops a line.
  retry_on_failure {
    enabled          = true
    max_elapsed_time = "0s"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
