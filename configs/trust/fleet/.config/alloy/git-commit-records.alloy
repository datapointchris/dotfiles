// The git.commit_made records the commit hook writes on this machine, one commit a
// line. Nothing syncs this directory, so its glob names no host. Each line already
// says its record's name and resource, and carries a trace context where the commit
// was made under one.
otelcol.receiver.filelog "git_commit_records" {
  include          = [string.format("%s/telemetry/git-commits.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      timestamp = {parse_from = "attributes.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
      trace     = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "move", from = "attributes.name", to = "body"},
    {type = "key_value_parser", parse_from = "attributes.resource", parse_to = "resource", delimiter = "=", pair_delimiter = ","},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "git.commit_made"},
  ]

  retry_on_failure {
    enabled          = true
    max_elapsed_time = "0s"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
