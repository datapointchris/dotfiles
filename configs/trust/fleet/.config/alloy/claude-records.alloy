// The record files Claude Code's tooling writes on this machine, each record once,
// named for this machine by its lowercased short hostname.

// The Claude Code statusline's usage readings, one a line: the account's
// window percents as the statusline wrote them, which the budget reader takes
// as this machine's reading. The reading is the body.
otelcol.receiver.filelog "budget_readings" {
  include          = [string.format("%s/claude/budget-readings/*-%s.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      timestamp = {parse_from = "attributes.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
    },
    {type = "move", from = "attributes.reading", to = "body"},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "budget.reading"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// What each Claude Code hook decided and each skill Chris typed, one event a line.
// A hook cannot wait on a socket, so builder.hook_run_recorder appends here. Nothing
// syncs this directory, so its glob names no host, and the `*` follows a file the
// recorder has rotated. Each line already says its record's name and resource.
otelcol.receiver.filelog "hook_runs" {
  include          = [string.format("%s/telemetry/claude-hooks.jsonl*", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      timestamp = {parse_from = "attributes.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
      trace     = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "move", from = "attributes.name", to = "body"},
    {type = "key_value_parser", parse_from = "attributes.resource", parse_to = "resource", delimiter = "=", pair_delimiter = ","},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "claude.hook.record"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// Each call a session made into a watched CLI, scored for suspicion, one call a line.
// A review drains a session's ledger by renaming it into reviewed/. The receiver tells
// files apart by their opening bytes, so reading both globs ships each line once.
otelcol.receiver.filelog "session_review_ledgers" {
  include = [
    string.format("%s/session-review/sessions/*.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME")))),
    string.format("%s/session-review/reviewed/*.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME")))),
  ]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      parse_to  = "attributes.record",
      on_error  = "send_quiet",
      timestamp = {parse_from = "attributes.record.at", layout_type = "epoch", layout = "s.us"},
    },
    {type = "remove", if = "attributes.record != nil", field = "attributes.record"},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "claude.cli_call"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// What the dispatch-work skill sent a worker and what the worker reported: one
// indented JSON document a file, so a record opens at a brace in the first column.
// A worker's model stream sits beside these under a numbered name, and stays out.
otelcol.receiver.filelog "dispatch_worker_records" {
  include  = [string.format("%s/dispatch-work/*/*.[a-z]*.json", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dispatch.worker_record"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// What the director skill heard and carried between its user and running sessions.
otelcol.receiver.filelog "director_log" {
  include          = [string.format("%s/claude/director/*.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      parse_to  = "attributes.record",
      on_error  = "send_quiet",
      timestamp = {parse_from = "attributes.record.at", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
    },
    {type = "remove", if = "attributes.record != nil", field = "attributes.record"},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "claude.director_event"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
