// The record file `forge` writes on this machine, each record once. Nothing syncs
// this directory, so the glob names no host. It sits under data rather than state
// because forge's `stats` reads it back as its own.

// One die's result from one check, plan or apply, one die a line.
otelcol.receiver.filelog "forge_die_stats" {
  include          = [string.format("%s/forge/stats.jsonl", coalesce(sys.env("XDG_DATA_HOME"), string.format("%s/.local/share", sys.env("HOME"))))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      parse_to  = "attributes.record",
      on_error  = "send_quiet",
      timestamp = {parse_from = "attributes.record.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
    },
    {type = "remove", if = "attributes.record != nil", field = "attributes.record"},
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "forge.die_stat"},
  ]

  retry_on_failure {
    enabled          = true
    max_elapsed_time = "0s"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
