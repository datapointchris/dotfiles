// The record files dotfiles writes on this machine, each record once. A synced
// directory also holds other machines' files, so each glob names this machine's
// own by its lowercased short hostname, and the box that wrote a record is the
// one that ships it.
//
// A JSON record carrying a W3C traceparent lands under the trace that wrote it.
// One without the field passes through unparsed.

// A dotfiles run: one JSON object per file, its closing brace at the first column.
otelcol.receiver.filelog "dotfiles_runs" {
  include  = [string.format("%s/.local/state/dotfiles/runs/*-%s-*.json", sys.env("HOME"), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {
      type     = "regex_parser",
      regex    = "\"traceparent\":\\s*\"00-(?P<trace_id>[0-9a-f]{32})-(?P<span_id>[0-9a-f]{16})-",
      on_error = "send_quiet",
      trace    = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.run"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// Each command a dotfiles run made, one JSON object a line.
otelcol.receiver.filelog "dotfiles_effects" {
  include  = [string.format("%s/.local/state/dotfiles/runs/*-%s-*.jsonl", sys.env("HOME"), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {
      type     = "regex_parser",
      regex    = "\"traceparent\":\\s*\"00-(?P<trace_id>[0-9a-f]{32})-(?P<span_id>[0-9a-f]{16})-",
      on_error = "send_quiet",
      trace    = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.effect"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// A run of one of this machine's dotfiles timers, one JSON object a line, mapped
// onto the check record the inbox reader files a row from and resolves it by: the
// command's report is the body, the machine is the resource's host.name, and the
// key, outcome and summary are attributes. The key is the timer's name under its
// own prefix, so no other producer's row is resolved by a timer's pass.
otelcol.receiver.filelog "timer_reports" {
  include          = [string.format("%s/dotfiles/timer-reports/*-%s.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      timestamp = {parse_from = "attributes.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
    },
    {type = "move", from = "attributes.report", to = "body"},
    {type = "move", from = "attributes.host", to = "resource[\"host.name\"]"},
    {type = "add", field = "attributes[\"fleet.check.key\"]", value = "EXPR(\"timer/\" + attributes.timer)"},
    {type = "move", from = "attributes.outcome", to = "attributes[\"fleet.check.outcome\"]"},
    {type = "move", from = "attributes.summary", to = "attributes[\"fleet.check.summary\"]"},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "desk.check"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
