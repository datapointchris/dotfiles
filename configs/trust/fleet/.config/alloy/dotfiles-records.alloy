// The record files dotfiles writes on this machine, each record once.
// `dotfiles report download` puts other machines' files in the same directory, so
// each glob names this machine's own by its lowercased short hostname, and the box
// that wrote a record is the one that ships it.
//
// A JSON record carrying a W3C traceparent lands under the trace that wrote it.
// One without the field passes through unparsed.
//
// The runs directory holds thousands of files, and each poll opens every one and
// matches its fingerprint against the rest. So its two tails poll every 30s
// rather than every 200ms. That is a fifteenth of the CPU, and no reader of these
// records works within minutes.

// A dotfiles run: one JSON object per file, its closing brace at the first column.
otelcol.receiver.filelog "dotfiles_runs" {
  include       = [string.format("%s/.local/state/dotfiles/runs/*-%s-*.json", sys.env("HOME"), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at      = "beginning"
  storage       = otelcol.storage.file.offsets.handler
  poll_interval = "30s"

  operators = [
    {
      type     = "regex_parser",
      regex    = "\"traceparent\":\\s*\"00-(?P<trace_id>[0-9a-f]{32})-(?P<span_id>[0-9a-f]{16})-",
      on_error = "send_quiet",
      trace    = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.run"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// Each command a dotfiles run made, one JSON object a line. A log can open with a
// tool's long usage text, the same across runs, so its first KiB does not tell it
// from another run's and the receiver would take it for a file already read.
otelcol.receiver.filelog "dotfiles_effects" {
  include          = [string.format("%s/.local/state/dotfiles/runs/*-%s-*.jsonl", sys.env("HOME"), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  poll_interval    = "30s"
  fingerprint_size = "8KiB"

  operators = [
    {
      type     = "regex_parser",
      regex    = "\"traceparent\":\\s*\"00-(?P<trace_id>[0-9a-f]{32})-(?P<span_id>[0-9a-f]{16})-",
      on_error = "send_quiet",
      trace    = {trace_id = {parse_from = "attributes.trace_id"}, span_id = {parse_from = "attributes.span_id"}},
    },
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.effect"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// A run of one of this machine's dotfiles timers, one JSON object a line, mapped
// onto the check record the inbox reader files a row from and resolves it by: the
// command's report is the body, the machine is the resource's host.name, and the
// key, outcome and summary are attributes. The key is the timer's name under its
// own prefix, so no other producer's row is resolved by a timer's pass.
otelcol.receiver.filelog "timer_reports" {
  include          = [string.format("%s/dotfiles/timer-reports/*-%s.jsonl", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at         = "beginning"
  storage          = otelcol.storage.file.offsets.handler
  fingerprint_size = "1KiB"

  operators = [
    {
      type      = "json_parser",
      timestamp = {parse_from = "attributes.timestamp", layout_type = "gotime", layout = "2006-01-02T15:04:05.999999999Z07:00"},
    },
    {type = "move", from = "attributes.report", to = "body"},
    {type = "move", from = "attributes.host", to = "resource[\"host.name\"]"},
    {type = "add", field = "attributes[\"fleet.check.key\"]", value = "EXPR(\"timer/\" + attributes.timer)"},
    {type = "move", from = "attributes.outcome", to = "attributes[\"fleet.check.outcome\"]"},
    {type = "move", from = "attributes.summary", to = "attributes[\"fleet.check.summary\"]"},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "desk.check"},
  ]

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// One end-to-end test matrix's outcome: one indented JSON document a run, so a record
// opens at a brace in the first column. Its own machine field names the box.
otelcol.receiver.filelog "test_runs" {
  include  = [string.format("%s/dotfiles/test-runs/*/record.json", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.test_run"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// One mutation-testing run's survivors and score: one indented JSON document a run.
otelcol.receiver.filelog "mutation_runs" {
  include  = [string.format("%s/dotfiles/mutation-runs/*-%s.json", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))), string.to_lower(string.split(constants.hostname, ".")[0]))]
  start_at = "beginning"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.mutation_run"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// One persona review's run record and report: one indented JSON document a run. Nothing
// syncs this directory, so the glob names no host.
otelcol.receiver.filelog "persona_review_runs" {
  include      = [string.format("%s/dotfiles/persona-review/runs/*/run.json", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at     = "beginning"
  storage      = otelcol.storage.file.offsets.handler
  max_log_size = "8MiB"

  operators = [
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "dotfiles.persona_review_run"},
  ]

  multiline {
    line_start_pattern = "^\\{"
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}

// Every notification the ntfy client received here. A delivery opens at its time of
// day and may run over several lines. The line carries no date, so only a delivery
// arriving from now on has a true timestamp, and the tail starts at the end. The title
// sits in brackets and a delivery may have none.
otelcol.receiver.filelog "ntfy_deliveries" {
  include  = [string.format("%s/ntfy/notify.log", coalesce(sys.env("XDG_STATE_HOME"), string.format("%s/.local/state", sys.env("HOME"))))]
  start_at = "end"
  storage  = otelcol.storage.file.offsets.handler

  operators = [
    {
      type     = "regex_parser",
      regex    = "^(?P<time_of_day>[0-9]{2}:[0-9]{2}:[0-9]{2})  (?:\\[(?P<title>[^\\]]*)\\] )?",
      on_error = "send_quiet",
    },
    {type = "add", field = "resource[\"host.name\"]", value = string.to_lower(string.split(constants.hostname, ".")[0])},
    {type = "add", field = "attributes[\"fleet.kind\"]", value = "ntfy.delivery"},
  ]

  multiline {
    line_start_pattern = "^[0-9]{2}:[0-9]{2}:[0-9]{2}  "
  }

  output {
    logs = [otelcol.exporter.otlphttp.collector.input]
  }
}
