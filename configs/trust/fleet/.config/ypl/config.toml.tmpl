# ypl's machine config: the server, the identity provider that signs the tokens
# it takes, and the OAuth client this machine logs in as.
#
# Rendered from ~/.env rather than linked. The addresses are this fleet's own
# and this repo is public, and ypl compiles neither in. The client id is this
# machine's, and a link into the tree every machine shares would hand it to all
# of them.
#
# Fleet-scoped because every value names this fleet's installation. A nonfleet
# manifest does not install ypl, so configs/trust/nonfleet/ carries no
# counterpart.
api = "https://ypl.${HOMELAB_DOMAIN}"
issuer = "https://auth.${HOMELAB_DOMAIN}"
client_id = "ypl-${OAUTH_CLIENT_SUFFIX}"

# The same server under the key ypl releases without `api` read. ypl ignores a
# key it does not name, so each release reads the one it knows.
api_base = "https://ypl.${HOMELAB_DOMAIN}"
