# A fleet machine hosts personal work only, so the personal identity is simply
# the default and nothing here needs a condition.
[include]
path = ~/.config/git/personal.gitconfig

# Each hook is set in config, so it runs in every repo and leaves .git/hooks to the
# repo's own hook manager. git appends the hook's arguments to the command. The
# test skips a hook until `dotfiles symlinks apply` deploys its script, because a
# command that is not there prints the shell's error on every commit. A git too old
# to run a hook set in config skips it silently, which `dotfiles check` reports.

# Records a session's commit on the slate worklog the session is in. A merge commit
# runs post-merge rather than post-commit, so it listens on both.
[hook "slate-worklog-link"]
event = post-commit
event = post-merge
command = [ ! -x ~/.local/bin/link-commit-to-slate-worklog ] || exec ~/.local/bin/link-commit-to-slate-worklog

# Appends a git.commit_made record for each commit, which Alloy ships, on both
# events as above.
[hook "git-commit-record"]
event = post-commit
event = post-merge
command = [ ! -x ~/.local/bin/record-git-commit ] || exec ~/.local/bin/record-git-commit
