# Nonfleet is the default and personal is the exception, never the reverse. A
# repo that slips through the match then commits under the default address, which
# is wrong and stays inside. The inverse puts a personal address into history that
# is not personal, which does not come back.
#
# local.gitconfig is the one identity this repo does not ship, so it is
# declared in install/flags.yml and `dotfiles check` fails while it is missing.
# Without that the machine simply refuses to commit, naming nothing.
[include]
path = ~/.config/git/local.gitconfig

# Keyed on the remote rather than the checkout path, so it holds wherever a repo
# is cloned rather than only under a blessed directory. Two blocks because the
# condition matches the URL literally and the same remote is spelled differently
# over HTTPS and SSH.
[includeIf "hasconfig:remote.*.url:https://github.com/datapointchris/**"]
path = ~/.config/git/personal.gitconfig

[includeIf "hasconfig:remote.*.url:git@github.com:datapointchris/**"]
path = ~/.config/git/personal.gitconfig
