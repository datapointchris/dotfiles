# prs — machine config.
#
# A template rather than a trust-scoped literal, because prs reads the same
# registry `repos-registry` names, and REPOS_REGISTRY resolves through the same
# two rungs: the DOTFILES_REPOS_REGISTRY variable, then repos_registry in
# dotfiles' own config. A machine that moves its registry changes that setting, and this file
# follows on the next apply. Change a key here rather than in the rendered file,
# which apply overwrites.
repos_registry: "${REPOS_REGISTRY}"

# The two Claude keys, offered only where claude is on PATH, which a network
# that blocks claude.ai leaves uninstalled. Each opens a tmux window in the pull
# request's checkout. r runs a review round, so the row reads claude running
# while its window is open.
window_actions:
  - key: r
    label: claude review
    detail: a Claude window running /review-pr on it
    needs: [claude]
    providers: [github]
    window: "review {repo} #{number}"
    command: "claude --permission-mode bypassPermissions '/review-pr {number}'"
    runs_review_round: true
  - key: C
    label: claude explain
    detail: a Claude window running /explain-code-changes on it
    needs: [claude]
    providers: [github]
    window: "explain {repo} #{number}"
    command: "claude --permission-mode bypassPermissions '/explain-code-changes #{number}'"

# The recaps tab, drawn only where every program in needs is on PATH, so a
# machine without them draws none. list sorts, because the recap listing puts
# the oldest window first with days and weeks mixed. pipefail makes a failure
# ahead of the pipe fail the list, which jq's exit would otherwise read as no
# recap written. write is a model call, which prs asks before running.
recaps:
  needs: [fleet, jq]
  list:
    - sh
    - -c
    - >-
      set -o pipefail;
      fleet ledger recap --since 90d --json
      | jq -r 'sort_by(.window.since) | reverse | .[].window | "\(.kind) \(.label)"'
  show: [fleet, ledger, recap, "--{kind}", "{label}"]
  write: [fleet, agents, dispatch, recap, "--{kind}", "{label}"]
