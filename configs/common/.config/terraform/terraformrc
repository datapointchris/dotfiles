# TF_CLI_CONFIG_FILE points here, so this file has to exist.
#
# plugin_cache_dir is also exported as TF_PLUGIN_CACHE_DIR, but declaring it
# here covers non-login shells that never source .zshrc — CI containers and
# `ssh host terraform ...` — where every init would otherwise re-download
# providers it already has.
plugin_cache_dir = "$HOME/.cache/terraform/plugins"
