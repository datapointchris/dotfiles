# Written by `theme` and `font`, so none of them exists until one has been run.
# The leading ? is ghostty's own "suppress errors if the file does not exist",
# which is what keeps a fresh machine from opening on a config error for three
# files whose absence is the normal state before the first apply.
config-file = ?themes/current.conf
config-file = ?fonts/current.conf
config-file = ?opacity/current.conf

macos-titlebar-style = hidden

# Linux/GTK chrome — match Ghostty's palette, use the terminal font for tab
# labels, flatten the toolbar, and let tabs size to their content.
window-theme = ghostty
gtk-toolbar-style = flat
gtk-wide-tabs = true
gtk-custom-css = ?themes/current.css
gtk-custom-css = ?fonts/current.css

window-padding-x = 16
window-padding-y = 4,4
window-padding-balance = false

# Trails the cursor on jumps longer than a couple of cells, so word and line
# motions read as movement while ordinary typing stays still.
custom-shader = shaders/cursor-smear.glsl

# Font rendering preferences
font-style = Regular
adjust-cell-height = 3
adjust-cell-width = 0
font-thicken = false
font-feature = -liga
font-feature = -calt
font-feature = -clig

confirm-close-surface = false

keybind = shift+enter=text:\x1b\r
