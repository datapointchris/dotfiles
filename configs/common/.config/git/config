[advice]
addIgnoredFile = false

# No identity here, by design — it is the one git setting that differs per
# machine rather than per platform, so it lives in ~/.gitconfig, which git reads
# after this file. useConfigOnly stops git synthesizing one from hostname and
# username when that file is missing: on a machine where employer and personal
# repos coexist, a guessed author is a wrong author that commits silently.
[user]
useConfigOnly = true

[core]
pager = delta
editor = nvim

[init]
defaultBranch = main

[pull]
rebase = true

[push]
autoSetupRemote = true

[merge]
conflictstyle = zdiff3
tool = nvimdiff

[mergetool]
keepBackup = false
prompt = false

[mergetool "nvimdiff"]
layout = "LOCAL,BASE,REMOTE / MERGED"

[diff]
colorMoved = default
tool = nvimdiff

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true
line-numbers = true
side-by-side = true

# Colors only — written by `theme apply`, and ignored by git while absent.
# Must follow [delta] above so the palette wins over any colour set there.
[include]
path = ~/.config/delta/current.gitconfig

# Whatever this platform needs that the others do not — the gh path differs,
# WSL needs autocrlf. Absolute rather than relative because this file is reached
# through a symlink and a relative include would resolve against the repo.
# Ignored while absent, so a platform shipping none needs no file.
[include]
path = ~/.config/git/platform.gitconfig

[alias]
prune = fetch --prune
undo-commit = reset --soft HEAD^
unstage = restore --staged
graph = log --graph --pretty=format:'%C(blue)%h%C(auto)%d %s %C(green)(%cr)%C(dim yellow) - %an%C(auto)'
oneline = log --oneline
last = commit --amend --no-edit --no-verify
last-commit = log -1 HEAD
changes = log --pretty='short' --name-status
