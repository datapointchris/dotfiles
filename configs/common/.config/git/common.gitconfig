[advice]
addIgnoredFile = false

# No identity here, by design — it differs per machine, not per platform, so it
# arrives through the trust include at the foot of this file. useConfigOnly stops
# git synthesizing one from hostname and username when nothing sets it: on a
# machine where employer and personal repos coexist, a guessed author is a wrong
# author that commits silently.
[user]
useConfigOnly = true

[core]
pager = delta
editor = nvim

[init]
defaultBranch = main

[fetch]
prune = true
# Not implied by fetch.prune, and safe on this fleet: every tag is created
# inside GitHub Actions, so it reaches the server before any clone, and no
# active repo carries a second remote — the only local-only tag would be one
# deleted upstream on purpose.
pruneTags = true

[pull]
rebase = true

# Catching a stack up with main is one rebase of its top branch instead of one
# per level. Off by default upstream because it moves refs the caller did not
# name, which is the point here and a hazard elsewhere: a stale branch pointing
# into the rebased range follows the rebase and stops being the safety net it
# was kept as. Measured caveat — a branch in the range that is checked out in
# another worktree is skipped silently, exit 0 and no warning, leaving that ref
# on pre-rebase commits. One worktree per stack, at its top.
[rebase]
updateRefs = true

[push]
autoSetupRemote = true

[merge]
conflictstyle = zdiff3
tool = nvimdiff

[mergetool]
keepBackup = false
prompt = false

[mergetool "nvimdiff"]
layout = "LOCAL,BASE,REMOTE / MERGED"

[diff]
colorMoved = default
tool = nvimdiff

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true
line-numbers = true
side-by-side = true

# Colors only — written by `theme apply`, and ignored by git while absent.
# Must follow [delta] above so the palette wins over any colour set there.
[include]
path = ~/.config/delta/current.gitconfig

# GitHub credentials through gh. The empty helper = clears any inherited or
# system helper before setting ours, so git does not stack several and prompt
# unexpectedly.
#
# `gh` unqualified, not the absolute path `gh auth setup-git` writes: that path
# was the only thing making this per-platform — /usr/bin on Linux, /usr/local/bin
# on an Intel Mac, and /opt/homebrew/bin on an Apple Silicon one, which no
# platform string distinguishes. PATH resolves it everywhere git runs here.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Whatever one coordinate needs that the rest do not, one include per variant
# that exists, each named for the coordinate *value* rather than the axis. So
# `ls ~/.config/git/` says what this machine is: nonfleet.gitconfig names which
# side of the trust split this box sits on, where trust.gitconfig said only that
# a side had been chosen. The axis is what the comment headings below carry.
#
# The values are written out because git cannot expand a variable in an
# include.path — `~` is the only substitution it does. .zshrc sources the same
# layers by globbing the deployed tree and needs no such list, which is why
# shell/ keeps the axis/value directory in its deployed path and this cannot.
#
# That enumeration is the one cost, and it is guarded: `dotfiles machines check`
# fails when a variant ships a gitconfig no line here names, because git ignores
# a missing include silently and a forgotten line would deploy a file nothing
# ever reads.
#
# Absolute rather than relative because this file is reached through a symlink
# and a relative include would resolve against the repo. Ignored while absent, so
# each machine reads only the lines its own coordinates deployed.
#
# trust comes last: it carries identity, and on a machine hosting both employer
# and personal work the personal exception is an includeIf that has to be read
# after the default it overrides.

# os
[include]
path = ~/.config/git/windows.gitconfig

# host
[include]
path = ~/.config/git/wsl.gitconfig

# trust
[include]
path = ~/.config/git/fleet.gitconfig

[include]
path = ~/.config/git/nonfleet.gitconfig

# %cs/%cr rather than %ad with --date=short, so the format carries its own date
# rendering and stays usable from any alias without a paired flag.
[pretty]
detailed = tformat:%C(blue)%h%C(auto)%d %s %C(green)%cs (%cr)%C(dim yellow) - %an%C(auto)

[alias]
undo-commit = reset --soft HEAD^
unstage = restore --staged
graph = log --graph --pretty=detailed
oneline = log --pretty=detailed
last = commit --amend --no-edit --no-verify
last-commit = log -1 HEAD
changes = log --pretty='short' --name-status
