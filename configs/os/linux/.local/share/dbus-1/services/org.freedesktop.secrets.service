# Overrides /usr/share/dbus-1/services/org.freedesktop.secrets.service.
#
# Arch offers two ways to start the Secret Service — this D-Bus activation entry
# and gnome-keyring-daemon.socket — and nothing arbitrates between them. Both
# fire during login, so a session ends up running two gnome-keyring-daemon
# processes: whichever wins claims org.freedesktop.secrets, and the loser sits
# there owning no bus name. Harmless until you are trying to work out which
# daemon holds a key.
#
# SystemdService= makes D-Bus activation hand the request to the systemd unit
# rather than forking its own process, so both paths converge on one daemon.
# Exec stays as the fallback for a session with no systemd user manager.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
