[Unit]
Description=Save tmux sessions when a shutdown or reboot is announced

# tmux-restore's script holds a logind "delay" lock and waits for
# PrepareForShutdown. logind then waits for the save, up to InhibitDelayMaxSec,
# before it stops anything, so the server it saves is still whole. A hook inside
# tmux fires only as the server is torn down, and saved a cut-off snapshot.
# gdbus is glib2's, which the desktop's GTK already brings.
[Service]
ExecStart=%h/.config/tmux/plugins/tmux-restore/scripts/shutdown-save.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
